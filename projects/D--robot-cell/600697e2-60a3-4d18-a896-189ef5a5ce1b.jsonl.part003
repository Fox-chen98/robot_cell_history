{"type":"api-request-blob","sessionId":"600697e2-60a3-4d18-a896-189ef5a5ce1b","hash":"3f8e039e22a651bd3df3abdbd35817bfafabead7dea0cf11634e56d0f3e0fac6","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01WjHXRyUt2wG5pLLAGSu38R","name":"Bash","input":{"command":"cd /d/robot_cell; export PYTHONIOENCODING=utf-8; /d/miniconda/envs/cad/python.exe - <<'EOF'\nimport io\nBS = chr(92)\ndef patch(p, pairs, blocks=()):\n    s = io.open(p, encoding=\"utf-8\").read()\n    for a, b in pairs:\n        assert s.count(a) == 1, (p, a, s.count(a))\n        s = s.replace(a, b.replace(\"@@\", BS + \"n\"))\n    for start, end, new in blocks:\n        i = s.index(start); j = s.index(end)\n        s = s[:i] + new.replace(\"@@\", BS + \"n\") + s[j:]\n    io.open(p, \"w\", encoding=\"utf-8\", newline=chr(10)).write(s)\n\n# ---------- 模型: 进气口转到相机一侧(-x), 螺栓改沿 y 穿 ----------\npatch(\"scripts/cad/cnc_tool.py\", [\n (\"#       螺栓沿 x 穿; +y = 进气口那一面; 相机支架沿 -x 伸出\",\n  \"#       相机侧臂沿 -x 伸出; 进气口朝相机一侧(-x 面, 2026-11-10 用户定: 与实机一致); 螺栓沿 y 穿(头在 +y)@#       单件(方管/杆头)按自身坐标建模(螺栓沿 x), 装配时绕杆轴转 90 度(rz)\".replace(\"@\", chr(10))),\n (\"def boss(z0, up=True):\", \"def rz(o):\\n    \\\"\\\"\\\"单件坐标 -> 装配朝向: 绕杆轴转 90 度(+y -> -x, +x -> +y)\\\"\\\"\\\"\\n    return o.rotate((0, 0, 0), (0, 0, 1), 90)\\n\\n\\ndef boss(z0, up=True):\".replace(BS + \"n\", chr(10))),\n (\"    body = body.cut(slot)\\n\".replace(BS + \"n\", chr(10)), \"    body = body.cut(rz(slot))                                                               # 转到 -x 面(相机一侧)\\n\".replace(BS + \"n\", chr(10))),\n (\"    body = body.cut(bolt_holes([P[\\\"COL_H\\\"] + d for d in P[\\\"BOLT_Z\\\"]]))\\n    return body.clean(), filleted\".replace(BS + \"n\", chr(10)),\n  \"    body = body.cut(rz(bolt_holes([P[\\\"COL_H\\\"] + d for d in P[\\\"BOLT_Z\\\"]])))\\n    return body.clean(), filleted\".replace(BS + \"n\", chr(10))),\n (\"        items += [head, nut, tip]\", \"        items += [rz(head), rz(nut), rz(tip)]\"),\n (\"    tube = part_tube().translate((0, 0, Z_TUBE))\\n    cap = part_cap().translate((0, 0, Z_CAP))\".replace(BS + \"n\", chr(10)),\n  \"    tube = rz(part_tube()).translate((0, 0, Z_TUBE))\\n    cap = rz(part_cap()).translate((0, 0, Z_CAP))\".replace(BS + \"n\", chr(10))),\n])\n\n# ---------- 立体图 ----------\nseat_new = '''    anchors = [(0, 0, H + BL), (-P[\"BOLT_OFF\"], 10.45, H + P[\"BOLT_Z\"][1]), (0, 12.5, H), (-12.5, 0, (z0 + z1) / 2),\n               (4, 12.5, 16), (-17.68, -17.68, 0), (22, 30, 0), (-75, 22.5, 0), (-100, 8, -40), (0, 13.6, 1.0)]\n    img, a = scene([(seat, \"alu\")], pos=(-175, 300, 240), focal=(-30, 0, 2), up=(0, 0, 1), anchors=anchors, angle=24)\n    lab = [(a[0], (0.30, 0.09), \"Ø9 气路@@气管从这里通到进气长孔\"),\n           (a[1], (0.12, 0.27), \"2 个螺栓孔 Ø3.4@@M3 横穿，锁住方管\"),\n           (a[2], (0.12, 0.45), \"台阶@@方管口顶在这里，长度就固定了\"),\n           (a[3], (0.70, 0.10), \"进气长孔 10×22，朝相机一侧@@气管从这里进来，拐进中心孔\"),\n           (a[4], (0.11, 0.63), \"立柱 25×25，高 40@@和方管外形一样平齐\"),\n           (a[5], (0.88, 0.30), \"4 个法兰孔（M6）@@接机械臂，位置照抄现役下盖\"),\n           (a[6], (0.14, 0.92), \"底板 Ø80 厚 7@@热熔螺母坑和中心孔已填实\"),\n           (a[7], (0.42, 0.93), \"侧臂和 6 个小孔@@照抄现役下盖，相机位置不变\"),\n           (a[8], (0.86, 0.90), \"后挡板@@照抄现役下盖\"),\n           (a[9], (0.12, 0.79), \"根部圆角 R3\")]\n'''\npatch(\"scripts/cad/cnc_tool_render.py\", [\n (\"(mv(ja, 34, d1 / 2 + 5), \\\"steel\\\")\", \"(ja.translate((0, 34, d1 / 2 + 5)), \\\"steel\\\")\"),\n (\"(mv(jb, 34, (d1 + d2) / 2 - 5), \\\"steel\\\")\", \"(jb.translate((0, 34, (d1 + d2) / 2 - 5)), \\\"steel\\\")\"),\n (\"(mv(parts[\\\"pc6\\\"], 42, d2), \\\"steel\\\")\", \"(parts[\\\"pc6\\\"].translate((0, 42, d2)), \\\"steel\\\")\"),\n (\"(42, 6, T.LIP_Z - 45 + d2), (50, P[\\\"BOLT_OFF\\\"], Zt + 15 + d1 / 2 + 5)\", \"(0, 48, T.LIP_Z - 45 + d2), (-P[\\\"BOLT_OFF\\\"], 50, Zt + 15 + d1 / 2 + 5)\"),\n (\"(50, P[\\\"BOLT_OFF\\\"], Zc - 15 + (d1 + d2) / 2 - 5)\", \"(-P[\\\"BOLT_OFF\\\"], 50, Zc - 15 + (d1 + d2) / 2 - 5)\"),\n (\"s1, _ = scene(items, pos=(215, 235, 215), focal=(-25, 0, 22)\", \"s1, _ = scene(items, pos=(-185, 290, 225), focal=(-28, 0, 20)\"),\n (\"s2, _ = scene(items, pos=(210, 130, zc + 130)\", \"s2, _ = scene(items, pos=(130, 210, zc + 130)\"),\n], blocks=[(\"    anchors = [(0, 0, H + BL), (10.45\", \"    figure(img, \\\"1 法兰座\", seat_new)])\nprint(\"patched\")\nEOF\n/d/miniconda/envs/cad/python.exe scripts/cad/cnc_tool.py build 2>&1 | grep -e PASS -e FAIL -e 判决 | tail -9; /d/miniconda/envs/cad/python.exe scripts/cad/cnc_tool.py render 2>&1 | grep -c OK","description":"把进气口改到相机一侧（螺栓相应改为沿另一方向横穿），重新生成模型并渲染立体图","timeout":600000},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"600697e2-60a3-4d18-a896-189ef5a5ce1b","hash":"3b712e7bed8756793ecb935e9dd72eab401920abe6ad8fc8cb52973f662825fd","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01PNZyrBCLVpcxXe47C1689v","name":"Bash","input":{"command":"cd /d/robot_cell; export PYTHONIOENCODING=utf-8; /d/miniconda/envs/cad/python.exe - <<'EOF'\nimport io\nBS = chr(92)\np = \"scripts/cad/cnc_tool_render.py\"\ns = io.open(p, encoding=\"utf-8\").read()\nfor a, b in [('(a[6], (0.14, 0.92), \"底板', '(a[6], (0.11, 0.79), \"底板'), ('(a[9], (0.12, 0.79), \"根部圆角 R3\")', '(a[9], (0.17, 0.92), \"根部圆角 R3\")')]:\n    assert s.count(a) == 1, a\n    s = s.replace(a, b)\nio.open(p, \"w\", encoding=\"utf-8\", newline=chr(10)).write(s)\n\np = \"scripts/cad/cnc_tool_draw.py\"\ns = io.open(p, encoding=\"utf-8\").read()\ni = s.index(\"def draw_seat():\"); j = s.index(\"def draw_tube():\")\nblk = s[i:j]\ndef rep(a, b):\n    global blk\n    assert blk.count(a) >= 1, a\n    blk = blk.replace(a, b)\nrep('    H, BL = P[\"COL_H\"], P[\"BOSS_L\"]', '    H, BL = P[\"COL_H\"], P[\"BOSS_L\"]' + chr(10) + '    OFF = -P[\"BOLT_OFF\"]      # 螺栓沿 y 穿, 孔偏向相机一侧(-x)')\nrep('s.lead(f(0, 9), f(52, 20), \"进气长孔（在 +y 面）\")', 's.lead(f(-9, 0), f(52, 20), \"进气长孔（朝相机一侧）\")')\nrep('label=\"侧视（从进气口一侧看）\"', 'label=\"侧视（从螺栓头一侧看）\"')\nrep('s.lead(f((z0 + z1) / 2, 0), f(40, -42), \"长孔', 's.lead(f((z0 + z1) / 2, -12.5), f(40, -42), \"朝相机一面：长孔')\nrep(\"f = s.view(sub, (-1, 0, 0), (0, 0, 1), 60, 85, sc=k\", \"f = s.view(sub, (0, 1, 0), (0, 0, 1), 60, 85, sc=k\")\nrep('P[\"BOLT_OFF\"] + 1.7', \"OFF + 1.7\")\nrep('P[\"BOLT_OFF\"])', \"OFF)\")\nrep('\"%.1f\" % OFF)', '\"%.1f\" % P[\"BOLT_OFF\"])')\ns = s[:i] + blk + s[j:]\nfor a, b in [('label=\"主视（从进气口一面看）\"', 'label=\"主视（从螺栓头一侧看；进气口朝相机）\"'), ('label=\"俯视（从螺栓头一侧看）\")', 'label=\"侧视（背对相机一侧看）\")')]:\n    assert s.count(a) == 1, a\n    s = s.replace(a, b)\nio.open(p, \"w\", encoding=\"utf-8\", newline=chr(10)).write(s)\nEOF\n/d/miniconda/envs/cad/python.exe scripts/cad/cnc_tool.py draw 2>&1 | grep -c OK; /d/miniconda/envs/cad/python.exe scripts/cad/cnc_tool.py render 2>&1 | grep -c OK","description":"同步修正平面图纸里的方向标注，重新生成图纸和立体图","timeout":600000},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"600697e2-60a3-4d18-a896-189ef5a5ce1b","hash":"145d689face2343e72a4f266ec2d151a340471624a5749bfdae72031b6e475cf","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_019JjLnssKWDHjbV2KsoxLdV","name":"Bash","input":{"command":"cd /d/robot_cell; git add scripts/cad \"3D_model/CNC末端\" && git commit -q -m \"fix: CNC 末端进气口改到相机一侧(螺栓改沿另一方向横穿), 图纸与立体图同步\n\nCo-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>\" && git log --oneline -1; echo ---; cat \"$LOCALAPPDATA/Temp/claude/43f48c4257a38110/600697e2-60a3-4d18-a896-189ef5a5ce1b/tasks/b0fg1ymjt.output\" | head -40","description":"提交修改，并查看后台磁盘统计结果"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01QwyMUyZ8Tm9KeBXzRHwzrb","name":"SendUserFile","input":{"files":["D:\\robot_cell\\3D_model\\CNC末端\\渲染图\\3_法兰座_立体标注.png","D:\\robot_cell\\3D_model\\CNC末端\\渲染图\\1_效果图_黑色氧化.png","D:\\robot_cell\\3D_model\\CNC末端\\渲染图\\2_爆炸图.png"],"caption":"进气口已改到相机一侧","status":"normal","display":"render"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"600697e2-60a3-4d18-a896-189ef5a5ce1b","hash":"faba543092513a21d0126b1614a37286096c0a1f2dec2973880f14aee02b8534","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01B8HbsMXW8DXgnWBU1XtQDs","name":"Artifact","input":{"action":"quickstart","intent":"other","design_systems":false},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"600697e2-60a3-4d18-a896-189ef5a5ce1b","hash":"d39d3b77d4742864b67eecdce7ea3c0873640fb0528a526dc3d1e506fe251353","message":{"role":"assistant","content":[{"type":"text","text":"可以。我做一个网页：鼠标拖动旋转、滚轮缩放，还能拉开成爆炸图、切换黑色氧化效果、点零件看说明。"},{"type":"tool_use","id":"toolu_019DMQvrypSzWxtGeYzDjpdN","name":"Write","input":{"file_path":"D:\\robot_cell\\scripts\\cad\\cnc_tool_web.py","content":"#!/usr/bin/env python3\n# ============================================================\n# CNC 末端 可拖动旋转的立体查看网页\n# 用法: D:\\miniconda\\envs\\cad\\python.exe scripts\\cad\\cnc_tool_web.py [发布用片段输出路径]\n# 产物: 3D_model/CNC末端/立体查看.html (完整网页, 双击用浏览器打开; three.js 从 cdnjs 加载, 需联网)\n#       给了第二个路径时, 另存一份不带 <html>/<body> 的片段(发布 Artifact 用)\n# 做法: 模型取自 cnc_tool.assembly_parts() -> 三角网格量化成 Int16(0.02 mm) 内嵌 base64; 页面逻辑见 cnc_tool_web.tpl.html\n# ============================================================\nimport os, sys, json, base64\nimport numpy as np\nimport cadquery as cq\nimport cnc_tool as T\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nP = T.P\n\n\ndef mesh(o, tol, ang):\n    vs = o.vals()\n    shape = vs[0] if len(vs) == 1 else cq.Compound.makeCompound(vs)\n    v, t = shape.tessellate(tol, ang)\n    pos = np.array([[p.x, p.y, p.z] for p in v], dtype=np.float64)\n    q = np.round(pos * 50).astype(np.int16)\n    idx = np.array(t, dtype=np.uint32).reshape(-1)\n    return dict(p=base64.b64encode(q.tobytes()).decode(), i=base64.b64encode(idx.tobytes()).decode(), n=int(len(idx) // 3))\n\n\ndef split_fasteners():\n    m6, ja, jb = [], [], []\n    for so in T.fasteners().vals():\n        z = so.BoundingBox().center.z\n        (m6 if z < 10 else ja if z < 200 else jb).append(so)\n    mk = lambda l: cq.Workplane(\"XY\").add(cq.Compound.makeCompound(l))\n    return mk(m6), mk(ja), mk(jb)\n\n\ndef main():\n    parts = dict(T.assembly_parts())\n    m6, ja, jb = split_fasteners()\n    d1, d2 = 62, 124\n    spec = [\n        # key, 名称, 来源, 说明, 对象, 爆炸位移(x,y,z), 类别, 精度, 画棱线\n        (\"seat\", \"① 法兰座\", \"CNC 定做 · 6061-T6\",\n         \"接机械臂法兰。底板、4 个法兰孔、侧臂和后挡板照抄现役下盖，相机位置不变。新做的是中间的立柱（25×25，高 %.0f）、凸台（%.1f 方，长 %.0f）和朝相机一侧的进气长孔。\" % (P[\"COL_H\"], T.BOSS, P[\"BOSS_L\"]),\n         parts[\"seat\"], (0, 0, 0), \"cnc\", 0.05, True),\n        (\"tube\", \"② 方管\", \"现成铝方管 25×25×2\",\n         \"买现成型材，锯到 %.1f 长，两端各打 2 个 Ø%.1f 的横穿孔。两头分别套在法兰座和杆头的凸台上。\" % (T.TUBE_L, P[\"BOLT_D\"]),\n         parts[\"tube\"], (0, 0, d1), \"cnc\", 0.05, True),\n        (\"cap\", \"③ 杆头\", \"CNC 定做 · 6061-T6\",\n         \"装吸盘的一端。凸台插进方管；侧面开一个装配腔（%.0f 宽 × %.0f 长），用手在里面拧螺母、拧快插、插气管；端块厚 %.0f，中间 Ø%.1f 孔穿吸盘螺纹。\" % (\n             P[\"CAP_WIN_W\"], P[\"CAP_BODY\"] - P[\"CAP_BLOCK\"] - P[\"CAP_POCKET_Z0\"], P[\"CAP_BLOCK\"], P[\"BORE_M8\"]),\n         parts[\"cap\"], (0, 0, d2), \"cnc\", 0.05, True),\n        (\"ja\", \"M3×30 螺栓（法兰座一端）\", \"外购 · 2 套\", \"2 颗 M3×30 内六角 + 尼龙锁紧螺母，横穿方管和法兰座的凸台，防止拔出。\",\n         ja, (0, 34, d1 / 2 + 5), \"buy\", 0.05, False),\n        (\"jb\", \"M3×30 螺栓（杆头一端）\", \"外购 · 2 套\", \"2 颗 M3×30 内六角 + 尼龙锁紧螺母，横穿方管和杆头的凸台。换吸盘时拆这两颗。\",\n         jb, (0, 34, (d1 + d2) / 2 - 5), \"buy\", 0.05, False),\n        (\"m6\", \"M6 螺栓\", \"外购 · 4 颗（沿用）\", \"4 颗 M6 内六角，把法兰座固定在机械臂法兰上。孔位和现役下盖一样。\",\n         m6, (0, 0, 26), \"buy\", 0.05, False),\n        (\"pad\", \"吸盘\", \"ZP3-T13UMSK6-B5（沿用）\", \"从杆头端面插入，里面用两颗薄螺母夹紧。唇边露出端面 8.5，离法兰面 436。\",\n         parts[\"pad\"], (0, 0, d2 + 42), \"buy\", 0.08, False),\n        (\"pc6\", \"快插接头\", \"PC6-M5（沿用）\", \"拧在吸盘金具尾部，气管从方管里上来插在这里。从杆头侧面的装配腔装进去。\",\n         parts[\"pc6\"], (0, 42, d2), \"buy\", 0.08, False),\n        (\"camera\", \"相机\", \"Gemini 335（沿用）\", \"装在法兰座侧臂上，位置和现在完全一样，所以手眼标定不用重做。\",\n         parts[\"camera\"], (0, 0, 0), \"buy\", 0.12, False),\n    ]\n    data = []\n    total = 0\n    for key, name, src, info, obj, off, kind, tol, edges in spec:\n        m = mesh(obj, tol, 0.25)\n        total += m[\"n\"]\n        m.update(key=key, name=name, src=src, info=info, off=list(off), kind=kind, edges=edges)\n        data.append(m)\n    facts = dict(total=T.TOTAL, tube=T.TUBE_L, boss=T.BOSS)\n    tpl = open(os.path.join(HERE, \"cnc_tool_web.tpl.html\"), encoding=\"utf-8\").read()\n    frag = tpl.replace(\"/*__DATA__*/null\", json.dumps(data, ensure_ascii=False)).replace(\"/*__FACTS__*/null\", json.dumps(facts))\n    full = ('<!doctype html>\\n<html lang=\"zh-CN\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n            '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\\n'\n            '<style>html,body{height:100%;margin:0}</style>\\n</head>\\n<body>\\n' + frag + '\\n</body>\\n</html>\\n')\n    out = os.path.join(T.OUT, \"立体查看.html\")\n    open(out, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(full)\n    print(\"[OK] 网页 %s  (%d 个三角面, %.1f MB)\" % (out, total, len(full.encode(\"utf-8\")) / 1e6))\n    if len(sys.argv) > 1:\n        open(sys.argv[1], \"w\", encoding=\"utf-8\", newline=\"\\n\").write(frag)\n        print(\"[OK] 发布用片段 \" + sys.argv[1])\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01J4YSVVoYEcQFPSajWLtRd2","name":"Write","input":{"file_path":"D:\\robot_cell\\scripts\\cad\\cnc_tool_web.tpl.html","content":"<title>立放末端 CNC 版</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<style>\n/* 布局: 一屏工作台 —— 左边是可拖动的立体模型, 右边一条窄栏放三样操作(拉开/配色/零件清单)和选中零件的说明; 窄屏时上下排 */\n:root {\n  --bg: #eef1f4; --stage: #e3e8ee; --panel: #ffffff; --line: #cdd5de;\n  --fg: #18222d; --muted: #5a6877; --accent: #1b5fb8; --accent-fg: #ffffff; --mark: #d9482b;\n  --font: \"Microsoft YaHei\", \"PingFang SC\", \"Noto Sans SC\", \"Segoe UI\", system-ui, sans-serif;\n  --mono: \"Cascadia Mono\", \"Consolas\", ui-monospace, monospace;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --bg: #12171d; --stage: #1a2129; --panel: #1e262f; --line: #33404d;\n  --fg: #e6ecf2; --muted: #9aa8b6; --accent: #6aa7f2; --accent-fg: #0d1620; --mark: #ff7a5c; color-scheme: dark } }\n:root[data-theme=\"dark\"] {\n  --bg: #12171d; --stage: #1a2129; --panel: #1e262f; --line: #33404d;\n  --fg: #e6ecf2; --muted: #9aa8b6; --accent: #6aa7f2; --accent-fg: #0d1620; --mark: #ff7a5c; color-scheme: dark }\nhtml, body { height: 100%; }\nbody { background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 14px; line-height: 1.55; }\n.app { height: 100%; display: flex; flex-direction: column; gap: 10px; box-sizing: border-box;\n  padding-block: 12px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }\n.head h1 { margin: 0; font-size: 19px; font-weight: 700; letter-spacing: .01em; }\n.head p { margin: 0; color: var(--muted); font-size: 13px; }\n.facts { margin-left: auto; display: flex; gap: 14px; font-family: var(--mono); font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }\n.facts b { color: var(--fg); font-weight: 600; }\n.work { flex: 1; min-height: 0; display: flex; gap: 12px; }\n.stage { flex: 1; min-width: 0; position: relative; background: var(--stage); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }\n.stage canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }\n.stage canvas:active { cursor: grabbing; }\n.hint { position: absolute; left: 12px; bottom: 10px; font-size: 12px; color: var(--muted); pointer-events: none; }\n.views { position: absolute; right: 10px; top: 10px; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }\n.side { width: 300px; flex: none; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; }\n.box { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }\n.box h2 { margin: 0; font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: .08em; }\nbutton { font: inherit; color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: 5px; padding: 5px 10px; cursor: pointer; }\nbutton:hover { border-color: var(--accent); }\nbutton:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\nbutton[aria-pressed=\"true\"] { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }\n.row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }\ninput[type=range] { flex: 1; min-width: 0; accent-color: var(--accent); }\n.parts { display: flex; flex-direction: column; gap: 2px; }\n.part { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 5px; border: 1px solid transparent; cursor: pointer; }\n.part:hover { background: var(--stage); }\n.part.sel { border-color: var(--mark); }\n.part input { accent-color: var(--accent); margin: 0; }\n.part .nm { flex: 1; min-width: 0; }\n.part .tag { font-size: 11px; color: var(--muted); white-space: nowrap; }\n.info h3 { margin: 0; font-size: 15px; }\n.info .src { color: var(--accent); font-size: 12px; }\n.info p { margin: 0; color: var(--fg); }\n.err { padding: 16px; color: var(--mark); }\n@media (max-width: 760px) {\n  .work { flex-direction: column; }\n  .stage { flex: none; height: 56vh; min-height: 300px; }\n  .side { width: auto; overflow: visible; }\n  .app { height: auto; min-height: 100%; }\n  .facts { margin-left: 0; }\n}\n</style>\n\n<div class=\"app\">\n  <div class=\"head\">\n    <h1>立放末端 CNC 版</h1>\n    <p>初稿 V0.1 · 三个铝件 + 沿用的吸盘、快插、相机</p>\n    <div class=\"facts\"><span>法兰面→唇边 <b id=\"f-total\"></b></span><span>方管长 <b id=\"f-tube\"></b></span><span>凸台 <b id=\"f-boss\"></b> 方</span></div>\n  </div>\n  <div class=\"work\">\n    <div class=\"stage\" id=\"stage\">\n      <canvas id=\"cv\"></canvas>\n      <div class=\"views\">\n        <button id=\"v-all\" type=\"button\">整体</button>\n        <button id=\"v-seat\" type=\"button\">看法兰座</button>\n        <button id=\"v-cap\" type=\"button\">看杆头</button>\n      </div>\n      <div class=\"hint\">拖动旋转 · 滚轮缩放 · 右键拖动平移 · 点零件看说明</div>\n    </div>\n    <div class=\"side\">\n      <div class=\"box\">\n        <h2>拉开看怎么装</h2>\n        <div class=\"row\"><span>合上</span><input id=\"explode\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" aria-label=\"拉开程度\"><span>拉开</span></div>\n      </div>\n      <div class=\"box\">\n        <h2>表面</h2>\n        <div class=\"row\">\n          <button id=\"c-alu\" type=\"button\" aria-pressed=\"true\">浅色（看结构）</button>\n          <button id=\"c-blk\" type=\"button\" aria-pressed=\"false\">黑色氧化</button>\n        </div>\n      </div>\n      <div class=\"box\">\n        <h2>零件（勾选显示，点名字选中）</h2>\n        <div class=\"parts\" id=\"parts\"></div>\n      </div>\n      <div class=\"box info\" id=\"info\">\n        <h3 id=\"i-name\">点一个零件</h3>\n        <div class=\"src\" id=\"i-src\"></div>\n        <p id=\"i-text\">在模型上点一下，或者点上面清单里的名字，这里会显示它是什么、怎么来的。</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\n(function () {\n  var DATA = /*__DATA__*/null, FACTS = /*__FACTS__*/null;\n  var stage = document.getElementById('stage'), cv = document.getElementById('cv');\n  if (!window.THREE || !THREE.OrbitControls) {\n    stage.innerHTML = '<div class=\"err\">立体显示库没有加载成功（需要联网）。请检查网络后刷新页面。</div>';\n    return;\n  }\n  document.getElementById('f-total').textContent = FACTS.total.toFixed(0) + ' mm';\n  document.getElementById('f-tube').textContent = FACTS.tube.toFixed(1) + ' mm';\n  document.getElementById('f-boss').textContent = FACTS.boss.toFixed(1);\n\n  function b64(s, Type) {\n    var bin = atob(s), n = bin.length, u8 = new Uint8Array(n);\n    for (var i = 0; i < n; i++) u8[i] = bin.charCodeAt(i);\n    return new Type(u8.buffer);\n  }\n  // 配色: [浅色, 黑色氧化]\n  var LOOK = {\n    seat: [0xb9c1cc, 0x2b2c31], tube: [0x9fb0c6, 0x303137], cap: [0xb9c1cc, 0x2b2c31],\n    ja: [0xd8d9dc, 0xd8d9dc], jb: [0xd8d9dc, 0xd8d9dc], m6: [0xd8d9dc, 0xd8d9dc],\n    pad: [0x24477f, 0x24477f], pc6: [0xd0d2d6, 0xd0d2d6], camera: [0x4a4d55, 0x4a4d55]\n  };\n  var renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true });\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n  var scene = new THREE.Scene();\n  var cam = new THREE.PerspectiveCamera(28, 1, 5, 6000);\n  scene.add(new THREE.HemisphereLight(0xffffff, 0x8a94a3, 0.85));\n  var key = new THREE.DirectionalLight(0xffffff, 0.75); cam.add(key); key.position.set(-200, 300, 200);\n  var fill = new THREE.DirectionalLight(0xffffff, 0.3); cam.add(fill); fill.position.set(300, -100, 100);\n  scene.add(cam);\n  var ctl = new THREE.OrbitControls(cam, cv);\n  ctl.enableDamping = true; ctl.dampingFactor = 0.12; ctl.minDistance = 60; ctl.maxDistance = 2500;\n\n  var parts = {}, meshes = [], selected = null, blk = false, explode = 0;\n  DATA.forEach(function (d) {\n    var q = b64(d.p, Int16Array), pos = new Float32Array(q.length);\n    for (var i = 0; i < q.length; i++) pos[i] = q[i] / 50;\n    var g = new THREE.BufferGeometry();\n    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n    g.setIndex(new THREE.BufferAttribute(b64(d.i, Uint32Array), 1));\n    g.computeVertexNormals();\n    var metal = d.kind === 'cnc' || d.key === 'ja' || d.key === 'jb' || d.key === 'm6' || d.key === 'pc6';\n    var mat = new THREE.MeshStandardMaterial({ color: LOOK[d.key][0], metalness: metal ? 0.35 : 0.0, roughness: metal ? 0.55 : 0.8 });\n    var m = new THREE.Mesh(g, mat);\n    m.userData.key = d.key;\n    var grp = new THREE.Group(); grp.add(m);\n    var line = null;\n    if (d.edges) {\n      line = new THREE.LineSegments(new THREE.EdgesGeometry(g, 32), new THREE.LineBasicMaterial({ color: 0x2a3340, transparent: true, opacity: 0.55 }));\n      grp.add(line);\n    }\n    scene.add(grp);\n    parts[d.key] = { d: d, grp: grp, mesh: m, line: line };\n    meshes.push(m);\n  });\n\n  function applyExplode() {\n    DATA.forEach(function (d) { parts[d.key].grp.position.set(d.off[0] * explode, d.off[1] * explode, d.off[2] * explode); });\n  }\n  function applyLook() {\n    DATA.forEach(function (d) {\n      var p = parts[d.key];\n      p.mesh.material.color.setHex(LOOK[d.key][blk ? 1 : 0]);\n      p.mesh.material.emissive.setHex(selected === d.key ? 0x7a2412 : 0x000000);\n      if (d.kind === 'cnc') { p.mesh.material.roughness = blk ? 0.68 : 0.55; p.mesh.material.metalness = blk ? 0.45 : 0.35; }\n      if (p.line) { p.line.material.color.setHex(blk ? 0x8a8f99 : 0x2a3340); p.line.material.opacity = blk ? 0.35 : 0.55; }\n    });\n    document.getElementById('c-alu').setAttribute('aria-pressed', String(!blk));\n    document.getElementById('c-blk').setAttribute('aria-pressed', String(blk));\n  }\n  function select(k) {\n    selected = k;\n    var d = k ? parts[k].d : null;\n    document.getElementById('i-name').textContent = d ? d.name : '点一个零件';\n    document.getElementById('i-src').textContent = d ? d.src : '';\n    document.getElementById('i-text').textContent = d ? d.info : '在模型上点一下，或者点上面清单里的名字，这里会显示它是什么、怎么来的。';\n    Array.prototype.forEach.call(document.querySelectorAll('.part'), function (el) { el.classList.toggle('sel', el.dataset.key === k); });\n    applyLook();\n  }\n\n  // 零件清单\n  var list = document.getElementById('parts');\n  DATA.forEach(function (d) {\n    var row = document.createElement('div'); row.className = 'part'; row.dataset.key = d.key;\n    var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = true; cb.id = 'show-' + d.key; cb.setAttribute('aria-label', '显示 ' + d.name);\n    cb.addEventListener('click', function (e) { e.stopPropagation(); });\n    cb.addEventListener('change', function () { parts[d.key].grp.visible = cb.checked; });\n    var nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = d.name;\n    var tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = d.kind === 'cnc' ? (d.key === 'tube' ? '型材' : 'CNC') : '外购';\n    row.appendChild(cb); row.appendChild(nm); row.appendChild(tag);\n    row.addEventListener('click', function () { select(selected === d.key ? null : d.key); });\n    list.appendChild(row);\n  });\n\n  // 视角\n  var Z = FACTS.total - 7;\n  function view(target, dir, dist) {\n    ctl.target.set(target[0], target[1], target[2] + (target[2] > 100 ? 0 : 0));\n    var v = new THREE.Vector3(dir[0], dir[1], dir[2]).normalize().multiplyScalar(dist);\n    cam.position.set(target[0] + v.x, target[1] + v.y, target[2] + v.z);\n    ctl.update();\n  }\n  cam.up.set(0, 1, 0);\n  function vAll() { var s = 1 + explode * 0.35; view([-12, -6, (Z / 2 - 8) * s], [0.72, 0.55, 0.5], 760 * s); }\n  function vSeat() { view([-30, 0, 12], [-0.45, 0.62, 0.62], 400); }\n  function vCap() { var dz = parts.cap.d.off[2] * explode; view([0, 0, Z - 50 + dz], [0.55, 0.62, 0.55], 260); }\n  document.getElementById('v-all').addEventListener('click', vAll);\n  document.getElementById('v-seat').addEventListener('click', vSeat);\n  document.getElementById('v-cap').addEventListener('click', vCap);\n  document.getElementById('explode').addEventListener('input', function (e) { explode = e.target.value / 100; applyExplode(); });\n  document.getElementById('c-alu').addEventListener('click', function () { blk = false; applyLook(); });\n  document.getElementById('c-blk').addEventListener('click', function () { blk = true; applyLook(); });\n\n  // 点选(区分拖动)\n  var ray = new THREE.Raycaster(), down = null;\n  cv.addEventListener('pointerdown', function (e) { down = [e.clientX, e.clientY]; });\n  cv.addEventListener('pointerup', function (e) {\n    if (!down || Math.abs(e.clientX - down[0]) + Math.abs(e.clientY - down[1]) > 5) return;\n    var r = cv.getBoundingClientRect();\n    ray.setFromCamera(new THREE.Vector2((e.clientX - r.left) / r.width * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1), cam);\n    var hit = ray.intersectObjects(meshes.filter(function (m) { return m.parent.visible; }), false)[0];\n    select(hit ? hit.object.userData.key : null);\n  });\n\n  function resize() {\n    var w = stage.clientWidth, h = stage.clientHeight;\n    if (!w || !h) return;\n    renderer.setSize(w, h, false); cam.aspect = w / h; cam.updateProjectionMatrix();\n  }\n  if (window.ResizeObserver) new ResizeObserver(resize).observe(stage); else window.addEventListener('resize', resize);\n  resize(); applyExplode(); applyLook(); vAll();\n  (function loop() { ctl.update(); renderer.render(scene, cam); requestAnimationFrame(loop); })();\n})();\n</script>\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Fvukxrj2RbkXapL2kxeNH6","name":"Bash","input":{"command":"cd /d/robot_cell; export PYTHONIOENCODING=utf-8; S=$(cygpath -w \"$LOCALAPPDATA/Temp/claude/43f48c4257a38110/600697e2-60a3-4d18-a896-189ef5a5ce1b/scratchpad/cnc_viewer.html\"); cd scripts/cad && /d/miniconda/envs/cad/python.exe cnc_tool_web.py \"$S\" 2>&1 | grep -v -e mstmc -e Warning -e \"warn(\"","description":"生成可拖动旋转的立体查看网页","timeout":300000},"caller":{"type":"direct"}}]}}
