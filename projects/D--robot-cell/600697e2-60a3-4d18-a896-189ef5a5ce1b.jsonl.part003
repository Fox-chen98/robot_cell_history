05, True),","         (\"ja\", \"M3×30 螺栓（法兰座一端）\", \"外购 · 2 套\", \"2 颗 M3×30 内六角 + 尼龙锁紧螺母，横穿方管和法兰座的凸台，防止拔出。\",","          ja, (0, 34, d1 / 2 + 5), \"buy\", 0.05, False),","         (\"jb\", \"M3×30 螺栓（杆头一端）\", \"外购 · 2 套\", \"2 颗 M3×30 内六角 + 尼龙锁紧螺母，横穿方管和杆头的凸台。换吸盘时拆这两颗。\","]}]},{"filePath":"D:\\robot_cell\\scripts\\cad\\cnc_tool_web.tpl.html","hunks":[{"oldStart":61,"oldLines":7,"newStart":61,"newLines":7,"lines":[" <div class=\"app\">","   <div class=\"head\">","     <h1>立放末端 CNC 版</h1>","-    <p>初稿 V0.1 · 三个铝件 + 沿用的吸盘、快插、相机</p>","+    <p>初稿 V0.1 · 四个铝件 + 沿用的吸盘、快插、相机</p>","     <div class=\"facts\"><span>法兰面→唇边 <b id=\"f-total\"></b></span><span>方管长 <b id=\"f-tube\"></b></span><span>凸台 <b id=\"f-boss\"></b> 方</span></div>","   </div>","   <div class=\"work\">"]},{"oldStart":120,"oldLines":7,"newStart":120,"newLines":7,"lines":["   }","   // 配色: [浅色, 黑色氧化]","   var LOOK = {","-    seat: [0xb9c1cc, 0x2b2c31], tube: [0x9fb0c6, 0x303137], cap: [0xb9c1cc, 0x2b2c31],","+    seat: [0xb9c1cc, 0x2b2c31], tube: [0x9fb0c6, 0x303137], cap: [0xb9c1cc, 0x2b2c31], back: [0xa9b6c6, 0x2b2c31],","     ja: [0xd8d9dc, 0xd8d9dc], jb: [0xd8d9dc, 0xd8d9dc], m6: [0xd8d9dc, 0xd8d9dc],","     pad: [0x24477f, 0x24477f], pc6: [0xd0d2d6, 0xd0d2d6], camera: [0x4a4d55, 0x4a4d55]","   };"]}]}],"moreFiles":1,"changedFiles":["D:\\robot_cell\\3D_model\\CNC末端\\立体查看.html","D:\\robot_cell\\scripts\\cad\\cnc_tool_web.py","D:\\robot_cell\\scripts\\cad\\cnc_tool_web.tpl.html"]}},"serverClassifierContext":{"request":"c2c9420a-03f3-4d69-824d-d4f109fc277c","context":{"git_state":{"cwd":"/d/robot_cell/scripts/cad","root":"/d/robot_cell","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/d/robot_cell/scripts/cad","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"9