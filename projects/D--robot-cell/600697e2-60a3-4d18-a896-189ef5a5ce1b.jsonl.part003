nJN = [\"arm_1_joint_1\", \"arm_1_joint_2\", \"arm_1_joint_3\", \"arm_1_joint_4\", \"arm_1_joint_5\", \"arm_1_joint_6\"]\nrclpy.init(); n = Node(\"self_check_%d\" % os.getpid())\nsv = n.create_client(GetStateValidity, \"/check_state_validity\")\nassert sv.wait_for_service(timeout_sec=10)\n\n\ndef w(a):\n    a = math.degrees(a); return (a + 180.0) % 360.0 - 180.0\n\n\ndef is_scene(b):\n    return b.startswith(\"scene_\") or b in (\"table\", \"floor\", \"shelf\", \"conveyor\", \"pedestal_obstacle\")\n\n\nfor path in sys.argv[1:]:\n    d = json.load(open(path)); traj = d.get(\"traj\") or d.get(\"rec\")\n    first, pairs, nbad, jfree = -1, [], 0, 0.0\n    for i, row in enumerate(traj):\n        req = GetStateValidity.Request(); rs = RobotState(); rs.joint_state = JointState()\n        rs.joint_state.name = JN; rs.joint_state.position = [float(x) for x in row[1:7]]\n        req.robot_state = rs; req.group_name = \"arm_1\"\n        f = sv.call_async(req); rclpy.spin_until_future_complete(n, f); r = f.result()\n        sp = [[c.contact_body_1, c.contact_body_2] for c in r.contacts if not is_scene(c.contact_body_1) and not is_scene(c.contact_body_2)]\n        if sp:\n            nbad += 1\n            if first < 0: first, pairs = i, sp[:4]\n        else:\n            jfree = max(jfree, abs(w(row[3])))\n27:for path in sys.argv[1:]:\n35:        sp = [[c.contact_body_1, c.contact_body_2] for c in r.contacts if not is_scene(c.contact_body_1) and not is_scene(c.contact_body_2)]\nwsl: Failed to translate 'E:\\PyCharm Community Edition 2022.3.2\\bin'\nbash: C:/Program Files/Git/mnt/d/robot_cell/scripts/serverside/stack/sim_stack.sh: No such file or directory","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"203d173b-8f76-45e2-91e8-0c3196f8d05c","context":{"git_state":{"cwd":"/d/robot_cell","root":"/d/robot_cell","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"