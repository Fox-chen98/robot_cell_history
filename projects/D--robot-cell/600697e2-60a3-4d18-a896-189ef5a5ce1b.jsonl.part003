,"+","+    def add(m, color):","+        pd = vtk.vtkPolyData()","+        pts = vtk.vtkPoints()","+        pts.SetData(numpy_support.numpy_to_vtk(np.ascontiguousarray(m.vertices, dtype=np.float64), deep=True))","+        cells = vtk.vtkCellArray()","+        f = np.c_[np.full(len(m.faces), 3), m.faces].astype(np.int64).ravel()","+        cells.SetCells(len(m.faces), numpy_support.numpy_to_vtkIdTypeArray(f, deep=True))","+        pd.SetPoints(pts)","+        pd.SetPolys(cells)","+        n = vtk.vtkPolyDataNormals()","+        n.SetInputData(pd)","+        n.SetFeatureAngle(40)","+        n.SplittingOn()","+        mp = vtk.vtkPolyDataMapper()","+        mp.SetInputConnection(n.GetOutputPort())","+        ac = vtk.vtkActor()","+        ac.SetMapper(mp)","+        ac.GetProperty().SetColor(*color)","+        ac.GetProperty().SetAmbient(0.25)","+        ac.GetProperty().SetSpecular(0.25)","+        actors.append(ac)","+","+    for name in LINKS:","+        v = vis[name]","+        m = trimesh.load(os.path.join(MESH_DIR, os.path.basename(v[\"file\"])), force=\"mesh\")","+        m.apply_scale(v[\"scale\"][0])","+        m.apply_transform(T[name] @ v[\"T\"])","+        add(m, (0.80, 0.82, 0.85))","+    tm = trimesh.load(os.path.join(ROOT, sp[\"tool\"][\"mesh\"]), force=\"mesh\")","+    tm.apply_scale(0.001 if tm.extents.max() > 5 else 1.0)","+    tm.apply_transform(vis[\"suction_cup_link\"][\"T\"])","+    back = tm.triangles_center[:, 2] < -0.001","+    for mask, col in [(back, (0.88, 0.25, 0.18)), (~back, (0.25, 0.27, 0.30))]:","+        sub = tm.submesh([np.nonzero(mask)[0]], append=True)","+        sub.apply_transform(T[\"tool\"])","+        add(sub, col)","+    c = T[\"tool\"][:3, 3]","+    views = views or [(0.55, 0.45, 0.30), (-0.50, 0.50, 0.25), (0.10, -0.65, 0.30)]","+    imgs = []","+    for v in views:","+        ren = vtk.vtkRenderer()","+        ren.SetBackground(0.95, 0.96, 0.97)","+        for ac in actors:","+            ren.AddActor(ac)","+        kit = vtk.vtkLightKit()","+        kit.AddLightsToRenderer(ren)","+        cam = ren.GetActiveCamera()","+        cam.SetFocalPoint(*c)","+        cam.SetPosition(*(c + np.array(v)))","+        cam.SetViewUp(0, 0, 1)","+        cam.SetViewAngle(30)","+        ren.ResetCameraClippingRange()","+        rw = vtk.vtkRenderWindow()","+        rw.SetOffScreenRendering(1)","+        rw.AddRenderer(ren)","+        rw.SetSize(1100, 1000)","+        ren.UseFXAAOn()","+        rw.Render()","+        w2i = vtk.vtkWindowToImageFilter()","+        w2i.SetInput(rw)","+        w2i.Update()","+        im = w2i.GetOutput()","+        w, h, _ = im.GetDimensions()","+        imgs.append(numpy_support.vtk_to_numpy(im.GetPointData().GetScalars()).reshape(h, w, -1)[::-1, :, :3].copy())","+        rw.Finalize()","+    import matplotlib","+    matplotlib.use(\"Agg\")","+    import matplotlib.pyplot as plt","+    plt.rcParams[\"font.sans-serif\"] = [\"Microsoft YaHei\", \"SimHei\"]","+    fig, axs = plt.subplots(1, len(imgs), figsize=(6.2 * len(imgs), 6.4))","+    for ax, im, t in zip(np.atleast_1d(axs), imgs, [\"视角 1\", \"视角 2\", \"视角 3\"]):","+        ax.imshow(im)","+        ax.axis(\"off\")","+        ax.set_title(t, fontsize=11, color=\"#555\")","+    fig.suptitle(\"扫码位，手腕转 %d 次 90°（J6 = %.0f°）；红色 = 后挡板\" % (turns, math.degrees(q[5])), fontsize=15, weight=\"bold\", x=0.02, ha=\"left\")","+    fig.tight_layout()","+    fig.savefig(png, dpi=120, facecolor=\"white\")","+    print(\"[OK] \" + png)","+","+","+if __name__ == \"__main__\" and len(sys.argv) > 1 and sys.argv[1] == \"shot\":","+    shot(sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else 2)","+elif __name__ == \"__main__\":","     sys.exit(main())"]}]}],"moreFiles":1,"changedFiles":["D:\\robot_cell\\3D_model\\CNC末端\\渲染图\\7_扫码位_转两次.png","D:\\robot_cell\\tools\\arm\\wrist_clearance.py"]}},"serverClassifierContext":{"request":"f8136db5-3ed6-44ee-948e-95cbc86e2a30","context":{"git_state":{"cwd":"/d/robot_cell","root":"/d/robot_cell","b