rs()","     d1, d2 = 62, 124","     mv = lambda o, dx, dz: o.translate((dx, 0, dz))","-    items = [(parts[\"seat\"], \"alu\"), (parts[\"camera\"], \"cam\"), (mv(m6, 0, 26), \"steel\"),","+    items = [(parts[\"seat\"], \"alu\"), (parts[\"back\"].translate((-30, 0, -34)), \"alu2\"), (parts[\"camera\"], \"cam\"), (mv(m6, 0, 26), \"steel\"),","              (mv(parts[\"tube\"], 0, d1), \"alu2\"), (ja.translate((0, 34, d1 / 2 + 5)), \"steel\"),","              (mv(parts[\"cap\"], 0, d2), \"alu\"), (jb.translate((0, 34, (d1 + d2) / 2 - 5)), \"steel\"),","              (parts[\"pc6\"].translate((0, 42, d2)), \"steel\"), (mv(parts[\"pad\"], 0, d2 + 42), \"rubber\")]"]},{"oldStart":273,"oldLines":7,"newStart":274,"newLines":7,"lines":[" "," def r_final():","     parts = dict(T.assembly_parts())","-    items = [(parts[\"seat\"], \"black\"), (parts[\"tube\"], \"black2\"), (parts[\"cap\"], \"black\"), (parts[\"pad\"], \"rubber\"),","+    items = [(parts[\"seat\"], \"black\"), (parts[\"back\"], \"black\"), (parts[\"tube\"], \"black2\"), (parts[\"cap\"], \"black\"), (parts[\"pad\"], \"rubber\"),","              (parts[\"pc6\"], \"steel\"), (parts[\"camera\"], \"cam\"), (parts[\"fasteners\"], \"steel\")]","     bg = (0.93, 0.94, 0.95)","     c = (-12, -8, 208)"]},{"oldStart":291,"oldLines":7,"newStart":292,"newLines":7,"lines":[" "," def r_arm():","     \"\"\"高亮: 法兰座里照抄打印件的侧臂 + 后挡板(红), 以及 CNC 不好做的几处\"\"\"","-    seat, _ = T.part_seat()","+    seat, _ = T.part_seat_whole()","     cut = cq.Workplane(\"XY\").box(200, 200, 400).translate((-140, 0, 0))      # x < -40 的部分","     arm = seat.intersect(cut)","     rest = seat.cut(cut)"]},{"oldStart":313,"oldLines":6,"newStart":314,"newLines":36,"lines":["            lab, \"6_法兰座_照抄部分高亮\")"," "," ","+def r_back():","+    \"\"\"后挡板 改之前 / 改之后 对比(带气管走向)\"\"\"","+    old, _ = T.part_seat_whole()","+    cut = cq.Workplane(\"XY\").box(40, 200, 200).translate((-100 + 3, 0, -107))          # 整体版里的后挡板+加强筋(z<-7, 靠末端)","+    cut2 = cq.Workplane(\"XY\").box(200, 200, 200).translate((0, 0, -107))","+    old_back = old.intersect(cut2)","+    old_main = old.cut(cut2)","+    new, _ = T.part_seat()","+    back = T.part_back()","+    cam = T.camera_from_whole()","+    view = dict(pos=(-330, 250, -170), focal=(-62, 0, -22), up=(0, 0, 1), size=(1500, 1250), angle=25)","+    i1, a = scene([(old_main, \"alu\"), (old_back, \"hot\"), (cam, \"cam\"), (T.hose(True), \"hose\")],","+                  anchors=[(-100, 30, -60), (-100, -4, -18), (-104, 0, -60), (-100, 15, -49)], **view)","+    i2, b = scene([(new, \"alu\"), (back, \"hot\"), (cam, \"cam\"), (T.hose(False), \"hose\"), (T.fasteners(), \"steel\")],","+                  anchors=[(-100, 20, -52), (-100, -4, -27), (-89, -15, -14), (-100, 15, -49), (-100, 36, -3.5)], **view)","+    img = np.hstack([i1, i2])","+    off = lambda q: (q[0] + 1500, q[1])","+    lab = [(a[0], (0.33, 0.90), \"现在：80 宽、66 长，和法兰座连成一体\"),","+           (a[1], (0.08, 0.30), \"方窗：气管从这里穿过\"),","+           (a[2], (0.10, 0.80), \"气管（蓝色）\"),","+           (a[3], (0.40, 0.14), \"管线包的 2 个固定孔\"),","+           (off(b[0]), (0.84, 0.90), \"改后：50 宽、50 长，下面两个角改圆角\"),","+           (off(b[1]), (0.60, 0.28), \"方窗改成长圆孔并加长，气管可以斜着过\"),","+           (off(b[2]), (0.62, 0.62), \"2 颗 M4 拧在侧臂下面\"),","+           (off(b[3]), (0.90, 0.14), \"2 个固定孔：间距 30、位置都不变\"),","+           (off(b[4]), (0.87, 0.50), \"侧臂两边露出来的部分不再有挡板\")]","+    figure(img, \"后挡板：改之前（左） / 改之后（右）\", \"从背面斜下方看。红色是后挡板，蓝色是气管，深灰是相机。两个管线包固定孔的位置和间距没有动，只是把孔周围多余的板去掉了。\",","+           lab, \"8_后挡板_改前改后\")","+","+"," def main():","     r_final()","     r_explode()"]},{"oldStart":320,"oldLines":3,"newStart":351,"newLines":4,"lines":["     r_tube()","     r_cap()","     r_arm()","+    r_back()"]}]}],"moreFiles":1,"changedFiles":["D:\\robot_cell\\3D_model\\CNC末端\\渲染图\\8_后挡板_改前改后.png","D:\\robot_cell\\scripts\\cad\\cnc_tool_render.py"]}},"serverClassifierContext":{"request":"606e6eb2-2f16-4bb5-9fea-09af5baae6e5","context":{"git_state":{"cwd":"/d/robot_cell","root":