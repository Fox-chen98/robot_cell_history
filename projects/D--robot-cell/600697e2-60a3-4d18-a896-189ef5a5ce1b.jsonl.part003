d in P[\"BOLT_Z\"]])))","     return body.clean(), filleted"," "," "]},{"oldStart":140,"oldLines":7,"newStart":146,"newLines":7,"lines":["         nut = (cq.Workplane(\"YZ\").workplane(offset=-h - 4).center(P[\"BOLT_OFF\"], z)","                .polygon(6, 5.5 / math.cos(math.pi / 6)).extrude(4))","         tip = cq.Workplane(\"YZ\").workplane(offset=-h - 5).center(P[\"BOLT_OFF\"], z).circle(1.5).extrude(1.2)","-        items += [head, nut, tip]","+        items += [rz(head), rz(nut), rz(tip)]","     out = cq.Workplane(\"XY\")","     for it in items:","         out = out.add(it.val())"]},{"oldStart":149,"oldLines":8,"newStart":155,"newLines":8,"lines":[" "," def assembly_parts():","     seat, _ = part_seat()","-    tube = part_tube().translate((0, 0, Z_TUBE))","-    cap = part_cap().translate((0, 0, Z_CAP))","+    tube = rz(part_tube()).translate((0, 0, Z_TUBE))","+    cap = rz(part_cap()).translate((0, 0, Z_CAP))","     pad = cq.importers.importStep(FIT_PAD).rotate((0, 0, 0), (1, 0, 0), -90).translate((0, 0, LIP_Z))","     pc6 = cq.importers.importStep(FIT_PC6).rotate((0, 0, 0), (1, 0, 0), -90).translate((0, 0, LIP_Z - 34.0))","     return [(\"seat\", seat), (\"tube\", tube), (\"cap\", cap), (\"pad\", pad), (\"pc6\", pc6),"]}]},{"filePath":"D:\\robot_cell\\scripts\\cad\\cnc_tool_render.py","hunks":[{"oldStart":184,"oldLines":19,"newStart":184,"newLines":19,"lines":["     seat, _ = T.part_seat()","     H, BL = P[\"COL_H\"], P[\"BOSS_L\"]","     z0, z1 = P[\"SLOT_Z\"]","-    anchors = [(0, 0, H + BL), (10.45, P[\"BOLT_OFF\"], H + P[\"BOLT_Z\"][1]), (12.5, 0, H), (0, 12.5, (z0 + z1) / 2),","-               (12.5, -4, 16), (-17.68, 17.68, 0), (36, -6, 0), (-75, 22.5, 0), (-94, 26, -40), (13.6, 0, 1.0)]","-    img, a = scene([(seat, \"alu\")], pos=(210, 250, 235), focal=(-28, 0, 5), up=(0, 0, 1), anchors=anchors, angle=24)","-    lab = [(a[0], (0.26, 0.10), \"Ø9 气路\\n气管从这里通到进气长孔\"),","-           (a[1], (0.13, 0.30), \"2 个螺栓孔 Ø3.4\\nM3 横穿，锁住方管\"),","-           (a[2], (