n    left_lim/right_lim: 可用宽度范围(相对悬停中线, 右正, 已扣 margin); depth_mm: 可用深度(第0盒推进量+盒厚-架口); n_deep(D): 这种厚度一列能放几盒\"\"\"\n    T = led[\"taught\"]\n    Wbox, H, D = [float(v) for v in (box_mm or scfg[\"box_mm\"])]\n    gs, gd, m = float(scfg[\"gap_side_mm\"]), float(scfg[\"gap_deep_mm\"]), float(scfg[\"margin_mm\"])\n    bp = float(scfg.get(\"back_press_mm\", 0))\n    if \"back_hold_mm\" in T:      # 新口径: 持货盒背顶背板的推进量(吸盘吸瘪已含). 含示教盒厚 D_teach: 换盒厚 D 时第0盒 = back_hold + (D_teach - D) + bp\n        D_teach = float((T.get(\"hold_box_mm\") or [0, 0, D])[2])\n        back_work = T[\"back_hold_mm\"] + D_teach + bp                     # back_work = \"第0盒推进量 + 盒厚\"(与 D 无关)\n    else:                        # 旧口径: 空吸盘唇边碰背板 + 过盈(持货时吸盘被吸瘪 2~3mm, 偏松)\n        back_work = T[\"back_mm\"] + bp\n    face = T.get(\"face_mm\", 0.0) or 0.0\n63:  place_press_mm: 2          # 贴放补偿(2026-09-01实验: 吹开有小下落=停高了; 吸附态唇边压缩+标定轻触偏早; 观察调参: 仍下落加大, 压痕明显减小)\n74:  back_press_mm: 2           # 背板方向不回收, 反而多推这么多让盒背确实靠上背板(2026-09-15 真机首放: 按回收10算, 盒离背板10mm没靠上)","is_error":false}]},"uuid":"6c44b0b3-667e-471c-b7d8-d42df04fb8f7","timestamp":"2026-10-22T08:33:02.560Z","toolUseResult":{"stdout":"47:def pitch_for(box_mm, scfg):\n48-    \"\"\"这种盒在货架里每盒实际占的厚度(叠放节距): 尺寸表 pitch_mm(盘点 --learn 学到, 含盒间缝) 匹配不到则用盒厚 + gap_deep. 放置第 idx 盒的推进量与每列可放盒数都按它算(2026-09-17)\"\"\"\n49-    try:\n50-        skus = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"sku_dims.yaml\"), encoding=\"utf-8\")) or {}\n51-        W, H, D = [float(v) for v in (box_mm or scfg[\"box_mm\"])]\n52-        for v in skus.values():\n53-            if isinstance(v, dict) and v.get(\"pitch_mm\") and abs(float(v[\"dims_mm\"][0]) - W) < 1.5 and abs(float(v[\"dims_mm\"][2]) - D) < 1.5:\n54-                return float(v[\"pitch_mm\"]), \"已学\"\n55-    except Exception:\n56-        pass\n57-    D = float((box_mm or scfg[\"box_mm\"])[2]); return D + float(scfg[\"gap_deep_mm\"]), \"盒厚+缝\"\n58-\n59-\n60-def stand_geometry(led, scfg, box_mm=None):\n61-    \"\"\"格口物理量 + 这盒的尺寸