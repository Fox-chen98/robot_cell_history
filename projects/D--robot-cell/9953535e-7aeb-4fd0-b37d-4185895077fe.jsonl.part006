 type: str = Field(..., description=\"store/retrieve\")","     feed: str = Field(..., description=\"auto=上苗机送盒 manual=人放盒\")"]},{"oldStart":343,"oldLines":7,"newStart":357,"newLines":8,"lines":["     dest: Optional[str] = Field(None, description=\"retrieve: 去处名\")","     reason: Optional[str] = Field(None, description=\"下任务时给的业务原因(原样)\")","     state: str = Field(..., description=\"任务状态: queued=排队; running=进行中; awaiting_destination=等上位机答复去处; paused=已暂停; needs_human=需人工处理; finished=已结束(正常或被停止, 见 end_reason)\")","-    stage: str = Field(..., description=\"当前在做什么(中文), 供界面显示: 回位/识别/送料/等待人工放盒/吸取/扫码/等去处/去中转位/飞行/放置/丢回/复位/暂停/等人处理/结束\")","+    stage: str = Field(..., description=\"当前阶段(中文术语, 供界面显示; 措辞可能调整, 程序判断请用 stage_code): 待执行/任务启动/返回原点/视觉定位/自动上料/等待上料/等待人工摆正/真空拾取/追溯码识读/等待货位分配/移至中转位/路径搬运/货位上架/货位拣取/回流剔除/出库投放/异常复位/库存盘点/已暂停/待人工处置/任务结束\")","+    stage_code: str = Field(..., description=\"当前阶段代码(固定不变, 供程序判断): PENDING/STARTING/HOMING/LOCATING/FEEDING/WAIT_LOADING/WAIT_ADJUST/PICKING/SCANNING/WAIT_ALLOCATION/TO_TRANSIT/TRANSFERRING/PUTAWAY/RETRIEVING/REJECTING/DISPENSING/RECOVERING/STOCKTAKING/PAUSED/NEED_INTERVENTION/FINISHED\")","     progress: Progress = Field(..., description=\"进度计数\")","     current: Dict[str, Any] = Field(..., description=\"正在处理的这盒: box_seq第几盒, code追溯码, slot格口, pit坑位\")","     end_reason: Optional[str] = Field(None, description=\"结束原因: count_reached=做够数量; time_up=时间到; pits_exhausted=坑位用完; stopped=被停止; aborted=被立即停止; table_empty=桌上一直没盒; feeder_empty=传送带没盒; fault=动作失败; not_ready=设备未就绪; exception=程序异常\")"]},{"oldStart":527,"oldLines":7,"newStart":542,"newLines":7,"lines":[" "," class Task(object):","     def __init__(self, tid, req):","-        self.id = tid; self.req = req; self.state = \"queued\"; self.stage = \"排队\"; self.end_reason = None","+        self.id = tid; self.req = req; self.state = \"queued\"; self.stage_code = \"PENDING\"; self.end_reason = None","         self.created = time.time(); self.started = None; self.ended = None","         self.events = []; self.seq = 0; self.lock = threading.Lock()","         n_pits = len(req.pits) if req.pits else (len(req.items) if req.items else None)"]},{"oldStart":575,"oldLines":7,"newStart":590,"newLines":7,"lines":["         d = {\"task_id\": self.id, \"type\": self.req.type, \"feed\": self.req.feed, \"destination\": self.req.destination,","              \"slot\": self.req.slot, \"pits\": self.req.pits if self.req.type == \"store\" else [[it.x_mm, it.index, 0] for it in (self.req.items or [])], \"stop\": self.req.stop.model_dump(),","              \"dest\": self.req.dest if self.req.type in (\"retrieve\", \"outbound\") else None, \"reason\": self.req.reason,","-             \"state\": self.state, \"stage\": self.stage, \"progress\": self.progress, \"current\": self.current,","+             \"state\": self.state, \"stage\": self.stage, \"stage_code\": self.stage_code, \"progress\": self.progress, \"current\": self.current,","              \"end_reason\": self.end_reason, \"n_events\": self.seq, \"awaiting_seq\": self.awaiting_seq,","              \"created\": time.strftime(\"%H:%M:%S\", time.localtime(self.created)),","              \"elapsed_s\": round((self.ended or time.time()) - (self.started or self.created), 1)}"]},{"oldStart":629,"oldLines":11,"newStart":644,"newLines":11,"lines":["     # ── 一个任务 = 一次开硬件 + N 盒循环 ──","     def _run(self, t):","         import flows.store_one_box as F","-        t.state = \"running\"; t.started = time.time(); t.stage = \"开工\"","+        t.state = \"running\"; t.started = time.time(); t.stage_code = \"STARTING\"","         t.emit(\"task_start\", feed=t.req.feed, destination=t.req.destination, slot=t.req.slot, pits=t.req.pits, stop=t.req.stop.model_dump(),","                dest=t.req.dest if t.req.type in (\"retrieve\", \"outbound\") else None, reason=t.req.reason, items=len(t.req.items or []) if t.req.type in (\"retrieve\", \"outbound\") else None)","-        _stage_of = {\"去 home\": \"回位\", \"识别\": \"识别\", \"送料\": \"送料\", \"吸取\": \"