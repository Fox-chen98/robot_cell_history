tage_code = \"NEED_INTERVENTION\"; t.emit(\"needs_human\", box_seq=t.box_seq, text=s)\n820:            outcome = (\"needs_human\", \"exception\"); t.emit(\"fault\", box_seq=t.box_seq, code=\"EXCEPTION\", message=\"%s: %s\" % (type(e).__name__, str(e)[:120]))\n1035:@app.post(\"/device/reset\", response_model=CardResp, tags=[\"调试/恢复\"])\n1132:        if cmd != \"restart\": raise HTTPException(409, {\"error\": \"self\", \"detail\": \"工作站服务不能从接口停自己(它就是这个接口); 用命令行 services\\\\svc.bat stop cell\"})\n1133:        if TASKS.running is not None and TASKS.running.state not in (\"needs_human\", \"paused\", \"finished\", \"aborted\"):\n1134:            raise HTTPException(409, {\"error\": \"busy\", \"task_id\": TASKS.running.id})\n1240:    \"\"\"一次只跑一个任务(忙→409). 立刻返回task_id与预计用时, 过程靠 GET /tasks/{id}/events 轮询.\n1257:    \"\"\"任务快照: state=queued/running/awaiting_destination/paused/needs_human/finished; stage; progress; remaining/avg_box_s/eta_s/eta_at\"\"\"\n1263:    \"\"\"事件流: task_start/box_start/card/text/code_scanned/stored/discarded/waiting_box/fault/needs_human/paused/resumed/box_end/task_end\"\"\"\n1275:        raise HTTPException(409, {\"error\": \"not_awaiting\", \"awaiting_seq\": t.awaiting_seq, \"state\": t.state})\n1290:    if t.ended: raise HTTPException(409, {\"error\": \"already_ended\", \"state\": t.state})\n1299:    if t.ended: raise HTTPException(409, {\"error\": \"already_ended\", \"state\": t.state})\n1319:    if t.ended or t.state not in (\"running\", \"awaiting_destination\"): raise HTTPException(409, {\"error\": \"not_running\", \"state\": t.state})\n1326:    \"\"\"从 paused 或 needs_human 继续(下一盒从头开始; 需人的情况请先把臂收到home/mid)\"\"\"\n1328:    if t.ended: raise HTTPException(409, {\"error\": \"already_ended\", \"state\": t.state, \"detail\": \"任务已结束(立即停止/异常后即终态); 恢复现场后另下新任务\"})\n1329:    if t.state not in (\"paused\", \"needs_human\"): raise HTTPException(409, {\"error\": \"not_paused\", \"state\": t.state})","is_error":false}]},"uuid":"072ec4cb-e472-4b79-9dc3-fda7