(target_url(), cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"]), cfg.get(\"_file\")), flush=True)","     threading.Thread(target=_ping, name=\"webhook-ping\", daemon=True).start()","     return True"," "," ","+def _upper_port():","+    \"\"\"upper.port: 数字直接用; auto = 读 CRV runtime-state.json 的 apiPort(读不到退 8080)\"\"\"","+    up = _CFG.get(\"_upper\") or {}","+    p = up.get(\"port\", \"auto\")","+    if str(p).lower() != \"auto\":","+        return int(p)","+    try:","+        return int(json.load(open(up.get(\"crv_state_file\", \"\"), encoding=\"utf-8\"))[\"apiPort\"])","+    except Exception:","+        return 8080","+","+","+def target_url():","+    \"\"\"当前推送目标(每次投递前现算, port=auto 时跟随 CRV 端口变化)\"\"\"","+    if _CFG.get(\"url\"):","+        return _CFG[\"url\"]","+    up = _CFG.get(\"_upper\") or {}","+    return \"http://%s:%d%s\" % (up.get(\"host\", \"127.0.0.1\"), _upper_port(), _CFG.get(\"path\", \"\"))","+","+"," def post_event(task_id, ev):","     \"\"\"机械臂线程调这里。只入队, 不做任何网络动作, 不抛异常。\"\"\"","     try:"]},{"oldStart":104,"oldLines":7,"newStart":131,"newLines":10,"lines":[" def status():","     \"\"\"给 GET /device 用的一小段状态。\"\"\"","     s = dict(_ST)","-    s[\"url\"] = _CFG.get(\"url\", \"\")","+    try:","+        s[\"url\"] = target_url() if _CFG else \"\"","+    except Exception:","+        s[\"url\"] = _CFG.get(\"url\", \"\")","     # 待发条数要把\"正在发的那一条\"算进去, 否则重试期间 /device 显示 0 条, 看着像发完了其实没有","     s[\"queued\"] = (_Q.qsize() if _Q is not None else 0) + (1 if _ST.get(\"inflight\") else 0)","     return s"]},{"oldStart":113,"oldLines":11,"newStart":143,"newLines":12,"lines":[" def _deliver(item, event_id):","     \"\"\"发一条; 返回 (成功?, 状态码或错误文字)。只在送信线程里调。\"\"\"","     body = json.dumps(item, ensure_ascii=False).encode(\"utf-8\")","-    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")","+    req = urllib.request.Request(target_url(), data=body, method=\"POST\")","     req.add_header(\"Content-Type\", \"application/json; charset=utf-8\")","     req.add_header(\"X-Event-Id\", event_id)             # 幂等键, 重试时不变","     if _CFG.get(\"token\"):","-        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])","+        for h in (_CFG.get(\"token_headers\") or [\"X-Cell-Token\"]):","+            req.add_header(h, _CFG[\"token\"])","     try:","         with urllib.request.urlopen(req, timeout=float(_CFG[\"timeout_s\"])) as r:","             return (200 <= r.status < 300), str(r.status)"]},{"oldStart":172,"oldLines":5,"newStart":203,"newLines":5,"lines":["             _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")","         else:","             _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"","-            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info","+            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/upper_link.yaml 的 upper/webhook(当前目标 %s)\" % (info, target_url())","     print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)"]}]}],"moreFiles":0,"changedFiles":["/Users/chen/Desktop/robocenter/scripts/bluespace/services/cell_server.py","/Users/chen/Desktop/robocenter/scripts/bluespace/services/webhook.py"]}},"serverClassifierContext":{"request":"582e81ce-21b9-4fb2-9762-f36c4a4f5255","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":17},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"cb6a7b43-8d02-419b-b91e-964f1ebb4f97","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-