{"parentUuid":"c91d7b1d-dbd3-4548-bce5-7ba0c82f4770","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgGmsQzZP5E52c7pKRPWW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016niX3WyF1xTrRFMZD7yQMp","name":"Write","input":{"file_path":"/Users/chen/Desktop/robocenter/docs/盘点货架选择/picker_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>盘点选格口</title>\n<!--\n  盘点页: 整个货架正面白模, 选货架 → 点格口(可多选) → 开始盘点。\n  嵌入用法:  const p = ShelfPicker(容器div, 货架数据, { onChange(已选格口数组){}, highlight:\"药名\" })\n               p.setShelf(\"A\") / p.select([\"A-L10\",...]) / p.clear() / p.highlight(药名|null) / p.selected()\n  货架数据:   { id:\"A\", columns:{L:13,R:13}, slots:{ \"A-L10\":{ enabled, columns:[{x_mm, box_mm, group_key, count}], last:{t, result:\"match|mismatch|none\"} } } }\n              columns 与 POST /plan/store 的格口列表同格式; last.result: match 相符 / mismatch 待核对 / none 未盘\n  坐标: 左列 L 在左, 右列 R 在右; 层从下往上 1..13\n-->\n<link href=\"https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#eef2f7;--ink:#1d2939;--ink2:#5b6b80;--ink3:#97a3b4;--line:#d7dee8;--blue:#1f6fff;--red:#ff3b4a;--cyan:#14b8b0;\n  --num:\"Rajdhani\",\"DIN Alternate\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{background:linear-gradient(180deg,#f6f8fb 0%,#e9eef5 100%);background-color:var(--bg);color:var(--ink);\n  font:13px/1.5 \"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;overflow:hidden}\n.app{display:grid;grid-template-columns:1fr 340px;grid-template-rows:auto 1fr;height:100%}\nheader{grid-column:1/3;display:flex;align-items:center;gap:18px;padding:14px 22px 6px}\nheader h1{font-size:18px;font-weight:700}\nheader h1 small{font-size:12px;color:var(--ink3);font-weight:400;margin-left:8px}\n.tabs{display:flex;gap:4px;margin-left:10px;background:rgba(255,255,255,.6);border:1px solid var(--line);border-radius:8px;padding:3px}\n.tabs button{border:0;background:none;padding:5px 16px;border-radius:6px;font:inherit;font-weight:600;color:var(--ink2);cursor:pointer}\n.tabs button.on{background:#fff;color:var(--blue);box-shadow:0 1px 4px rgba(30,60,120,.12)}\n.tabs button:disabled{color:var(--ink3);cursor:not-allowed}\n.tabs button small{font-weight:400;font-size:11px;margin-left:4px}\n.legend{display:flex;gap:14px;margin-left:auto;font-size:12px;color:var(--ink2);flex-wrap:wrap}\n.legend i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-2px;border:1px solid var(--line)}\n.hlsel{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink2)}\n.hlsel select{padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:rgba(255,255,255,.85);font:inherit;color:var(--ink)}\n\n.view{position:relative;overflow:hidden}\n.view canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer}\n.lbl{position:absolute;transform:translate(-50%,-50%);pointer-events:none;font-family:var(--num);font-weight:700;color:var(--ink3);font-size:13px;white-space:nowrap}\n.lbl.col{font-size:15px;color:var(--ink2)}\n.badge{position:absolute;transform:translate(-50%,-50%);pointer-events:none;min-width:22px;height:22px;padding:0 6px;border-radius:11px;\n  background:var(--blue);color:#fff;font:700 12px/22px var(--num);text-align:center;box-shadow:0 2px 8px rgba(31,111,255,.45)}\n.warn{position:absolute;transform:translate(-50%,-50%);pointer-events:none;width:18px;height:18px;border-radius:50%;background:var(--red);color:#fff;\n  font:700 12px/18px var(--num);text-align:center;box-shadow:0 0 0 4px rgba(255,59,74,.18)}\n.tip{position:absolute;pointer-events:none;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border:1px solid var(--line);border-left:3px solid var(--blue);\n  border-radius:6px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(30,60,120,.14);display:none;min-width:190px;z-index:5}\n.tip b{font-size:13px}\n.tip .r{display:flex;justify-content:space-between;gap:12px;color:var(--ink2)}\n.tip .r span:last-child{color:var(--ink);font-weight:500}\n.tip.bad{border-left-color:var(--red)}\n.hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);font-size:12px;color:var(--ink3);pointer-events:none}\n\naside{padding:8px 22px 18px 6px;display:flex;flex-direction:column;gap:12px;min-height:0}\n.card{background:rgba(255,255,255,.62);backdrop-filter:blur(8px);border:1px solid rgba(215,222,232,.8);border-radius:10px;padding:12px 14px}\n.hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.hd h3{font-size:14px}\n.hd .ic{width:13px;height:13px;border:1.5px solid var(--blue);display:grid;place-items:center}\n.hd .ic::after{content:\"\";width:4px;height:4px;background:var(--blue)}\n.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}\n.kpis div small{display:block;font-size:11px;color:var(--ink3)}\n.kpis div b{font:700 26px/1.1 var(--num)}\n.kpis .b{color:var(--blue)}.kpis .r{color:var(--red)}\n.quick{display:flex;gap:6px;flex-wrap:wrap}\n.quick button,.go{border:1px solid var(--line);background:rgba(255,255,255,.85);border-radius:6px;padding:5px 10px;font:inherit;font-size:12px;color:var(--ink2);cursor:pointer}\n.quick button:hover{border-color:var(--blue);color:var(--blue)}\n.list{flex:1;min-height:0;overflow:auto}\n.list ol{list-style:none}\n.list li{display:flex;align-items:center;gap:8px;padding:6px 2px;border-bottom:1px dashed var(--line);font-size:12.5px}\n.list li .n{width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff;font:700 11px/20px var(--num);text-align:center;flex:none}\n.list li .s{font-weight:700;width:52px}\n.list li .m{flex:1;color:var(--ink2);font-size:11.5px}\n.list li.bad .s{color:var(--red)}\n.list li button{border:0;background:none;color:var(--ink3);cursor:pointer;font-size:14px;line-height:1}\n.list li button:hover{color:var(--red)}\n.empty{color:var(--ink3);font-size:12px;padding:16px 0;text-align:center}\n.go{width:100%;height:40px;background:var(--blue);border-color:var(--blue);color:#fff;font-size:14px;font-weight:700}\n.go:disabled{background:#b9c8e6;border-color:#b9c8e6;cursor:not-allowed}\n.eta{font-size:12px;color:var(--ink2);margin-bottom:8px}\n.eta b{font:700 15px var(--num);color:var(--ink)}\npre{font:11px/1.45 ui-monospace,Menlo,Consolas,monospace;background:rgba(240,244,250,.9);border:1px solid var(--line);border-radius:6px;padding:8px;max-height:150px;overflow:auto;display:none;margin-top:8px;white-space:pre-wrap}\n\n@media (max-width:900px){\n  body{overflow:auto}\n  .app{grid-template-columns:1fr;grid-template-rows:auto 70vh auto;height:auto}\n  header{grid-column:1;flex-wrap:wrap;padding:12px 16px 4px}\n  .legend{margin-left:0}\n  aside{padding:8px 16px 16px}\n}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <h1>盘点<small>选择货架与格口</small></h1>\n    <div class=\"tabs\" id=\"tabs\"></div>\n    <div class=\"hlsel\">高亮疫苗 <select id=\"hl\"></select></div>\n    <div class=\"legend\">\n      <span><i style=\"background:#f7f9fc\"></i>有货</span>\n      <span><i style=\"background:transparent;border-style:dashed\"></i>空</span>\n      <span><i style=\"background:#ffd5d9;border-color:#ff9aa4\"></i>待核对</span>\n      <span><i style=\"background:#e3e7ed\"></i>未启用</span>\n      <span><i style=\"background:#cfe0ff;border-color:#1f6fff\"></i>已选</span>\n    </div>\n  </header>\n\n  <main class=\"view\" id=\"view\">\n    <div class=\"tip\" id=\"tip\"></div>\n    <div class=\"hint\">点击格口选中 / 取消 · 拖动可小幅旋转</div>\n  </main>\n\n  <aside>\n    <section class=\"card\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3 id=\"shTitle\">货架 A</h3></div>\n      <div class=\"kpis\">\n        <div><small>启用格口</small><b id=\"kEn\">0</b></div>\n        <div><small>待核对</small><b class=\"r\" id=\"kBad\">0</b></div>\n        <div><small>已选</small><b class=\"b\" id=\"kSel\">0</b></div>\n      </div>\n    </section>\n    <section class=\"card\">\n      <div class=\"quick\">\n        <button id=\"qAll\">全选有货</button>\n        <button id=\"qBad\">只选待核对</button>\n        <button id=\"qOld\">未盘 / 超 7 天</button>\n        <button id=\"qClr\">清空</button>\n      </div>\n    </section>\n    <section class=\"card list\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3>盘点顺序</h3></div>\n      <ol id=\"list\"></ol>\n    </section>\n    <section class=\"card\">\n      <div class=\"eta\" id=\"eta\">未选格口</div>\n      <button class=\"go\" id=\"go\" disabled>开始盘点</button>\n      <pre id=\"out\"></pre>\n    </section>\n  </aside>\n</div>\n\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script>\n// ───────────────────────── 组件 ─────────────────────────\nfunction ShelfPicker(host, shelf, opt) {\n  opt = opt || {};\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n  renderer.setClearColor(0, 0); renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));\n  renderer.outputEncoding = THREE.sRGBEncoding;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.0;\n  host.prepend(renderer.domElement);\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(32, 1, 0.05, 40);\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true; controls.enablePan = false;\n  controls.minAzimuthAngle = -0.35; controls.maxAzimuthAngle = 0.35;\n  controls.minPolarAngle = 1.2; controls.maxPolarAngle = 1.62;\n  scene.add(new THREE.HemisphereLight(0xffffff, 0xc5cfdc, 0.9));\n  const sun = new THREE.DirectionalLight(0xffffff, 0.7); sun.position.set(-1.5, 3, 3); scene.add(sun);\n\n  // 材质(白模)\n  const M = {\n    white: new THREE.MeshStandardMaterial({ color: 0xf3f5f9, roughness: 0.85 }),\n    back: new THREE.MeshStandardMaterial({ color: 0xe6ebf2, roughness: 0.9 }),\n    box: new THREE.MeshStandardMaterial({ color: 0xf8fafd, roughness: 0.8 }),\n    hl: new THREE.MeshStandardMaterial({ color: 0x1f63ff, roughness: 0.45, emissive: 0x0b3fd0, emissiveIntensity: 0.35, toneMapped: false }),\n    off: new THREE.MeshStandardMaterial({ color: 0xdfe4eb, roughness: 0.95, transparent: true, opacity: 0.85 }),\n    edge: new THREE.LineBasicMaterial({ color: 0xa9b5c6, transparent: true, opacity: 0.7 }),\n    boxEdge: new THREE.LineBasicMaterial({ color: 0xb3bfce, transparent: true, opacity: 0.8 }),\n    hlEdge: new THREE.LineBasicMaterial({ color: 0xbfd6ff }),\n  };\n  const fillMat = () => new THREE.MeshBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0, depthWrite: false });\n  const lineMat = () => new THREE.LineBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0 });\n  const mm = v => v / 1000;\n\n  // 几何: 每列宽 0.62, 层高 0.13, 深 0.56; 原点 = 货架底面中心, Z 朝观众\n  const G = { cw: 0.62, post: 0.035, dy: 0.13, y0: 0.12, depth: 0.56, board: 0.012 };\n  const root = new THREE.Group(); scene.add(root);\n  const slotObjs = new Map();                    // 名称 → {hit, fill, line, center, data}\n  let hlName = opt.highlight || null, sel = [], hover = null;\n  const nameOf = k => String(k || \"\").split(\"|\")[0];\n  const isHL = k => !!hlName && nameOf(k).includes(hlName);\n\n  function add(g, mat, x, y, z, parent, edge) {\n    const m = new THREE.Mesh(g, mat); m.position.set(x, y, z); (parent || root).add(m);\n    if (edge !== false) m.add(new THREE.LineSegments(new THREE.EdgesGeometry(g), edge || M.edge));\n    return m;\n  }\n  const B = (w, h, d) => new THREE.BoxGeometry(w, h, d);\n\n  // 地面: 网格+光晕径向渐隐(融入页面底色)\n  (function () {\n    const S = 1024, c = document.createElement(\"canvas\"); c.width = c.height = S;\n    const g = c.getContext(\"2d\"), cx = S / 2;\n    g.strokeStyle = \"rgba(31,111,255,.14)\"; g.lineWidth = 1;\n    for (let p = 0; p <= S; p += S / 32) { g.beginPath(); g.moveTo(p, 0); g.lineTo(p, S); g.moveTo(0, p); g.lineTo(S, p); g.stroke(); }\n    g.save(); g.shadowColor = \"rgba(31,111,255,.8)\"; g.shadowBlur = 30; g.strokeStyle = \"rgba(77,155,255,.85)\"; g.lineWidth = 4;\n    const w = S * 0.36, d = S * 0.13; g.beginPath(); g.roundRect ? g.roundRect(cx - w / 2, cx - d / 2, w, d, 18) : g.rect(cx - w / 2, cx - d / 2, w, d); g.stroke(); g.restore();\n    g.globalCompositeOperation = \"destination-in\";\n    const rg = g.createRadialGradient(cx, cx, S * .1, cx, cx, S * .5); rg.addColorStop(0, \"#000\"); rg.addColorStop(.6, \"rgba(0,0,0,.5)\"); rg.addColorStop(1, \"rgba(0,0,0,0)\");\n    g.fillStyle = rg; g.fillRect(0, 0, S, S);\n    const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding;\n    const fl = new THREE.Mesh(new THREE.PlaneGeometry(4.2, 4.2), new THREE.MeshBasicMaterial({ map: t, transparent: true, depthWrite: false }));\n    fl.rotation.x = -Math.PI / 2; fl.position.set(0, 0.001, -G.depth / 2); scene.add(fl);\n  })();\n\n  // 盒子: 每列 = 一队盒(从背板往外), 白模; 高亮疫苗染蓝\n  function drawBoxes(group, cols, xc, y, cap) {\n    for (const c of cols || []) {\n      const [w, h, t] = c.box_mm, n = Math.min(c.count || 0, cap);\n      if (!n) continue;\n      const L = mm(t) * n, hl = isHL(c.group_key);\n      const m = add(B(mm(w) - 0.002, Math.min(mm(h), G.dy - G.board - 0.01), L - 0.002), hl ? M.hl : M.box,\n        xc + mm(c.x_mm), y + Math.min(mm(h), G.dy - G.board - 0.01) / 2, -G.depth + 0.01 + L / 2, group, hl ? M.hlEdge : M.boxEdge);\n      m.userData.gk = c.group_key;\n      const seams = [], hh = Math.min(mm(h), G.dy - G.board - 0.01) / 2;      // 盒缝(顶面)\n      for (let j = 1; j < n; j++) { const z = -L / 2 + j * mm(t); seams.push(-mm(w) / 2, hh + 0.0005, z, mm(w) / 2, hh + 0.0005, z); }\n      const sg = new THREE.BufferGeometry(); sg.setAttribute(\"position\", new THREE.Float32BufferAttribute(seams, 3));\n      m.add(new THREE.LineSegments(sg, hl ? M.hlEdge : M.boxEdge));\n    }\n  }\n\n  let labels = [];\n  function build() {\n    root.clear(); slotObjs.clear(); labels.forEach(l => l.el.remove()); labels = [];\n    const cols = Object.keys(shelf.columns);     // [\"L\",\"R\"]\n    const nMax = Math.max(...cols.map(k => shelf.columns[k]));\n    const W = cols.length * G.cw + (cols.length + 1) * G.post, H = G.y0 + nMax * G.dy + 0.04;\n    const xOf = i => -W / 2 + G.post + G.cw / 2 + i * (G.cw + G.post);\n    // 框架\n    for (let i = 0; i <= cols.length; i++) add(B(G.post, H, G.depth), M.white, -W / 2 + G.post / 2 + i * (G.cw + G.post), H / 2, -G.depth / 2);\n    add(B(W, H, 0.012), M.back, 0, H / 2, -G.depth - 0.006);\n    add(B(W + 0.03, 0.035, G.depth + 0.02), M.white, 0, H + 0.017, -G.depth / 2);\n    add(B(W + 0.03, G.y0 - 0.02, G.depth + 0.02), M.white, 0, (G.y0 - 0.02) / 2, -G.depth / 2);   // 底座\n    cols.forEach((col, ci) => {\n      const xc = xOf(ci), n = shelf.columns[col];\n      labels.push({ el: mkLabel(col === \"L\" ? \"左列 L\" : col === \"R\" ? \"右列 R\" : col, \"col\"), v: new THREE.Vector3(xc, H + 0.09, 0) });\n      for (let l = 1; l <= n; l++) {\n        const y = G.y0 + (l - 1) * G.dy;\n        add(B(G.cw, G.board, G.depth), M.white, xc, y - G.board / 2, -G.depth / 2);\n        if (ci === 0) labels.push({ el: mkLabel(String(l)), v: new THREE.Vector3(-W / 2 - 0.07, y + G.dy / 2, 0) });\n        const name = `${shelf.id}-${col}${l}`, d = shelf.slots[name] || { enabled: false };\n        const hg = B(G.cw - 0.012, G.dy - G.board - 0.006, G.depth - 0.01);\n        const cy = y + (G.dy - G.board) / 2 + 0.002, cz = -G.depth / 2 + 0.005;\n        if (!d.enabled) { add(B(G.cw - 0.01, G.dy - G.board - 0.01, 0.006), M.off, xc, cy, -0.004, root, false); }\n        else drawBoxes(root, d.columns, xc, y, 30);\n        const fill = new THREE.Mesh(hg, fillMat()); fill.position.set(xc, cy, cz); root.add(fill);\n        const line = new THREE.LineSegments(new THREE.EdgesGeometry(hg), lineMat()); fill.add(line);\n        fill.userData.slot = name;\n        slotObjs.set(name, { hit: fill, fill, line, center: new THREE.Vector3(xc, cy, 0.02), data: d, badge: null, warn: null });\n        if (d.enabled && d.last && d.last.result === \"mismatch\") {\n          const o = slotObjs.get(name); o.warn = mkLabel(\"!\", \"warn\"); labels.push({ el: o.warn, v: new THREE.Vector3(xc + G.cw / 2 - 0.035, y + G.dy - 0.03, 0.02) });\n        }\n      }\n    });\n    // 取景: 正面略俯视\n    const dist = Math.max(H * 1.75, W * 1.6);\n    controls.target.set(0, H * 0.5, -G.depth / 2);\n    camera.position.set(0, H * 0.62, dist);\n    controls.minDistance = dist * 0.6; controls.maxDistance = dist * 1.5;\n    paint();\n  }\n  function mkLabel(t, cls) {\n    const el = document.createElement(\"div\");\n    el.className = cls === \"warn\" ? \"warn\" : \"lbl\" + (cls ? \" \" + cls : \"\"); el.textContent = t; host.appendChild(el); return el;\n  }\n\n  // 状态着色: 悬停浅蓝 / 已选蓝 / 待核对红\n  function paint() {\n    const t = performance.now() / 1000;\n    for (const [name, o] of slotObjs) {\n      const si = sel.indexOf(name), d = o.data, bad = d.enabled && d.last && d.last.result === \"mismatch\";\n      let col = 0x1f6fff, fo = 0, lo = 0;\n      if (si >= 0) { fo = 0.16; lo = 1; }\n      else if (hover === name && d.enabled) { fo = 0.08; lo = 0.7; }\n      if (bad && si < 0) { col = 0xff3b4a; fo = Math.max(fo, 0.07 + 0.06 * (0.5 + 0.5 * Math.sin(t * 3))); lo = Math.max(lo, 0.6); }\n      o.fill.material.color.setHex(col); o.fill.material.opacity = fo;\n      o.line.material.color.setHex(col); o.line.material.opacity = lo;\n      if (si >= 0 && !o.badge) { o.badge = mkLabel(\"\", \"x\"); o.badge.className = \"badge\"; labels.push({ el: o.badge, v: o.center }); }\n      if (o.badge) { if (si < 0) { o.badge.remove(); labels = labels.filter(l => l.el !== o.badge); o.badge = null; } else o.badge.textContent = si + 1; }\n    }\n  }\n\n  // 交互\n  const ray = new THREE.Raycaster(), p = new THREE.Vector2(), tip = host.querySelector(\".tip\");\n  const hits = () => [...slotObjs.values()].map(o => o.hit);\n  function pick(e) {\n    const r = renderer.domElement.getBoundingClientRect();\n    p.set((e.clientX - r.left) / r.width * 2 - 1, -(e.clientY - r.top) / r.height * 2 + 1);\n    ray.setFromCamera(p, camera);\n    const h = ray.intersectObjects(hits(), false)[0]; return h ? h.object.userData.slot : null;\n  }\n  renderer.domElement.addEventListener(\"pointermove\", e => {\n    const s = pick(e); hover = s;\n    if (!s) { tip.style.display = \"none\"; return; }\n    const d = slotObjs.get(s).data, r = host.getBoundingClientRect();\n    tip.innerHTML = tipHtml(s, d); tip.className = \"tip\" + (d.last && d.last.result === \"mismatch\" ? \" bad\" : \"\");\n    tip.style.display = \"block\";\n    tip.style.left = Math.min(e.clientX - r.left + 16, r.width - 220) + \"px\"; tip.style.top = (e.clientY - r.top + 14) + \"px\";\n  });\n  renderer.domElement.addEventListener(\"pointerleave\", () => { hover = null; tip.style.display = \"none\"; });\n  let down = null;\n  renderer.domElement.addEventListener(\"pointerdown\", e => down = [e.clientX, e.clientY]);\n  renderer.domElement.addEventListener(\"pointerup\", e => {\n    if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 4) return;\n    const s = pick(e); if (!s || !slotObjs.get(s).data.enabled) return;\n    const i = sel.indexOf(s); i >= 0 ? sel.splice(i, 1) : sel.push(s); changed();\n  });\n  function tipHtml(s, d) {\n    if (!d.enabled) return `<b>${s}</b><div class=\"r\"><span>状态</span><span>未启用(未标定)</span></div>`;\n    const n = (d.columns || []).reduce((a, c) => a + (c.count || 0), 0);\n    const kinds = [...new Set((d.columns || []).map(c => nameOf(c.group_key)))];\n    const res = { match: \"相符\", mismatch: \"不符 · 待核对\", none: \"未盘点\" }[(d.last || {}).result || \"none\"];\n    const hlN = (d.columns || []).filter(c => isHL(c.group_key)).reduce((a, c) => a + c.count, 0);\n    return `<b>${s}</b>` +\n      `<div class=\"r\"><span>账上</span><span>${n} 盒 · ${(d.columns || []).length} 列</span></div>` +\n      (kinds.length ? `<div class=\"r\"><span>品种</span><span>${kinds.map(k => k.replace(/(疫苗|\\(.*?\\))/g, \"\")).join(\"、\")}</span></div>` : \"\") +\n      (hlName && hlN ? `<div class=\"r\"><span>${hlName.slice(0, 6)}…</span><span style=\"color:var(--blue)\">${hlN} 盒</span></div>` : \"\") +\n      `<div class=\"r\"><span>上次盘点</span><span>${(d.last && d.last.t) || \"—\"} ${res}</span></div>` +\n      `<div class=\"r\" style=\"margin-top:3px;color:var(--ink3)\"><span>点击${sel.includes(s) ? \"取消\" : \"加入盘点\"}</span><span></span></div>`;\n  }\n  function changed() { paint(); opt.onChange && opt.onChange(sel.slice()); }\n\n  // 尺寸/循环\n  const ro = new ResizeObserver(() => {\n    const w = host.clientWidth, h = host.clientHeight;\n    renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();\n  }); ro.observe(host);\n  const tmp = new THREE.Vector3();\n  renderer.setAnimationLoop(() => {\n    M.hl.emissiveIntensity = 0.28 + 0.2 * (0.5 + 0.5 * Math.sin(performance.now() / 420));\n    controls.update(); paint(); renderer.render(scene, camera);\n    const w = host.clientWidth, h = host.clientHeight;\n    for (const l of labels) { tmp.copy(l.v).project(camera); l.el.style.left = (tmp.x + 1) / 2 * w + \"px\"; l.el.style.top = (1 - tmp.y) / 2 * h + \"px\"; }\n  });\n  build();\n\n  return {\n    setShelf(s) { shelf = s; sel = []; build(); changed(); },\n    select(list) { sel = list.filter(n => slotObjs.get(n) && slotObjs.get(n).data.enabled); changed(); },\n    clear() { sel = []; changed(); },\n    selected: () => sel.slice(),\n    highlight(name) { hlName = name || null; const keep = sel.slice(); build(); sel = keep; changed(); },\n    slots: () => [...slotObjs.entries()].map(([n, o]) => ({ name: n, ...o.data })),\n  };\n}\nwindow.ShelfPicker = ShelfPicker;\n\n// ───────────────────────── 示例数据 ─────────────────────────\n// 现役格口按 2026-10 实际: 左右列第 8~12 层 + 第 2/6 层部分已标定; A-L10 为真实库存, 其余演示\nconst VAC = {\n  mmr: \"麻腮风联合减毒活疫苗|202504034\", ipv: \"Sabin株脊髓灰质炎灭活疫苗(Vero细胞)|C202407009\",\n  hav: \"甲型肝炎灭活疫苗(人二倍体细胞)|20241021\", hbv: \"重组乙型肝炎疫苗(酿酒酵母)|20250311\",\n};\nconst SZ = { mmr: [60, 38.5, 22.4], ipv: [133, 38, 25], hav: [63, 50, 23], hbv: [70, 35, 24] };\nlet seed = 11; const rnd = () => (seed = seed * 16807 % 2147483647) / 2147483647;\nfunction demoCols(kinds) {\n  const out = []; let x = -270;\n  for (const k of kinds) { const w = SZ[k][0]; if (x + w > 280) break; out.push({ x_mm: x + w / 2, box_mm: SZ[k], group_key: VAC[k], count: 3 + Math.floor(rnd() * 15) }); x += w + 10; }\n  return out;\n}\nfunction mkShelf(id, enabledSet, overrides) {\n  const slots = {};\n  for (const col of [\"L\", \"R\"]) for (let l = 1; l <= 13; l++) {\n    const n = `${id}-${col}${l}`, en = enabledSet.has(n);\n    const pool = [\"mmr\", \"ipv\", \"hav\", \"hbv\"], kinds = [];\n    for (let i = 0; i < 6; i++) kinds.push(pool[Math.floor(rnd() * pool.length)]);\n    slots[n] = en ? { enabled: true, columns: rnd() < 0.15 ? [] : demoCols(kinds),\n      last: { t: `10-${String(14 + Math.floor(rnd() * 8)).padStart(2, \"0\")}`, result: rnd() < 0.2 ? \"none\" : \"match\" } } : { enabled: false };\n  }\n  Object.assign(slots, overrides || {});\n  return { id, columns: { L: 13, R: 13 }, slots };\n}\nconst EN_A = new Set([\"A-L2\", \"A-L6\", \"A-R2\", \"A-R4\", \"A-R6\", ...[8, 9, 10, 11, 12].flatMap(l => [`A-L${l}`, `A-R${l}`])]);\nconst SHELVES = {\n  A: mkShelf(\"A\", EN_A, {\n    \"A-L10\": { enabled: true, last: { t: \"10-22 10:04\", result: \"match\" }, columns: [\n      { x_mm: -246.2, box_mm: SZ.mmr, group_key: VAC.mmr, count: 17 }, { x_mm: -141.7, box_mm: SZ.ipv, group_key: VAC.ipv, count: 6 },\n      { x_mm: -37.2, box_mm: SZ.mmr, group_key: \"麻腮风联合减毒活疫苗|202503015\", count: 11 }, { x_mm: 30.8, box_mm: SZ.mmr, group_key: VAC.mmr, count: 6 }] },\n    \"A-R10\": { enabled: true, last: { t: \"10-21 15:36\", result: \"mismatch\" }, columns: demoCols([\"ipv\", \"mmr\", \"hav\"]) },\n    \"A-L2\": { enabled: true, last: { t: \"10-21 15:33\", result: \"mismatch\" }, columns: demoCols([\"hav\", \"hav\", \"mmr\"]) },\n  }),\n  B: { id: \"B\", columns: { L: 13, R: 13 }, slots: {}, planned: true },\n};\n\n// ───────────────────────── 页面 ─────────────────────────\nconst $ = id => document.getElementById(id);\nconst PER_SLOT_S = 50;                                          // 单格口盘点约 50 s(飞过去+拍一帧+飞回)\nconst view = $(\"view\");\nconst picker = ShelfPicker(view, SHELVES.A, { highlight: \"\", onChange: refresh });\nlet cur = \"A\";\n\n$(\"tabs\").innerHTML = Object.values(SHELVES).map(s =>\n  `<button data-id=\"${s.id}\" ${s.planned ? \"disabled\" : \"\"} class=\"${s.id === cur ? \"on\" : \"\"}\">货架 ${s.id}${s.planned ? \"<small>未部署</small>\" : \"\"}</button>`).join(\"\");\n$(\"tabs\").onclick = e => {\n  const b = e.target.closest(\"button\"); if (!b || b.disabled) return;\n  cur = b.dataset.id; [...$(\"tabs\").children].forEach(x => x.classList.toggle(\"on\", x === b));\n  picker.setShelf(SHELVES[cur]); $(\"shTitle\").textContent = \"货架 \" + cur;\n};\nconst kinds = [...new Set(Object.values(SHELVES.A.slots).flatMap(s => (s.columns || []).map(c => c.group_key.split(\"|\")[0])))];\n$(\"hl\").innerHTML = `<option value=\"\">不高亮</option>` + kinds.map(k => `<option>${k}</option>`).join(\"\");\n$(\"hl\").onchange = () => picker.highlight($(\"hl\").value);\n\nfunction refresh(sel) {\n  sel = sel || picker.selected();\n  const all = picker.slots(), en = all.filter(s => s.enabled), bad = en.filter(s => s.last && s.last.result === \"mismatch\");\n  $(\"kEn\").textContent = en.length; $(\"kBad\").textContent = bad.length; $(\"kSel\").textContent = sel.length;\n  const by = Object.fromEntries(all.map(s => [s.name, s]));\n  $(\"list\").innerHTML = sel.length ? sel.map((n, i) => {\n    const s = by[n], c = (s.columns || []).reduce((a, x) => a + x.count, 0), b = s.last && s.last.result === \"mismatch\";\n    return `<li class=\"${b ? \"bad\" : \"\"}\"><span class=\"n\">${i + 1}</span><span class=\"s\">${n}</span><span class=\"m\">${c} 盒 · ${(s.columns || []).length} 列${b ? \" · 待核对\" : \"\"}</span><button data-n=\"${n}\" title=\"移除\">×</button></li>`;\n  }).join(\"\") : `<div class=\"empty\">在左侧货架上点击格口</div>`;\n  const t = sel.length * PER_SLOT_S;\n  $(\"eta\").innerHTML = sel.length ? `共 <b>${sel.length}</b> 个格口 · 预计 <b>${Math.floor(t / 60)}</b> 分 <b>${t % 60}</b> 秒` : \"未选格口\";\n  $(\"go\").disabled = !sel.length; $(\"out\").style.display = \"none\";\n}\n$(\"list\").onclick = e => { const b = e.target.closest(\"button\"); if (b) picker.select(picker.selected().filter(n => n !== b.dataset.n)); };\n$(\"qAll\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (s.columns || []).length).map(s => s.name));\n$(\"qBad\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && s.last && s.last.result === \"mismatch\").map(s => s.name));\n$(\"qOld\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (!s.last || s.last.result === \"none\" || s.last.t < \"10-15\")).map(s => s.name));\n$(\"qClr\").onclick = () => picker.clear();\n// 开始盘点: 设备一次只盘一个格口 → 按顺序逐个 POST /tasks(上一单 task_end 后再下一单); 这里只展示请求\n$(\"go\").onclick = () => {\n  const by = Object.fromEntries(picker.slots().map(s => [s.name, s]));\n  const reqs = picker.selected().map(n => ({ type: \"stocktake\", slot: n,\n    columns: (by[n].columns || []).map(c => ({ x_mm: c.x_mm, box_mm: c.box_mm, group_key: c.group_key, count: c.count })) }));\n  $(\"out\").textContent = `// 按顺序逐个下单(上一单 task_end 后再下一单)\\n` + reqs.map((r, i) => `// ${i + 1}. POST /tasks\\n` + JSON.stringify(r)).join(\"\\n\");\n  $(\"out\").style.display = \"block\";\n};\nrefresh([]);\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2007,"cache_read_input_tokens":326563,"output_tokens":13563,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2007,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":13563,"cache_read_input_tokens":326563,"cache_creation_input_tokens":2007,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2007},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_016niX3WyF1xTrRFMZD7yQMp":{"file_path":"/Users/chen/Desktop/robocenter/docs/盘点货架选择/picker_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>盘点选格口</title>\n<!--\n  盘点页: 整个货架正面白模, 选货架 → 点格口(可多选) → 开始盘点。\n  嵌入用法:  const p = ShelfPicker(容器div, 货架数据, { onChange(已选格口数组){}, highlight:\"药名\" })\n               p.setShelf(\"A\") / p.select([\"A-L10\",...]) / p.clear() / p.highlight(药名|null) / p.selected()\n  货架数据:   { id:\"A\", columns:{L:13,R:13}, slots:{ \"A-L10\":{ enabled, columns:[{x_mm, box_mm, group_key, count}], last:{t, result:\"match|mismatch|none\"} } } }\n              columns 与 POST /plan/store 的格口列表同格式; last.result: match 相符 / mismatch 待核对 / none 未盘\n  坐标: 左列 L 在左, 右列 R 在右; 层从下往上 1..13\n-->\n<link href=\"https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#eef2f7;--ink:#1d2939;--ink2:#5b6b80;--ink3:#97a3b4;--line:#d7dee8;--blue:#1f6fff;--red:#ff3b4a;--cyan:#14b8b0;\n  --num:\"Rajdhani\",\"DIN Alternate\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{background:linear-gradient(180deg,#f6f8fb 0%,#e9eef5 100%);background-color:var(--bg);color:var(--ink);\n  font:13px/1.5 \"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;overflow:hidden}\n.app{display:grid;grid-template-columns:1fr 340px;grid-template-rows:auto 1fr;height:100%}\nheader{grid-column:1/3;display:flex;align-items:center;gap:18px;padding:14px 22px 6px}\nheader h1{font-size:18px;font-weight:700}\nheader h1 small{font-size:12px;color:var(--ink3);font-weight:400;margin-left:8px}\n.tabs{display:flex;gap:4px;margin-left:10px;background:rgba(255,255,255,.6);border:1px solid var(--line);border-radius:8px;padding:3px}\n.tabs button{border:0;background:none;padding:5px 16px;border-radius:6px;font:inherit;font-weight:600;color:var(--ink2);cursor:pointer}\n.tabs button.on{background:#fff;color:var(--blue);box-shadow:0 1px 4px rgba(30,60,120,.12)}\n.tabs button:disabled{color:var(--ink3);cursor:not-allowed}\n.tabs button small{font-weight:400;font-size:11px;margin-left:4px}\n.legend{display:flex;gap:14px;margin-left:auto;font-size:12px;color:var(--ink2);flex-wrap:wrap}\n.legend i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-2px;border:1px solid var(--line)}\n.hlsel{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink2)}\n.hlsel select{padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:rgba(255,255,255,.85);font:inherit;color:var(--ink)}\n\n.view{position:relative;overflow:hidden}\n.view canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer}\n.lbl{position:absolute;transform:translate(-50%,-50%);pointer-events:none;font-family:var(--num);font-weight:700;color:var(--ink3);font-size:13px;white-space:nowrap}\n.lbl.col{font-size:15px;color:var(--ink2)}\n.badge{position:absolute;transform:translate(-50%,-50%);pointer-events:none;min-width:22px;height:22px;padding:0 6px;border-radius:11px;\n  background:var(--blue);color:#fff;font:700 12px/22px var(--num);text-align:center;box-shadow:0 2px 8px rgba(31,111,255,.45)}\n.warn{position:absolute;transform:translate(-50%,-50%);pointer-events:none;width:18px;height:18px;border-radius:50%;background:var(--red);color:#fff;\n  font:700 12px/18px var(--num);text-align:center;box-shadow:0 0 0 4px rgba(255,59,74,.18)}\n.tip{position:absolute;pointer-events:none;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border:1px solid var(--line);border-left:3px solid var(--blue);\n  border-radius:6px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(30,60,120,.14);display:none;min-width:190px;z-index:5}\n.tip b{font-size:13px}\n.tip .r{display:flex;justify-content:space-between;gap:12px;color:var(--ink2)}\n.tip .r span:last-child{color:var(--ink);font-weight:500}\n.tip.bad{border-left-color:var(--red)}\n.hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);font-size:12px;color:var(--ink3);pointer-events:none}\n\naside{padding:8px 22px 18px 6px;display:flex;flex-direction:column;gap:12px;min-height:0}\n.card{background:rgba(255,255,255,.62);backdrop-filter:blur(8px);border:1px solid rgba(215,222,232,.8);border-radius:10px;padding:12px 14px}\n.hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.hd h3{font-size:14px}\n.hd .ic{width:13px;height:13px;border:1.5px solid var(--blue);display:grid;place-items:center}\n.hd .ic::after{content:\"\";width:4px;height:4px;background:var(--blue)}\n.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}\n.kpis div small{display:block;font-size:11px;color:var(--ink3)}\n.kpis div b{font:700 26px/1.1 var(--num)}\n.kpis .b{color:var(--blue)}.kpis .r{color:var(--red)}\n.quick{display:flex;gap:6px;flex-wrap:wrap}\n.quick button,.go{border:1px solid var(--line);background:rgba(255,255,255,.85);border-radius:6px;padding:5px 10px;font:inherit;font-size:12px;color:var(--ink2);cursor:pointer}\n.quick button:hover{border-color:var(--blue);color:var(--blue)}\n.list{flex:1;min-height:0;overflow:auto}\n.list ol{list-style:none}\n.list li{display:flex;align-items:center;gap:8px;padding:6px 2px;border-bottom:1px dashed var(--line);font-size:12.5px}\n.list li .n{width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff;font:700 11px/20px var(--num);text-align:center;flex:none}\n.list li .s{font-weight:700;width:52px}\n.list li .m{flex:1;color:var(--ink2);font-size:11.5px}\n.list li.bad .s{color:var(--red)}\n.list li button{border:0;background:none;color:var(--ink3);cursor:pointer;font-size:14px;line-height:1}\n.list li button:hover{color:var(--red)}\n.empty{color:var(--ink3);font-size:12px;padding:16px 0;text-align:center}\n.go{width:100%;height:40px;background:var(--blue);border-color:var(--blue);color:#fff;font-size:14px;font-weight:700}\n.go:disabled{background:#b9c8e6;border-color:#b9c8e6;cursor:not-allowed}\n.eta{font-size:12px;color:var(--ink2);margin-bottom:8px}\n.eta b{font:700 15px var(--num);color:var(--ink)}\npre{font:11px/1.45 ui-monospace,Menlo,Consolas,monospace;background:rgba(240,244,250,.9);border:1px solid var(--line);border-radius:6px;padding:8px;max-height:150px;overflow:auto;display:none;margin-top:8px;white-space:pre-wrap}\n\n@media (max-width:900px){\n  body{overflow:auto}\n  .app{grid-template-columns:1fr;grid-template-rows:auto 70vh auto;height:auto}\n  header{grid-column:1;flex-wrap:wrap;padding:12px 16px 4px}\n  .legend{margin-left:0}\n  aside{padding:8px 16px 16px}\n}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <h1>盘点<small>选择货架与格口</small></h1>\n    <div class=\"tabs\" id=\"tabs\"></div>\n    <div class=\"hlsel\">高亮疫苗 <select id=\"hl\"></select></div>\n    <div class=\"legend\">\n      <span><i style=\"background:#f7f9fc\"></i>有货</span>\n      <span><i style=\"background:transparent;border-style:dashed\"></i>空</span>\n      <span><i style=\"background:#ffd5d9;border-color:#ff9aa4\"></i>待核对</span>\n      <span><i style=\"background:#e3e7ed\"></i>未启用</span>\n      <span><i style=\"background:#cfe0ff;border-color:#1f6fff\"></i>已选</span>\n    </div>\n  </header>\n\n  <main class=\"view\" id=\"view\">\n    <div class=\"tip\" id=\"tip\"></div>\n    <div class=\"hint\">点击格口选中 / 取消 · 拖动可小幅旋转</div>\n  </main>\n\n  <aside>\n    <section class=\"card\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3 id=\"shTitle\">货架 A</h3></div>\n      <div class=\"kpis\">\n        <div><small>启用格口</small><b id=\"kEn\">0</b></div>\n        <div><small>待核对</small><b class=\"r\" id=\"kBad\">0</b></div>\n        <div><small>已选</small><b class=\"b\" id=\"kSel\">0</b></div>\n      </div>\n    </section>\n    <section class=\"card\">\n      <div class=\"quick\">\n        <button id=\"qAll\">全选有货</button>\n        <button id=\"qBad\">只选待核对</button>\n        <button id=\"qOld\">未盘 / 超 7 天</button>\n        <button id=\"qClr\">清空</button>\n      </div>\n    </section>\n    <section class=\"card list\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3>盘点顺序</h3></div>\n      <ol id=\"list\"></ol>\n    </section>\n    <section class=\"card\">\n      <div class=\"eta\" id=\"eta\">未选格口</div>\n      <button class=\"go\" id=\"go\" disabled>开始盘点</button>\n      <pre id=\"out\"></pre>\n    </section>\n  </aside>\n</div>\n\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script>\n// ───────────────────────── 组件 ─────────────────────────\nfunction ShelfPicker(host, shelf, opt) {\n  opt = opt || {};\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n  renderer.setClearColor(0, 0); renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));\n  renderer.outputEncoding = THREE.sRGBEncoding;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.0;\n  host.prepend(renderer.domElement);\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(32, 1, 0.05, 40);\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true; controls.enablePan = false;\n  controls.minAzimuthAngle = -0.35; controls.maxAzimuthAngle = 0.35;\n  controls.minPolarAngle = 1.2; controls.maxPolarAngle = 1.62;\n  scene.add(new THREE.HemisphereLight(0xffffff, 0xc5cfdc, 0.9));\n  const sun = new THREE.DirectionalLight(0xffffff, 0.7); sun.position.set(-1.5, 3, 3); scene.add(sun);\n\n  // 材质(白模)\n  const M = {\n    white: new THREE.MeshStandardMaterial({ color: 0xf3f5f9, roughness: 0.85 }),\n    back: new THREE.MeshStandardMaterial({ color: 0xe6ebf2, roughness: 0.9 }),\n    box: new THREE.MeshStandardMaterial({ color: 0xf8fafd, roughness: 0.8 }),\n    hl: new THREE.MeshStandardMaterial({ color: 0x1f63ff, roughness: 0.45, emissive: 0x0b3fd0, emissiveIntensity: 0.35, toneMapped: false }),\n    off: new THREE.MeshStandardMaterial({ color: 0xdfe4eb, roughness: 0.95, transparent: true, opacity: 0.85 }),\n    edge: new THREE.LineBasicMaterial({ color: 0xa9b5c6, transparent: true, opacity: 0.7 }),\n    boxEdge: new THREE.LineBasicMaterial({ color: 0xb3bfce, transparent: true, opacity: 0.8 }),\n    hlEdge: new THREE.LineBasicMaterial({ color: 0xbfd6ff }),\n  };\n  const fillMat = () => new THREE.MeshBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0, depthWrite: false });\n  const lineMat = () => new THREE.LineBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0 });\n  const mm = v => v / 1000;\n\n  // 几何: 每列宽 0.62, 层高 0.13, 深 0.56; 原点 = 货架底面中心, Z 朝观众\n  const G = { cw: 0.62, post: 0.035, dy: 0.13, y0: 0.12, depth: 0.56, board: 0.012 };\n  const root = new THREE.Group(); scene.add(root);\n  const slotObjs = new Map();                    // 名称 → {hit, fill, line, center, data}\n  let hlName = opt.highlight || null, sel = [], hover = null;\n  const nameOf = k => String(k || \"\").split(\"|\")[0];\n  const isHL = k => !!hlName && nameOf(k).includes(hlName);\n\n  function add(g, mat, x, y, z, parent, edge) {\n    const m = new THREE.Mesh(g, mat); m.position.set(x, y, z); (parent || root).add(m);\n    if (edge !== false) m.add(new THREE.LineSegments(new THREE.EdgesGeometry(g), edge || M.edge));\n    return m;\n  }\n  const B = (w, h, d) => new THREE.BoxGeometry(w, h, d);\n\n  // 地面: 网格+光晕径向渐隐(融入页面底色)\n  (function () {\n    const S = 1024, c = document.createElement(\"canvas\"); c.width = c.height = S;\n    const g = c.getContext(\"2d\"), cx = S / 2;\n    g.strokeStyle = \"rgba(31,111,255,.14)\"; g.lineWidth = 1;\n    for (let p = 0; p <= S; p += S / 32) { g.beginPath(); g.moveTo(p, 0); g.lineTo(p, S); g.moveTo(0, p); g.lineTo(S, p); g.stroke(); }\n    g.save(); g.shadowColor = \"rgba(31,111,255,.8)\"; g.shadowBlur = 30; g.strokeStyle = \"rgba(77,155,255,.85)\"; g.lineWidth = 4;\n    const w = S * 0.36, d = S * 0.13; g.beginPath(); g.roundRect ? g.roundRect(cx - w / 2, cx - d / 2, w, d, 18) : g.rect(cx - w / 2, cx - d / 2, w, d); g.stroke(); g.restore();\n    g.globalCompositeOperation = \"destination-in\";\n    const rg = g.createRadialGradient(cx, cx, S * .1, cx, cx, S * .5); rg.addColorStop(0, \"#000\"); rg.addColorStop(.6, \"rgba(0,0,0,.5)\"); rg.addColorStop(1, \"rgba(0,0,0,0)\");\n    g.fillStyle = rg; g.fillRect(0, 0, S, S);\n    const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding;\n    const fl = new THREE.Mesh(new THREE.PlaneGeometry(4.2, 4.2), new THREE.MeshBasicMaterial({ map: t, transparent: true, depthWrite: false }));\n    fl.rotation.x = -Math.PI / 2; fl.position.set(0, 0.001, -G.depth / 2); scene.add(fl);\n  })();\n\n  // 盒子: 每列 = 一队盒(从背板往外), 白模; 高亮疫苗染蓝\n  function drawBoxes(group, cols, xc, y, cap) {\n    for (const c of cols || []) {\n      const [w, h, t] = c.box_mm, n = Math.min(c.count || 0, cap);\n      if (!n) continue;\n      const L = mm(t) * n, hl = isHL(c.group_key);\n      const m = add(B(mm(w) - 0.002, Math.min(mm(h), G.dy - G.board - 0.01), L - 0.002), hl ? M.hl : M.box,\n        xc + mm(c.x_mm), y + Math.min(mm(h), G.dy - G.board - 0.01) / 2, -G.depth + 0.01 + L / 2, group, hl ? M.hlEdge : M.boxEdge);\n      m.userData.gk = c.group_key;\n      const seams = [], hh = Math.min(mm(h), G.dy - G.board - 0.01) / 2;      // 盒缝(顶面)\n      for (let j = 1; j < n; j++) { const z = -L / 2 + j * mm(t); seams.push(-mm(w) / 2, hh + 0.0005, z, mm(w) / 2, hh + 0.0005, z); }\n      const sg = new THREE.BufferGeometry(); sg.setAttribute(\"position\", new THREE.Float32BufferAttribute(seams, 3));\n      m.add(new THREE.LineSegments(sg, hl ? M.hlEdge : M.boxEdge));\n    }\n  }\n\n  let labels = [];\n  function build() {\n    root.clear(); slotObjs.clear(); labels.forEach(l => l.el.remove()); labels = [];\n    const cols = Object.keys(shelf.columns);     // [\"L\",\"R\"]\n    const nMax = Math.max(...cols.map(k => shelf.columns[k]));\n    const W = cols.length * G.cw + (cols.length + 1) * G.post, H = G.y0 + nMax * G.dy + 0.04;\n    const xOf = i => -W / 2 + G.post + G.cw / 2 + i * (G.cw + G.post);\n    // 框架\n    for (let i = 0; i <= cols.length; i++) add(B(G.post, H, G.depth), M.white, -W / 2 + G.post / 2 + i * (G.cw + G.post), H / 2, -G.depth / 2);\n    add(B(W, H, 0.012), M.back, 0, H / 2, -G.depth - 0.006);\n    add(B(W + 0.03, 0.035, G.depth + 0.02), M.white, 0, H + 0.017, -G.depth / 2);\n    add(B(W + 0.03, G.y0 - 0.02, G.depth + 0.02), M.white, 0, (G.y0 - 0.02) / 2, -G.depth / 2);   // 底座\n    cols.forEach((col, ci) => {\n      const xc = xOf(ci), n = shelf.columns[col];\n      labels.push({ el: mkLabel(col === \"L\" ? \"左列 L\" : col === \"R\" ? \"右列 R\" : col, \"col\"), v: new THREE.Vector3(xc, H + 0.09, 0) });\n      for (let l = 1; l <= n; l++) {\n        const y = G.y0 + (l - 1) * G.dy;\n        add(B(G.cw, G.board, G.depth), M.white, xc, y - G.board / 2, -G.depth / 2);\n        if (ci === 0) labels.push({ el: mkLabel(String(l)), v: new THREE.Vector3(-W / 2 - 0.07, y + G.dy / 2, 0) });\n        const name = `${shelf.id}-${col}${l}`, d = shelf.slots[name] || { enabled: false };\n        const hg = B(G.cw - 0.012, G.dy - G.board - 0.006, G.depth - 0.01);\n        const cy = y + (G.dy - G.board) / 2 + 0.002, cz = -G.depth / 2 + 0.005;\n        if (!d.enabled) { add(B(G.cw - 0.01, G.dy - G.board - 0.01, 0.006), M.off, xc, cy, -0.004, root, false); }\n        else drawBoxes(root, d.columns, xc, y, 30);\n        const fill = new THREE.Mesh(hg, fillMat()); fill.position.set(xc, cy, cz); root.add(fill);\n        const line = new THREE.LineSegments(new THREE.EdgesGeometry(hg), lineMat()); fill.add(line);\n        fill.userData.slot = name;\n        slotObjs.set(name, { hit: fill, fill, line, center: new THREE.Vector3(xc, cy, 0.02), data: d, badge: null, warn: null });\n        if (d.enabled && d.last && d.last.result === \"mismatch\") {\n          const o = slotObjs.get(name); o.warn = mkLabel(\"!\", \"warn\"); labels.push({ el: o.warn, v: new THREE.Vector3(xc + G.cw / 2 - 0.035, y + G.dy - 0.03, 0.02) });\n        }\n      }\n    });\n    // 取景: 正面略俯视\n    const dist = Math.max(H * 1.75, W * 1.6);\n    controls.target.set(0, H * 0.5, -G.depth / 2);\n    camera.position.set(0, H * 0.62, dist);\n    controls.minDistance = dist * 0.6; controls.maxDistance = dist * 1.5;\n    paint();\n  }\n  function mkLabel(t, cls) {\n    const el = document.createElement(\"div\");\n    el.className = cls === \"warn\" ? \"warn\" : \"lbl\" + (cls ? \" \" + cls : \"\"); el.textContent = t; host.appendChild(el); return el;\n  }\n\n  // 状态着色: 悬停浅蓝 / 已选蓝 / 待核对红\n  function paint() {\n    const t = performance.now() / 1000;\n    for (const [name, o] of slotObjs) {\n      const si = sel.indexOf(name), d = o.data, bad = d.enabled && d.last && d.last.result === \"mismatch\";\n      let col = 0x1f6fff, fo = 0, lo = 0;\n      if (si >= 0) { fo = 0.16; lo = 1; }\n      else if (hover === name && d.enabled) { fo = 0.08; lo = 0.7; }\n      if (bad && si < 0) { col = 0xff3b4a; fo = Math.max(fo, 0.07 + 0.06 * (0.5 + 0.5 * Math.sin(t * 3))); lo = Math.max(lo, 0.6); }\n      o.fill.material.color.setHex(col); o.fill.material.opacity = fo;\n      o.line.material.color.setHex(col); o.line.material.opacity = lo;\n      if (si >= 0 && !o.badge) { o.badge = mkLabel(\"\", \"x\"); o.badge.className = \"badge\"; labels.push({ el: o.badge, v: o.center }); }\n      if (o.badge) { if (si < 0) { o.badge.remove(); labels = labels.filter(l => l.el !== o.badge); o.badge = null; } else o.badge.textContent = si + 1; }\n    }\n  }\n\n  // 交互\n  const ray = new THREE.Raycaster(), p = new THREE.Vector2(), tip = host.querySelector(\".tip\");\n  const hits = () => [...slotObjs.values()].map(o => o.hit);\n  function pick(e) {\n    const r = renderer.domElement.getBoundingClientRect();\n    p.set((e.clientX - r.left) / r.width * 2 - 1, -(e.clientY - r.top) / r.height * 2 + 1);\n    ray.setFromCamera(p, camera);\n    const h = ray.intersectObjects(hits(), false)[0]; return h ? h.object.userData.slot : null;\n  }\n  renderer.domElement.addEventListener(\"pointermove\", e => {\n    const s = pick(e); hover = s;\n    if (!s) { tip.style.display = \"none\"; return; }\n    const d = slotObjs.get(s).data, r = host.getBoundingClientRect();\n    tip.innerHTML = tipHtml(s, d); tip.className = \"tip\" + (d.last && d.last.result === \"mismatch\" ? \" bad\" : \"\");\n    tip.style.display = \"block\";\n    tip.style.left = Math.min(e.clientX - r.left + 16, r.width - 220) + \"px\"; tip.style.top = (e.clientY - r.top + 14) + \"px\";\n  });\n  renderer.domElement.addEventListener(\"pointerleave\", () => { hover = null; tip.style.display = \"none\"; });\n  let down = null;\n  renderer.domElement.addEventListener(\"pointerdown\", e => down = [e.clientX, e.clientY]);\n  renderer.domElement.addEventListener(\"pointerup\", e => {\n    if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 4) return;\n    const s = pick(e); if (!s || !slotObjs.get(s).data.enabled) return;\n    const i = sel.indexOf(s); i >= 0 ? sel.splice(i, 1) : sel.push(s); changed();\n  });\n  function tipHtml(s, d) {\n    if (!d.enabled) return `<b>${s}</b><div class=\"r\"><span>状态</span><span>未启用(未标定)</span></div>`;\n    const n = (d.columns || []).reduce((a, c) => a + (c.count || 0), 0);\n    const kinds = [...new Set((d.columns || []).map(c => nameOf(c.group_key)))];\n    const res = { match: \"相符\", mismatch: \"不符 · 待核对\", none: \"未盘点\" }[(d.last || {}).result || \"none\"];\n    const hlN = (d.columns || []).filter(c => isHL(c.group_key)).reduce((a, c) => a + c.count, 0);\n    return `<b>${s}</b>` +\n      `<div class=\"r\"><span>账上</span><span>${n} 盒 · ${(d.columns || []).length} 列</span></div>` +\n      (kinds.length ? `<div class=\"r\"><span>品种</span><span>${kinds.map(k => k.replace(/(疫苗|\\(.*?\\))/g, \"\")).join(\"、\")}</span></div>` : \"\") +\n      (hlName && hlN ? `<div class=\"r\"><span>${hlName.slice(0, 6)}…</span><span style=\"color:var(--blue)\">${hlN} 盒</span></div>` : \"\") +\n      `<div class=\"r\"><span>上次盘点</span><span>${(d.last && d.last.t) || \"—\"} ${res}</span></div>` +\n      `<div class=\"r\" style=\"margin-top:3px;color:var(--ink3)\"><span>点击${sel.includes(s) ? \"取消\" : \"加入盘点\"}</span><span></span></div>`;\n  }\n  function changed() { paint(); opt.onChange && opt.onChange(sel.slice()); }\n\n  // 尺寸/循环\n  const ro = new ResizeObserver(() => {\n    const w = host.clientWidth, h = host.clientHeight;\n    renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();\n  }); ro.observe(host);\n  const tmp = new THREE.Vector3();\n  renderer.setAnimationLoop(() => {\n    M.hl.emissiveIntensity = 0.28 + 0.2 * (0.5 + 0.5 * Math.sin(performance.now() / 420));\n    controls.update(); paint(); renderer.render(scene, camera);\n    const w = host.clientWidth, h = host.clientHeight;\n    for (const l of labels) { tmp.copy(l.v).project(camera); l.el.style.left = (tmp.x + 1) / 2 * w + \"px\"; l.el.style.top = (1 - tmp.y) / 2 * h + \"px\"; }\n  });\n  build();\n\n  return {\n    setShelf(s) { shelf = s; sel = []; build(); changed(); },\n    select(list) { sel = list.filter(n => slotObjs.get(n) && slotObjs.get(n).data.enabled); changed(); },\n    clear() { sel = []; changed(); },\n    selected: () => sel.slice(),\n    highlight(name) { hlName = name || null; const keep = sel.slice(); build(); sel = keep; changed(); },\n    slots: () => [...slotObjs.entries()].map(([n, o]) => ({ name: n, ...o.data })),\n  };\n}\nwindow.ShelfPicker = ShelfPicker;\n\n// ───────────────────────── 示例数据 ─────────────────────────\n// 现役格口按 2026-10 实际: 左右列第 8~12 层 + 第 2/6 层部分已标定; A-L10 为真实库存, 其余演示\nconst VAC = {\n  mmr: \"麻腮风联合减毒活疫苗|202504034\", ipv: \"Sabin株脊髓灰质炎灭活疫苗(Vero细胞)|C202407009\",\n  hav: \"甲型肝炎灭活疫苗(人二倍体细胞)|20241021\", hbv: \"重组乙型肝炎疫苗(酿酒酵母)|20250311\",\n};\nconst SZ = { mmr: [60, 38.5, 22.4], ipv: [133, 38, 25], hav: [63, 50, 23], hbv: [70, 35, 24] };\nlet seed = 11; const rnd = () => (seed = seed * 16807 % 2147483647) / 2147483647;\nfunction demoCols(kinds) {\n  const out = []; let x = -270;\n  for (const k of kinds) { const w = SZ[k][0]; if (x + w > 280) break; out.push({ x_mm: x + w / 2, box_mm: SZ[k], group_key: VAC[k], count: 3 + Math.floor(rnd() * 15) }); x += w + 10; }\n  return out;\n}\nfunction mkShelf(id, enabledSet, overrides) {\n  const slots = {};\n  for (const col of [\"L\", \"R\"]) for (let l = 1; l <= 13; l++) {\n    const n = `${id}-${col}${l}`, en = enabledSet.has(n);\n    const pool = [\"mmr\", \"ipv\", \"hav\", \"hbv\"], kinds = [];\n    for (let i = 0; i < 6; i++) kinds.push(pool[Math.floor(rnd() * pool.length)]);\n    slots[n] = en ? { enabled: true, columns: rnd() < 0.15 ? [] : demoCols(kinds),\n      last: { t: `10-${String(14 + Math.floor(rnd() * 8)).padStart(2, \"0\")}`, result: rnd() < 0.2 ? \"none\" : \"match\" } } : { enabled: false };\n  }\n  Object.assign(slots, overrides || {});\n  return { id, columns: { L: 13, R: 13 }, slots };\n}\nconst EN_A = new Set([\"A-L2\", \"A-L6\", \"A-R2\", \"A-R4\", \"A-R6\", ...[8, 9, 10, 11, 12].flatMap(l => [`A-L${l}`, `A-R${l}`])]);\nconst SHELVES = {\n  A: mkShelf(\"A\", EN_A, {\n    \"A-L10\": { enabled: true, last: { t: \"10-22 10:04\", result: \"match\" }, columns: [\n      { x_mm: -246.2, box_mm: SZ.mmr, group_key: VAC.mmr, count: 17 }, { x_mm: -141.7, box_mm: SZ.ipv, group_key: VAC.ipv, count: 6 },\n      { x_mm: -37.2, box_mm: SZ.mmr, group_key: \"麻腮风联合减毒活疫苗|202503015\", count: 11 }, { x_mm: 30.8, box_mm: SZ.mmr, group_key: VAC.mmr, count: 6 }] },\n    \"A-R10\": { enabled: true, last: { t: \"10-21 15:36\", result: \"mismatch\" }, columns: demoCols([\"ipv\", \"mmr\", \"hav\"]) },\n    \"A-L2\": { enabled: true, last: { t: \"10-21 15:33\", result: \"mismatch\" }, columns: demoCols([\"hav\", \"hav\", \"mmr\"]) },\n  }),\n  B: { id: \"B\", columns: { L: 13, R: 13 }, slots: {}, planned: true },\n};\n\n// ───────────────────────── 页面 ─────────────────────────\nconst $ = id => document.getElementById(id);\nconst PER_SLOT_S = 50;                                          // 单格口盘点约 50 s(飞过去+拍一帧+飞回)\nconst view = $(\"view\");\nconst picker = ShelfPicker(view, SHELVES.A, { highlight: \"\", onChange: refresh });\nlet cur = \"A\";\n\n$(\"tabs\").innerHTML = Object.values(SHELVES).map(s =>\n  `<button data-id=\"${s.id}\" ${s.planned ? \"disabled\" : \"\"} class=\"${s.id === cur ? \"on\" : \"\"}\">货架 ${s.id}${s.planned ? \"<small>未部署</small>\" : \"\"}</button>`).join(\"\");\n$(\"tabs\").onclick = e => {\n  const b = e.target.closest(\"button\"); if (!b || b.disabled) return;\n  cur = b.dataset.id; [...$(\"tabs\").children].forEach(x => x.classList.toggle(\"on\", x === b));\n  picker.setShelf(SHELVES[cur]); $(\"shTitle\").textContent = \"货架 \" + cur;\n};\nconst kinds = [...new Set(Object.values(SHELVES.A.slots).flatMap(s => (s.columns || []).map(c => c.group_key.split(\"|\")[0])))];\n$(\"hl\").innerHTML = `<option value=\"\">不高亮</option>` + kinds.map(k => `<option>${k}</option>`).join(\"\");\n$(\"hl\").onchange = () => picker.highlight($(\"hl\").value);\n\nfunction refresh(sel) {\n  sel = sel || picker.selected();\n  const all = picker.slots(), en = all.filter(s => s.enabled), bad = en.filter(s => s.last && s.last.result === \"mismatch\");\n  $(\"kEn\").textContent = en.length; $(\"kBad\").textContent = bad.length; $(\"kSel\").textContent = sel.length;\n  const by = Object.fromEntries(all.map(s => [s.name, s]));\n  $(\"list\").innerHTML = sel.length ? sel.map((n, i) => {\n    const s = by[n], c = (s.columns || []).reduce((a, x) => a + x.count, 0), b = s.last && s.last.result === \"mismatch\";\n    return `<li class=\"${b ? \"bad\" : \"\"}\"><span class=\"n\">${i + 1}</span><span class=\"s\">${n}</span><span class=\"m\">${c} 盒 · ${(s.columns || []).length} 列${b ? \" · 待核对\" : \"\"}</span><button data-n=\"${n}\" title=\"移除\">×</button></li>`;\n  }).join(\"\") : `<div class=\"empty\">在左侧货架上点击格口</div>`;\n  const t = sel.length * PER_SLOT_S;\n  $(\"eta\").innerHTML = sel.length ? `共 <b>${sel.length}</b> 个格口 · 预计 <b>${Math.floor(t / 60)}</b> 分 <b>${t % 60}</b> 秒` : \"未选格口\";\n  $(\"go\").disabled = !sel.length; $(\"out\").style.display = \"none\";\n}\n$(\"list\").onclick = e => { const b = e.target.closest(\"button\"); if (b) picker.select(picker.selected().filter(n => n !== b.dataset.n)); };\n$(\"qAll\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (s.columns || []).length).map(s => s.name));\n$(\"qBad\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && s.last && s.last.result === \"mismatch\").map(s => s.name));\n$(\"qOld\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (!s.last || s.last.result === \"none\" || s.last.t < \"10-15\")).map(s => s.name));\n$(\"qClr\").onclick = () => picker.clear();\n// 开始盘点: 设备一次只盘一个格口 → 按顺序逐个 POST /tasks(上一单 task_end 后再下一单); 这里只展示请求\n$(\"go\").onclick = () => {\n  const by = Object.fromEntries(picker.slots().map(s => [s.name, s]));\n  const reqs = picker.selected().map(n => ({ type: \"stocktake\", slot: n,\n    columns: (by[n].columns || []).map(c => ({ x_mm: c.x_mm, box_mm: c.box_mm, group_key: c.group_key, count: c.count })) }));\n  $(\"out\").textContent = `// 按顺序逐个下单(上一单 task_end 后再下一单)\\n` + reqs.map((r, i) => `// ${i + 1}. POST /tasks\\n` + JSON.stringify(r)).join(\"\\n\");\n  $(\"out\").style.display = \"block\";\n};\nrefresh([]);\n</script>\n</body>\n</html>\n"}},"serverClassifierRequest":"205abf4f-d7c7-4836-975c-9ec2c5502309","apiBlockIndex":0,"requestId":"req_011CgGmsQYXPYaTwhoX4ne1C","requestRef":"44267deb-cd42-494c-8ae2-68a88c0ad29b","requestedModel":"claude-opus-5-5[1m]","type":"assistant","uuid":"c4266f4a-b473-46b1-a87c-9bb24039035d","timestamp":"2026-10-22T06:08:53.117Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"c4266f4a-b473-46b1-a87c-9bb24039035d","isSidechain":false,"promptId":"49e7c855-63f5-473f-8d5a-46ed8b9a7609","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016niX3WyF1xTrRFMZD7yQMp","type":"tool_result","content":"File created successfully at: /Users/chen/Desktop/robocenter/docs/盘点货架选择/picker_src.html (file state is current in your context — no need to Read it back)"}]},"uuid":"205e74c9-cef0-4205-a5ec-448a6cd1d500","timestamp":"2026-10-22T06:08:53.216Z","toolUseResult":{"type":"create","filePath":"/Users/chen/Desktop/robocenter/docs/盘点货架选择/picker_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>盘点选格口</title>\n<!--\n  盘点页: 整个货架正面白模, 选货架 → 点格口(可多选) → 开始盘点。\n  嵌入用法:  const p = ShelfPicker(容器div, 货架数据, { onChange(已选格口数组){}, highlight:\"药名\" })\n               p.setShelf(\"A\") / p.select([\"A-L10\",...]) / p.clear() / p.highlight(药名|null) / p.selected()\n  货架数据:   { id:\"A\", columns:{L:13,R:13}, slots:{ \"A-L10\":{ enabled, columns:[{x_mm, box_mm, group_key, count}], last:{t, result:\"match|mismatch|none\"} } } }\n              columns 与 POST /plan/store 的格口列表同格式; last.result: match 相符 / mismatch 待核对 / none 未盘\n  坐标: 左列 L 在左, 右列 R 在右; 层从下往上 1..13\n-->\n<link href=\"https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#eef2f7;--ink:#1d2939;--ink2:#5b6b80;--ink3:#97a3b4;--line:#d7dee8;--blue:#1f6fff;--red:#ff3b4a;--cyan:#14b8b0;\n  --num:\"Rajdhani\",\"DIN Alternate\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{background:linear-gradient(180deg,#f6f8fb 0%,#e9eef5 100%);background-color:var(--bg);color:var(--ink);\n  font:13px/1.5 \"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;overflow:hidden}\n.app{display:grid;grid-template-columns:1fr 340px;grid-template-rows:auto 1fr;height:100%}\nheader{grid-column:1/3;display:flex;align-items:center;gap:18px;padding:14px 22px 6px}\nheader h1{font-size:18px;font-weight:700}\nheader h1 small{font-size:12px;color:var(--ink3);font-weight:400;margin-left:8px}\n.tabs{display:flex;gap:4px;margin-left:10px;background:rgba(255,255,255,.6);border:1px solid var(--line);border-radius:8px;padding:3px}\n.tabs button{border:0;background:none;padding:5px 16px;border-radius:6px;font:inherit;font-weight:600;color:var(--ink2);cursor:pointer}\n.tabs button.on{background:#fff;color:var(--blue);box-shadow:0 1px 4px rgba(30,60,120,.12)}\n.tabs button:disabled{color:var(--ink3);cursor:not-allowed}\n.tabs button small{font-weight:400;font-size:11px;margin-left:4px}\n.legend{display:flex;gap:14px;margin-left:auto;font-size:12px;color:var(--ink2);flex-wrap:wrap}\n.legend i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-2px;border:1px solid var(--line)}\n.hlsel{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink2)}\n.hlsel select{padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:rgba(255,255,255,.85);font:inherit;color:var(--ink)}\n\n.view{position:relative;overflow:hidden}\n.view canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer}\n.lbl{position:absolute;transform:translate(-50%,-50%);pointer-events:none;font-family:var(--num);font-weight:700;color:var(--ink3);font-size:13px;white-space:nowrap}\n.lbl.col{font-size:15px;color:var(--ink2)}\n.badge{position:absolute;transform:translate(-50%,-50%);pointer-events:none;min-width:22px;height:22px;padding:0 6px;border-radius:11px;\n  background:var(--blue);color:#fff;font:700 12px/22px var(--num);text-align:center;box-shadow:0 2px 8px rgba(31,111,255,.45)}\n.warn{position:absolute;transform:translate(-50%,-50%);pointer-events:none;width:18px;height:18px;border-radius:50%;background:var(--red);color:#fff;\n  font:700 12px/18px var(--num);text-align:center;box-shadow:0 0 0 4px rgba(255,59,74,.18)}\n.tip{position:absolute;pointer-events:none;background:rgba(255,255,255,.95);backdrop-filter:blur(6px);border:1px solid var(--line);border-left:3px solid var(--blue);\n  border-radius:6px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(30,60,120,.14);display:none;min-width:190px;z-index:5}\n.tip b{font-size:13px}\n.tip .r{display:flex;justify-content:space-between;gap:12px;color:var(--ink2)}\n.tip .r span:last-child{color:var(--ink);font-weight:500}\n.tip.bad{border-left-color:var(--red)}\n.hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);font-size:12px;color:var(--ink3);pointer-events:none}\n\naside{padding:8px 22px 18px 6px;display:flex;flex-direction:column;gap:12px;min-height:0}\n.card{background:rgba(255,255,255,.62);backdrop-filter:blur(8px);border:1px solid rgba(215,222,232,.8);border-radius:10px;padding:12px 14px}\n.hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.hd h3{font-size:14px}\n.hd .ic{width:13px;height:13px;border:1.5px solid var(--blue);display:grid;place-items:center}\n.hd .ic::after{content:\"\";width:4px;height:4px;background:var(--blue)}\n.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}\n.kpis div small{display:block;font-size:11px;color:var(--ink3)}\n.kpis div b{font:700 26px/1.1 var(--num)}\n.kpis .b{color:var(--blue)}.kpis .r{color:var(--red)}\n.quick{display:flex;gap:6px;flex-wrap:wrap}\n.quick button,.go{border:1px solid var(--line);background:rgba(255,255,255,.85);border-radius:6px;padding:5px 10px;font:inherit;font-size:12px;color:var(--ink2);cursor:pointer}\n.quick button:hover{border-color:var(--blue);color:var(--blue)}\n.list{flex:1;min-height:0;overflow:auto}\n.list ol{list-style:none}\n.list li{display:flex;align-items:center;gap:8px;padding:6px 2px;border-bottom:1px dashed var(--line);font-size:12.5px}\n.list li .n{width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff;font:700 11px/20px var(--num);text-align:center;flex:none}\n.list li .s{font-weight:700;width:52px}\n.list li .m{flex:1;color:var(--ink2);font-size:11.5px}\n.list li.bad .s{color:var(--red)}\n.list li button{border:0;background:none;color:var(--ink3);cursor:pointer;font-size:14px;line-height:1}\n.list li button:hover{color:var(--red)}\n.empty{color:var(--ink3);font-size:12px;padding:16px 0;text-align:center}\n.go{width:100%;height:40px;background:var(--blue);border-color:var(--blue);color:#fff;font-size:14px;font-weight:700}\n.go:disabled{background:#b9c8e6;border-color:#b9c8e6;cursor:not-allowed}\n.eta{font-size:12px;color:var(--ink2);margin-bottom:8px}\n.eta b{font:700 15px var(--num);color:var(--ink)}\npre{font:11px/1.45 ui-monospace,Menlo,Consolas,monospace;background:rgba(240,244,250,.9);border:1px solid var(--line);border-radius:6px;padding:8px;max-height:150px;overflow:auto;display:none;margin-top:8px;white-space:pre-wrap}\n\n@media (max-width:900px){\n  body{overflow:auto}\n  .app{grid-template-columns:1fr;grid-template-rows:auto 70vh auto;height:auto}\n  header{grid-column:1;flex-wrap:wrap;padding:12px 16px 4px}\n  .legend{margin-left:0}\n  aside{padding:8px 16px 16px}\n}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <h1>盘点<small>选择货架与格口</small></h1>\n    <div class=\"tabs\" id=\"tabs\"></div>\n    <div class=\"hlsel\">高亮疫苗 <select id=\"hl\"></select></div>\n    <div class=\"legend\">\n      <span><i style=\"background:#f7f9fc\"></i>有货</span>\n      <span><i style=\"background:transparent;border-style:dashed\"></i>空</span>\n      <span><i style=\"background:#ffd5d9;border-color:#ff9aa4\"></i>待核对</span>\n      <span><i style=\"background:#e3e7ed\"></i>未启用</span>\n      <span><i style=\"background:#cfe0ff;border-color:#1f6fff\"></i>已选</span>\n    </div>\n  </header>\n\n  <main class=\"view\" id=\"view\">\n    <div class=\"tip\" id=\"tip\"></div>\n    <div class=\"hint\">点击格口选中 / 取消 · 拖动可小幅旋转</div>\n  </main>\n\n  <aside>\n    <section class=\"card\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3 id=\"shTitle\">货架 A</h3></div>\n      <div class=\"kpis\">\n        <div><small>启用格口</small><b id=\"kEn\">0</b></div>\n        <div><small>待核对</small><b class=\"r\" id=\"kBad\">0</b></div>\n        <div><small>已选</small><b class=\"b\" id=\"kSel\">0</b></div>\n      </div>\n    </section>\n    <section class=\"card\">\n      <div class=\"quick\">\n        <button id=\"qAll\">全选有货</button>\n        <button id=\"qBad\">只选待核对</button>\n        <button id=\"qOld\">未盘 / 超 7 天</button>\n        <button id=\"qClr\">清空</button>\n      </div>\n    </section>\n    <section class=\"card list\">\n      <div class=\"hd\"><div class=\"ic\"></div><h3>盘点顺序</h3></div>\n      <ol id=\"list\"></ol>\n    </section>\n    <section class=\"card\">\n      <div class=\"eta\" id=\"eta\">未选格口</div>\n      <button class=\"go\" id=\"go\" disabled>开始盘点</button>\n      <pre id=\"out\"></pre>\n    </section>\n  </aside>\n</div>\n\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script>\n// ───────────────────────── 组件 ─────────────────────────\nfunction ShelfPicker(host, shelf, opt) {\n  opt = opt || {};\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n  renderer.setClearColor(0, 0); renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));\n  renderer.outputEncoding = THREE.sRGBEncoding;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.0;\n  host.prepend(renderer.domElement);\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(32, 1, 0.05, 40);\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true; controls.enablePan = false;\n  controls.minAzimuthAngle = -0.35; controls.maxAzimuthAngle = 0.35;\n  controls.minPolarAngle = 1.2; controls.maxPolarAngle = 1.62;\n  scene.add(new THREE.HemisphereLight(0xffffff, 0xc5cfdc, 0.9));\n  const sun = new THREE.DirectionalLight(0xffffff, 0.7); sun.position.set(-1.5, 3, 3); scene.add(sun);\n\n  // 材质(白模)\n  const M = {\n    white: new THREE.MeshStandardMaterial({ color: 0xf3f5f9, roughness: 0.85 }),\n    back: new THREE.MeshStandardMaterial({ color: 0xe6ebf2, roughness: 0.9 }),\n    box: new THREE.MeshStandardMaterial({ color: 0xf8fafd, roughness: 0.8 }),\n    hl: new THREE.MeshStandardMaterial({ color: 0x1f63ff, roughness: 0.45, emissive: 0x0b3fd0, emissiveIntensity: 0.35, toneMapped: false }),\n    off: new THREE.MeshStandardMaterial({ color: 0xdfe4eb, roughness: 0.95, transparent: true, opacity: 0.85 }),\n    edge: new THREE.LineBasicMaterial({ color: 0xa9b5c6, transparent: true, opacity: 0.7 }),\n    boxEdge: new THREE.LineBasicMaterial({ color: 0xb3bfce, transparent: true, opacity: 0.8 }),\n    hlEdge: new THREE.LineBasicMaterial({ color: 0xbfd6ff }),\n  };\n  const fillMat = () => new THREE.MeshBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0, depthWrite: false });\n  const lineMat = () => new THREE.LineBasicMaterial({ color: 0x1f6fff, transparent: true, opacity: 0 });\n  const mm = v => v / 1000;\n\n  // 几何: 每列宽 0.62, 层高 0.13, 深 0.56; 原点 = 货架底面中心, Z 朝观众\n  const G = { cw: 0.62, post: 0.035, dy: 0.13, y0: 0.12, depth: 0.56, board: 0.012 };\n  const root = new THREE.Group(); scene.add(root);\n  const slotObjs = new Map();                    // 名称 → {hit, fill, line, center, data}\n  let hlName = opt.highlight || null, sel = [], hover = null;\n  const nameOf = k => String(k || \"\").split(\"|\")[0];\n  const isHL = k => !!hlName && nameOf(k).includes(hlName);\n\n  function add(g, mat, x, y, z, parent, edge) {\n    const m = new THREE.Mesh(g, mat); m.position.set(x, y, z); (parent || root).add(m);\n    if (edge !== false) m.add(new THREE.LineSegments(new THREE.EdgesGeometry(g), edge || M.edge));\n    return m;\n  }\n  const B = (w, h, d) => new THREE.BoxGeometry(w, h, d);\n\n  // 地面: 网格+光晕径向渐隐(融入页面底色)\n  (function () {\n    const S = 1024, c = document.createElement(\"canvas\"); c.width = c.height = S;\n    const g = c.getContext(\"2d\"), cx = S / 2;\n    g.strokeStyle = \"rgba(31,111,255,.14)\"; g.lineWidth = 1;\n    for (let p = 0; p <= S; p += S / 32) { g.beginPath(); g.moveTo(p, 0); g.lineTo(p, S); g.moveTo(0, p); g.lineTo(S, p); g.stroke(); }\n    g.save(); g.shadowColor = \"rgba(31,111,255,.8)\"; g.shadowBlur = 30; g.strokeStyle = \"rgba(77,155,255,.85)\"; g.lineWidth = 4;\n    const w = S * 0.36, d = S * 0.13; g.beginPath(); g.roundRect ? g.roundRect(cx - w / 2, cx - d / 2, w, d, 18) : g.rect(cx - w / 2, cx - d / 2, w, d); g.stroke(); g.restore();\n    g.globalCompositeOperation = \"destination-in\";\n    const rg = g.createRadialGradient(cx, cx, S * .1, cx, cx, S * .5); rg.addColorStop(0, \"#000\"); rg.addColorStop(.6, \"rgba(0,0,0,.5)\"); rg.addColorStop(1, \"rgba(0,0,0,0)\");\n    g.fillStyle = rg; g.fillRect(0, 0, S, S);\n    const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding;\n    const fl = new THREE.Mesh(new THREE.PlaneGeometry(4.2, 4.2), new THREE.MeshBasicMaterial({ map: t, transparent: true, depthWrite: false }));\n    fl.rotation.x = -Math.PI / 2; fl.position.set(0, 0.001, -G.depth / 2); scene.add(fl);\n  })();\n\n  // 盒子: 每列 = 一队盒(从背板往外), 白模; 高亮疫苗染蓝\n  function drawBoxes(group, cols, xc, y, cap) {\n    for (const c of cols || []) {\n      const [w, h, t] = c.box_mm, n = Math.min(c.count || 0, cap);\n      if (!n) continue;\n      const L = mm(t) * n, hl = isHL(c.group_key);\n      const m = add(B(mm(w) - 0.002, Math.min(mm(h), G.dy - G.board - 0.01), L - 0.002), hl ? M.hl : M.box,\n        xc + mm(c.x_mm), y + Math.min(mm(h), G.dy - G.board - 0.01) / 2, -G.depth + 0.01 + L / 2, group, hl ? M.hlEdge : M.boxEdge);\n      m.userData.gk = c.group_key;\n      const seams = [], hh = Math.min(mm(h), G.dy - G.board - 0.01) / 2;      // 盒缝(顶面)\n      for (let j = 1; j < n; j++) { const z = -L / 2 + j * mm(t); seams.push(-mm(w) / 2, hh + 0.0005, z, mm(w) / 2, hh + 0.0005, z); }\n      const sg = new THREE.BufferGeometry(); sg.setAttribute(\"position\", new THREE.Float32BufferAttribute(seams, 3));\n      m.add(new THREE.LineSegments(sg, hl ? M.hlEdge : M.boxEdge));\n    }\n  }\n\n  let labels = [];\n  function build() {\n    root.clear(); slotObjs.clear(); labels.forEach(l => l.el.remove()); labels = [];\n    const cols = Object.keys(shelf.columns);     // [\"L\",\"R\"]\n    const nMax = Math.max(...cols.map(k => shelf.columns[k]));\n    const W = cols.length * G.cw + (cols.length + 1) * G.post, H = G.y0 + nMax * G.dy + 0.04;\n    const xOf = i => -W / 2 + G.post + G.cw / 2 + i * (G.cw + G.post);\n    // 框架\n    for (let i = 0; i <= cols.length; i++) add(B(G.post, H, G.depth), M.white, -W / 2 + G.post / 2 + i * (G.cw + G.post), H / 2, -G.depth / 2);\n    add(B(W, H, 0.012), M.back, 0, H / 2, -G.depth - 0.006);\n    add(B(W + 0.03, 0.035, G.depth + 0.02), M.white, 0, H + 0.017, -G.depth / 2);\n    add(B(W + 0.03, G.y0 - 0.02, G.depth + 0.02), M.white, 0, (G.y0 - 0.02) / 2, -G.depth / 2);   // 底座\n    cols.forEach((col, ci) => {\n      const xc = xOf(ci), n = shelf.columns[col];\n      labels.push({ el: mkLabel(col === \"L\" ? \"左列 L\" : col === \"R\" ? \"右列 R\" : col, \"col\"), v: new THREE.Vector3(xc, H + 0.09, 0) });\n      for (let l = 1; l <= n; l++) {\n        const y = G.y0 + (l - 1) * G.dy;\n        add(B(G.cw, G.board, G.depth), M.white, xc, y - G.board / 2, -G.depth / 2);\n        if (ci === 0) labels.push({ el: mkLabel(String(l)), v: new THREE.Vector3(-W / 2 - 0.07, y + G.dy / 2, 0) });\n        const name = `${shelf.id}-${col}${l}`, d = shelf.slots[name] || { enabled: false };\n        const hg = B(G.cw - 0.012, G.dy - G.board - 0.006, G.depth - 0.01);\n        const cy = y + (G.dy - G.board) / 2 + 0.002, cz = -G.depth / 2 + 0.005;\n        if (!d.enabled) { add(B(G.cw - 0.01, G.dy - G.board - 0.01, 0.006), M.off, xc, cy, -0.004, root, false); }\n        else drawBoxes(root, d.columns, xc, y, 30);\n        const fill = new THREE.Mesh(hg, fillMat()); fill.position.set(xc, cy, cz); root.add(fill);\n        const line = new THREE.LineSegments(new THREE.EdgesGeometry(hg), lineMat()); fill.add(line);\n        fill.userData.slot = name;\n        slotObjs.set(name, { hit: fill, fill, line, center: new THREE.Vector3(xc, cy, 0.02), data: d, badge: null, warn: null });\n        if (d.enabled && d.last && d.last.result === \"mismatch\") {\n          const o = slotObjs.get(name); o.warn = mkLabel(\"!\", \"warn\"); labels.push({ el: o.warn, v: new THREE.Vector3(xc + G.cw / 2 - 0.035, y + G.dy - 0.03, 0.02) });\n        }\n      }\n    });\n    // 取景: 正面略俯视\n    const dist = Math.max(H * 1.75, W * 1.6);\n    controls.target.set(0, H * 0.5, -G.depth / 2);\n    camera.position.set(0, H * 0.62, dist);\n    controls.minDistance = dist * 0.6; controls.maxDistance = dist * 1.5;\n    paint();\n  }\n  function mkLabel(t, cls) {\n    const el = document.createElement(\"div\");\n    el.className = cls === \"warn\" ? \"warn\" : \"lbl\" + (cls ? \" \" + cls : \"\"); el.textContent = t; host.appendChild(el); return el;\n  }\n\n  // 状态着色: 悬停浅蓝 / 已选蓝 / 待核对红\n  function paint() {\n    const t = performance.now() / 1000;\n    for (const [name, o] of slotObjs) {\n      const si = sel.indexOf(name), d = o.data, bad = d.enabled && d.last && d.last.result === \"mismatch\";\n      let col = 0x1f6fff, fo = 0, lo = 0;\n      if (si >= 0) { fo = 0.16; lo = 1; }\n      else if (hover === name && d.enabled) { fo = 0.08; lo = 0.7; }\n      if (bad && si < 0) { col = 0xff3b4a; fo = Math.max(fo, 0.07 + 0.06 * (0.5 + 0.5 * Math.sin(t * 3))); lo = Math.max(lo, 0.6); }\n      o.fill.material.color.setHex(col); o.fill.material.opacity = fo;\n      o.line.material.color.setHex(col); o.line.material.opacity = lo;\n      if (si >= 0 && !o.badge) { o.badge = mkLabel(\"\", \"x\"); o.badge.className = \"badge\"; labels.push({ el: o.badge, v: o.center }); }\n      if (o.badge) { if (si < 0) { o.badge.remove(); labels = labels.filter(l => l.el !== o.badge); o.badge = null; } else o.badge.textContent = si + 1; }\n    }\n  }\n\n  // 交互\n  const ray = new THREE.Raycaster(), p = new THREE.Vector2(), tip = host.querySelector(\".tip\");\n  const hits = () => [...slotObjs.values()].map(o => o.hit);\n  function pick(e) {\n    const r = renderer.domElement.getBoundingClientRect();\n    p.set((e.clientX - r.left) / r.width * 2 - 1, -(e.clientY - r.top) / r.height * 2 + 1);\n    ray.setFromCamera(p, camera);\n    const h = ray.intersectObjects(hits(), false)[0]; return h ? h.object.userData.slot : null;\n  }\n  renderer.domElement.addEventListener(\"pointermove\", e => {\n    const s = pick(e); hover = s;\n    if (!s) { tip.style.display = \"none\"; return; }\n    const d = slotObjs.get(s).data, r = host.getBoundingClientRect();\n    tip.innerHTML = tipHtml(s, d); tip.className = \"tip\" + (d.last && d.last.result === \"mismatch\" ? \" bad\" : \"\");\n    tip.style.display = \"block\";\n    tip.style.left = Math.min(e.clientX - r.left + 16, r.width - 220) + \"px\"; tip.style.top = (e.clientY - r.top + 14) + \"px\";\n  });\n  renderer.domElement.addEventListener(\"pointerleave\", () => { hover = null; tip.style.display = \"none\"; });\n  let down = null;\n  renderer.domElement.addEventListener(\"pointerdown\", e => down = [e.clientX, e.clientY]);\n  renderer.domElement.addEventListener(\"pointerup\", e => {\n    if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 4) return;\n    const s = pick(e); if (!s || !slotObjs.get(s).data.enabled) return;\n    const i = sel.indexOf(s); i >= 0 ? sel.splice(i, 1) : sel.push(s); changed();\n  });\n  function tipHtml(s, d) {\n    if (!d.enabled) return `<b>${s}</b><div class=\"r\"><span>状态</span><span>未启用(未标定)</span></div>`;\n    const n = (d.columns || []).reduce((a, c) => a + (c.count || 0), 0);\n    const kinds = [...new Set((d.columns || []).map(c => nameOf(c.group_key)))];\n    const res = { match: \"相符\", mismatch: \"不符 · 待核对\", none: \"未盘点\" }[(d.last || {}).result || \"none\"];\n    const hlN = (d.columns || []).filter(c => isHL(c.group_key)).reduce((a, c) => a + c.count, 0);\n    return `<b>${s}</b>` +\n      `<div class=\"r\"><span>账上</span><span>${n} 盒 · ${(d.columns || []).length} 列</span></div>` +\n      (kinds.length ? `<div class=\"r\"><span>品种</span><span>${kinds.map(k => k.replace(/(疫苗|\\(.*?\\))/g, \"\")).join(\"、\")}</span></div>` : \"\") +\n      (hlName && hlN ? `<div class=\"r\"><span>${hlName.slice(0, 6)}…</span><span style=\"color:var(--blue)\">${hlN} 盒</span></div>` : \"\") +\n      `<div class=\"r\"><span>上次盘点</span><span>${(d.last && d.last.t) || \"—\"} ${res}</span></div>` +\n      `<div class=\"r\" style=\"margin-top:3px;color:var(--ink3)\"><span>点击${sel.includes(s) ? \"取消\" : \"加入盘点\"}</span><span></span></div>`;\n  }\n  function changed() { paint(); opt.onChange && opt.onChange(sel.slice()); }\n\n  // 尺寸/循环\n  const ro = new ResizeObserver(() => {\n    const w = host.clientWidth, h = host.clientHeight;\n    renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();\n  }); ro.observe(host);\n  const tmp = new THREE.Vector3();\n  renderer.setAnimationLoop(() => {\n    M.hl.emissiveIntensity = 0.28 + 0.2 * (0.5 + 0.5 * Math.sin(performance.now() / 420));\n    controls.update(); paint(); renderer.render(scene, camera);\n    const w = host.clientWidth, h = host.clientHeight;\n    for (const l of labels) { tmp.copy(l.v).project(camera); l.el.style.left = (tmp.x + 1) / 2 * w + \"px\"; l.el.style.top = (1 - tmp.y) / 2 * h + \"px\"; }\n  });\n  build();\n\n  return {\n    setShelf(s) { shelf = s; sel = []; build(); changed(); },\n    select(list) { sel = list.filter(n => slotObjs.get(n) && slotObjs.get(n).data.enabled); changed(); },\n    clear() { sel = []; changed(); },\n    selected: () => sel.slice(),\n    highlight(name) { hlName = name || null; const keep = sel.slice(); build(); sel = keep; changed(); },\n    slots: () => [...slotObjs.entries()].map(([n, o]) => ({ name: n, ...o.data })),\n  };\n}\nwindow.ShelfPicker = ShelfPicker;\n\n// ───────────────────────── 示例数据 ─────────────────────────\n// 现役格口按 2026-10 实际: 左右列第 8~12 层 + 第 2/6 层部分已标定; A-L10 为真实库存, 其余演示\nconst VAC = {\n  mmr: \"麻腮风联合减毒活疫苗|202504034\", ipv: \"Sabin株脊髓灰质炎灭活疫苗(Vero细胞)|C202407009\",\n  hav: \"甲型肝炎灭活疫苗(人二倍体细胞)|20241021\", hbv: \"重组乙型肝炎疫苗(酿酒酵母)|20250311\",\n};\nconst SZ = { mmr: [60, 38.5, 22.4], ipv: [133, 38, 25], hav: [63, 50, 23], hbv: [70, 35, 24] };\nlet seed = 11; const rnd = () => (seed = seed * 16807 % 2147483647) / 2147483647;\nfunction demoCols(kinds) {\n  const out = []; let x = -270;\n  for (const k of kinds) { const w = SZ[k][0]; if (x + w > 280) break; out.push({ x_mm: x + w / 2, box_mm: SZ[k], group_key: VAC[k], count: 3 + Math.floor(rnd() * 15) }); x += w + 10; }\n  return out;\n}\nfunction mkShelf(id, enabledSet, overrides) {\n  const slots = {};\n  for (const col of [\"L\", \"R\"]) for (let l = 1; l <= 13; l++) {\n    const n = `${id}-${col}${l}`, en = enabledSet.has(n);\n    const pool = [\"mmr\", \"ipv\", \"hav\", \"hbv\"], kinds = [];\n    for (let i = 0; i < 6; i++) kinds.push(pool[Math.floor(rnd() * pool.length)]);\n    slots[n] = en ? { enabled: true, columns: rnd() < 0.15 ? [] : demoCols(kinds),\n      last: { t: `10-${String(14 + Math.floor(rnd() * 8)).padStart(2, \"0\")}`, result: rnd() < 0.2 ? \"none\" : \"match\" } } : { enabled: false };\n  }\n  Object.assign(slots, overrides || {});\n  return { id, columns: { L: 13, R: 13 }, slots };\n}\nconst EN_A = new Set([\"A-L2\", \"A-L6\", \"A-R2\", \"A-R4\", \"A-R6\", ...[8, 9, 10, 11, 12].flatMap(l => [`A-L${l}`, `A-R${l}`])]);\nconst SHELVES = {\n  A: mkShelf(\"A\", EN_A, {\n    \"A-L10\": { enabled: true, last: { t: \"10-22 10:04\", result: \"match\" }, columns: [\n      { x_mm: -246.2, box_mm: SZ.mmr, group_key: VAC.mmr, count: 17 }, { x_mm: -141.7, box_mm: SZ.ipv, group_key: VAC.ipv, count: 6 },\n      { x_mm: -37.2, box_mm: SZ.mmr, group_key: \"麻腮风联合减毒活疫苗|202503015\", count: 11 }, { x_mm: 30.8, box_mm: SZ.mmr, group_key: VAC.mmr, count: 6 }] },\n    \"A-R10\": { enabled: true, last: { t: \"10-21 15:36\", result: \"mismatch\" }, columns: demoCols([\"ipv\", \"mmr\", \"hav\"]) },\n    \"A-L2\": { enabled: true, last: { t: \"10-21 15:33\", result: \"mismatch\" }, columns: demoCols([\"hav\", \"hav\", \"mmr\"]) },\n  }),\n  B: { id: \"B\", columns: { L: 13, R: 13 }, slots: {}, planned: true },\n};\n\n// ───────────────────────── 页面 ─────────────────────────\nconst $ = id => document.getElementById(id);\nconst PER_SLOT_S = 50;                                          // 单格口盘点约 50 s(飞过去+拍一帧+飞回)\nconst view = $(\"view\");\nconst picker = ShelfPicker(view, SHELVES.A, { highlight: \"\", onChange: refresh });\nlet cur = \"A\";\n\n$(\"tabs\").innerHTML = Object.values(SHELVES).map(s =>\n  `<button data-id=\"${s.id}\" ${s.planned ? \"disabled\" : \"\"} class=\"${s.id === cur ? \"on\" : \"\"}\">货架 ${s.id}${s.planned ? \"<small>未部署</small>\" : \"\"}</button>`).join(\"\");\n$(\"tabs\").onclick = e => {\n  const b = e.target.closest(\"button\"); if (!b || b.disabled) return;\n  cur = b.dataset.id; [...$(\"tabs\").children].forEach(x => x.classList.toggle(\"on\", x === b));\n  picker.setShelf(SHELVES[cur]); $(\"shTitle\").textContent = \"货架 \" + cur;\n};\nconst kinds = [...new Set(Object.values(SHELVES.A.slots).flatMap(s => (s.columns || []).map(c => c.group_key.split(\"|\")[0])))];\n$(\"hl\").innerHTML = `<option value=\"\">不高亮</option>` + kinds.map(k => `<option>${k}</option>`).join(\"\");\n$(\"hl\").onchange = () => picker.highlight($(\"hl\").value);\n\nfunction refresh(sel) {\n  sel = sel || picker.selected();\n  const all = picker.slots(), en = all.filter(s => s.enabled), bad = en.filter(s => s.last && s.last.result === \"mismatch\");\n  $(\"kEn\").textContent = en.length; $(\"kBad\").textContent = bad.length; $(\"kSel\").textContent = sel.length;\n  const by = Object.fromEntries(all.map(s => [s.name, s]));\n  $(\"list\").innerHTML = sel.length ? sel.map((n, i) => {\n    const s = by[n], c = (s.columns || []).reduce((a, x) => a + x.count, 0), b = s.last && s.last.result === \"mismatch\";\n    return `<li class=\"${b ? \"bad\" : \"\"}\"><span class=\"n\">${i + 1}</span><span class=\"s\">${n}</span><span class=\"m\">${c} 盒 · ${(s.columns || []).length} 列${b ? \" · 待核对\" : \"\"}</span><button data-n=\"${n}\" title=\"移除\">×</button></li>`;\n  }).join(\"\") : `<div class=\"empty\">在左侧货架上点击格口</div>`;\n  const t = sel.length * PER_SLOT_S;\n  $(\"eta\").innerHTML = sel.length ? `共 <b>${sel.length}</b> 个格口 · 预计 <b>${Math.floor(t / 60)}</b> 分 <b>${t % 60}</b> 秒` : \"未选格口\";\n  $(\"go\").disabled = !sel.length; $(\"out\").style.display = \"none\";\n}\n$(\"list\").onclick = e => { const b = e.target.closest(\"button\"); if (b) picker.select(picker.selected().filter(n => n !== b.dataset.n)); };\n$(\"qAll\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (s.columns || []).length).map(s => s.name));\n$(\"qBad\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && s.last && s.last.result === \"mismatch\").map(s => s.name));\n$(\"qOld\").onclick = () => picker.select(picker.slots().filter(s => s.enabled && (!s.last || s.last.result === \"none\" || s.last.t < \"10-15\")).map(s => s.name));\n$(\"qClr\").onclick = () => picker.clear();\n// 开始盘点: 设备一次只盘一个格口 → 按顺序逐个 POST /tasks(上一单 task_end 后再下一单); 这里只展示请求\n$(\"go\").onclick = () => {\n  const by = Object.fromEntries(picker.slots().map(s => [s.name, s]));\n  const reqs = picker.selected().map(n => ({ type: \"stocktake\", slot: n,\n    columns: (by[n].columns || []).map(c => ({ x_mm: c.x_mm, box_mm: c.box_mm, group_key: c.group_key, count: c.count })) }));\n  $(\"out\").textContent = `// 按顺序逐个下单(上一单 task_end 后再下一单)\\n` + reqs.map((r, i) => `// ${i + 1}. POST /tasks\\n` + JSON.stringify(r)).join(\"\\n\");\n  $(\"out\").style.display = \"block\";\n};\nrefresh([]);\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"c4266f4a-b473-46b1-a87c-9bb24039035d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
