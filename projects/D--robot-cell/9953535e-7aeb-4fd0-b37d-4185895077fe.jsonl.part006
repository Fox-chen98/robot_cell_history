{"parentUuid":"a49f6867-25b5-4787-b642-ce2e37e99a2b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgGq4wmspLMp26ZDiqLUw","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":819,"cache_read_input_tokens":394758,"output_tokens":15115,"output_tokens_details":{"thinking_tokens":24},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":819,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":15115,"cache_read_input_tokens":394758,"cache_creation_input_tokens":819,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":819},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":708,"thinkingDisplay":"updates","serverClassifierRequest":"c5be68cb-8836-4b49-8038-ee346a3517b2","apiBlockIndex":0,"requestId":"req_011CgGq4w4Djbgc6ftbMh8u3","requestRef":"2738077a-5f00-4d04-a844-382117ac23d9","requestedModel":"claude-opus-5-5[1m]","type":"assistant","uuid":"b563ca4f-a7a5-4d9b-8b64-45c05c1aa82a","timestamp":"2026-10-22T06:49:09.839Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"b563ca4f-a7a5-4d9b-8b64-45c05c1aa82a","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgGq4wmspLMp26ZDiqLUw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013yS3JatXqV2Byoi7Y2M1YM","name":"Write","input":{"file_path":"/Users/chen/Desktop/robocenter/docs/首页改版/index_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>冷链自动发苗机器人</title>\n<!--\n  首页改版效果图(演示数据). 排版顺序: 状态 → 待办 → 入口 → 数据\n  ① 设备卡(3D 白模工作站, 任务进行时机械臂随步骤动) + 待处理(按紧急度)\n  ② 快捷访问 6 卡(保留卡片, 插画统一为白模等轴风格)\n  ③ 今日数据(与昨日对比)  ④ 近 7 日上苗/发苗柱图 + 货架库存分布\n  颜色约定: 主色蓝; 红=过期/故障; 橙=临期/待核对; 黄=提醒; 其余灰蓝\n-->\n<style>\n:root{--bg:#eef2f7;--card:#fff;--ink:#1f2633;--ink2:#5d6b7e;--ink3:#98a3b3;--line:#e3e8ef;\n  --blue:#1f6fff;--blue2:#e8f0ff;--teal:#13a89e;--red:#f04444;--red2:#fdecec;--orange:#f08a24;--orange2:#fef3e6;--yellow:#e5a50a;--yellow2:#fdf6e0;\n  --r:14px;--num:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:linear-gradient(180deg,#f3f6fb 0%,#e9eef6 100%) fixed;background-color:var(--bg);color:var(--ink);\n  font:14px/1.5 -apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}\na{color:inherit;text-decoration:none}\n.num{font-family:var(--num);font-weight:700}\n\n/* 顶栏 */\n.top{position:sticky;top:0;z-index:10;height:60px;display:flex;align-items:center;gap:16px;padding:0 28px;\n  background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border-bottom:1px solid rgba(227,232,239,.8)}\n.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}\n.logo svg{width:30px;height:30px}\n.top .sp{flex:1}\n.pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:14px;font-size:12.5px;color:var(--ink2);background:#f2f5f9}\n.pill.ok{background:#e7f7f3;color:#0b8a7f}\n.pill i{width:7px;height:7px;border-radius:50%;background:currentColor}\n.icon-btn{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:var(--ink2);position:relative;cursor:pointer}\n.icon-btn:hover{background:#f2f5f9}\n.icon-btn svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8}\n.icon-btn b{position:absolute;top:3px;right:3px;min-width:16px;height:16px;border-radius:8px;background:var(--red);color:#fff;font:700 10px/16px var(--num);text-align:center;padding:0 4px}\n.user{display:flex;align-items:center;gap:8px;font-size:13px}\n.user span{width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:700}\n\n.wrap{max-width:1680px;margin:0 auto;padding:22px 28px 40px;display:flex;flex-direction:column;gap:22px}\n.sec-h{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}\n.sec-h h2{font-size:17px;font-weight:700;position:relative}\n.sec-h h2::after{content:\"\";position:absolute;left:0;bottom:-2px;width:100%;height:5px;background:linear-gradient(90deg,rgba(31,111,255,.45),rgba(31,111,255,0));border-radius:3px;z-index:-1}\n.sec-h small{margin-left:auto;font-size:12.5px;color:var(--ink3)}\n.card{background:var(--card);border-radius:var(--r);box-shadow:0 1px 2px rgba(20,40,80,.04),0 6px 24px rgba(20,40,80,.05)}\n\n/* ① 主区 */\n.hero{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.dev{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);overflow:hidden;min-height:340px;position:relative}\n.dev .scene{position:relative;background:radial-gradient(ellipse 70% 60% at 50% 60%,#fff 0%,rgba(255,255,255,0) 70%),linear-gradient(180deg,#f6f8fc,#edf2f8)}\n#stage3d{position:absolute;inset:0}\n#gl{width:100%;height:100%;display:block;cursor:grab}\n.scene .badge{position:absolute;left:16px;top:14px;font-size:12px;color:var(--ink3)}\n.scene .badge b{color:var(--ink2);font-weight:600}\n.dev .info{padding:22px 24px 20px;display:flex;flex-direction:column}\n.dev .k{font-size:12.5px;color:var(--ink3)}\n.state{display:flex;align-items:center;gap:10px;margin:2px 0 4px}\n.state .dot{width:12px;height:12px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(31,111,255,.15);animation:br 1.6s infinite}\n.state.idle .dot{background:var(--teal);box-shadow:0 0 0 5px rgba(19,168,158,.15)}\n@keyframes br{50%{box-shadow:0 0 0 9px rgba(31,111,255,.05)}}\n.state b{font-size:30px;font-weight:700;letter-spacing:.02em}\n.state.idle b{color:var(--teal)}\n.task{margin-top:8px;padding:12px 14px;border-radius:10px;background:#f5f8fc}\n.task .t1{display:flex;justify-content:space-between;font-size:13px}\n.task .t1 b{font-weight:600}\n.task .t1 span{color:var(--ink3)}\n.bar{height:6px;border-radius:3px;background:#e3e9f2;margin:9px 0 7px;overflow:hidden}\n.bar i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,#4d8dff,var(--blue));transition:width .6s}\n.steps{display:flex;gap:4px;font-size:11.5px;color:var(--ink3);flex-wrap:wrap}\n.steps span{padding:1px 7px;border-radius:9px}\n.steps span.on{background:var(--blue);color:#fff}\n.steps span.done{color:var(--blue)}\n.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0 auto}\n.facts div{font-size:12px;color:var(--ink3)}\n.facts b{display:block;font-size:14px;color:var(--ink);font-weight:600;margin-top:1px}\n.facts b.g{color:var(--teal)}\n.acts{display:flex;gap:10px;margin-top:18px}\n.btn{height:42px;padding:0 18px;border-radius:10px;border:1px solid var(--line);background:#fff;font:inherit;font-size:14.5px;font-weight:600;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;gap:7px;justify-content:center}\n.btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2}\n.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff;flex:1}\n.btn.sec{flex:1;color:var(--blue);border-color:#c9dbff;background:var(--blue2)}\n.btn:hover{filter:brightness(.97)}\n.meta{font-size:11.5px;color:var(--ink3);margin-top:12px;display:flex;justify-content:space-between}\n.meta a{color:var(--blue)}\n\n.todo{padding:20px 22px;display:flex;flex-direction:column}\n.todo .hd{display:flex;align-items:center;gap:10px;margin-bottom:12px}\n.todo .hd h3{font-size:16px}\n.todo .hd .cnt{min-width:22px;height:22px;border-radius:11px;background:var(--red);color:#fff;font:700 12px/22px var(--num);text-align:center;padding:0 7px}\n.todo .hd small{margin-left:auto;color:var(--ink3);font-size:12px}\n.chips{display:flex;gap:6px;margin-bottom:10px}\n.chips span{font-size:12px;padding:2px 10px;border-radius:12px;background:#f2f5f9;color:var(--ink2);cursor:pointer}\n.chips span.on{background:var(--ink);color:#fff}\n.item{display:flex;gap:12px;padding:12px 4px;border-top:1px solid var(--line);align-items:flex-start}\n.item:first-of-type{border-top:0}\n.lv{flex:none;width:36px;height:36px;border-radius:10px;display:grid;place-items:center}\n.lv svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:2}\n.lv.red{background:var(--red2);color:var(--red)}.lv.orange{background:var(--orange2);color:var(--orange)}.lv.yellow{background:var(--yellow2);color:var(--yellow)}\n.item .c{flex:1;min-width:0}\n.item .t{font-weight:600;font-size:14px;display:flex;gap:8px;align-items:center}\n.tag{font-size:11px;font-weight:600;padding:0 6px;border-radius:4px;line-height:18px}\n.tag.red{background:var(--red2);color:var(--red)}.tag.orange{background:var(--orange2);color:var(--orange)}.tag.yellow{background:var(--yellow2);color:#b98200}\n.item .d{font-size:12.5px;color:var(--ink2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.item .go{flex:none;font-size:12.5px;color:var(--blue);border:1px solid #c9dbff;border-radius:8px;padding:4px 10px;align-self:center;white-space:nowrap}\n.item .go:hover{background:var(--blue2)}\n.todo .more{margin-top:auto;padding-top:10px;font-size:12.5px;color:var(--blue);text-align:center}\n\n/* ② 快捷访问 */\n.quick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}\n.qc{display:flex;align-items:center;gap:18px;padding:18px 22px;min-height:118px;transition:transform .18s,box-shadow .18s;position:relative;overflow:hidden}\n.qc::before{content:\"\";position:absolute;right:-40px;top:-40px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(31,111,255,.06),rgba(31,111,255,0) 70%)}\n.qc:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(20,40,80,.05),0 14px 32px rgba(20,40,80,.09)}\n.qc svg.ill{width:96px;height:80px;flex:none}\n.qc h4{font-size:18px;font-weight:700}\n.qc p{font-size:13px;color:var(--ink3);margin-top:3px}\n.qc .n{font-size:12px;color:var(--blue);margin-top:6px;font-weight:600}\n.qc .n.warn{color:var(--red)}\n.qc .arr{margin-left:auto;color:#c2cad6;font-size:20px;transition:transform .18s}\n.qc:hover .arr{transform:translateX(3px);color:var(--blue)}\n\n/* ③ 今日数据 */\n.kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px}\n.kpi{padding:16px 20px 12px;position:relative}\n.kpi .k{font-size:13px;color:var(--ink2);display:flex;align-items:center;gap:6px}\n.kpi .k small{color:var(--ink3);font-size:11.5px}\n.kpi .v{display:flex;align-items:baseline;gap:5px;margin-top:4px}\n.kpi .v b{font:700 34px/1.1 var(--num)}\n.kpi .v span{font-size:13px;color:var(--ink3)}\n.kpi .delta{font-size:12px;margin-top:2px;color:var(--ink3)}\n.kpi .delta b{font-weight:600}\n.kpi .delta .up{color:var(--teal)}.kpi .delta .dn{color:var(--red)}\n.kpi svg.sp{position:absolute;right:16px;bottom:14px;width:92px;height:34px}\n.ring{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:56px;height:56px}\n\n/* ④ 趋势 + 货架 */\n.row4{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.panel{padding:18px 22px}\n.panel .hd{display:flex;align-items:center;gap:12px;margin-bottom:6px}\n.panel .hd h3{font-size:16px}\n.panel .hd .lg{display:flex;gap:14px;font-size:12px;color:var(--ink2);margin-left:8px}\n.panel .hd .lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.seg{margin-left:auto;display:flex;background:#f2f5f9;border-radius:8px;padding:2px}\n.seg span{font-size:12px;padding:3px 12px;border-radius:6px;color:var(--ink2);cursor:pointer}\n.seg span.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(20,40,80,.1)}\n#trend{width:100%;height:260px;display:block}\n.tt{position:absolute;pointer-events:none;background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(20,40,80,.12);display:none;white-space:nowrap}\n.shelf{display:grid;grid-template-columns:auto 1fr 1fr;gap:3px 6px;margin-top:8px;font-size:11px;color:var(--ink3)}\n.shelf .h{text-align:center;font-weight:600;color:var(--ink2);font-size:12px}\n.shelf .l{text-align:right;padding-right:2px;font-family:var(--num);line-height:16px}\n.cell{height:16px;border-radius:3px;background:#f0f3f7;position:relative;overflow:hidden;cursor:pointer;border:1px solid transparent}\n.cell i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,#6aa2ff,var(--blue));border-radius:2px}\n.cell.off{background:repeating-linear-gradient(135deg,#eef1f5 0 4px,#e5e9ef 4px 8px)}\n.cell.bad{border-color:var(--orange);background:var(--orange2)}\n.cell.bad i{background:linear-gradient(90deg,#ffb36b,var(--orange))}\n.cell:hover{outline:2px solid rgba(31,111,255,.35)}\n.shelf-lg{display:flex;gap:12px;font-size:11.5px;color:var(--ink2);margin-top:10px;flex-wrap:wrap}\n.shelf-lg i{display:inline-block;width:12px;height:8px;border-radius:2px;margin-right:4px}\n.shelf-sum{display:flex;gap:18px;margin-top:4px}\n.shelf-sum div{font-size:12px;color:var(--ink3)}\n.shelf-sum b{display:block;font:700 20px var(--num);color:var(--ink)}\n.foot{text-align:center;font-size:12px;color:var(--ink3)}\n\n@media (max-width:1180px){\n  .hero,.row4{grid-template-columns:1fr}\n  .kpis{grid-template-columns:repeat(3,1fr)}\n  .quick{grid-template-columns:repeat(2,1fr)}\n}\n@media (max-width:720px){\n  .wrap{padding:16px}\n  .top{padding:0 16px}.top .pill,.user b{display:none}\n  .dev{grid-template-columns:1fr}.dev .scene{height:240px}\n  .quick{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}\n}\n</style>\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 40 40\"><path d=\"M6 26l14-16 4 4-14 16z\" fill=\"#f5a623\"/><path d=\"M16 30L32 8l3 3-16 22z\" fill=\"#1f6fff\"/><path d=\"M12 32h22\" stroke=\"#1f6fff\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n    冷链自动发苗机器人\n  </div>\n  <div class=\"sp\"></div>\n  <span class=\"pill\" id=\"clock\">2026-10-22 14:46</span>\n  <span class=\"pill ok\"><i></i>设备在线</span>\n  <div class=\"icon-btn\" title=\"消息\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0\"/></svg><b>4</b></div>\n  <div class=\"user\"><span>王</span><b>王医生</b></div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- ① 状态 + 待办 -->\n  <section class=\"hero\">\n    <div class=\"card dev\">\n      <div class=\"scene\">\n        <main id=\"stage3d\"><canvas id=\"gl\"></canvas></main>\n        <div class=\"badge\">工作站 <b>GCR10 · 货架 A</b></div>\n      </div>\n      <div class=\"info\">\n        <div class=\"k\">设备状态</div>\n        <div class=\"state\" id=\"state\"><span class=\"dot\"></span><b id=\"stTxt\">运行中</b></div>\n        <div class=\"k\" id=\"stSub\">正在执行上苗任务</div>\n        <div class=\"task\" id=\"task\">\n          <div class=\"t1\"><b>上苗 #116 · 自动送料</b><span id=\"prog\">3 / 10 盒</span></div>\n          <div class=\"bar\"><i id=\"pbar\" style=\"width:30%\"></i></div>\n          <div class=\"steps\" id=\"steps\"></div>\n        </div>\n        <div class=\"facts\">\n          <div>通信<b class=\"g\">已连接</b></div>\n          <div>使能<b>已使能</b></div>\n          <div>急停<b>未触发</b></div>\n        </div>\n        <div class=\"acts\">\n          <button class=\"btn pri\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg>上苗</button>\n          <button class=\"btn sec\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12l7 7 7-7\"/></svg>发苗</button>\n          <button class=\"btn\" title=\"盘点\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 12h6M9 16h4\"/></svg>盘点</button>\n        </div>\n        <div class=\"meta\"><span>最近检测 14:46:48 · 192.168.100.190:8902</span><a href=\"#\">设备看板 ›</a></div>\n      </div>\n    </div>\n\n    <div class=\"card todo\">\n      <div class=\"hd\"><h3>待处理</h3><span class=\"cnt\">4</span><small>按紧急程度排序</small></div>\n      <div class=\"chips\"><span class=\"on\">全部 4</span><span>库存 3</span><span>盘点 1</span><span>设备 0</span></div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">Sabin株脊髓灰质炎灭活疫苗 <span class=\"tag red\">已过期 84 天</span></div>\n          <div class=\"d\">批号 C202407009 · 4 支 · A-L10 x=-141.7</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 49 天</span></div>\n          <div class=\"d\">批号 202503015 · 7 支 · A-L10 x=-37.2</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 2 天</span></div>\n          <div class=\"d\">批号 202504034 · 41 支 · A-L10 / A-R10</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv orange\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 13l2 2 4-4\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">A-R10 盘点不符 <span class=\"tag orange\">待核对</span></div>\n          <div class=\"d\">10-21 15:36 盘点 · 账上 19 支, 实测少 1 支</div></div>\n        <a class=\"go\" href=\"#\">核对</a>\n      </div>\n      <a class=\"more\" href=\"#\">查看全部提醒 ›</a>\n    </div>\n  </section>\n\n  <!-- ② 快捷访问 -->\n  <section>\n    <div class=\"sec-h\"><h2>快捷访问</h2><small>点击卡片进入</small></div>\n    <div class=\"quick\" id=\"quick\"></div>\n  </section>\n\n  <!-- ③ 今日数据 -->\n  <section>\n    <div class=\"sec-h\"><h2>今日数据</h2><small>数量单位：支 · 对比昨日同期</small></div>\n    <div class=\"kpis\">\n      <div class=\"card kpi\"><div class=\"k\">今日上苗</div><div class=\"v\"><b class=\"num\">22</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 18</b> 比昨日</div><svg class=\"sp\" id=\"sp1\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">今日发苗</div><div class=\"v\"><b class=\"num\">4</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 3</b> 比昨日</div><svg class=\"sp\" id=\"sp2\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">当前库存</div><div class=\"v\"><b class=\"num\">52</b><span>支</span></div>\n        <div class=\"delta\">3 个品种 · 4 个批号</div><svg class=\"sp\" id=\"sp3\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">格口占用 <small>货架 A</small></div><div class=\"v\"><b class=\"num\">38</b><span>%</span></div>\n        <div class=\"delta\">在用 15 格口 · 空 4</div>\n        <svg class=\"ring\" viewBox=\"0 0 56 56\"><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#eaf0f7\" stroke-width=\"7\"/><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#1f6fff\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"52.5 138.2\" transform=\"rotate(-90 28 28)\"/></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">过期 / 临期 <small>批次</small></div><div class=\"v\"><b class=\"num\" style=\"color:var(--red)\">3</b><span>/ 0</span></div>\n        <div class=\"delta\"><b class=\"dn\">涉及 52 支</b> · 需退苗</div></div>\n    </div>\n  </section>\n\n  <!-- ④ 趋势 + 货架 -->\n  <section class=\"row4\">\n    <div class=\"card panel\" style=\"position:relative\">\n      <div class=\"hd\"><h3>近 7 日出入库</h3>\n        <div class=\"lg\"><span><i style=\"background:var(--blue)\"></i>上苗</span><span><i style=\"background:var(--teal)\"></i>发苗</span></div>\n        <div class=\"seg\"><span class=\"on\">7 天</span><span>30 天</span></div></div>\n      <svg id=\"trend\"></svg>\n      <div class=\"tt\" id=\"tt\"></div>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"hd\"><h3>货架库存分布</h3><div class=\"seg\"><span class=\"on\">货架 A</span><span>货架 B</span></div></div>\n      <div class=\"shelf-sum\">\n        <div>在用格口<b>15</b></div><div>有货<b>11</b></div><div>待核对<b style=\"color:var(--orange)\">1</b></div><div>未启用<b>11</b></div>\n      </div>\n      <div class=\"shelf\" id=\"shelf\"></div>\n      <div class=\"shelf-lg\"><span><i style=\"background:var(--blue)\"></i>占用比例</span><span><i style=\"background:#f0f3f7\"></i>空</span>\n        <span><i style=\"background:var(--orange)\"></i>待核对</span><span><i style=\"background:repeating-linear-gradient(135deg,#eef1f5 0 3px,#dfe4eb 3px 6px)\"></i>未启用</span></div>\n    </div>\n  </section>\n\n  <div class=\"foot\">演示数据 · 2026-10-22</div>\n</div>\n\n<script>window.SCENE_OPTS = { cam: [3.2, 3.3, 6.6], target: [-0.32, 0.8, 0.05], fov: 30 };</script>\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script src=\"lib/RoundedBoxGeometry.js\"></script>\n<script src=\"scene3d.js\"></script>\n<script>\n(function () {\n  const $ = id => document.getElementById(id);\n  // 时钟\n  const p2 = n => String(n).padStart(2, \"0\");\n  setInterval(() => { const d = new Date(); $(\"clock\").textContent = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())} ${p2(d.getHours())}:${p2(d.getMinutes())}`; }, 1000);\n\n  // 任务步骤(演示: 循环推进, 3D 机械臂同步)\n  const STEPS = [\"取货\", \"回 home\", \"扫码\", \"核验\", \"投放\", \"完成\"];\n  const LABEL = [\"识别吸取\", \"扫码\", \"核验\", \"飞往格口\", \"放置\", \"回位\"];\n  let si = 0, box = 3;\n  function step() {\n    $(\"steps\").innerHTML = LABEL.map((s, i) => `<span class=\"${i < si ? \"done\" : i === si ? \"on\" : \"\"}\">${s}</span>`).join(\"\");\n    if (window.SCENE) SCENE.setStep([1, 2, 3, 0, 0, 5][si]);\n    si++; if (si >= LABEL.length) { si = 0; box = box >= 10 ? 1 : box + 1; $(\"prog\").textContent = `${box} / 10 盒`; $(\"pbar\").style.width = box * 10 + \"%\"; }\n  }\n  step(); setInterval(step, 2400);\n\n  // 快捷访问: 白模等轴插画(统一一套画法, 不同的只是机柜内景和右下角徽标)\n  function ill(kind, badge) {\n    const iso = (x, y) => `${x},${y}`;\n    const inner = {\n      up: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M14 52l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M26 59v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M30 46h10l-3-3M40 46l-3 3\" stroke=\"#1f6fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      down: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M12 54l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M12 54v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 61v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M40 47H29l3-3M29 47l3 3\" stroke=\"#13a89e\" stroke-width=\"2\" fill=\"none\"/>`,\n      shelf: `<g fill=\"#5b95ff\">${[0, 1, 2].map(r => [0, 1, 2].map(c => `<rect x=\"${38 + c * 7}\" y=\"${24 + r * 10}\" width=\"5\" height=\"7\" rx=\"1\" opacity=\"${0.55 + 0.15 * ((r + c) % 3)}\"/>`).join(\"\")).join(\"\")}</g>`,\n      dev: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"30\" rx=\"2\" fill=\"#dbe6f5\"/><path d=\"M44 50v-9l6-5 4 2\" stroke=\"#fff\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"44\" cy=\"50\" r=\"2.5\" fill=\"#fff\"/>`,\n      chart: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"22\" rx=\"2\" fill=\"#dbe6f5\"/><rect x=\"41\" y=\"36\" width=\"3\" height=\"7\" fill=\"#13a89e\"/><rect x=\"46\" y=\"31\" width=\"3\" height=\"12\" fill=\"#1f6fff\"/><rect x=\"51\" y=\"34\" width=\"3\" height=\"9\" fill=\"#13a89e\"/><rect x=\"56\" y=\"28\" width=\"2.5\" height=\"15\" fill=\"#1f6fff\"/>`,\n      trace: `<rect x=\"38\" y=\"26\" width=\"22\" height=\"16\" rx=\"2\" fill=\"#fff\" stroke=\"#c9d3e0\"/>${[0, 2, 3, 5, 7, 8, 10, 12, 13, 15, 17].map(i => `<rect x=\"${40 + i}\" y=\"29\" width=\"${i % 3 ? 1 : 1.6}\" height=\"10\" fill=\"#1f2633\"/>`).join(\"\")}<path d=\"M14 52l10-6 10 6-10 6z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l10 6v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 58v7l10-6v-7z\" fill=\"#5b95ff\"/>`,\n    }[kind];\n    const B = {\n      in: `<path d=\"M84 63v-8M80 59l4 4 4-4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`, out: `<path d=\"M84 55v8M80 59l4-4 4 4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      list: `<path d=\"M80 56h8M80 59h8M80 62h6\" stroke=\"#fff\" stroke-width=\"1.6\"/>`, gear: `<circle cx=\"84\" cy=\"59\" r=\"3\" stroke=\"#fff\" stroke-width=\"1.8\" fill=\"none\"/><path d=\"M84 53v2M84 63v2M78 59h2M88 59h2\" stroke=\"#fff\" stroke-width=\"1.8\"/>`,\n      pie: `<path d=\"M84 59V54a5 5 0 1 1-5 5z\" fill=\"#fff\"/>`, ok: `<path d=\"M80 59l3 3 5-5\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n    }[badge];\n    const col = { in: \"#1f6fff\", out: \"#13a89e\", list: \"#13a89e\", gear: \"#1f6fff\", pie: \"#1f6fff\", ok: \"#13a89e\" }[badge];\n    return `<svg class=\"ill\" viewBox=\"0 0 96 80\">\n      <ellipse cx=\"46\" cy=\"72\" rx=\"36\" ry=\"5\" fill=\"#1f6fff\" opacity=\".07\"/>\n      <path d=\"M32 14l30-6 12 6v52l-12 6-30-6z\" fill=\"#e8edf4\"/>\n      <path d=\"M32 14l30-6v58l-30-6z\" fill=\"#fff\" stroke=\"#d3dbe6\"/>\n      <path d=\"M62 8l12 6v52l-12 6z\" fill=\"#dfe6ef\" stroke=\"#d3dbe6\"/>\n      <path d=\"M36 20l22-4v42l-22-4z\" fill=\"#f4f7fb\" stroke=\"#d3dbe6\"/>\n      <path d=\"M32 62l30 6 12-6\" stroke=\"#13a89e\" stroke-width=\"1.5\" fill=\"none\" opacity=\".7\"/>\n      ${inner}\n      <circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"${col}\"/><circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/>${B}\n    </svg>`;\n  }\n  const Q = [\n    [\"上苗管理\", \"创建任务 · 查看上苗进度\", \"up\", \"in\", \"进行中 1 个任务\"],\n    [\"发苗管理\", \"选择疫苗 · 查看发苗任务\", \"down\", \"out\", \"今日已发 4 支\"],\n    [\"库存管理\", \"库存查询 · 盘点与锁苗\", \"shelf\", \"list\", \"3 批需处理\", true],\n    [\"设备管理\", \"设备信息与运行状态\", \"dev\", \"gear\", \"运行正常\"],\n    [\"统计报表\", \"查看业务数据统计\", \"chart\", \"pie\", \"本周上苗 80 支\"],\n    [\"追溯码对照\", \"查询疫苗追溯信息\", \"trace\", \"ok\", \"已登记 126 码\"],\n  ];\n  $(\"quick\").innerHTML = Q.map(q => `<a class=\"card qc\" href=\"#\">${ill(q[2], q[3])}<div><h4>${q[0]}</h4><p>${q[1]}</p><div class=\"n${q[5] ? \" warn\" : \"\"}\">${q[4]}</div></div><span class=\"arr\">›</span></a>`).join(\"\");\n\n  // 迷你折线\n  function spark(id, data, color) {\n    const el = $(id), w = 92, h = 34, mx = Math.max(...data, 1);\n    const pts = data.map((v, i) => [i * w / (data.length - 1), h - 3 - v / mx * (h - 8)]);\n    const d = pts.map((p, i) => (i ? \"L\" : \"M\") + p[0].toFixed(1) + \" \" + p[1].toFixed(1)).join(\" \");\n    el.setAttribute(\"viewBox\", `0 0 ${w} ${h}`);\n    el.innerHTML = `<defs><linearGradient id=\"g${id}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${color}\" stop-opacity=\".22\"/><stop offset=\"1\" stop-color=\"${color}\" stop-opacity=\"0\"/></linearGradient></defs>\n      <path d=\"${d} L${w} ${h} L0 ${h}Z\" fill=\"url(#g${id})\"/><path d=\"${d}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <circle cx=\"${pts.at(-1)[0] - 1}\" cy=\"${pts.at(-1)[1]}\" r=\"3\" fill=\"${color}\"/>`;\n  }\n  const UP = [0, 0, 0, 0, 2, 54, 22], OUT = [0, 0, 0, 0, 0, 1, 4], STOCK = [0, 0, 0, 0, 2, 38, 52];\n  spark(\"sp1\", UP, \"#1f6fff\"); spark(\"sp2\", OUT, \"#13a89e\"); spark(\"sp3\", STOCK, \"#7a8aa3\");\n\n  // 7 日柱图(上苗/发苗并排, 数值标在柱顶)\n  const DAYS = [\"10-16\", \"10-17\", \"10-18\", \"10-19\", \"10-20\", \"10-21\", \"今天\"];\n  function trend() {\n    const svg = $(\"trend\"), W = svg.clientWidth || 700, H = 260, pl = 34, pr = 8, pt = 18, pb = 30;\n    const mx = Math.ceil(Math.max(...UP, ...OUT) / 10) * 10 || 10, cw = (W - pl - pr) / DAYS.length, bw = Math.min(26, cw * 0.28);\n    const y = v => pt + (H - pt - pb) * (1 - v / mx);\n    let s = \"\";\n    for (let k = 0; k <= 4; k++) { const v = mx * k / 4, yy = y(v); s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${yy}\" y2=\"${yy}\" stroke=\"#eef1f6\"/><text x=\"${pl - 8}\" y=\"${yy + 4}\" font-size=\"11\" fill=\"#98a3b3\" text-anchor=\"end\">${v}</text>`; }\n    DAYS.forEach((d, i) => {\n      const cx = pl + cw * i + cw / 2, today = i === DAYS.length - 1;\n      if (today) s += `<rect x=\"${cx - cw / 2 + 4}\" y=\"${pt - 8}\" width=\"${cw - 8}\" height=\"${H - pt - pb + 8}\" rx=\"8\" fill=\"#f3f7ff\"/>`;\n      [[UP[i], \"#1f6fff\", -bw - 2], [OUT[i], \"#13a89e\", 2]].forEach(([v, c, dx]) => {\n        const h = Math.max(v ? 3 : 1.5, (H - pt - pb) * v / mx);\n        s += `<rect x=\"${cx + dx}\" y=\"${y(0) - h}\" width=\"${bw}\" height=\"${h}\" rx=\"4\" fill=\"${c}\" opacity=\"${v ? 1 : .25}\"><animate attributeName=\"height\" from=\"0\" to=\"${h}\" dur=\".6s\"/><animate attributeName=\"y\" from=\"${y(0)}\" to=\"${y(0) - h}\" dur=\".6s\"/></rect>`;\n        if (v) s += `<text x=\"${cx + dx + bw / 2}\" y=\"${y(0) - h - 6}\" font-size=\"12\" font-weight=\"700\" fill=\"${c}\" text-anchor=\"middle\" font-family=\"DIN Alternate,Bahnschrift,sans-serif\">${v}</text>`;\n      });\n      s += `<text x=\"${cx}\" y=\"${H - 8}\" font-size=\"12\" fill=\"${today ? \"#1f6fff\" : \"#98a3b3\"}\" font-weight=\"${today ? 700 : 400}\" text-anchor=\"middle\">${d}</text>`;\n      s += `<rect class=\"hit\" data-i=\"${i}\" x=\"${cx - cw / 2}\" y=\"${pt}\" width=\"${cw}\" height=\"${H - pt - pb}\" fill=\"transparent\"/>`;\n    });\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n  }\n  trend(); addEventListener(\"resize\", trend);\n  $(\"trend\").addEventListener(\"mousemove\", e => {\n    const h = e.target.closest(\".hit\"), tt = $(\"tt\");\n    if (!h) { tt.style.display = \"none\"; return; }\n    const i = +h.dataset.i, r = e.currentTarget.parentElement.getBoundingClientRect();\n    tt.innerHTML = `<b>${DAYS[i]}</b><br><span style=\"color:#1f6fff\">● 上苗 ${UP[i]} 支</span><br><span style=\"color:#13a89e\">● 发苗 ${OUT[i]} 支</span>`;\n    tt.style.display = \"block\"; tt.style.left = (e.clientX - r.left + 14) + \"px\"; tt.style.top = (e.clientY - r.top - 10) + \"px\";\n  });\n  $(\"trend\").addEventListener(\"mouseleave\", () => $(\"tt\").style.display = \"none\");\n\n  // 货架库存分布(正面缩略: 左右列 × 13 层, 条长 = 占用比例)\n  const EN = new Set([\"L2\", \"L6\", \"R2\", \"R4\", \"R6\", ...[8, 9, 10, 11, 12].flatMap(l => [\"L\" + l, \"R\" + l])]);\n  const OCC = { L10: 0.86, L8: 0.62, L9: 0.4, L11: 0.55, L12: 0.3, R8: 0.48, R9: 0.22, R10: 0.68, R11: 0.36, R12: 0.12, L6: 0.5, R6: 0, R4: 0, L2: 0.25, R2: 0 };\n  let html = `<span></span><span class=\"h\">左列 L</span><span class=\"h\">右列 R</span>`;\n  for (let l = 13; l >= 1; l--) {\n    html += `<span class=\"l\">${l}</span>`;\n    for (const c of [\"L\", \"R\"]) {\n      const k = c + l, en = EN.has(k), bad = k === \"R10\", o = OCC[k] || 0;\n      html += `<div class=\"cell${en ? \"\" : \" off\"}${bad ? \" bad\" : \"\"}\" title=\"A-${k}${en ? ` · 占用 ${Math.round(o * 100)}%${bad ? \" · 盘点待核对\" : \"\"}` : \" · 未启用\"}\">${en ? `<i style=\"width:${o * 100}%\"></i>` : \"\"}</div>`;\n    }\n  }\n  $(\"shelf\").innerHTML = html;\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":819,"cache_read_input_tokens":394758,"output_tokens":15115,"output_tokens_details":{"thinking_tokens":24},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":819,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":15115,"cache_read_input_tokens":394758,"cache_creation_input_tokens":819,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":819},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013yS3JatXqV2Byoi7Y2M1YM":{"file_path":"/Users/chen/Desktop/robocenter/docs/首页改版/index_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>冷链自动发苗机器人</title>\n<!--\n  首页改版效果图(演示数据). 排版顺序: 状态 → 待办 → 入口 → 数据\n  ① 设备卡(3D 白模工作站, 任务进行时机械臂随步骤动) + 待处理(按紧急度)\n  ② 快捷访问 6 卡(保留卡片, 插画统一为白模等轴风格)\n  ③ 今日数据(与昨日对比)  ④ 近 7 日上苗/发苗柱图 + 货架库存分布\n  颜色约定: 主色蓝; 红=过期/故障; 橙=临期/待核对; 黄=提醒; 其余灰蓝\n-->\n<style>\n:root{--bg:#eef2f7;--card:#fff;--ink:#1f2633;--ink2:#5d6b7e;--ink3:#98a3b3;--line:#e3e8ef;\n  --blue:#1f6fff;--blue2:#e8f0ff;--teal:#13a89e;--red:#f04444;--red2:#fdecec;--orange:#f08a24;--orange2:#fef3e6;--yellow:#e5a50a;--yellow2:#fdf6e0;\n  --r:14px;--num:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:linear-gradient(180deg,#f3f6fb 0%,#e9eef6 100%) fixed;background-color:var(--bg);color:var(--ink);\n  font:14px/1.5 -apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}\na{color:inherit;text-decoration:none}\n.num{font-family:var(--num);font-weight:700}\n\n/* 顶栏 */\n.top{position:sticky;top:0;z-index:10;height:60px;display:flex;align-items:center;gap:16px;padding:0 28px;\n  background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border-bottom:1px solid rgba(227,232,239,.8)}\n.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}\n.logo svg{width:30px;height:30px}\n.top .sp{flex:1}\n.pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:14px;font-size:12.5px;color:var(--ink2);background:#f2f5f9}\n.pill.ok{background:#e7f7f3;color:#0b8a7f}\n.pill i{width:7px;height:7px;border-radius:50%;background:currentColor}\n.icon-btn{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:var(--ink2);position:relative;cursor:pointer}\n.icon-btn:hover{background:#f2f5f9}\n.icon-btn svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8}\n.icon-btn b{position:absolute;top:3px;right:3px;min-width:16px;height:16px;border-radius:8px;background:var(--red);color:#fff;font:700 10px/16px var(--num);text-align:center;padding:0 4px}\n.user{display:flex;align-items:center;gap:8px;font-size:13px}\n.user span{width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:700}\n\n.wrap{max-width:1680px;margin:0 auto;padding:22px 28px 40px;display:flex;flex-direction:column;gap:22px}\n.sec-h{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}\n.sec-h h2{font-size:17px;font-weight:700;position:relative}\n.sec-h h2::after{content:\"\";position:absolute;left:0;bottom:-2px;width:100%;height:5px;background:linear-gradient(90deg,rgba(31,111,255,.45),rgba(31,111,255,0));border-radius:3px;z-index:-1}\n.sec-h small{margin-left:auto;font-size:12.5px;color:var(--ink3)}\n.card{background:var(--card);border-radius:var(--r);box-shadow:0 1px 2px rgba(20,40,80,.04),0 6px 24px rgba(20,40,80,.05)}\n\n/* ① 主区 */\n.hero{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.dev{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);overflow:hidden;min-height:340px;position:relative}\n.dev .scene{position:relative;background:radial-gradient(ellipse 70% 60% at 50% 60%,#fff 0%,rgba(255,255,255,0) 70%),linear-gradient(180deg,#f6f8fc,#edf2f8)}\n#stage3d{position:absolute;inset:0}\n#gl{width:100%;height:100%;display:block;cursor:grab}\n.scene .badge{position:absolute;left:16px;top:14px;font-size:12px;color:var(--ink3)}\n.scene .badge b{color:var(--ink2);font-weight:600}\n.dev .info{padding:22px 24px 20px;display:flex;flex-direction:column}\n.dev .k{font-size:12.5px;color:var(--ink3)}\n.state{display:flex;align-items:center;gap:10px;margin:2px 0 4px}\n.state .dot{width:12px;height:12px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(31,111,255,.15);animation:br 1.6s infinite}\n.state.idle .dot{background:var(--teal);box-shadow:0 0 0 5px rgba(19,168,158,.15)}\n@keyframes br{50%{box-shadow:0 0 0 9px rgba(31,111,255,.05)}}\n.state b{font-size:30px;font-weight:700;letter-spacing:.02em}\n.state.idle b{color:var(--teal)}\n.task{margin-top:8px;padding:12px 14px;border-radius:10px;background:#f5f8fc}\n.task .t1{display:flex;justify-content:space-between;font-size:13px}\n.task .t1 b{font-weight:600}\n.task .t1 span{color:var(--ink3)}\n.bar{height:6px;border-radius:3px;background:#e3e9f2;margin:9px 0 7px;overflow:hidden}\n.bar i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,#4d8dff,var(--blue));transition:width .6s}\n.steps{display:flex;gap:4px;font-size:11.5px;color:var(--ink3);flex-wrap:wrap}\n.steps span{padding:1px 7px;border-radius:9px}\n.steps span.on{background:var(--blue);color:#fff}\n.steps span.done{color:var(--blue)}\n.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0 auto}\n.facts div{font-size:12px;color:var(--ink3)}\n.facts b{display:block;font-size:14px;color:var(--ink);font-weight:600;margin-top:1px}\n.facts b.g{color:var(--teal)}\n.acts{display:flex;gap:10px;margin-top:18px}\n.btn{height:42px;padding:0 18px;border-radius:10px;border:1px solid var(--line);background:#fff;font:inherit;font-size:14.5px;font-weight:600;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;gap:7px;justify-content:center}\n.btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2}\n.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff;flex:1}\n.btn.sec{flex:1;color:var(--blue);border-color:#c9dbff;background:var(--blue2)}\n.btn:hover{filter:brightness(.97)}\n.meta{font-size:11.5px;color:var(--ink3);margin-top:12px;display:flex;justify-content:space-between}\n.meta a{color:var(--blue)}\n\n.todo{padding:20px 22px;display:flex;flex-direction:column}\n.todo .hd{display:flex;align-items:center;gap:10px;margin-bottom:12px}\n.todo .hd h3{font-size:16px}\n.todo .hd .cnt{min-width:22px;height:22px;border-radius:11px;background:var(--red);color:#fff;font:700 12px/22px var(--num);text-align:center;padding:0 7px}\n.todo .hd small{margin-left:auto;color:var(--ink3);font-size:12px}\n.chips{display:flex;gap:6px;margin-bottom:10px}\n.chips span{font-size:12px;padding:2px 10px;border-radius:12px;background:#f2f5f9;color:var(--ink2);cursor:pointer}\n.chips span.on{background:var(--ink);color:#fff}\n.item{display:flex;gap:12px;padding:12px 4px;border-top:1px solid var(--line);align-items:flex-start}\n.item:first-of-type{border-top:0}\n.lv{flex:none;width:36px;height:36px;border-radius:10px;display:grid;place-items:center}\n.lv svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:2}\n.lv.red{background:var(--red2);color:var(--red)}.lv.orange{background:var(--orange2);color:var(--orange)}.lv.yellow{background:var(--yellow2);color:var(--yellow)}\n.item .c{flex:1;min-width:0}\n.item .t{font-weight:600;font-size:14px;display:flex;gap:8px;align-items:center}\n.tag{font-size:11px;font-weight:600;padding:0 6px;border-radius:4px;line-height:18px}\n.tag.red{background:var(--red2);color:var(--red)}.tag.orange{background:var(--orange2);color:var(--orange)}.tag.yellow{background:var(--yellow2);color:#b98200}\n.item .d{font-size:12.5px;color:var(--ink2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.item .go{flex:none;font-size:12.5px;color:var(--blue);border:1px solid #c9dbff;border-radius:8px;padding:4px 10px;align-self:center;white-space:nowrap}\n.item .go:hover{background:var(--blue2)}\n.todo .more{margin-top:auto;padding-top:10px;font-size:12.5px;color:var(--blue);text-align:center}\n\n/* ② 快捷访问 */\n.quick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}\n.qc{display:flex;align-items:center;gap:18px;padding:18px 22px;min-height:118px;transition:transform .18s,box-shadow .18s;position:relative;overflow:hidden}\n.qc::before{content:\"\";position:absolute;right:-40px;top:-40px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(31,111,255,.06),rgba(31,111,255,0) 70%)}\n.qc:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(20,40,80,.05),0 14px 32px rgba(20,40,80,.09)}\n.qc svg.ill{width:96px;height:80px;flex:none}\n.qc h4{font-size:18px;font-weight:700}\n.qc p{font-size:13px;color:var(--ink3);margin-top:3px}\n.qc .n{font-size:12px;color:var(--blue);margin-top:6px;font-weight:600}\n.qc .n.warn{color:var(--red)}\n.qc .arr{margin-left:auto;color:#c2cad6;font-size:20px;transition:transform .18s}\n.qc:hover .arr{transform:translateX(3px);color:var(--blue)}\n\n/* ③ 今日数据 */\n.kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px}\n.kpi{padding:16px 20px 12px;position:relative}\n.kpi .k{font-size:13px;color:var(--ink2);display:flex;align-items:center;gap:6px}\n.kpi .k small{color:var(--ink3);font-size:11.5px}\n.kpi .v{display:flex;align-items:baseline;gap:5px;margin-top:4px}\n.kpi .v b{font:700 34px/1.1 var(--num)}\n.kpi .v span{font-size:13px;color:var(--ink3)}\n.kpi .delta{font-size:12px;margin-top:2px;color:var(--ink3)}\n.kpi .delta b{font-weight:600}\n.kpi .delta .up{color:var(--teal)}.kpi .delta .dn{color:var(--red)}\n.kpi svg.sp{position:absolute;right:16px;bottom:14px;width:92px;height:34px}\n.ring{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:56px;height:56px}\n\n/* ④ 趋势 + 货架 */\n.row4{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.panel{padding:18px 22px}\n.panel .hd{display:flex;align-items:center;gap:12px;margin-bottom:6px}\n.panel .hd h3{font-size:16px}\n.panel .hd .lg{display:flex;gap:14px;font-size:12px;color:var(--ink2);margin-left:8px}\n.panel .hd .lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.seg{margin-left:auto;display:flex;background:#f2f5f9;border-radius:8px;padding:2px}\n.seg span{font-size:12px;padding:3px 12px;border-radius:6px;color:var(--ink2);cursor:pointer}\n.seg span.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(20,40,80,.1)}\n#trend{width:100%;height:260px;display:block}\n.tt{position:absolute;pointer-events:none;background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(20,40,80,.12);display:none;white-space:nowrap}\n.shelf{display:grid;grid-template-columns:auto 1fr 1fr;gap:3px 6px;margin-top:8px;font-size:11px;color:var(--ink3)}\n.shelf .h{text-align:center;font-weight:600;color:var(--ink2);font-size:12px}\n.shelf .l{text-align:right;padding-right:2px;font-family:var(--num);line-height:16px}\n.cell{height:16px;border-radius:3px;background:#f0f3f7;position:relative;overflow:hidden;cursor:pointer;border:1px solid transparent}\n.cell i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,#6aa2ff,var(--blue));border-radius:2px}\n.cell.off{background:repeating-linear-gradient(135deg,#eef1f5 0 4px,#e5e9ef 4px 8px)}\n.cell.bad{border-color:var(--orange);background:var(--orange2)}\n.cell.bad i{background:linear-gradient(90deg,#ffb36b,var(--orange))}\n.cell:hover{outline:2px solid rgba(31,111,255,.35)}\n.shelf-lg{display:flex;gap:12px;font-size:11.5px;color:var(--ink2);margin-top:10px;flex-wrap:wrap}\n.shelf-lg i{display:inline-block;width:12px;height:8px;border-radius:2px;margin-right:4px}\n.shelf-sum{display:flex;gap:18px;margin-top:4px}\n.shelf-sum div{font-size:12px;color:var(--ink3)}\n.shelf-sum b{display:block;font:700 20px var(--num);color:var(--ink)}\n.foot{text-align:center;font-size:12px;color:var(--ink3)}\n\n@media (max-width:1180px){\n  .hero,.row4{grid-template-columns:1fr}\n  .kpis{grid-template-columns:repeat(3,1fr)}\n  .quick{grid-template-columns:repeat(2,1fr)}\n}\n@media (max-width:720px){\n  .wrap{padding:16px}\n  .top{padding:0 16px}.top .pill,.user b{display:none}\n  .dev{grid-template-columns:1fr}.dev .scene{height:240px}\n  .quick{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}\n}\n</style>\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 40 40\"><path d=\"M6 26l14-16 4 4-14 16z\" fill=\"#f5a623\"/><path d=\"M16 30L32 8l3 3-16 22z\" fill=\"#1f6fff\"/><path d=\"M12 32h22\" stroke=\"#1f6fff\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n    冷链自动发苗机器人\n  </div>\n  <div class=\"sp\"></div>\n  <span class=\"pill\" id=\"clock\">2026-10-22 14:46</span>\n  <span class=\"pill ok\"><i></i>设备在线</span>\n  <div class=\"icon-btn\" title=\"消息\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0\"/></svg><b>4</b></div>\n  <div class=\"user\"><span>王</span><b>王医生</b></div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- ① 状态 + 待办 -->\n  <section class=\"hero\">\n    <div class=\"card dev\">\n      <div class=\"scene\">\n        <main id=\"stage3d\"><canvas id=\"gl\"></canvas></main>\n        <div class=\"badge\">工作站 <b>GCR10 · 货架 A</b></div>\n      </div>\n      <div class=\"info\">\n        <div class=\"k\">设备状态</div>\n        <div class=\"state\" id=\"state\"><span class=\"dot\"></span><b id=\"stTxt\">运行中</b></div>\n        <div class=\"k\" id=\"stSub\">正在执行上苗任务</div>\n        <div class=\"task\" id=\"task\">\n          <div class=\"t1\"><b>上苗 #116 · 自动送料</b><span id=\"prog\">3 / 10 盒</span></div>\n          <div class=\"bar\"><i id=\"pbar\" style=\"width:30%\"></i></div>\n          <div class=\"steps\" id=\"steps\"></div>\n        </div>\n        <div class=\"facts\">\n          <div>通信<b class=\"g\">已连接</b></div>\n          <div>使能<b>已使能</b></div>\n          <div>急停<b>未触发</b></div>\n        </div>\n        <div class=\"acts\">\n          <button class=\"btn pri\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg>上苗</button>\n          <button class=\"btn sec\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12l7 7 7-7\"/></svg>发苗</button>\n          <button class=\"btn\" title=\"盘点\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 12h6M9 16h4\"/></svg>盘点</button>\n        </div>\n        <div class=\"meta\"><span>最近检测 14:46:48 · 192.168.100.190:8902</span><a href=\"#\">设备看板 ›</a></div>\n      </div>\n    </div>\n\n    <div class=\"card todo\">\n      <div class=\"hd\"><h3>待处理</h3><span class=\"cnt\">4</span><small>按紧急程度排序</small></div>\n      <div class=\"chips\"><span class=\"on\">全部 4</span><span>库存 3</span><span>盘点 1</span><span>设备 0</span></div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">Sabin株脊髓灰质炎灭活疫苗 <span class=\"tag red\">已过期 84 天</span></div>\n          <div class=\"d\">批号 C202407009 · 4 支 · A-L10 x=-141.7</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 49 天</span></div>\n          <div class=\"d\">批号 202503015 · 7 支 · A-L10 x=-37.2</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 2 天</span></div>\n          <div class=\"d\">批号 202504034 · 41 支 · A-L10 / A-R10</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv orange\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 13l2 2 4-4\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">A-R10 盘点不符 <span class=\"tag orange\">待核对</span></div>\n          <div class=\"d\">10-21 15:36 盘点 · 账上 19 支, 实测少 1 支</div></div>\n        <a class=\"go\" href=\"#\">核对</a>\n      </div>\n      <a class=\"more\" href=\"#\">查看全部提醒 ›</a>\n    </div>\n  </section>\n\n  <!-- ② 快捷访问 -->\n  <section>\n    <div class=\"sec-h\"><h2>快捷访问</h2><small>点击卡片进入</small></div>\n    <div class=\"quick\" id=\"quick\"></div>\n  </section>\n\n  <!-- ③ 今日数据 -->\n  <section>\n    <div class=\"sec-h\"><h2>今日数据</h2><small>数量单位：支 · 对比昨日同期</small></div>\n    <div class=\"kpis\">\n      <div class=\"card kpi\"><div class=\"k\">今日上苗</div><div class=\"v\"><b class=\"num\">22</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 18</b> 比昨日</div><svg class=\"sp\" id=\"sp1\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">今日发苗</div><div class=\"v\"><b class=\"num\">4</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 3</b> 比昨日</div><svg class=\"sp\" id=\"sp2\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">当前库存</div><div class=\"v\"><b class=\"num\">52</b><span>支</span></div>\n        <div class=\"delta\">3 个品种 · 4 个批号</div><svg class=\"sp\" id=\"sp3\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">格口占用 <small>货架 A</small></div><div class=\"v\"><b class=\"num\">38</b><span>%</span></div>\n        <div class=\"delta\">在用 15 格口 · 空 4</div>\n        <svg class=\"ring\" viewBox=\"0 0 56 56\"><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#eaf0f7\" stroke-width=\"7\"/><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#1f6fff\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"52.5 138.2\" transform=\"rotate(-90 28 28)\"/></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">过期 / 临期 <small>批次</small></div><div class=\"v\"><b class=\"num\" style=\"color:var(--red)\">3</b><span>/ 0</span></div>\n        <div class=\"delta\"><b class=\"dn\">涉及 52 支</b> · 需退苗</div></div>\n    </div>\n  </section>\n\n  <!-- ④ 趋势 + 货架 -->\n  <section class=\"row4\">\n    <div class=\"card panel\" style=\"position:relative\">\n      <div class=\"hd\"><h3>近 7 日出入库</h3>\n        <div class=\"lg\"><span><i style=\"background:var(--blue)\"></i>上苗</span><span><i style=\"background:var(--teal)\"></i>发苗</span></div>\n        <div class=\"seg\"><span class=\"on\">7 天</span><span>30 天</span></div></div>\n      <svg id=\"trend\"></svg>\n      <div class=\"tt\" id=\"tt\"></div>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"hd\"><h3>货架库存分布</h3><div class=\"seg\"><span class=\"on\">货架 A</span><span>货架 B</span></div></div>\n      <div class=\"shelf-sum\">\n        <div>在用格口<b>15</b></div><div>有货<b>11</b></div><div>待核对<b style=\"color:var(--orange)\">1</b></div><div>未启用<b>11</b></div>\n      </div>\n      <div class=\"shelf\" id=\"shelf\"></div>\n      <div class=\"shelf-lg\"><span><i style=\"background:var(--blue)\"></i>占用比例</span><span><i style=\"background:#f0f3f7\"></i>空</span>\n        <span><i style=\"background:var(--orange)\"></i>待核对</span><span><i style=\"background:repeating-linear-gradient(135deg,#eef1f5 0 3px,#dfe4eb 3px 6px)\"></i>未启用</span></div>\n    </div>\n  </section>\n\n  <div class=\"foot\">演示数据 · 2026-10-22</div>\n</div>\n\n<script>window.SCENE_OPTS = { cam: [3.2, 3.3, 6.6], target: [-0.32, 0.8, 0.05], fov: 30 };</script>\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script src=\"lib/RoundedBoxGeometry.js\"></script>\n<script src=\"scene3d.js\"></script>\n<script>\n(function () {\n  const $ = id => document.getElementById(id);\n  // 时钟\n  const p2 = n => String(n).padStart(2, \"0\");\n  setInterval(() => { const d = new Date(); $(\"clock\").textContent = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())} ${p2(d.getHours())}:${p2(d.getMinutes())}`; }, 1000);\n\n  // 任务步骤(演示: 循环推进, 3D 机械臂同步)\n  const STEPS = [\"取货\", \"回 home\", \"扫码\", \"核验\", \"投放\", \"完成\"];\n  const LABEL = [\"识别吸取\", \"扫码\", \"核验\", \"飞往格口\", \"放置\", \"回位\"];\n  let si = 0, box = 3;\n  function step() {\n    $(\"steps\").innerHTML = LABEL.map((s, i) => `<span class=\"${i < si ? \"done\" : i === si ? \"on\" : \"\"}\">${s}</span>`).join(\"\");\n    if (window.SCENE) SCENE.setStep([1, 2, 3, 0, 0, 5][si]);\n    si++; if (si >= LABEL.length) { si = 0; box = box >= 10 ? 1 : box + 1; $(\"prog\").textContent = `${box} / 10 盒`; $(\"pbar\").style.width = box * 10 + \"%\"; }\n  }\n  step(); setInterval(step, 2400);\n\n  // 快捷访问: 白模等轴插画(统一一套画法, 不同的只是机柜内景和右下角徽标)\n  function ill(kind, badge) {\n    const iso = (x, y) => `${x},${y}`;\n    const inner = {\n      up: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M14 52l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M26 59v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M30 46h10l-3-3M40 46l-3 3\" stroke=\"#1f6fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      down: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M12 54l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M12 54v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 61v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M40 47H29l3-3M29 47l3 3\" stroke=\"#13a89e\" stroke-width=\"2\" fill=\"none\"/>`,\n      shelf: `<g fill=\"#5b95ff\">${[0, 1, 2].map(r => [0, 1, 2].map(c => `<rect x=\"${38 + c * 7}\" y=\"${24 + r * 10}\" width=\"5\" height=\"7\" rx=\"1\" opacity=\"${0.55 + 0.15 * ((r + c) % 3)}\"/>`).join(\"\")).join(\"\")}</g>`,\n      dev: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"30\" rx=\"2\" fill=\"#dbe6f5\"/><path d=\"M44 50v-9l6-5 4 2\" stroke=\"#fff\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"44\" cy=\"50\" r=\"2.5\" fill=\"#fff\"/>`,\n      chart: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"22\" rx=\"2\" fill=\"#dbe6f5\"/><rect x=\"41\" y=\"36\" width=\"3\" height=\"7\" fill=\"#13a89e\"/><rect x=\"46\" y=\"31\" width=\"3\" height=\"12\" fill=\"#1f6fff\"/><rect x=\"51\" y=\"34\" width=\"3\" height=\"9\" fill=\"#13a89e\"/><rect x=\"56\" y=\"28\" width=\"2.5\" height=\"15\" fill=\"#1f6fff\"/>`,\n      trace: `<rect x=\"38\" y=\"26\" width=\"22\" height=\"16\" rx=\"2\" fill=\"#fff\" stroke=\"#c9d3e0\"/>${[0, 2, 3, 5, 7, 8, 10, 12, 13, 15, 17].map(i => `<rect x=\"${40 + i}\" y=\"29\" width=\"${i % 3 ? 1 : 1.6}\" height=\"10\" fill=\"#1f2633\"/>`).join(\"\")}<path d=\"M14 52l10-6 10 6-10 6z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l10 6v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 58v7l10-6v-7z\" fill=\"#5b95ff\"/>`,\n    }[kind];\n    const B = {\n      in: `<path d=\"M84 63v-8M80 59l4 4 4-4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`, out: `<path d=\"M84 55v8M80 59l4-4 4 4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      list: `<path d=\"M80 56h8M80 59h8M80 62h6\" stroke=\"#fff\" stroke-width=\"1.6\"/>`, gear: `<circle cx=\"84\" cy=\"59\" r=\"3\" stroke=\"#fff\" stroke-width=\"1.8\" fill=\"none\"/><path d=\"M84 53v2M84 63v2M78 59h2M88 59h2\" stroke=\"#fff\" stroke-width=\"1.8\"/>`,\n      pie: `<path d=\"M84 59V54a5 5 0 1 1-5 5z\" fill=\"#fff\"/>`, ok: `<path d=\"M80 59l3 3 5-5\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n    }[badge];\n    const col = { in: \"#1f6fff\", out: \"#13a89e\", list: \"#13a89e\", gear: \"#1f6fff\", pie: \"#1f6fff\", ok: \"#13a89e\" }[badge];\n    return `<svg class=\"ill\" viewBox=\"0 0 96 80\">\n      <ellipse cx=\"46\" cy=\"72\" rx=\"36\" ry=\"5\" fill=\"#1f6fff\" opacity=\".07\"/>\n      <path d=\"M32 14l30-6 12 6v52l-12 6-30-6z\" fill=\"#e8edf4\"/>\n      <path d=\"M32 14l30-6v58l-30-6z\" fill=\"#fff\" stroke=\"#d3dbe6\"/>\n      <path d=\"M62 8l12 6v52l-12 6z\" fill=\"#dfe6ef\" stroke=\"#d3dbe6\"/>\n      <path d=\"M36 20l22-4v42l-22-4z\" fill=\"#f4f7fb\" stroke=\"#d3dbe6\"/>\n      <path d=\"M32 62l30 6 12-6\" stroke=\"#13a89e\" stroke-width=\"1.5\" fill=\"none\" opacity=\".7\"/>\n      ${inner}\n      <circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"${col}\"/><circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/>${B}\n    </svg>`;\n  }\n  const Q = [\n    [\"上苗管理\", \"创建任务 · 查看上苗进度\", \"up\", \"in\", \"进行中 1 个任务\"],\n    [\"发苗管理\", \"选择疫苗 · 查看发苗任务\", \"down\", \"out\", \"今日已发 4 支\"],\n    [\"库存管理\", \"库存查询 · 盘点与锁苗\", \"shelf\", \"list\", \"3 批需处理\", true],\n    [\"设备管理\", \"设备信息与运行状态\", \"dev\", \"gear\", \"运行正常\"],\n    [\"统计报表\", \"查看业务数据统计\", \"chart\", \"pie\", \"本周上苗 80 支\"],\n    [\"追溯码对照\", \"查询疫苗追溯信息\", \"trace\", \"ok\", \"已登记 126 码\"],\n  ];\n  $(\"quick\").innerHTML = Q.map(q => `<a class=\"card qc\" href=\"#\">${ill(q[2], q[3])}<div><h4>${q[0]}</h4><p>${q[1]}</p><div class=\"n${q[5] ? \" warn\" : \"\"}\">${q[4]}</div></div><span class=\"arr\">›</span></a>`).join(\"\");\n\n  // 迷你折线\n  function spark(id, data, color) {\n    const el = $(id), w = 92, h = 34, mx = Math.max(...data, 1);\n    const pts = data.map((v, i) => [i * w / (data.length - 1), h - 3 - v / mx * (h - 8)]);\n    const d = pts.map((p, i) => (i ? \"L\" : \"M\") + p[0].toFixed(1) + \" \" + p[1].toFixed(1)).join(\" \");\n    el.setAttribute(\"viewBox\", `0 0 ${w} ${h}`);\n    el.innerHTML = `<defs><linearGradient id=\"g${id}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${color}\" stop-opacity=\".22\"/><stop offset=\"1\" stop-color=\"${color}\" stop-opacity=\"0\"/></linearGradient></defs>\n      <path d=\"${d} L${w} ${h} L0 ${h}Z\" fill=\"url(#g${id})\"/><path d=\"${d}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <circle cx=\"${pts.at(-1)[0] - 1}\" cy=\"${pts.at(-1)[1]}\" r=\"3\" fill=\"${color}\"/>`;\n  }\n  const UP = [0, 0, 0, 0, 2, 54, 22], OUT = [0, 0, 0, 0, 0, 1, 4], STOCK = [0, 0, 0, 0, 2, 38, 52];\n  spark(\"sp1\", UP, \"#1f6fff\"); spark(\"sp2\", OUT, \"#13a89e\"); spark(\"sp3\", STOCK, \"#7a8aa3\");\n\n  // 7 日柱图(上苗/发苗并排, 数值标在柱顶)\n  const DAYS = [\"10-16\", \"10-17\", \"10-18\", \"10-19\", \"10-20\", \"10-21\", \"今天\"];\n  function trend() {\n    const svg = $(\"trend\"), W = svg.clientWidth || 700, H = 260, pl = 34, pr = 8, pt = 18, pb = 30;\n    const mx = Math.ceil(Math.max(...UP, ...OUT) / 10) * 10 || 10, cw = (W - pl - pr) / DAYS.length, bw = Math.min(26, cw * 0.28);\n    const y = v => pt + (H - pt - pb) * (1 - v / mx);\n    let s = \"\";\n    for (let k = 0; k <= 4; k++) { const v = mx * k / 4, yy = y(v); s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${yy}\" y2=\"${yy}\" stroke=\"#eef1f6\"/><text x=\"${pl - 8}\" y=\"${yy + 4}\" font-size=\"11\" fill=\"#98a3b3\" text-anchor=\"end\">${v}</text>`; }\n    DAYS.forEach((d, i) => {\n      const cx = pl + cw * i + cw / 2, today = i === DAYS.length - 1;\n      if (today) s += `<rect x=\"${cx - cw / 2 + 4}\" y=\"${pt - 8}\" width=\"${cw - 8}\" height=\"${H - pt - pb + 8}\" rx=\"8\" fill=\"#f3f7ff\"/>`;\n      [[UP[i], \"#1f6fff\", -bw - 2], [OUT[i], \"#13a89e\", 2]].forEach(([v, c, dx]) => {\n        const h = Math.max(v ? 3 : 1.5, (H - pt - pb) * v / mx);\n        s += `<rect x=\"${cx + dx}\" y=\"${y(0) - h}\" width=\"${bw}\" height=\"${h}\" rx=\"4\" fill=\"${c}\" opacity=\"${v ? 1 : .25}\"><animate attributeName=\"height\" from=\"0\" to=\"${h}\" dur=\".6s\"/><animate attributeName=\"y\" from=\"${y(0)}\" to=\"${y(0) - h}\" dur=\".6s\"/></rect>`;\n        if (v) s += `<text x=\"${cx + dx + bw / 2}\" y=\"${y(0) - h - 6}\" font-size=\"12\" font-weight=\"700\" fill=\"${c}\" text-anchor=\"middle\" font-family=\"DIN Alternate,Bahnschrift,sans-serif\">${v}</text>`;\n      });\n      s += `<text x=\"${cx}\" y=\"${H - 8}\" font-size=\"12\" fill=\"${today ? \"#1f6fff\" : \"#98a3b3\"}\" font-weight=\"${today ? 700 : 400}\" text-anchor=\"middle\">${d}</text>`;\n      s += `<rect class=\"hit\" data-i=\"${i}\" x=\"${cx - cw / 2}\" y=\"${pt}\" width=\"${cw}\" height=\"${H - pt - pb}\" fill=\"transparent\"/>`;\n    });\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n  }\n  trend(); addEventListener(\"resize\", trend);\n  $(\"trend\").addEventListener(\"mousemove\", e => {\n    const h = e.target.closest(\".hit\"), tt = $(\"tt\");\n    if (!h) { tt.style.display = \"none\"; return; }\n    const i = +h.dataset.i, r = e.currentTarget.parentElement.getBoundingClientRect();\n    tt.innerHTML = `<b>${DAYS[i]}</b><br><span style=\"color:#1f6fff\">● 上苗 ${UP[i]} 支</span><br><span style=\"color:#13a89e\">● 发苗 ${OUT[i]} 支</span>`;\n    tt.style.display = \"block\"; tt.style.left = (e.clientX - r.left + 14) + \"px\"; tt.style.top = (e.clientY - r.top - 10) + \"px\";\n  });\n  $(\"trend\").addEventListener(\"mouseleave\", () => $(\"tt\").style.display = \"none\");\n\n  // 货架库存分布(正面缩略: 左右列 × 13 层, 条长 = 占用比例)\n  const EN = new Set([\"L2\", \"L6\", \"R2\", \"R4\", \"R6\", ...[8, 9, 10, 11, 12].flatMap(l => [\"L\" + l, \"R\" + l])]);\n  const OCC = { L10: 0.86, L8: 0.62, L9: 0.4, L11: 0.55, L12: 0.3, R8: 0.48, R9: 0.22, R10: 0.68, R11: 0.36, R12: 0.12, L6: 0.5, R6: 0, R4: 0, L2: 0.25, R2: 0 };\n  let html = `<span></span><span class=\"h\">左列 L</span><span class=\"h\">右列 R</span>`;\n  for (let l = 13; l >= 1; l--) {\n    html += `<span class=\"l\">${l}</span>`;\n    for (const c of [\"L\", \"R\"]) {\n      const k = c + l, en = EN.has(k), bad = k === \"R10\", o = OCC[k] || 0;\n      html += `<div class=\"cell${en ? \"\" : \" off\"}${bad ? \" bad\" : \"\"}\" title=\"A-${k}${en ? ` · 占用 ${Math.round(o * 100)}%${bad ? \" · 盘点待核对\" : \"\"}` : \" · 未启用\"}\">${en ? `<i style=\"width:${o * 100}%\"></i>` : \"\"}</div>`;\n    }\n  }\n  $(\"shelf\").innerHTML = html;\n})();\n</script>\n</body>\n</html>\n"}},"serverClassifierRequest":"c5be68cb-8836-4b49-8038-ee346a3517b2","apiBlockIndex":1,"requestId":"req_011CgGq4w4Djbgc6ftbMh8u3","requestRef":"2738077a-5f00-4d04-a844-382117ac23d9","requestedModel":"claude-opus-5-5[1m]","type":"assistant","uuid":"e5cc4daf-cc8c-480d-959e-c8da561c23a3","timestamp":"2026-10-22T06:51:07.810Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"e5cc4daf-cc8c-480d-959e-c8da561c23a3","isSidechain":false,"promptId":"ec41321f-790d-46be-ae90-dbc8d2f98928","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013yS3JatXqV2Byoi7Y2M1YM","type":"tool_result","content":"File created successfully at: /Users/chen/Desktop/robocenter/docs/首页改版/index_src.html (file state is current in your context — no need to Read it back)"}]},"uuid":"34a6d7ff-47bf-4e1d-b26e-c83cb0ee1d3f","timestamp":"2026-10-22T06:51:07.934Z","toolUseResult":{"type":"create","filePath":"/Users/chen/Desktop/robocenter/docs/首页改版/index_src.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>冷链自动发苗机器人</title>\n<!--\n  首页改版效果图(演示数据). 排版顺序: 状态 → 待办 → 入口 → 数据\n  ① 设备卡(3D 白模工作站, 任务进行时机械臂随步骤动) + 待处理(按紧急度)\n  ② 快捷访问 6 卡(保留卡片, 插画统一为白模等轴风格)\n  ③ 今日数据(与昨日对比)  ④ 近 7 日上苗/发苗柱图 + 货架库存分布\n  颜色约定: 主色蓝; 红=过期/故障; 橙=临期/待核对; 黄=提醒; 其余灰蓝\n-->\n<style>\n:root{--bg:#eef2f7;--card:#fff;--ink:#1f2633;--ink2:#5d6b7e;--ink3:#98a3b3;--line:#e3e8ef;\n  --blue:#1f6fff;--blue2:#e8f0ff;--teal:#13a89e;--red:#f04444;--red2:#fdecec;--orange:#f08a24;--orange2:#fef3e6;--yellow:#e5a50a;--yellow2:#fdf6e0;\n  --r:14px;--num:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:linear-gradient(180deg,#f3f6fb 0%,#e9eef6 100%) fixed;background-color:var(--bg);color:var(--ink);\n  font:14px/1.5 -apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}\na{color:inherit;text-decoration:none}\n.num{font-family:var(--num);font-weight:700}\n\n/* 顶栏 */\n.top{position:sticky;top:0;z-index:10;height:60px;display:flex;align-items:center;gap:16px;padding:0 28px;\n  background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border-bottom:1px solid rgba(227,232,239,.8)}\n.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}\n.logo svg{width:30px;height:30px}\n.top .sp{flex:1}\n.pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:14px;font-size:12.5px;color:var(--ink2);background:#f2f5f9}\n.pill.ok{background:#e7f7f3;color:#0b8a7f}\n.pill i{width:7px;height:7px;border-radius:50%;background:currentColor}\n.icon-btn{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:var(--ink2);position:relative;cursor:pointer}\n.icon-btn:hover{background:#f2f5f9}\n.icon-btn svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8}\n.icon-btn b{position:absolute;top:3px;right:3px;min-width:16px;height:16px;border-radius:8px;background:var(--red);color:#fff;font:700 10px/16px var(--num);text-align:center;padding:0 4px}\n.user{display:flex;align-items:center;gap:8px;font-size:13px}\n.user span{width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-weight:700}\n\n.wrap{max-width:1680px;margin:0 auto;padding:22px 28px 40px;display:flex;flex-direction:column;gap:22px}\n.sec-h{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}\n.sec-h h2{font-size:17px;font-weight:700;position:relative}\n.sec-h h2::after{content:\"\";position:absolute;left:0;bottom:-2px;width:100%;height:5px;background:linear-gradient(90deg,rgba(31,111,255,.45),rgba(31,111,255,0));border-radius:3px;z-index:-1}\n.sec-h small{margin-left:auto;font-size:12.5px;color:var(--ink3)}\n.card{background:var(--card);border-radius:var(--r);box-shadow:0 1px 2px rgba(20,40,80,.04),0 6px 24px rgba(20,40,80,.05)}\n\n/* ① 主区 */\n.hero{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.dev{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);overflow:hidden;min-height:340px;position:relative}\n.dev .scene{position:relative;background:radial-gradient(ellipse 70% 60% at 50% 60%,#fff 0%,rgba(255,255,255,0) 70%),linear-gradient(180deg,#f6f8fc,#edf2f8)}\n#stage3d{position:absolute;inset:0}\n#gl{width:100%;height:100%;display:block;cursor:grab}\n.scene .badge{position:absolute;left:16px;top:14px;font-size:12px;color:var(--ink3)}\n.scene .badge b{color:var(--ink2);font-weight:600}\n.dev .info{padding:22px 24px 20px;display:flex;flex-direction:column}\n.dev .k{font-size:12.5px;color:var(--ink3)}\n.state{display:flex;align-items:center;gap:10px;margin:2px 0 4px}\n.state .dot{width:12px;height:12px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(31,111,255,.15);animation:br 1.6s infinite}\n.state.idle .dot{background:var(--teal);box-shadow:0 0 0 5px rgba(19,168,158,.15)}\n@keyframes br{50%{box-shadow:0 0 0 9px rgba(31,111,255,.05)}}\n.state b{font-size:30px;font-weight:700;letter-spacing:.02em}\n.state.idle b{color:var(--teal)}\n.task{margin-top:8px;padding:12px 14px;border-radius:10px;background:#f5f8fc}\n.task .t1{display:flex;justify-content:space-between;font-size:13px}\n.task .t1 b{font-weight:600}\n.task .t1 span{color:var(--ink3)}\n.bar{height:6px;border-radius:3px;background:#e3e9f2;margin:9px 0 7px;overflow:hidden}\n.bar i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,#4d8dff,var(--blue));transition:width .6s}\n.steps{display:flex;gap:4px;font-size:11.5px;color:var(--ink3);flex-wrap:wrap}\n.steps span{padding:1px 7px;border-radius:9px}\n.steps span.on{background:var(--blue);color:#fff}\n.steps span.done{color:var(--blue)}\n.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0 auto}\n.facts div{font-size:12px;color:var(--ink3)}\n.facts b{display:block;font-size:14px;color:var(--ink);font-weight:600;margin-top:1px}\n.facts b.g{color:var(--teal)}\n.acts{display:flex;gap:10px;margin-top:18px}\n.btn{height:42px;padding:0 18px;border-radius:10px;border:1px solid var(--line);background:#fff;font:inherit;font-size:14.5px;font-weight:600;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;gap:7px;justify-content:center}\n.btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2}\n.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff;flex:1}\n.btn.sec{flex:1;color:var(--blue);border-color:#c9dbff;background:var(--blue2)}\n.btn:hover{filter:brightness(.97)}\n.meta{font-size:11.5px;color:var(--ink3);margin-top:12px;display:flex;justify-content:space-between}\n.meta a{color:var(--blue)}\n\n.todo{padding:20px 22px;display:flex;flex-direction:column}\n.todo .hd{display:flex;align-items:center;gap:10px;margin-bottom:12px}\n.todo .hd h3{font-size:16px}\n.todo .hd .cnt{min-width:22px;height:22px;border-radius:11px;background:var(--red);color:#fff;font:700 12px/22px var(--num);text-align:center;padding:0 7px}\n.todo .hd small{margin-left:auto;color:var(--ink3);font-size:12px}\n.chips{display:flex;gap:6px;margin-bottom:10px}\n.chips span{font-size:12px;padding:2px 10px;border-radius:12px;background:#f2f5f9;color:var(--ink2);cursor:pointer}\n.chips span.on{background:var(--ink);color:#fff}\n.item{display:flex;gap:12px;padding:12px 4px;border-top:1px solid var(--line);align-items:flex-start}\n.item:first-of-type{border-top:0}\n.lv{flex:none;width:36px;height:36px;border-radius:10px;display:grid;place-items:center}\n.lv svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:2}\n.lv.red{background:var(--red2);color:var(--red)}.lv.orange{background:var(--orange2);color:var(--orange)}.lv.yellow{background:var(--yellow2);color:var(--yellow)}\n.item .c{flex:1;min-width:0}\n.item .t{font-weight:600;font-size:14px;display:flex;gap:8px;align-items:center}\n.tag{font-size:11px;font-weight:600;padding:0 6px;border-radius:4px;line-height:18px}\n.tag.red{background:var(--red2);color:var(--red)}.tag.orange{background:var(--orange2);color:var(--orange)}.tag.yellow{background:var(--yellow2);color:#b98200}\n.item .d{font-size:12.5px;color:var(--ink2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.item .go{flex:none;font-size:12.5px;color:var(--blue);border:1px solid #c9dbff;border-radius:8px;padding:4px 10px;align-self:center;white-space:nowrap}\n.item .go:hover{background:var(--blue2)}\n.todo .more{margin-top:auto;padding-top:10px;font-size:12.5px;color:var(--blue);text-align:center}\n\n/* ② 快捷访问 */\n.quick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}\n.qc{display:flex;align-items:center;gap:18px;padding:18px 22px;min-height:118px;transition:transform .18s,box-shadow .18s;position:relative;overflow:hidden}\n.qc::before{content:\"\";position:absolute;right:-40px;top:-40px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(31,111,255,.06),rgba(31,111,255,0) 70%)}\n.qc:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(20,40,80,.05),0 14px 32px rgba(20,40,80,.09)}\n.qc svg.ill{width:96px;height:80px;flex:none}\n.qc h4{font-size:18px;font-weight:700}\n.qc p{font-size:13px;color:var(--ink3);margin-top:3px}\n.qc .n{font-size:12px;color:var(--blue);margin-top:6px;font-weight:600}\n.qc .n.warn{color:var(--red)}\n.qc .arr{margin-left:auto;color:#c2cad6;font-size:20px;transition:transform .18s}\n.qc:hover .arr{transform:translateX(3px);color:var(--blue)}\n\n/* ③ 今日数据 */\n.kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px}\n.kpi{padding:16px 20px 12px;position:relative}\n.kpi .k{font-size:13px;color:var(--ink2);display:flex;align-items:center;gap:6px}\n.kpi .k small{color:var(--ink3);font-size:11.5px}\n.kpi .v{display:flex;align-items:baseline;gap:5px;margin-top:4px}\n.kpi .v b{font:700 34px/1.1 var(--num)}\n.kpi .v span{font-size:13px;color:var(--ink3)}\n.kpi .delta{font-size:12px;margin-top:2px;color:var(--ink3)}\n.kpi .delta b{font-weight:600}\n.kpi .delta .up{color:var(--teal)}.kpi .delta .dn{color:var(--red)}\n.kpi svg.sp{position:absolute;right:16px;bottom:14px;width:92px;height:34px}\n.ring{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:56px;height:56px}\n\n/* ④ 趋势 + 货架 */\n.row4{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:20px}\n.panel{padding:18px 22px}\n.panel .hd{display:flex;align-items:center;gap:12px;margin-bottom:6px}\n.panel .hd h3{font-size:16px}\n.panel .hd .lg{display:flex;gap:14px;font-size:12px;color:var(--ink2);margin-left:8px}\n.panel .hd .lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n.seg{margin-left:auto;display:flex;background:#f2f5f9;border-radius:8px;padding:2px}\n.seg span{font-size:12px;padding:3px 12px;border-radius:6px;color:var(--ink2);cursor:pointer}\n.seg span.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(20,40,80,.1)}\n#trend{width:100%;height:260px;display:block}\n.tt{position:absolute;pointer-events:none;background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:12px;box-shadow:0 8px 24px rgba(20,40,80,.12);display:none;white-space:nowrap}\n.shelf{display:grid;grid-template-columns:auto 1fr 1fr;gap:3px 6px;margin-top:8px;font-size:11px;color:var(--ink3)}\n.shelf .h{text-align:center;font-weight:600;color:var(--ink2);font-size:12px}\n.shelf .l{text-align:right;padding-right:2px;font-family:var(--num);line-height:16px}\n.cell{height:16px;border-radius:3px;background:#f0f3f7;position:relative;overflow:hidden;cursor:pointer;border:1px solid transparent}\n.cell i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,#6aa2ff,var(--blue));border-radius:2px}\n.cell.off{background:repeating-linear-gradient(135deg,#eef1f5 0 4px,#e5e9ef 4px 8px)}\n.cell.bad{border-color:var(--orange);background:var(--orange2)}\n.cell.bad i{background:linear-gradient(90deg,#ffb36b,var(--orange))}\n.cell:hover{outline:2px solid rgba(31,111,255,.35)}\n.shelf-lg{display:flex;gap:12px;font-size:11.5px;color:var(--ink2);margin-top:10px;flex-wrap:wrap}\n.shelf-lg i{display:inline-block;width:12px;height:8px;border-radius:2px;margin-right:4px}\n.shelf-sum{display:flex;gap:18px;margin-top:4px}\n.shelf-sum div{font-size:12px;color:var(--ink3)}\n.shelf-sum b{display:block;font:700 20px var(--num);color:var(--ink)}\n.foot{text-align:center;font-size:12px;color:var(--ink3)}\n\n@media (max-width:1180px){\n  .hero,.row4{grid-template-columns:1fr}\n  .kpis{grid-template-columns:repeat(3,1fr)}\n  .quick{grid-template-columns:repeat(2,1fr)}\n}\n@media (max-width:720px){\n  .wrap{padding:16px}\n  .top{padding:0 16px}.top .pill,.user b{display:none}\n  .dev{grid-template-columns:1fr}.dev .scene{height:240px}\n  .quick{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}\n}\n</style>\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 40 40\"><path d=\"M6 26l14-16 4 4-14 16z\" fill=\"#f5a623\"/><path d=\"M16 30L32 8l3 3-16 22z\" fill=\"#1f6fff\"/><path d=\"M12 32h22\" stroke=\"#1f6fff\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n    冷链自动发苗机器人\n  </div>\n  <div class=\"sp\"></div>\n  <span class=\"pill\" id=\"clock\">2026-10-22 14:46</span>\n  <span class=\"pill ok\"><i></i>设备在线</span>\n  <div class=\"icon-btn\" title=\"消息\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0\"/></svg><b>4</b></div>\n  <div class=\"user\"><span>王</span><b>王医生</b></div>\n</header>\n\n<div class=\"wrap\">\n\n  <!-- ① 状态 + 待办 -->\n  <section class=\"hero\">\n    <div class=\"card dev\">\n      <div class=\"scene\">\n        <main id=\"stage3d\"><canvas id=\"gl\"></canvas></main>\n        <div class=\"badge\">工作站 <b>GCR10 · 货架 A</b></div>\n      </div>\n      <div class=\"info\">\n        <div class=\"k\">设备状态</div>\n        <div class=\"state\" id=\"state\"><span class=\"dot\"></span><b id=\"stTxt\">运行中</b></div>\n        <div class=\"k\" id=\"stSub\">正在执行上苗任务</div>\n        <div class=\"task\" id=\"task\">\n          <div class=\"t1\"><b>上苗 #116 · 自动送料</b><span id=\"prog\">3 / 10 盒</span></div>\n          <div class=\"bar\"><i id=\"pbar\" style=\"width:30%\"></i></div>\n          <div class=\"steps\" id=\"steps\"></div>\n        </div>\n        <div class=\"facts\">\n          <div>通信<b class=\"g\">已连接</b></div>\n          <div>使能<b>已使能</b></div>\n          <div>急停<b>未触发</b></div>\n        </div>\n        <div class=\"acts\">\n          <button class=\"btn pri\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg>上苗</button>\n          <button class=\"btn sec\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12l7 7 7-7\"/></svg>发苗</button>\n          <button class=\"btn\" title=\"盘点\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 12h6M9 16h4\"/></svg>盘点</button>\n        </div>\n        <div class=\"meta\"><span>最近检测 14:46:48 · 192.168.100.190:8902</span><a href=\"#\">设备看板 ›</a></div>\n      </div>\n    </div>\n\n    <div class=\"card todo\">\n      <div class=\"hd\"><h3>待处理</h3><span class=\"cnt\">4</span><small>按紧急程度排序</small></div>\n      <div class=\"chips\"><span class=\"on\">全部 4</span><span>库存 3</span><span>盘点 1</span><span>设备 0</span></div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">Sabin株脊髓灰质炎灭活疫苗 <span class=\"tag red\">已过期 84 天</span></div>\n          <div class=\"d\">批号 C202407009 · 4 支 · A-L10 x=-141.7</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 49 天</span></div>\n          <div class=\"d\">批号 202503015 · 7 支 · A-L10 x=-37.2</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv red\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6M12 16.5v.5\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">麻腮风联合减毒活疫苗 <span class=\"tag red\">已过期 2 天</span></div>\n          <div class=\"d\">批号 202504034 · 41 支 · A-L10 / A-R10</div></div>\n        <a class=\"go\" href=\"#\">退苗</a>\n      </div>\n      <div class=\"item\">\n        <div class=\"lv orange\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 4h6v3H9zM6 6h12v15H6zM9 13l2 2 4-4\"/></svg></div>\n        <div class=\"c\"><div class=\"t\">A-R10 盘点不符 <span class=\"tag orange\">待核对</span></div>\n          <div class=\"d\">10-21 15:36 盘点 · 账上 19 支, 实测少 1 支</div></div>\n        <a class=\"go\" href=\"#\">核对</a>\n      </div>\n      <a class=\"more\" href=\"#\">查看全部提醒 ›</a>\n    </div>\n  </section>\n\n  <!-- ② 快捷访问 -->\n  <section>\n    <div class=\"sec-h\"><h2>快捷访问</h2><small>点击卡片进入</small></div>\n    <div class=\"quick\" id=\"quick\"></div>\n  </section>\n\n  <!-- ③ 今日数据 -->\n  <section>\n    <div class=\"sec-h\"><h2>今日数据</h2><small>数量单位：支 · 对比昨日同期</small></div>\n    <div class=\"kpis\">\n      <div class=\"card kpi\"><div class=\"k\">今日上苗</div><div class=\"v\"><b class=\"num\">22</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 18</b> 比昨日</div><svg class=\"sp\" id=\"sp1\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">今日发苗</div><div class=\"v\"><b class=\"num\">4</b><span>支</span></div>\n        <div class=\"delta\"><b class=\"up\">↑ 3</b> 比昨日</div><svg class=\"sp\" id=\"sp2\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">当前库存</div><div class=\"v\"><b class=\"num\">52</b><span>支</span></div>\n        <div class=\"delta\">3 个品种 · 4 个批号</div><svg class=\"sp\" id=\"sp3\"></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">格口占用 <small>货架 A</small></div><div class=\"v\"><b class=\"num\">38</b><span>%</span></div>\n        <div class=\"delta\">在用 15 格口 · 空 4</div>\n        <svg class=\"ring\" viewBox=\"0 0 56 56\"><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#eaf0f7\" stroke-width=\"7\"/><circle cx=\"28\" cy=\"28\" r=\"22\" fill=\"none\" stroke=\"#1f6fff\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"52.5 138.2\" transform=\"rotate(-90 28 28)\"/></svg></div>\n      <div class=\"card kpi\"><div class=\"k\">过期 / 临期 <small>批次</small></div><div class=\"v\"><b class=\"num\" style=\"color:var(--red)\">3</b><span>/ 0</span></div>\n        <div class=\"delta\"><b class=\"dn\">涉及 52 支</b> · 需退苗</div></div>\n    </div>\n  </section>\n\n  <!-- ④ 趋势 + 货架 -->\n  <section class=\"row4\">\n    <div class=\"card panel\" style=\"position:relative\">\n      <div class=\"hd\"><h3>近 7 日出入库</h3>\n        <div class=\"lg\"><span><i style=\"background:var(--blue)\"></i>上苗</span><span><i style=\"background:var(--teal)\"></i>发苗</span></div>\n        <div class=\"seg\"><span class=\"on\">7 天</span><span>30 天</span></div></div>\n      <svg id=\"trend\"></svg>\n      <div class=\"tt\" id=\"tt\"></div>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"hd\"><h3>货架库存分布</h3><div class=\"seg\"><span class=\"on\">货架 A</span><span>货架 B</span></div></div>\n      <div class=\"shelf-sum\">\n        <div>在用格口<b>15</b></div><div>有货<b>11</b></div><div>待核对<b style=\"color:var(--orange)\">1</b></div><div>未启用<b>11</b></div>\n      </div>\n      <div class=\"shelf\" id=\"shelf\"></div>\n      <div class=\"shelf-lg\"><span><i style=\"background:var(--blue)\"></i>占用比例</span><span><i style=\"background:#f0f3f7\"></i>空</span>\n        <span><i style=\"background:var(--orange)\"></i>待核对</span><span><i style=\"background:repeating-linear-gradient(135deg,#eef1f5 0 3px,#dfe4eb 3px 6px)\"></i>未启用</span></div>\n    </div>\n  </section>\n\n  <div class=\"foot\">演示数据 · 2026-10-22</div>\n</div>\n\n<script>window.SCENE_OPTS = { cam: [3.2, 3.3, 6.6], target: [-0.32, 0.8, 0.05], fov: 30 };</script>\n<script src=\"lib/three.min.js\"></script>\n<script src=\"lib/OrbitControls.js\"></script>\n<script src=\"lib/RoundedBoxGeometry.js\"></script>\n<script src=\"scene3d.js\"></script>\n<script>\n(function () {\n  const $ = id => document.getElementById(id);\n  // 时钟\n  const p2 = n => String(n).padStart(2, \"0\");\n  setInterval(() => { const d = new Date(); $(\"clock\").textContent = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())} ${p2(d.getHours())}:${p2(d.getMinutes())}`; }, 1000);\n\n  // 任务步骤(演示: 循环推进, 3D 机械臂同步)\n  const STEPS = [\"取货\", \"回 home\", \"扫码\", \"核验\", \"投放\", \"完成\"];\n  const LABEL = [\"识别吸取\", \"扫码\", \"核验\", \"飞往格口\", \"放置\", \"回位\"];\n  let si = 0, box = 3;\n  function step() {\n    $(\"steps\").innerHTML = LABEL.map((s, i) => `<span class=\"${i < si ? \"done\" : i === si ? \"on\" : \"\"}\">${s}</span>`).join(\"\");\n    if (window.SCENE) SCENE.setStep([1, 2, 3, 0, 0, 5][si]);\n    si++; if (si >= LABEL.length) { si = 0; box = box >= 10 ? 1 : box + 1; $(\"prog\").textContent = `${box} / 10 盒`; $(\"pbar\").style.width = box * 10 + \"%\"; }\n  }\n  step(); setInterval(step, 2400);\n\n  // 快捷访问: 白模等轴插画(统一一套画法, 不同的只是机柜内景和右下角徽标)\n  function ill(kind, badge) {\n    const iso = (x, y) => `${x},${y}`;\n    const inner = {\n      up: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M14 52l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M26 59v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M30 46h10l-3-3M40 46l-3 3\" stroke=\"#1f6fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      down: `<rect x=\"40\" y=\"26\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><rect x=\"40\" y=\"41\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"#dbe6f5\"/><path d=\"M12 54l12-7 12 7-12 7z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M12 54v7l12 7v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 61v7l12-7v-7z\" fill=\"#5b95ff\"/><path d=\"M40 47H29l3-3M29 47l3 3\" stroke=\"#13a89e\" stroke-width=\"2\" fill=\"none\"/>`,\n      shelf: `<g fill=\"#5b95ff\">${[0, 1, 2].map(r => [0, 1, 2].map(c => `<rect x=\"${38 + c * 7}\" y=\"${24 + r * 10}\" width=\"5\" height=\"7\" rx=\"1\" opacity=\"${0.55 + 0.15 * ((r + c) % 3)}\"/>`).join(\"\")).join(\"\")}</g>`,\n      dev: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"30\" rx=\"2\" fill=\"#dbe6f5\"/><path d=\"M44 50v-9l6-5 4 2\" stroke=\"#fff\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"44\" cy=\"50\" r=\"2.5\" fill=\"#fff\"/>`,\n      chart: `<rect x=\"38\" y=\"24\" width=\"22\" height=\"22\" rx=\"2\" fill=\"#dbe6f5\"/><rect x=\"41\" y=\"36\" width=\"3\" height=\"7\" fill=\"#13a89e\"/><rect x=\"46\" y=\"31\" width=\"3\" height=\"12\" fill=\"#1f6fff\"/><rect x=\"51\" y=\"34\" width=\"3\" height=\"9\" fill=\"#13a89e\"/><rect x=\"56\" y=\"28\" width=\"2.5\" height=\"15\" fill=\"#1f6fff\"/>`,\n      trace: `<rect x=\"38\" y=\"26\" width=\"22\" height=\"16\" rx=\"2\" fill=\"#fff\" stroke=\"#c9d3e0\"/>${[0, 2, 3, 5, 7, 8, 10, 12, 13, 15, 17].map(i => `<rect x=\"${40 + i}\" y=\"29\" width=\"${i % 3 ? 1 : 1.6}\" height=\"10\" fill=\"#1f2633\"/>`).join(\"\")}<path d=\"M14 52l10-6 10 6-10 6z\" fill=\"#fff\" stroke=\"#c9d3e0\"/><path d=\"M14 52v7l10 6v-7z\" fill=\"#eef2f8\" stroke=\"#c9d3e0\"/><path d=\"M24 58v7l10-6v-7z\" fill=\"#5b95ff\"/>`,\n    }[kind];\n    const B = {\n      in: `<path d=\"M84 63v-8M80 59l4 4 4-4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`, out: `<path d=\"M84 55v8M80 59l4-4 4 4\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n      list: `<path d=\"M80 56h8M80 59h8M80 62h6\" stroke=\"#fff\" stroke-width=\"1.6\"/>`, gear: `<circle cx=\"84\" cy=\"59\" r=\"3\" stroke=\"#fff\" stroke-width=\"1.8\" fill=\"none\"/><path d=\"M84 53v2M84 63v2M78 59h2M88 59h2\" stroke=\"#fff\" stroke-width=\"1.8\"/>`,\n      pie: `<path d=\"M84 59V54a5 5 0 1 1-5 5z\" fill=\"#fff\"/>`, ok: `<path d=\"M80 59l3 3 5-5\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"/>`,\n    }[badge];\n    const col = { in: \"#1f6fff\", out: \"#13a89e\", list: \"#13a89e\", gear: \"#1f6fff\", pie: \"#1f6fff\", ok: \"#13a89e\" }[badge];\n    return `<svg class=\"ill\" viewBox=\"0 0 96 80\">\n      <ellipse cx=\"46\" cy=\"72\" rx=\"36\" ry=\"5\" fill=\"#1f6fff\" opacity=\".07\"/>\n      <path d=\"M32 14l30-6 12 6v52l-12 6-30-6z\" fill=\"#e8edf4\"/>\n      <path d=\"M32 14l30-6v58l-30-6z\" fill=\"#fff\" stroke=\"#d3dbe6\"/>\n      <path d=\"M62 8l12 6v52l-12 6z\" fill=\"#dfe6ef\" stroke=\"#d3dbe6\"/>\n      <path d=\"M36 20l22-4v42l-22-4z\" fill=\"#f4f7fb\" stroke=\"#d3dbe6\"/>\n      <path d=\"M32 62l30 6 12-6\" stroke=\"#13a89e\" stroke-width=\"1.5\" fill=\"none\" opacity=\".7\"/>\n      ${inner}\n      <circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"${col}\"/><circle cx=\"84\" cy=\"59\" r=\"9\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/>${B}\n    </svg>`;\n  }\n  const Q = [\n    [\"上苗管理\", \"创建任务 · 查看上苗进度\", \"up\", \"in\", \"进行中 1 个任务\"],\n    [\"发苗管理\", \"选择疫苗 · 查看发苗任务\", \"down\", \"out\", \"今日已发 4 支\"],\n    [\"库存管理\", \"库存查询 · 盘点与锁苗\", \"shelf\", \"list\", \"3 批需处理\", true],\n    [\"设备管理\", \"设备信息与运行状态\", \"dev\", \"gear\", \"运行正常\"],\n    [\"统计报表\", \"查看业务数据统计\", \"chart\", \"pie\", \"本周上苗 80 支\"],\n    [\"追溯码对照\", \"查询疫苗追溯信息\", \"trace\", \"ok\", \"已登记 126 码\"],\n  ];\n  $(\"quick\").innerHTML = Q.map(q => `<a class=\"card qc\" href=\"#\">${ill(q[2], q[3])}<div><h4>${q[0]}</h4><p>${q[1]}</p><div class=\"n${q[5] ? \" warn\" : \"\"}\">${q[4]}</div></div><span class=\"arr\">›</span></a>`).join(\"\");\n\n  // 迷你折线\n  function spark(id, data, color) {\n    const el = $(id), w = 92, h = 34, mx = Math.max(...data, 1);\n    const pts = data.map((v, i) => [i * w / (data.length - 1), h - 3 - v / mx * (h - 8)]);\n    const d = pts.map((p, i) => (i ? \"L\" : \"M\") + p[0].toFixed(1) + \" \" + p[1].toFixed(1)).join(\" \");\n    el.setAttribute(\"viewBox\", `0 0 ${w} ${h}`);\n    el.innerHTML = `<defs><linearGradient id=\"g${id}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"${color}\" stop-opacity=\".22\"/><stop offset=\"1\" stop-color=\"${color}\" stop-opacity=\"0\"/></linearGradient></defs>\n      <path d=\"${d} L${w} ${h} L0 ${h}Z\" fill=\"url(#g${id})\"/><path d=\"${d}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <circle cx=\"${pts.at(-1)[0] - 1}\" cy=\"${pts.at(-1)[1]}\" r=\"3\" fill=\"${color}\"/>`;\n  }\n  const UP = [0, 0, 0, 0, 2, 54, 22], OUT = [0, 0, 0, 0, 0, 1, 4], STOCK = [0, 0, 0, 0, 2, 38, 52];\n  spark(\"sp1\", UP, \"#1f6fff\"); spark(\"sp2\", OUT, \"#13a89e\"); spark(\"sp3\", STOCK, \"#7a8aa3\");\n\n  // 7 日柱图(上苗/发苗并排, 数值标在柱顶)\n  const DAYS = [\"10-16\", \"10-17\", \"10-18\", \"10-19\", \"10-20\", \"10-21\", \"今天\"];\n  function trend() {\n    const svg = $(\"trend\"), W = svg.clientWidth || 700, H = 260, pl = 34, pr = 8, pt = 18, pb = 30;\n    const mx = Math.ceil(Math.max(...UP, ...OUT) / 10) * 10 || 10, cw = (W - pl - pr) / DAYS.length, bw = Math.min(26, cw * 0.28);\n    const y = v => pt + (H - pt - pb) * (1 - v / mx);\n    let s = \"\";\n    for (let k = 0; k <= 4; k++) { const v = mx * k / 4, yy = y(v); s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${yy}\" y2=\"${yy}\" stroke=\"#eef1f6\"/><text x=\"${pl - 8}\" y=\"${yy + 4}\" font-size=\"11\" fill=\"#98a3b3\" text-anchor=\"end\">${v}</text>`; }\n    DAYS.forEach((d, i) => {\n      const cx = pl + cw * i + cw / 2, today = i === DAYS.length - 1;\n      if (today) s += `<rect x=\"${cx - cw / 2 + 4}\" y=\"${pt - 8}\" width=\"${cw - 8}\" height=\"${H - pt - pb + 8}\" rx=\"8\" fill=\"#f3f7ff\"/>`;\n      [[UP[i], \"#1f6fff\", -bw - 2], [OUT[i], \"#13a89e\", 2]].forEach(([v, c, dx]) => {\n        const h = Math.max(v ? 3 : 1.5, (H - pt - pb) * v / mx);\n        s += `<rect x=\"${cx + dx}\" y=\"${y(0) - h}\" width=\"${bw}\" height=\"${h}\" rx=\"4\" fill=\"${c}\" opacity=\"${v ? 1 : .25}\"><animate attributeName=\"height\" from=\"0\" to=\"${h}\" dur=\".6s\"/><animate attributeName=\"y\" from=\"${y(0)}\" to=\"${y(0) - h}\" dur=\".6s\"/></rect>`;\n        if (v) s += `<text x=\"${cx + dx + bw / 2}\" y=\"${y(0) - h - 6}\" font-size=\"12\" font-weight=\"700\" fill=\"${c}\" text-anchor=\"middle\" font-family=\"DIN Alternate,Bahnschrift,sans-serif\">${v}</text>`;\n      });\n      s += `<text x=\"${cx}\" y=\"${H - 8}\" font-size=\"12\" fill=\"${today ? \"#1f6fff\" : \"#98a3b3\"}\" font-weight=\"${today ? 700 : 400}\" text-anchor=\"middle\">${d}</text>`;\n      s += `<rect class=\"hit\" data-i=\"${i}\" x=\"${cx - cw / 2}\" y=\"${pt}\" width=\"${cw}\" height=\"${H - pt - pb}\" fill=\"transparent\"/>`;\n    });\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n  }\n  trend(); addEventListener(\"resize\", trend);\n  $(\"trend\").addEventListener(\"mousemove\", e => {\n    const h = e.target.closest(\".hit\"), tt = $(\"tt\");\n    if (!h) { tt.style.display = \"none\"; return; }\n    const i = +h.dataset.i, r = e.currentTarget.parentElement.getBoundingClientRect();\n    tt.innerHTML = `<b>${DAYS[i]}</b><br><span style=\"color:#1f6fff\">● 上苗 ${UP[i]} 支</span><br><span style=\"color:#13a89e\">● 发苗 ${OUT[i]} 支</span>`;\n    tt.style.display = \"block\"; tt.style.left = (e.clientX - r.left + 14) + \"px\"; tt.style.top = (e.clientY - r.top - 10) + \"px\";\n  });\n  $(\"trend\").addEventListener(\"mouseleave\", () => $(\"tt\").style.display = \"none\");\n\n  // 货架库存分布(正面缩略: 左右列 × 13 层, 条长 = 占用比例)\n  const EN = new Set([\"L2\", \"L6\", \"R2\", \"R4\", \"R6\", ...[8, 9, 10, 11, 12].flatMap(l => [\"L\" + l, \"R\" + l])]);\n  const OCC = { L10: 0.86, L8: 0.62, L9: 0.4, L11: 0.55, L12: 0.3, R8: 0.48, R9: 0.22, R10: 0.68, R11: 0.36, R12: 0.12, L6: 0.5, R6: 0, R4: 0, L2: 0.25, R2: 0 };\n  let html = `<span></span><span class=\"h\">左列 L</span><span class=\"h\">右列 R</span>`;\n  for (let l = 13; l >= 1; l--) {\n    html += `<span class=\"l\">${l}</span>`;\n    for (const c of [\"L\", \"R\"]) {\n      const k = c + l, en = EN.has(k), bad = k === \"R10\", o = OCC[k] || 0;\n      html += `<div class=\"cell${en ? \"\" : \" off\"}${bad ? \" bad\" : \"\"}\" title=\"A-${k}${en ? ` · 占用 ${Math.round(o * 100)}%${bad ? \" · 盘点待核对\" : \"\"}` : \" · 未启用\"}\">${en ? `<i style=\"width:${o * 100}%\"></i>` : \"\"}</div>`;\n    }\n  }\n  $(\"shelf\").innerHTML = html;\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"e5cc4daf-cc8c-480d-959e-c8da561c23a3","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
