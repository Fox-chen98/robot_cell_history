se2\"></div><div class=\"dot\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 15l18-6M5 19l16-5\"/><rect x=\"11\" y=\"6\" width=\"5\" height=\"4\"/></svg></div><div class=\"tag\"><b>上苗机 · 送料</b><span>提升 / 上料 / 中转 三段皮带</span></div></div>\n  <div class=\"hs\" data-p=\"-0.87,0.70,0.35\"><div class=\"pulse\"></div><div class=\"pulse2\"></div><div class=\"dot\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3M7 9v6M10 9v6M13 9v6M16 9v6\"/></svg></div><div class=\"tag\"><b>扫码口</b><span>追溯码核验 · 今日 128 次</span></div></div>\n  <div class=\"hs\" data-p=\"0.15,0.62,1.0\"><div class=\"pulse\"></div><div class=\"pulse2\"></div><div class=\"dot\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 10h16v9H4zM9 14l3 3 3-3\"/></svg></div><div class=\"tag\"><b>退苗筐</b><span>今日退苗 3 盒</span></div></div>\n</main>\nEOF\n/usr/bin/python3 - <<'EOF'\np=\"home_src.html\"; s=open(p,encoding=\"utf-8\").read()\na=s.index('<main class=\"stage\">'); b=s.index('</main>')+len('</main>')\ns=s[:a]+open(\"/private/tmp/claude-501/-Users-chen-Desktop-robocenter/9953535e-7aeb-4fd0-b37d-4185895077fe/scratchpad/stage.html\",encoding=\"utf-8\").read().strip()+s[b:]\n# CSS: 场景背景改为与面板一致的柔光, 画布铺满; 去掉旧平面装饰\ns=s.replace(\".stage{position:fixed;inset:0;overflow:hidden;\",\".stage{position:fixed;inset:0;overflow:hidden;\\n  /* 3D 画布透明, 背景只此一层 → 模型地面渐隐进它, 无接缝 */\")\ns=s.replace(\".wm{position:absolute;left:50%;top:93%\",\n \"#gl{position:absolute;inset:0;width:100%;height:100%;display:block;outline:none;cursor:grab}\\n#gl:active{cursor:grabbing}\\n.stage .hs{z-index:3;transition:opacity .2s}\\n.wm{position:absolute;left:50%;top:93%\")\n# 旧 halo/ machine 规则留着无害; 加载库 + 3D 脚本\ns=s.replace(\"<script>\\n(function(){\",'<script src=\"lib/three.min.js\"></script>\\n<script src=\"lib/OrbitControls.js\"></script>\\n<script src=\"lib/RoundedBoxGeometry.js\"></script>\\n<script src=\"scene3d.js\"></script>\\n<script>\\n(function(){',1)\ns=s.replace('document.getElementById(\"armAt\").textContent=si==0?\"A-L10\":si<4?\"home\":si==4?\"出库口\":\"home\";',\n 'document.getElementById(\"armAt\").textContent=si==0?\"A-L10\":si<4?\"home\":si==4?\"出库口\":\"home\";\\n    if(window.SCENE)SCENE.setStep(si);')\nopen(p,\"w\",encoding=\"utf-8\").write(s)\nEOF\ngrep -n 'scene3d.js\\|SCENE.setStep\\|id=\"gl\"' home_src.html","description":"把中间整机图替换为 3D 画布与投影热点"},"caller":{"type":"direct"}}]}}
