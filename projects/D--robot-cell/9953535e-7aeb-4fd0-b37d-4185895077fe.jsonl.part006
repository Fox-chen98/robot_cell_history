,"mcp__ccd_pr__unbind_pr","mcp__ccd_session__dismiss_task","mcp__ccd_session__hand_off_to_session","mcp__ccd_session__list_start_targets","mcp__ccd_session__mark_chapter","mcp__ccd_session__move_to_cloud","mcp__ccd_session__read_widget_context","mcp__ccd_session__start_session","mcp__ccd_session_mgmt__archive_session","mcp__ccd_session_mgmt__clear_session","mcp__ccd_session_mgmt__delete_session","mcp__ccd_session_mgmt__detach_session","mcp__ccd_session_mgmt__export_transcript","mcp__ccd_session_mgmt__get_session","mcp__ccd_session_mgmt__get_usage","mcp__ccd_session_mgmt__list_events","mcp__ccd_session_mgmt__list_sessions","mcp__ccd_session_mgmt__search_session_transcripts","mcp__ccd_session_mgmt__send_message","mcp__ccd_session_mgmt__set_remote_control","mcp__ccd_session_mgmt__set_session_effort","mcp__ccd_session_mgmt__set_session_fast_mode","mcp__ccd_session_mgmt__set_session_model","mcp__ccd_session_mgmt__set_session_output_style","mcp__ccd_session_mgmt__set_session_permission_mode","mcp__ccd_session_mgmt__set_session_title","mcp__ccd_session_mgmt__stop_session","mcp__ccd_session_mgmt__unarchive_session","mcp__ccd_settings__get_settings","mcp__ccd_settings__set_setting","mcp__ccd_sidebar__create_group","mcp__ccd_sidebar__create_section","mcp__ccd_sidebar__delete_group","mcp__ccd_sidebar__delete_section","mcp__ccd_sidebar__list_groups","mcp__ccd_sidebar__list_sections","mcp__ccd_sidebar__mark_completed","mcp__ccd_sidebar__move_sessions","mcp__ccd_sidebar__rename_group","mcp__ccd_sidebar__rename_section","mcp__ccd_sidebar__set_pinned","mcp__ccd_sidebar__set_unread","mcp__ccd_sidebar__set_view","mcp__ccd_view__close_pane","mcp__ccd_view__get_layout","mcp__ccd_view__set_transcript_view","mcp__ccd_view__show_pane","mcp__ccd_window__close_split","mcp__ccd_window__get_window_layout","mcp__ccd_window__open_session_in","mcp__ccd_window__set_sidebar_collapsed","mcp__claude-in-chrome__browser_batch","mcp__claude-in-chrome__computer","mcp__claude-in-chrome__file_upload","mcp__claude-in-chrome__find","mcp__claude-in-chrome__form_input","mcp__claude-in-chrome__get_page_text","mcp__claude-in-chrome__gif_creator","mcp__claude-in-chrome__javascript_tool","mcp__claude-in-chrome__list_connected_browsers","mcp__claude-in-chrome__navigate","mcp__claude-in-chrome__read_console_messages","mcp__claude-in-chrome__read_network_requests","mcp__claude-in-chrome__read_page","mcp__claude-in-chrome__resize_window","mcp__claude-in-chrome__select_browser","mcp__claude-in-chrome__shortcuts_execute","mcp__claude-in-chrome__shortcuts_list","mcp__claude-in-chrome__switch_browser","mcp__claude-in-chrome__tabs_close_mcp","mcp__claude-in-chrome__tabs_context_mcp","mcp__claude-in-chrome__tabs_create_mcp","mcp__claude-in-chrome__upload_image","mcp__mcp-registry__list_connectors","mcp__mcp-registry__search_mcp_registry","mcp__mcp-registry__suggest_connectors","mcp__scheduled-tasks__create_scheduled_task","mcp__scheduled-tasks__delete_scheduled_task","mcp__scheduled-tasks__list_scheduled_tasks","mcp__scheduled-tasks__list_task_runs","mcp__scheduled-tasks__run_scheduled_task","mcp__scheduled-tasks__update_scheduled_task","mcp__terminal__list_terminal_tabs","mcp__terminal__open_terminal_tab","mcp__terminal__read_terminal","mcp__terminal__run_in_terminal","mcp__terminal__stop_terminal_tab","mcp__visualize__read_me","mcp__visualize__show_widget"],"addedLines":["ArtifactComments","ArtifactData","CronCreate","CronDelete","CronList","DesignSync","EnterPlanMode","EnterWorktree","ExitPlanMode","ExitWorktree","Glob","Grep","ListPlugins","ListSkills","Monitor","NotebookEdit","PowerShell","PushNotification","RemoteTrigger","SearchPlugins","SearchSkills","SendMessage","SendUserFile","SuggestPluginInstall","SuggestSkills","TaskStop","WebFetch","WebSearch","mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__batch","mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__create","mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__delete","mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c__export","mcp__1a59c906-04da-52