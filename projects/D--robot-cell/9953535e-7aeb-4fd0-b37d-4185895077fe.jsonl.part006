{"parentUuid":"9172c174-83fe-40a1-a449-c4385ef18e83","isSidechain":false,"promptId":"2b52c361-a189-4dc8-9444-35232e110e30","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196dDJfCwqu9qRTaizFLsUK","type":"tool_result","content":"    (\"预排位置\", \"上位机下任务时就把坑位列表排好，设备按顺序放\"),\n    (\"问位置\", \"设备每盒扫完码把追溯码报给上位机，上位机再告诉它放哪。适合按品种/批号分区存放\"),\n    (\"任务快照\", \"一个任务此刻的整体情况：状态、进度、还剩几盒、预计几点结束\"),\n    (\"事件\", \"任务过程中设备逐条报出来的记录，比如扫到码、已放好、已取出。上位机靠它记账和显示\"),\n    (\"吸空\", \"出库时到了坑位却没吸到盒子，说明账和实物对不上\"),\n    (\"盘点\", \"设备飞到格口，降到盘点位用深度相机拍一帧，量出每列最外面那盒（队首）的位置，与上位机随任务传来的账上队首位置 front_mm 比对：差不到半个节距为相符（diff_kind=match），差约 N 个节距为少/多 N 盒（whole_boxes, boxes_diff=±N），都不是为整列被碰动（shifted）。误差不随盒数累积。上位机据此核账：match 可用实测队首更新账，其余须人工确认后盒数与队首一起改\n    (\"节距\", \"一种盒在货架里每盒实际占的厚度，含盒间的缝，由录入品种时用 ≥4 盒的一列实测得到（叠厚 ÷ 盒数），存在设备尺寸表。盘点数盒和放置算推进量都用它，卡尺量的外形厚只用于认脸\"),\n    (\"需人工处理\", \"设备停下来等人：比如立即停止时手里还吸着盒，或动作失败。人处理好后再继续\"),\n]\nTYPE_CN = {\"string\": \"String\", \"integer\": \"Integer\", \"number\": \"Number\", \"boolean\": \"Boolean\", \"array\": \"List\", \"object\": \"Object\"}\n\n# ───────── 手写: 接口分组与顺序(路径, 方法, 中文名, 描述) ─────────\nSECTIONS = [\n    (\"设备状态查询接口\", [\n        (\"GET\", \"/device\", \"查询设备状态\", \"上位机随时查询设备当前状态：是否空闲、机械臂在哪、是否急停、手里有没有货、内部服务是否在线、当前任务号。\"),\n        (\"GET\", \"/capability\", \"查询设备能力\", \"上位机启动时查一次：有哪些格口、每个格口的可用宽度范围（left_lim_mm ~ right_lim_mm）、可用深度（depth_mm）、列间隙、单盒平均用时、可选去处、设备自带的药品尺寸表。pit_index 字段说明位置的含义。上位机据此建本地的“格口列表”。\"),\n        (\"POST\", \"/plan/store\", \"规划上架位置\", \"上位机把候选格口现有的列表（每列的 x_mm、盒尺寸、分组键、已放几盒）和要放的盒（尺寸、分组键如批号）传来，设备算出该放到哪个格口、哪一列（x_mm）、第几个（index），以及是否新开列。纯计算，设备不保存任何列表，每次都以上位机传来的为准。规则：先接同分组键、同宽、未满的列的队尾；否则按格口顺序在空余宽度里从左到右找第一段放得下的位置开新列；都放\n    ]),\n    (\"任务下发接口\", [\n        (\"POST\", \"/tasks\", \"下发任务（上架 / 出库 / 退苗 / 盘点）\", \"下发一批任务。type=store 为上架一批；type=retrieve 为出库一批，退苗与出库对设备是同一种任务，只是 dest（去处）与 reason（原因）不同；type=stocktake 为盘点一个格口（slot + 上位机账上的列表 columns），设备飞过去拍一帧，结果在 stocktake 事件里逐列给实测盒\n        (\"GET\", \"/tasks\", \"查询任务列表\", \"查询本次服务启动以来的任务列表及各自快照，以及当前正在跑的任务号。\"),\n        (\"GET\", \"/tasks/{tid}\", \"查询任务快照\", \"查询一个任务的当前状态、阶段、进度、剩余数量与预计结束时间。建议每 1~3 秒刷新一次用于界面显示。\"),\n        (\"GET\", \"/tasks/{tid}/events\", \"拉取任务事件\", \"增量拉取任务事件流。上位机记住最后一条的 seq，下次带 since=seq 只拉新事件。建议每 0.5 秒一次。上位机必须处理的事件：code_scanned（问位置模式下须答复去处）、stored（记账）、retrieved / pit_empty（出库结果）。\"),\n        (\"POST\", \"/tasks/{tid}/destination\", \"答复去处（问位置模式）\", \"问位置模式的上架任务：设备每盒扫码后报 code_scanned 事件并停住等待；上位机要在 10 秒内（见设备能力 dest_wait_s）调用本接口告诉它放到哪个格口哪个坑位（可附盒尺寸），或者指示丢回。超时这盒会被丢回传送带。\"),\n    ]),\n    (\"任务控制接口\", [\n        (\"POST\", \"/tasks/{tid}/stop\", \"停止任务\", \"当前盒做完后停止，任务结束。\"),\n        (\"POST\", \"/tasks/{tid}/pause\", \"暂停任务\", \"当前盒做完后暂停，可 resume 继续。\"),\n        (\"POST\", \"/tasks/{tid}/resume\", \"继续任务\", \"从暂停或需人工处理状态继续做下一盒。需人工处理时，须先由人把机械臂恢复到待机位（可用复位接口）。\"),\n        (\"POST\", \"/tasks/{tid}/abort\", \"立即停止\", \"机械臂立即停止运动（不是硬件急停）。手里有盒则任务转为需人工处理；任务就此结束，不能继续。\"),\n    ]),\n    (\"调试与恢复接口\", [\n        (\"POST\", \"/device/reset\", \"复位\", \"机械臂从当前位置安全退回待机位（先到货架前中转位再回 home）。手里有盒也能原样带回。只在设备空闲或任务处于需人工处理时可调，否则返回 409。\"),\n        (\"POST\", \"/device/drop\", \"丢回\", \"把手里吸着的盒放回传送带，然后回待机位。前提：手里有盒，且机械臂在桌面上方的安全区内。\"),\n        (\"POST\", \"/device/home\", \"回 home\", \"机械臂回待机位 home（只从几个已验证安全的起点放行）。\"),\n    ]),\n    (\"服务管理接口\", [\n        (\"GET\", \"/services\", \"查询常驻服务状态\", \"查询设备上四个常驻服务（视觉 8900 / 扫码 8901 / 工作站 8902 / 上位机后端 8903）是否在线。\"),\n        (\"POST\", \"/services/{name}/{cmd}\", \"启停常驻服务\", \"启动 / 停止 / 重启一个常驻服务。设备开机会自动拉起所有服务并每 5 分钟自检一次，本接口用于手动干预。工作站服务自身只能重启。\"),\n    ]),\n    (\"健康检查接口\", [\n        (\"GET\", \"/health\", \"探活\", \"返回服务是否存活及当前任务号。\"),\n    ]),\n]\n\n# ───────── 手写: 响应示例(GET 类来自实机抓取, POST 类按模型构造) ─────────\nEXAMPLES_RESP = {\n    (\"POST\", \"/tasks\"): {\"task_id\": 2, \"state\": \"queued\", \"avg_box_s\": 24.4, \"avg_src\": \"格口历史\", \"remaining\": 3, \"eta_s\": 73.0, \"eta_at\": \"08:46:48\", \"est_count\": None, \"note\": None},\n    (\"GET\", \"/tasks\"): {\"tasks\": [\"…同 GET /tasks/{tid} 的快照…\"], \"running\": 2},\n    (\"GET\", \"/tasks/{tid}\"): {\"task_id\": 2, \"type\": \"retrieve\", \"feed\": \"auto\", \"destination\": \"fixed\", \"slot\": None, \"pits\": [[0, 0, 0], [1, 0, 0], [2, 0, 0]], \"stop\": {\"count\": 3, \"minutes\": None, \"table_empty_s\": None\n                             \"dest\": \"drop\", \"reason\": \"退苗 批号202504034\", \"state\": \"running\", \"stage\": \"取货\", \"progress\": {\"stored\": 0, \"discarded\": 0, \"retrieved\": 1, \"empty\": 0, \"target_count\": 3, \"pits_total\": 3},\n                             \"current\": {\"box_seq\": 2, \"slot\": \"A-L10\", \"pit\": [1, 0, 0], \"code\": \"81002713761706233964\"}, \"end_reason\": None, \"n_events\": 15, \"awaiting_seq\": None,\n                             \"created\": \"08:45:35\", \"elapsed_s\": 30.2, \"avg_box_s\": 24.4, \"avg_src\": \"格口历史\", \"remaining\": 2, \"eta_s\": 48.8, \"eta_at\": \"08:46:49\", \"est_count\": None, \"note\": None},\n    (\"GET\", \"/tasks/{tid}/events\"): {\"task_id\": 2, \"state\": \"running\", \"last_seq\": 12, \"events\": [\n        {\"seq\": 1, \"t\": \"08:45:35\", \"ts\": 1789001135.2, \"kind\": \"task_start\", \"box_seq\": 0, \"feed\": \"auto\", \"destination\": \"fixed\", \"slot\": None, \"pits\": None, \"stop\": {\"count\": 3, \"minutes\": None, \"table_empty_s\": None}\n        {\"seq\": 2, \"t\": \"08:45:35\", \"ts\": 1789001135.3, \"kind\": \"box_start\", \"box_seq\": 1, \"slot\": \"A-L10\", \"pit\": [0, 0, 0]},\n        {\"seq\": 8, \"t\": \"08:45:47\", \"ts\": 1789001147.0, \"kind\": \"retrieved\", \"box_seq\": 1, \"code\": \"81002713752185299044\", \"slot\": \"A-L10\", \"pit\": [0, 0, 0], \"dest\": \"drop\"},\n        {\"seq\": 12, \"t\": \"08:45:59\", \"ts\": 1789001159.1, \"kind\": \"box_end\", \"box_seq\": 1, \"result\": \"ok\", \"text\": \"已从 L10 (0,0,0) 取出并丢回传送带, 臂在 home\", \"elapsed_s\": 24.4}]},\n    (\"POST\", \"/tasks/{tid}/destination\"): {\"accepted\": True},\n    (\"POST\", \"/tasks/{tid}/stop\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/pause\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/resume\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/abort\"): {\"ok\": True},\n    (\"POST\", \"/device/reset\"): {\"action\": \"复位→mid\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"从 home movej 到 mid\", \"payload\": \"none\", \"where\": \"mid\", \"elapsed_s\": 6.2, \"data\": {}},\n    (\"POST\", \"/device/drop\"): {\"action\": \"丢回传送带\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已吹开丢回传送带, 空手回到 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 9.8, \"data\": {}},\n    (\"POST\", \"/device/home\"): {\"action\": \"去 home\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已在 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 0.3, \"data\": {}},\n    (\"POST\", \"/services/{name}/{cmd}\"): {\"ok\": True, \"name\": \"vision\", \"cmd\": \"restart\", \"output\": \"vision pid 74368 killed\"},\n}\nEXAMPLES_REQ_EXTRA = {   # 请求示例(路径参数/查询参数类接口)\n    (\"GET\", \"/tasks/{tid}\"): \"GET /tasks/2\",\n    (\"GET\", \"/tasks/{tid}/events\"): \"GET /tasks/2/events?since=7\",\n    (\"POST\", \"/tasks/{tid}/destination\"): {\"box_seq\": 1, \"action\": \"place\", \"slot\": \"A-L10\", \"pit\": [3, 0, 0], \"box_mm\": [60.0, 38.5, 22.4], \"name\": \"麻腮风联合减毒活疫苗\"},\n    (\"POST\", \"/tasks/{tid}/stop\"): \"POST /tasks/2/stop\", (\"POST\", \"/tasks/{tid}/pause\"): \"POST /tasks/2/pause\", (\"POST\", \"/tasks/{tid}/resume\"): \"POST /tasks/2/resume\", (\"POST\", \"/tasks/{tid}/abort\"): \"POST /tasks/2/abor\n    (\"POST\", \"/services/{name}/{cmd}\"): \"POST /services/vision/restart\",\n}\nEVENT_KINDS = [\n93:EXAMPLES_REQ_EXTRA = {   # 请求示例(路径参数/查询参数类接口)\n279:            extra = EXAMPLES_REQ_EXTRA.get(key)","is_error":false}]},"uuid":"4986c35d-2355-4fd0-a101-fed625b3ff58","timestamp":"2026-10-22T01:52:33.843Z","toolUseResult":{"stdout":"    (\"预排位置\", \"上位机下任务时就把坑位列表排好，设备按顺序放\"),\n    (\"问位置\", \"设备每盒扫完码把追溯码报给上位机，上位机再告诉它放哪。适合按品种/批号分区存放\"),\n    (\"任务快照\", \"一个任务此刻的整体情况：状态、进度、还剩几盒、预计几点结束\"),\n    (\"事件\", \"任务过程中设备逐条报出来的记录，比如扫到码、已放好、已取出。上位机靠它记账和显示\"),\n    (\"吸空\", \"出库时到了坑位却没吸到盒子，说明账和实物对不上\"),\n    (\"盘点\", \"设备飞到格口，降到盘点位用深度相机拍一帧，量出每列最外面那盒（队首）的位置，与上位机随任务传来的账上队首位置 front_mm 比对：差不到半个节距为相符（diff_kind=match），差约 N 个节距为少/多 N 盒（whole_boxes, boxes_diff=±N），都不是为整列被碰动（shifted）。误差不随盒数累积。上位机据此核账：match 可用实测队首更新账，其余须人工确认后盒数与队首一起改\n    (\"节距\", \"一种盒在货架里每盒实际占的厚度，含盒间的缝，由录入品种时用 ≥4 盒的一列实测得到（叠厚 ÷ 盒数），存在设备尺寸表。盘点数盒和放置算推进量都用它，卡尺量的外形厚只用于认脸\"),\n    (\"需人工处理\", \"设备停下来等人：比如立即停止时手里还吸着盒，或动作失败。人处理好后再继续\"),\n]\nTYPE_CN = {\"string\": \"String\", \"integer\": \"Integer\", \"number\": \"Number\", \"boolean\": \"Boolean\", \"array\": \"List\", \"object\": \"Object\"}\n\n# ───────── 手写: 接口分组与顺序(路径, 方法, 中文名, 描述) ─────────\nSECTIONS = [\n    (\"设备状态查询接口\", [\n        (\"GET\", \"/device\", \"查询设备状态\", \"上位机随时查询设备当前状态：是否空闲、机械臂在哪、是否急停、手里有没有货、内部服务是否在线、当前任务号。\"),\n        (\"GET\", \"/capability\", \"查询设备能力\", \"上位机启动时查一次：有哪些格口、每个格口的可用宽度范围（left_lim_mm ~ right_lim_mm）、可用深度（depth_mm）、列间隙、单盒平均用时、可选去处、设备自带的药品尺寸表。pit_index 字段说明位置的含义。上位机据此建本地的“格口列表”。\"),\n        (\"POST\", \"/plan/store\", \"规划上架位置\", \"上位机把候选格口现有的列表（每列的 x_mm、盒尺寸、分组键、已放几盒）和要放的盒（尺寸、分组键如批号）传来，设备算出该放到哪个格口、哪一列（x_mm）、第几个（index），以及是否新开列。纯计算，设备不保存任何列表，每次都以上位机传来的为准。规则：先接同分组键、同宽、未满的列的队尾；否则按格口顺序在空余宽度里从左到右找第一段放得下的位置开新列；都放\n    ]),\n    (\"任务下发接口\", [\n        (\"POST\", \"/tasks\", \"下发任务（上架 / 出库 / 退苗 / 盘点）\", \"下发一批任务。type=store 为上架一批；type=retrieve 为出库一批，退苗与出库对设备是同一种任务，只是 dest（去处）与 reason（原因）不同；type=stocktake 为盘点一个格口（slot + 上位机账上的列表 columns），设备飞过去拍一帧，结果在 stocktake 事件里逐列给实测盒\n        (\"GET\", \"/tasks\", \"查询任务列表\", \"查询本次服务启动以来的任务列表及各自快照，以及当前正在跑的任务号。\"),\n        (\"GET\", \"/tasks/{tid}\", \"查询任务快照\", \"查询一个任务的当前状态、阶段、进度、剩余数量与预计结束时间。建议每 1~3 秒刷新一次用于界面显示。\"),\n        (\"GET\", \"/tasks/{tid}/events\", \"拉取任务事件\", \"增量拉取任务事件流。上位机记住最后一条的 seq，下次带 since=seq 只拉新事件。建议每 0.5 秒一次。上位机必须处理的事件：code_scanned（问位置模式下须答复去处）、stored（记账）、retrieved / pit_empty（出库结果）。\"),\n        (\"POST\", \"/tasks/{tid}/destination\", \"答复去处（问位置模式）\", \"问位置模式的上架任务：设备每盒扫码后报 code_scanned 事件并停住等待；上位机要在 10 秒内（见设备能力 dest_wait_s）调用本接口告诉它放到哪个格口哪个坑位（可附盒尺寸），或者指示丢回。超时这盒会被丢回传送带。\"),\n    ]),\n    (\"任务控制接口\", [\n        (\"POST\", \"/tasks/{tid}/stop\", \"停止任务\", \"当前盒做完后停止，任务结束。\"),\n        (\"POST\", \"/tasks/{tid}/pause\", \"暂停任务\", \"当前盒做完后暂停，可 resume 继续。\"),\n        (\"POST\", \"/tasks/{tid}/resume\", \"继续任务\", \"从暂停或需人工处理状态继续做下一盒。需人工处理时，须先由人把机械臂恢复到待机位（可用复位接口）。\"),\n        (\"POST\", \"/tasks/{tid}/abort\", \"立即停止\", \"机械臂立即停止运动（不是硬件急停）。手里有盒则任务转为需人工处理；任务就此结束，不能继续。\"),\n    ]),\n    (\"调试与恢复接口\", [\n        (\"POST\", \"/device/reset\", \"复位\", \"机械臂从当前位置安全退回待机位（先到货架前中转位再回 home）。手里有盒也能原样带回。只在设备空闲或任务处于需人工处理时可调，否则返回 409。\"),\n        (\"POST\", \"/device/drop\", \"丢回\", \"把手里吸着的盒放回传送带，然后回待机位。前提：手里有盒，且机械臂在桌面上方的安全区内。\"),\n        (\"POST\", \"/device/home\", \"回 home\", \"机械臂回待机位 home（只从几个已验证安全的起点放行）。\"),\n    ]),\n    (\"服务管理接口\", [\n        (\"GET\", \"/services\", \"查询常驻服务状态\", \"查询设备上四个常驻服务（视觉 8900 / 扫码 8901 / 工作站 8902 / 上位机后端 8903）是否在线。\"),\n        (\"POST\", \"/services/{name}/{cmd}\", \"启停常驻服务\", \"启动 / 停止 / 重启一个常驻服务。设备开机会自动拉起所有服务并每 5 分钟自检一次，本接口用于手动干预。工作站服务自身只能重启。\"),\n    ]),\n    (\"健康检查接口\", [\n        (\"GET\", \"/health\", \"探活\", \"返回服务是否存活及当前任务号。\"),\n    ]),\n]\n\n# ───────── 手写: 响应示例(GET 类来自实机抓取, POST 类按模型构造) ─────────\nEXAMPLES_RESP = {\n    (\"POST\", \"/tasks\"): {\"task_id\": 2, \"state\": \"queued\", \"avg_box_s\": 24.4, \"avg_src\": \"格口历史\", \"remaining\": 3, \"eta_s\": 73.0, \"eta_at\": \"08:46:48\", \"est_count\": None, \"note\": None},\n    (\"GET\", \"/tasks\"): {\"tasks\": [\"…同 GET /tasks/{tid} 的快照…\"], \"running\": 2},\n    (\"GET\", \"/tasks/{tid}\"): {\"task_id\": 2, \"type\": \"retrieve\", \"feed\": \"auto\", \"destination\": \"fixed\", \"slot\": None, \"pits\": [[0, 0, 0], [1, 0, 0], [2, 0, 0]], \"stop\": {\"count\": 3, \"minutes\": None, \"table_empty_s\": None\n                             \"dest\": \"drop\", \"reason\": \"退苗 批号202504034\", \"state\": \"running\", \"stage\": \"取货\", \"progress\": {\"stored\": 0, \"discarded\": 0, \"retrieved\": 1, \"empty\": 0, \"target_count\": 3, \"pits_total\": 3},\n                             \"current\": {\"box_seq\": 2, \"slot\": \"A-L10\", \"pit\": [1, 0, 0], \"code\": \"81002713761706233964\"}, \"end_reason\": None, \"n_events\": 15, \"awaiting_seq\": None,\n                             \"created\": \"08:45:35\", \"elapsed_s\": 30.2, \"avg_box_s\": 24.4, \"avg_src\": \"格口历史\", \"remaining\": 2, \"eta_s\": 48.8, \"eta_at\": \"08:46:49\", \"est_count\": None, \"note\": None},\n    (\"GET\", \"/tasks/{tid}/events\"): {\"task_id\": 2, \"state\": \"running\", \"last_seq\": 12, \"events\": [\n        {\"seq\": 1, \"t\": \"08:45:35\", \"ts\": 1789001135.2, \"kind\": \"task_start\", \"box_seq\": 0, \"feed\": \"auto\", \"destination\": \"fixed\", \"slot\": None, \"pits\": None, \"stop\": {\"count\": 3, \"minutes\": None, \"table_empty_s\": None}\n        {\"seq\": 2, \"t\": \"08:45:35\", \"ts\": 1789001135.3, \"kind\": \"box_start\", \"box_seq\": 1, \"slot\": \"A-L10\", \"pit\": [0, 0, 0]},\n        {\"seq\": 8, \"t\": \"08:45:47\", \"ts\": 1789001147.0, \"kind\": \"retrieved\", \"box_seq\": 1, \"code\": \"81002713752185299044\", \"slot\": \"A-L10\", \"pit\": [0, 0, 0], \"dest\": \"drop\"},\n        {\"seq\": 12, \"t\": \"08:45:59\", \"ts\": 1789001159.1, \"kind\": \"box_end\", \"box_seq\": 1, \"result\": \"ok\", \"text\": \"已从 L10 (0,0,0) 取出并丢回传送带, 臂在 home\", \"elapsed_s\": 24.4}]},\n    (\"POST\", \"/tasks/{tid}/destination\"): {\"accepted\": True},\n    (\"POST\", \"/tasks/{tid}/stop\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/pause\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/resume\"): {\"ok\": True}, (\"POST\", \"/tasks/{tid}/abort\"): {\"ok\": True},\n    (\"POST\", \"/device/reset\"): {\"action\": \"复位→mid\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"从 home movej 到 mid\", \"payload\": \"none\", \"where\": \"mid\", \"elapsed_s\": 6.2, \"data\": {}},\n    (\"POST\", \"/device/drop\"): {\"action\": \"丢回传送带\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已吹开丢回传送带, 空手回到 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 9.8, \"data\": {}},\n    (\"POST\", \"/device/home\"): {\"action\": \"去 home\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已在 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 0.3, \"data\": {}},\n    (\"POST\", \"/services/{name}/{cmd}\"): {\"ok\": True, \"name\": \"vision\", \"cmd\": \"restart\", \"output\": \"vision pid 74368 killed\"},\n}\nEXAMPLES_REQ_EXTRA = {   # 请求示例(路径参数/查询参数类接口)\n    (\"GET\", \"/tasks/{tid}\"): \"GET /tasks/2\",\n    (\"GET\", \"/tasks/{tid}/events\"): \"GET /tasks/2/events?since=7\",\n    (\"POST\", \"/tasks/{tid}/destination\"): {\"box_seq\": 1, \"action\": \"place\", \"slot\": \"A-L10\", \"pit\": [3, 0, 0], \"box_mm\": [60.0, 38.5, 22.4], \"name\": \"麻腮风联合减毒活疫苗\"},\n    (\"POST\", \"/tasks/{tid}/stop\"): \"POST /tasks/2/stop\", (\"POST\", \"/tasks/{tid}/pause\"): \"POST /tasks/2/pause\", (\"POST\", \"/tasks/{tid}/resume\"): \"POST /tasks/2/resume\", (\"POST\", \"/tasks/{tid}/abort\"): \"POST /tasks/2/abor\n    (\"POST\", \"/services/{name}/{cmd}\"): \"POST /services/vision/restart\",\n}\nEVENT_KINDS = [\n93:EXAMPLES_REQ_EXTRA = {   # 请求示例(路径参数/查询参数类接口)\n279:            extra = EXAMPLES_REQ_EXTRA.get(key)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"575f3ac3-f3dd-47aa-9d91-a3c001b8aa4b","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":6,"untracked":null,"untracked_normal":11},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}