只看 get_last_error(那是历史错误列表, 会把上午的奇异翻出来)。\n\"\"\"\nSR = {0: \"启动中\", 1: \"初始化\", 2: \"未登录\", 3: \"已登录\", 4: \"已断电\", 5: \"未使能\", 6: \"已使能\"}\nSP = {0: \"程序停止\", 1: \"程序停止中\", 2: \"程序运行\", 3: \"程序暂停\", 4: \"程序暂停中\"}\nSS = {0: \"安全初始化\", 2: \"安全等待\", 3: \"安全配置\", 4: \"安全断电\", 5: \"安全正常\", 6: \"安全恢复中\",\n      7: \"安全停止2(软停)\", 8: \"安全停止1(急停,断动力)\", 9: \"安全停止0(急停,立即断电)\", 10: \"模型\", 12: \"减速模式\", 13: \"安全启动\"}\nOM = {0: \"手动模式\", 1: \"自动模式\", 2: \"远程模式\"}\n\n\ndef describe(cobot):\n    \"\"\"返回(一句话, 原始四元组)。读失败返回(\"读不到状态\", None)。\"\"\"\n    try:\n        d = cobot.get_robot_state()\n        r, p, s, m = int(d[0]), int(d[1]), int(d[2]), int(d[3])\n    except Exception as e:\n        return \"读不到状态(%s)\" % e, None\n    parts = [SR.get(r, \"机器人状态%d\" % r), SS.get(s, \"安全状态%d\" % s), OM.get(m, \"模式%d\" % m)]\n    if s in (7, 8, 9):\n        head = \"⚠️ 急停/安全停止 → 需人工: 解除急停→上电→使能\"\n    elif r == 4:\n        head = \"⚠️ 已断电 → 需人工上电\"\n    elif r == 5:\n        head = \"未使能 → 可程序使能\"\n    else:\n        head = \"正常\"\n    return head + \" [\" + \" / \".join(parts) + \"]\", (r, p, s, m)\n\n\ndef joints_or_last(cobot, rec):\n    \"\"\"急停后控制器答关节全零; 用录制的最后一个有效点代替\"\"\"\n    try:\n        j = cobot.get_actual_joints_position()\n    except Exception:\n        j = None\n    if j and len(j) == 6 and any(abs(x) > 1e-6 for x in j):\n        return list(j), \"实时\"\n    if rec:\n        return list(rec[-1][1:7]), \"停滞前最后录制点\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"c9da96b4-9934-45b9-bd66-d55e94adb3a2","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":16},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter/scripts/bluespace/se