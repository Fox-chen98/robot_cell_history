ime/runtime-state.json   # port=auto 时从这里读 apiPort","+","+# 设备主动推送事件(②)","+webhook:","+  enabled: true                  # false = 不推送, 上位机只靠 ③ 补拉; 行为与没有推送功能完全一致","+  path: /vaccine/device/webhook  # 上位机接收事件的路径(CRV: DeviceWebhookController, 只收 POST)","+  url: \"\"                        # 留空 = 用 http://<upper.host>:<upper.port><path> 自动拼; 填了完整地址就以它为准(如临时指向测试接收端 http://127.0.0.1:8904/robot/events)","+  token: \"\"   # 与 CRV 参数 crv.device.webhookToken 一致","+  token_headers: [X-Cell-Token, X-Webhook-Token]   # 口令放进哪些请求头(旧版上位机读 X-Cell-Token, 新版 CRV 读 X-Webhook-Token; 都带上)","+  timeout_s: 3.0                 # 单次投递超时","+  retries: 3                     # 失败后重试次数(间隔 2s/4s/8s), 耗尽就放弃记一笔, 靠 ③ 兜底","+  backoff_s: 2.0","+  queue_max: 2000                # 待发队列上限, 满了丢弃+计数(宁可丢也不能卡住机械臂)","+  events:                        # 推哪些事件(card/text 等刷屏事件不推)","+    - stored","+    - discarded","+    - lost","+    - retrieved","+    - outbound_scanned","+    - pit_empty","+    - code_scanned","+    - stocktake","+    - needs_human","+    - fault","+    - task_end"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/chen/Desktop/robocenter/config/upper_link.yaml"]}},"serverClassifierContext":{"request":"d7e36e57-9a57-4378-ae64-e4f390d9b6e1","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":16},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"92fadd64-bd88-4d53-a25f-83ea7924f3bc","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe",