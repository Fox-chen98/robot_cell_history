));\n  renderer.shadowMap.enabled = true;\n  container.prepend(renderer.domElement);\n\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(dark ? 0x1e293b : 0xffffff);","new_string":"function renderSlot(container, stock, geom, opts = {}) {\n  container.classList.add(\"slot3d\");\n  const tip = document.createElement(\"div\"); tip.className = \"tip\"; container.appendChild(tip);\n  const flash = document.createElement(\"div\"); flash.className = \"flash\"; container.appendChild(flash);\n  const dark = matchMedia(\"(prefers-color-scheme: dark)\").matches;\n\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });   // 透明背景: 透出网页底色, 不再是一块方框\n  renderer.setClearColor(0x000000, 0);\n  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n  renderer.shadowMap.enabled = true;\n  container.prepend(renderer.domElement);\n  if (opts.fade !== false) {                         // 从左到右渐隐(遮罩作用于整张画布, 模型/药盒/动画一起变淡)\n    const f = { from: 0.4, to: 1.0, ...(opts.fade || {}) };\n    const g = `linear-gradient(to right, #000 ${f.from * 100}%, transparent ${f.to * 100}%)`;\n    renderer.domElement.style.maskImage = renderer.domElement.style.webkitMaskImage = g;\n  }\n\n  const scene = new THREE.Scene();"},"caller":{"type":"direct"}}]}}
