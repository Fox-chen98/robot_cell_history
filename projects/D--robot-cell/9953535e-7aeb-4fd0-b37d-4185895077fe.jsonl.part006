{"parentUuid":"652dc14e-a3c5-493c-a191-bd5381ce21cc","isSidechain":false,"promptId":"a7ffe1a0-139f-4057-ad30-a310ebbd1b13","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDJjP44eZCCw4s8FAmCyqY","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"事件 webhook 投递(设备 → 上位机)。默认关闭; config/webhook.yaml 里 enabled=false 时行为与没有本模块完全一致。\n3\t\n4\t设计要点(每条都是踩过或预判的坑, 改之前先读):\n5\t 1. **绝不阻塞机械臂**: post_event() 只做 queue.put_nowait(), 微秒级返回。真正的 POST/超时/重试全在独立的送信线程里。\n6\t    cell_server.Task.emit() 跑在机械臂执行线程上——那里同步发 HTTP, 上位机一重启机械臂就僵在格口里(3s×3次=9s)。\n7\t 2. **单线程串行保序**: 一条发完(或彻底放弃)才发下一条。并发发会让 task_end 抢在 stored 前面到, 上位机以为任务完了账还没记全。\n8\t 3. **幂等键 X-Event-Id = <task_id>-<seq>**, 重试时不变。上位机必须据此去重, 否则 stored 重投一次账上多一盒。\n9\t 4. **丢了不追**: 重试耗尽就记一笔继续往下。可靠性由 GET /tasks/{id}/events?since=N 补拉兜底, 不是由这里保证。\n10\t    队列满也是同理(直接丢+计数), 宁可丢事件也不能卡住调用方。\n11\t 5. **任何异常都不向上抛**: 调用方是机械臂流程, 投递失败绝不能影响干活。\n12\t\"\"\"\n13\timport json\n14\timport os\n15\timport queue\n16\timport threading\n17\timport time\n18\timport urllib.error\n19\timport urllib.request\n20\t\n21\t_CFG = {}\n22\t_Q = None\n23\t_TH = None\n24\t_LOCK = threading.Lock()\n25\t_ST = {\"enabled\": False, \"state\": \"disabled\", \"queued\": 0, \"sent\": 0, \"failed\": 0,\n26\t       \"dropped\": 0, \"last_error\": \"\", \"last_ok_at\": \"\", \"inflight\": False}\n27\t_OUT = None          # logs/webhook_out.log: 设备自己的出站流水(每次投递尝试一行), 不依赖接收端是否留了日志\n28\t_ROOT = \"\"\n29\t\n30\t\n31\tdef _out(line):\n32\t    \"\"\"出站流水, 追加写(2026-09-22: 接收端日志被 > 覆盖后, 任务1的投递记录全丢, 设备侧 sent 计数也随服务重启归零 —— 设备必须自己留底)\"\"\"\n33\t    global _OUT\n34\t    try:\n35\t        if _OUT is None and _ROOT:\n36\t            os.makedirs(os.path.join(_ROOT, \"logs\"), exist_ok=True)\n37\t            _OUT = open(os.path.join(_ROOT, \"logs\", \"webhook_out.log\"), \"a\", encoding=\"utf-8\")\n38\t        if _OUT is not None:\n39\t            _OUT.write(\"[out %s] %s\\n\" % (time.strftime(\"%H:%M:%S\"), line)); _OUT.flush()\n40\t    except Exception:\n41\t        pass\n42\t\n43\tDEFAULTS = {\"enabled\": False, \"url\": \"\", \"token\": \"\", \"timeout_s\": 3.0, \"retries\": 3,\n44\t            \"backoff_s\": 2.0, \"queue_max\": 2000,\n45\t            \"events\": [\"stored\", \"discarded\", \"lost\", \"retrieved\", \"outbound_scanned\", \"pit_empty\",\n46\t                       \"code_scanned\", \"stocktake\", \"needs_human\", \"fault\", \"task_end\"]}\n47\t\n48\t\n49\tdef init(root, quiet=False):\n50\t    \"\"\"读配置并(在 enabled 时)起送信线程。cell_server 启动时调一次; 配置缺失/关闭都安静返回。\"\"\"\n51\t    global _CFG, _Q, _TH, _ROOT\n52\t    _ROOT = root\n53\t    cfg = dict(DEFAULTS)\n54\t    path = os.path.join(root, \"config\", \"webhook.yaml\")\n55\t    try:\n56\t        import yaml\n57\t        y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n58\t        if isinstance(y.get(\"webhook\"), dict):\n59\t            y = y[\"webhook\"]\n60\t        cfg.update({k: v for k, v in y.items() if k in DEFAULTS})\n61\t    except FileNotFoundError:\n62\t        pass\n63\t    except Exception as e:\n64\t        _ST[\"last_error\"] = \"配置读取失败: %s\" % str(e)[:80]\n65\t    _CFG = cfg\n66\t    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and cfg[\"url\"])\n67\t    if not _ST[\"enabled\"]:\n68\t        _ST[\"state\"] = \"disabled\"\n69\t        if not quiet:\n70\t            print(\"[webhook] 未启用(config/webhook.yaml enabled=false 或 url 为空), 事件仅存本地供 events?since= 拉取\", flush=True)\n71\t        return False\n72\t    _Q = queue.Queue(maxsize=int(cfg[\"queue_max\"]))\n73\t    _ST[\"state\"] = \"starting\"\n74\t    _TH = threading.Thread(target=_sender_loop, name=\"webhook-sender\", daemon=True)\n75\t    _TH.start()\n76\t    if not quiet:\n77\t        print(\"[webhook] 已启用 -> %s (超时%.1fs 重试%d次 白名单%d种)\"\n78\t              % (cfg[\"url\"], cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"])), flush=True)\n79\t    threading.Thread(target=_ping, name=\"webhook-ping\", daemon=True).start()\n80\t    return True\n81\t\n82\t\n83\tdef post_event(task_id, ev):\n84\t    \"\"\"机械臂线程调这里。只入队, 不做任何网络动作, 不抛异常。\"\"\"\n85\t    try:\n86\t        if not _ST[\"enabled\"] or _Q is None:\n87\t            return\n88\t        kind = ev.get(\"kind\")\n89\t        if _CFG.get(\"events\") and kind not in _CFG[\"events\"]:\n90\t            return                                    # 白名单外(card/text 等刷屏事件)不推, 对方按需用 events?since= 拉\n91\t        item = dict(ev)\n92\t        item[\"task_id\"] = task_id\n93\t        _Q.put_nowait(item)\n94\t        _ST[\"queued\"] = _Q.qsize()\n95\t    except queue.Full:\n96\t        with _LOCK:\n97\t            _ST[\"dropped\"] += 1\n98\t            _ST[\"last_error\"] = \"队列满(%d), 丢弃 seq=%s; 对方可用 events?since= 补拉\" % (_CFG.get(\"queue_max\", 0), ev.get(\"seq\"))\n99\t    except Exception as e:\n100\t        with _LOCK:\n101\t            _ST[\"last_error\"] = \"入队异常: %s\" % str(e)[:80]\n102\t\n103\t\n104\tdef status():\n105\t    \"\"\"给 GET /device 用的一小段状态。\"\"\"\n106\t    s = dict(_ST)\n107\t    s[\"url\"] = _CFG.get(\"url\", \"\")\n108\t    # 待发条数要把\"正在发的那一条\"算进去, 否则重试期间 /device 显示 0 条, 看着像发完了其实没有\n109\t    s[\"queued\"] = (_Q.qsize() if _Q is not None else 0) + (1 if _ST.get(\"inflight\") else 0)\n110\t    return s\n111\t\n112\t\n113\tdef _deliver(item, event_id):\n114\t    \"\"\"发一条; 返回 (成功?, 状态码或错误文字)。只在送信线程里调。\"\"\"\n115\t    body = json.dumps(item, ensure_ascii=False).encode(\"utf-8\")\n116\t    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")\n117\t    req.add_header(\"Content-Type\", \"application/json; charset=utf-8\")\n118\t    req.add_header(\"X-Event-Id\", event_id)             # 幂等键, 重试时不变\n119\t    if _CFG.get(\"token\"):\n120\t        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])\n121\t    try:\n122\t        with urllib.request.urlopen(req, timeout=float(_CFG[\"timeout_s\"])) as r:\n123\t            return (200 <= r.status < 300), str(r.status)\n124\t    except urllib.error.HTTPError as e:\n125\t        return False, \"HTTP %s\" % e.code\n126\t    except Exception as e:\n127\t        return False, type(e).__name__\n128\t\n129\t\n130\tdef _sender_loop():\n131\t    \"\"\"送信线程: 从队列取一条, 发到成功或放弃, 再取下一条(串行=保序)。\"\"\"\n132\t    retries = int(_CFG[\"retries\"])\n133\t    backoff = float(_CFG[\"backoff_s\"])\n134\t    while True:\n135\t        item = _Q.get()\n136\t        _ST[\"inflight\"] = True\n137\t        event_id = \"%s-%s\" % (item.get(\"task_id\"), item.get(\"seq\"))\n138\t        ok, info = False, \"\"\n139\t        for attempt in range(retries + 1):\n140\t            t0 = time.time()\n141\t            ok, info = _deliver(item, event_id)\n142\t            _out(\"%s %s -> %s %.0fms attempt=%d%s\" % (event_id, item.get(\"kind\"), info, (time.time() - t0) * 1000,\n143\t                                                      attempt + 1, \"\" if ok else \" RETRY\" if attempt < retries else \" GIVEUP\"))\n144\t            if ok:\n145\t                break\n146\t            if attempt < retries:\n147\t                time.sleep(backoff * (2 ** attempt))   # 2s, 4s, 8s\n148\t        with _LOCK:\n149\t            if ok:\n150\t                _ST[\"sent\"] += 1\n151\t                _ST[\"state\"] = \"ok\"\n152\t                _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n153\t            else:\n154\t                _ST[\"failed\"] += 1\n155\t                _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n156\t                _ST[\"last_error\"] = \"%s 投递失败(%s), 已放弃; 对方可用 events?since= 补拉\" % (event_id, info)\n157\t                print(\"[webhook] %s\" % _ST[\"last_error\"], flush=True)\n158\t        _ST[\"inflight\"] = False\n159\t        _Q.task_done()\n160\t\n161\t\n162\tdef _ping():\n163\t    \"\"\"启动自检: 发一条 kind=ping, 让 GET /device 能报出地址配错/口令不对, 而不是默默失败。\"\"\"\n164\t    time.sleep(1.0)\n165\t    t0 = time.time()\n166\t    ok, info = _deliver({\"task_id\": 0, \"seq\": 0, \"kind\": \"ping\", \"t\": time.strftime(\"%H:%M:%S\"),\n167\t                         \"ts\": round(time.time(), 3), \"text\": \"设备启动自检\"}, \"0-0\")\n168\t    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, (time.time() - t0) * 1000))\n169\t    with _LOCK:\n170\t        if ok:\n171\t            _ST[\"state\"] = \"ok\"\n172\t            _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n173\t        else:\n174\t            _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n175\t            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info\n176\t    print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)\n177\t"}]},"uuid":"daabfff2-9897-4a29-80c7-9ffd059dbe69","timestamp":"2026-10-28T07:41:20.358Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/chen/Desktop/robocenter/scripts/bluespace/services/webhook.py","content":"# -*- coding: utf-8 -*-\n\"\"\"事件 webhook 投递(设备 → 上位机)。默认关闭; config/webhook.yaml 里 enabled=false 时行为与没有本模块完全一致。\n\n设计要点(每条都是踩过或预判的坑, 改之前先读):\n 1. **绝不阻塞机械臂**: post_event() 只做 queue.put_nowait(), 微秒级返回。真正的 POST/超时/重试全在独立的送信线程里。\n    cell_server.Task.emit() 跑在机械臂执行线程上——那里同步发 HTTP, 上位机一重启机械臂就僵在格口里(3s×3次=9s)。\n 2. **单线程串行保序**: 一条发完(或彻底放弃)才发下一条。并发发会让 task_end 抢在 stored 前面到, 上位机以为任务完了账还没记全。\n 3. **幂等键 X-Event-Id = <task_id>-<seq>**, 重试时不变。上位机必须据此去重, 否则 stored 重投一次账上多一盒。\n 4. **丢了不追**: 重试耗尽就记一笔继续往下。可靠性由 GET /tasks/{id}/events?since=N 补拉兜底, 不是由这里保证。\n    队列满也是同理(直接丢+计数), 宁可丢事件也不能卡住调用方。\n 5. **任何异常都不向上抛**: 调用方是机械臂流程, 投递失败绝不能影响干活。\n\"\"\"\nimport json\nimport os\nimport queue\nimport threading\nimport time\nimport urllib.error\nimport urllib.request\n\n_CFG = {}\n_Q = None\n_TH = None\n_LOCK = threading.Lock()\n_ST = {\"enabled\": False, \"state\": \"disabled\", \"queued\": 0, \"sent\": 0, \"failed\": 0,\n       \"dropped\": 0, \"last_error\": \"\", \"last_ok_at\": \"\", \"inflight\": False}\n_OUT = None          # logs/webhook_out.log: 设备自己的出站流水(每次投递尝试一行), 不依赖接收端是否留了日志\n_ROOT = \"\"\n\n\ndef _out(line):\n    \"\"\"出站流水, 追加写(2026-09-22: 接收端日志被 > 覆盖后, 任务1的投递记录全丢, 设备侧 sent 计数也随服务重启归零 —— 设备必须自己留底)\"\"\"\n    global _OUT\n    try:\n        if _OUT is None and _ROOT:\n            os.makedirs(os.path.join(_ROOT, \"logs\"), exist_ok=True)\n            _OUT = open(os.path.join(_ROOT, \"logs\", \"webhook_out.log\"), \"a\", encoding=\"utf-8\")\n        if _OUT is not None:\n            _OUT.write(\"[out %s] %s\\n\" % (time.strftime(\"%H:%M:%S\"), line)); _OUT.flush()\n    except Exception:\n        pass\n\nDEFAULTS = {\"enabled\": False, \"url\": \"\", \"token\": \"\", \"timeout_s\": 3.0, \"retries\": 3,\n            \"backoff_s\": 2.0, \"queue_max\": 2000,\n            \"events\": [\"stored\", \"discarded\", \"lost\", \"retrieved\", \"outbound_scanned\", \"pit_empty\",\n                       \"code_scanned\", \"stocktake\", \"needs_human\", \"fault\", \"task_end\"]}\n\n\ndef init(root, quiet=False):\n    \"\"\"读配置并(在 enabled 时)起送信线程。cell_server 启动时调一次; 配置缺失/关闭都安静返回。\"\"\"\n    global _CFG, _Q, _TH, _ROOT\n    _ROOT = root\n    cfg = dict(DEFAULTS)\n    path = os.path.join(root, \"config\", \"webhook.yaml\")\n    try:\n        import yaml\n        y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n        if isinstance(y.get(\"webhook\"), dict):\n            y = y[\"webhook\"]\n        cfg.update({k: v for k, v in y.items() if k in DEFAULTS})\n    except FileNotFoundError:\n        pass\n    except Exception as e:\n        _ST[\"last_error\"] = \"配置读取失败: %s\" % str(e)[:80]\n    _CFG = cfg\n    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and cfg[\"url\"])\n    if not _ST[\"enabled\"]:\n        _ST[\"state\"] = \"disabled\"\n        if not quiet:\n            print(\"[webhook] 未启用(config/webhook.yaml enabled=false 或 url 为空), 事件仅存本地供 events?since= 拉取\", flush=True)\n        return False\n    _Q = queue.Queue(maxsize=int(cfg[\"queue_max\"]))\n    _ST[\"state\"] = \"starting\"\n    _TH = threading.Thread(target=_sender_loop, name=\"webhook-sender\", daemon=True)\n    _TH.start()\n    if not quiet:\n        print(\"[webhook] 已启用 -> %s (超时%.1fs 重试%d次 白名单%d种)\"\n              % (cfg[\"url\"], cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"])), flush=True)\n    threading.Thread(target=_ping, name=\"webhook-ping\", daemon=True).start()\n    return True\n\n\ndef post_event(task_id, ev):\n    \"\"\"机械臂线程调这里。只入队, 不做任何网络动作, 不抛异常。\"\"\"\n    try:\n        if not _ST[\"enabled\"] or _Q is None:\n            return\n        kind = ev.get(\"kind\")\n        if _CFG.get(\"events\") and kind not in _CFG[\"events\"]:\n            return                                    # 白名单外(card/text 等刷屏事件)不推, 对方按需用 events?since= 拉\n        item = dict(ev)\n        item[\"task_id\"] = task_id\n        _Q.put_nowait(item)\n        _ST[\"queued\"] = _Q.qsize()\n    except queue.Full:\n        with _LOCK:\n            _ST[\"dropped\"] += 1\n            _ST[\"last_error\"] = \"队列满(%d), 丢弃 seq=%s; 对方可用 events?since= 补拉\" % (_CFG.get(\"queue_max\", 0), ev.get(\"seq\"))\n    except Exception as e:\n        with _LOCK:\n            _ST[\"last_error\"] = \"入队异常: %s\" % str(e)[:80]\n\n\ndef status():\n    \"\"\"给 GET /device 用的一小段状态。\"\"\"\n    s = dict(_ST)\n    s[\"url\"] = _CFG.get(\"url\", \"\")\n    # 待发条数要把\"正在发的那一条\"算进去, 否则重试期间 /device 显示 0 条, 看着像发完了其实没有\n    s[\"queued\"] = (_Q.qsize() if _Q is not None else 0) + (1 if _ST.get(\"inflight\") else 0)\n    return s\n\n\ndef _deliver(item, event_id):\n    \"\"\"发一条; 返回 (成功?, 状态码或错误文字)。只在送信线程里调。\"\"\"\n    body = json.dumps(item, ensure_ascii=False).encode(\"utf-8\")\n    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")\n    req.add_header(\"Content-Type\", \"application/json; charset=utf-8\")\n    req.add_header(\"X-Event-Id\", event_id)             # 幂等键, 重试时不变\n    if _CFG.get(\"token\"):\n        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])\n    try:\n        with urllib.request.urlopen(req, timeout=float(_CFG[\"timeout_s\"])) as r:\n            return (200 <= r.status < 300), str(r.status)\n    except urllib.error.HTTPError as e:\n        return False, \"HTTP %s\" % e.code\n    except Exception as e:\n        return False, type(e).__name__\n\n\ndef _sender_loop():\n    \"\"\"送信线程: 从队列取一条, 发到成功或放弃, 再取下一条(串行=保序)。\"\"\"\n    retries = int(_CFG[\"retries\"])\n    backoff = float(_CFG[\"backoff_s\"])\n    while True:\n        item = _Q.get()\n        _ST[\"inflight\"] = True\n        event_id = \"%s-%s\" % (item.get(\"task_id\"), item.get(\"seq\"))\n        ok, info = False, \"\"\n        for attempt in range(retries + 1):\n            t0 = time.time()\n            ok, info = _deliver(item, event_id)\n            _out(\"%s %s -> %s %.0fms attempt=%d%s\" % (event_id, item.get(\"kind\"), info, (time.time() - t0) * 1000,\n                                                      attempt + 1, \"\" if ok else \" RETRY\" if attempt < retries else \" GIVEUP\"))\n            if ok:\n                break\n            if attempt < retries:\n                time.sleep(backoff * (2 ** attempt))   # 2s, 4s, 8s\n        with _LOCK:\n            if ok:\n                _ST[\"sent\"] += 1\n                _ST[\"state\"] = \"ok\"\n                _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n            else:\n                _ST[\"failed\"] += 1\n                _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n                _ST[\"last_error\"] = \"%s 投递失败(%s), 已放弃; 对方可用 events?since= 补拉\" % (event_id, info)\n                print(\"[webhook] %s\" % _ST[\"last_error\"], flush=True)\n        _ST[\"inflight\"] = False\n        _Q.task_done()\n\n\ndef _ping():\n    \"\"\"启动自检: 发一条 kind=ping, 让 GET /device 能报出地址配错/口令不对, 而不是默默失败。\"\"\"\n    time.sleep(1.0)\n    t0 = time.time()\n    ok, info = _deliver({\"task_id\": 0, \"seq\": 0, \"kind\": \"ping\", \"t\": time.strftime(\"%H:%M:%S\"),\n                         \"ts\": round(time.time(), 3), \"text\": \"设备启动自检\"}, \"0-0\")\n    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, (time.time() - t0) * 1000))\n    with _LOCK:\n        if ok:\n            _ST[\"state\"] = \"ok\"\n            _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n        else:\n            _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info\n    print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)\n","numLines":177,"startLine":1,"totalLines":177}},"sourceToolAssistantUUID":"652dc14e-a3c5-493c-a191-bd5381ce21cc","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.311","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"daabfff2-9897-4a29-80c7-9ffd059dbe69","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgUFuCW58LFthy7Caqmfc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LZNDcqMzNMH9zMzVYUdjGD","name":"Bash","input":{"command":"sed -n 20,32p scripts/bluespace/services/cell_server.py; sed -n 1330,1347p scripts/bluespace/services/cell_server.py; cat config/webhook.yaml | sed 's/\\(token: *\\).*/\\1<已隐藏>/' | head -12","description":"查看工作站端口定义、启动代码与现有推送配置头部"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3352,"cache_read_input_tokens":506187,"output_tokens":326,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3352,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":326,"cache_read_input_tokens":506187,"cache_creation_input_tokens":3352,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3352},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01LZNDcqMzNMH9zMzVYUdjGD":{"command":"cd /Users/chen/Desktop/robocenter && sed -n 20,32p scripts/bluespace/services/cell_server.py; sed -n 1330,1347p scripts/bluespace/services/cell_server.py; cat config/webhook.yaml | sed 's/\\(token: *\\).*/\\1<已隐藏>/' | head -12","description":"查看工作站端口定义、启动代码与现有推送配置头部"}},"wireIngestContext":{"toolu_01LZNDcqMzNMH9zMzVYUdjGD":{"cwd":"D:\\robot_cell"}},"serverClassifierRequest":"f331f2ab-3b60-46e2-95de-74991ae8670d","apiBlockIndex":1,"requestId":"req_011CgUFuBqtVuvXD5X5w15iD","requestRef":"948bb574-b1e8-416d-8f70-80ef580dfad4","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"59e35efa-2544-4057-b40b-860b5ae5ca21","timestamp":"2026-10-28T07:41:21.800Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.311","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"59e35efa-2544-4057-b40b-860b5ae5ca21","isSidechain":false,"promptId":"a7ffe1a0-139f-4057-ad30-a310ebbd1b13","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LZNDcqMzNMH9zMzVYUdjGD","type":"tool_result","content":"from fastapi.responses import FileResponse, RedirectResponse\nfrom pydantic import BaseModel, BeforeValidator, Field\nfrom tools.grasp.slotname import canon as _slot_canon\n# 2026-09-23 格口名统一为 <货架>-<列><层>(A-L10); 老名 L10 进门即转成 A-L10, 下游按新名找文件。所有入参 slot 字段用这个类型\nSlotName = Annotated[str, BeforeValidator(_slot_canon)]\nimport uvicorn\n\nPORT = 8902\nDEST_WAIT_S = 10.0          # 等上位机给去处的上限\nTAGS = [\n    {\"name\": \"盘点\", \"description\": \"POST /tasks type=stocktake {slot, columns}: 设备飞到格口降到盘点位, 深度相机一帧数每列盒数, 与 columns 逐列比对 → 事件 stocktake(字段 stocktake: compare[{ledger_count, measured_count, p, diff, suspect}], columns_found, stray). 示例见 POST /tasks 的\\\"盘点一个格口\\\". 2026-09-17\"},\n    {\"name\": \"规划\", \"description\": \"纯计算接口: 上位机传现有列表, 设备算位置(不保存). 2026-09-16 立放列=横向毫米位置\"},\n    {\"name\": \"设备状态\", \"description\": \"只读. 上位机启动时问一次能力建占用表; 状态随时查. 内部服务(视觉/扫码)对上位机不可见.\"},\n    t.pause_req = False; t.resume_evt.set()\n    return {\"ok\": True}\n\n\nif __name__ == \"__main__\":\n    print(\"[cell] 工作站服务 step3 启动: http://0.0.0.0:%d  (/docs 调试面板, /upper 简易上位机)\" % PORT, flush=True)\n    webhook.init(ROOT)                    # 事件推送(config/webhook.yaml); 未启用时安静返回, 行为与从前一致\n    try:                                  # 2026-09-10: 上次动作中途被打断时吸盘可能停在\"吹气\"态(DO7=1), 启动时拨回吸取待机\n        from hardware.gripper import DucoSuction\n        _s = DucoSuction()\n        if _s.connect():\n            if _s.get_state() == \"blowing\":\n                _s.blow_stop(); print(\"[cell] 吸盘停在吹气态, 已拨回待机\", flush=True)\n            _s.disconnect()\n    except Exception as _e:\n        print(\"[cell] 吸盘自检跳过: %s\" % _e, flush=True)\n    uvicorn.run(app, host=\"0.0.0.0\", port=PORT, log_level=\"warning\")\n# 事件 webhook 推送(设备 → 上位机)。单一来源, deploy_cell.sh 同步到 robot_cell/config/。\n# enabled=false 时行为与没有 webhook 完全一致(事件只存本地, 上位机照旧用 GET /tasks/{id}/events?since=N 拉)。\n#\n# ⚠ webhook 是\"加\"不是\"换\": 推送只负责快, 可靠性始终由 events?since= 补拉兜底。\n#   推丢了(网络抖/对方重启/队列满)账也不会错, 对方按 seq 补拉即可。\n#\n# 绑定方式 = 配置写死(2026-09-21 用户定, 不做注册接口):\n#   上位机地址固定; 注册接口必须连带做鉴权, 否则内网任意机器可把事件流(含追溯码/格口位置/库存变动)重定向走。\n#   换地址: 改这里的 url → 重启工作站服务(scripts/svc.sh restart cell) → GET /device 看 webhook.state 是否 ok。\nwebhook:\n  enabled: true                        # 改 true 才开始推送\n  url: \"http://192.168.100.212:8080/vaccine/device/webhook\"   # 2026-10-20 上位机联调地址(同事电脑, DHCP 分配, IP 变了要改); 本机假上位机=http://127.0.0.1:8904/robot/events","is_error":false}]},"uuid":"edf5a95f-f7d8-45b0-8c3f-1e50b26adaa1","timestamp":"2026-10-28T07:41:22.991Z","toolUseResult":{"stdout":"from fastapi.responses import FileResponse, RedirectResponse\nfrom pydantic import BaseModel, BeforeValidator, Field\nfrom tools.grasp.slotname import canon as _slot_canon\n# 2026-09-23 格口名统一为 <货架>-<列><层>(A-L10); 老名 L10 进门即转成 A-L10, 下游按新名找文件。所有入参 slot 字段用这个类型\nSlotName = Annotated[str, BeforeValidator(_slot_canon)]\nimport uvicorn\n\nPORT = 8902\nDEST_WAIT_S = 10.0          # 等上位机给去处的上限\nTAGS = [\n    {\"name\": \"盘点\", \"description\": \"POST /tasks type=stocktake {slot, columns}: 设备飞到格口降到盘点位, 深度相机一帧数每列盒数, 与 columns 逐列比对 → 事件 stocktake(字段 stocktake: compare[{ledger_count, measured_count, p, diff, suspect}], columns_found, stray). 示例见 POST /tasks 的\\\"盘点一个格口\\\". 2026-09-17\"},\n    {\"name\": \"规划\", \"description\": \"纯计算接口: 上位机传现有列表, 设备算位置(不保存). 2026-09-16 立放列=横向毫米位置\"},\n    {\"name\": \"设备状态\", \"description\": \"只读. 上位机启动时问一次能力建占用表; 状态随时查. 内部服务(视觉/扫码)对上位机不可见.\"},\n    t.pause_req = False; t.resume_evt.set()\n    return {\"ok\": True}\n\n\nif __name__ == \"__main__\":\n    print(\"[cell] 工作站服务 step3 启动: http://0.0.0.0:%d  (/docs 调试面板, /upper 简易上位机)\" % PORT, flush=True)\n    webhook.init(ROOT)                    # 事件推送(config/webhook.yaml); 未启用时安静返回, 行为与从前一致\n    try:                                  # 2026-09-10: 上次动作中途被打断时吸盘可能停在\"吹气\"态(DO7=1), 启动时拨回吸取待机\n        from hardware.gripper import DucoSuction\n        _s = DucoSuction()\n        if _s.connect():\n            if _s.get_state() == \"blowing\":\n                _s.blow_stop(); print(\"[cell] 吸盘停在吹气态, 已拨回待机\", flush=True)\n            _s.disconnect()\n    except Exception as _e:\n        print(\"[cell] 吸盘自检跳过: %s\" % _e, flush=True)\n    uvicorn.run(app, host=\"0.0.0.0\", port=PORT, log_level=\"warning\")\n# 事件 webhook 推送(设备 → 上位机)。单一来源, deploy_cell.sh 同步到 robot_cell/config/。\n# enabled=false 时行为与没有 webhook 完全一致(事件只存本地, 上位机照旧用 GET /tasks/{id}/events?since=N 拉)。\n#\n# ⚠ webhook 是\"加\"不是\"换\": 推送只负责快, 可靠性始终由 events?since= 补拉兜底。\n#   推丢了(网络抖/对方重启/队列满)账也不会错, 对方按 seq 补拉即可。\n#\n# 绑定方式 = 配置写死(2026-09-21 用户定, 不做注册接口):\n#   上位机地址固定; 注册接口必须连带做鉴权, 否则内网任意机器可把事件流(含追溯码/格口位置/库存变动)重定向走。\n#   换地址: 改这里的 url → 重启工作站服务(scripts/svc.sh restart cell) → GET /device 看 webhook.state 是否 ok。\nwebhook:\n  enabled: true                        # 改 true 才开始推送\n  url: \"http://192.168.100.212:8080/vaccine/device/webhook\"   # 2026-10-20 上位机联调地址(同事电脑, DHCP 分配, IP 变了要改); 本机假上位机=http://127.0.0.1:8904/robot/events","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"f331f2ab-3b60-46e2-95de-74991ae8670d","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":16},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"59e35efa-2544-4057-b40b-860b5ae5ca21","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.311","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"ae92655b330f8335859c434942087e67c59c874667638308245d98dc9354b77f","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01MDJjP44eZCCw4s8FAmCyqY","name":"Read","input":{"file_path":"/Users/chen/Desktop/robocenter/scripts/bluespace/services/webhook.py","offset":1,"limit":185},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01LZNDcqMzNMH9zMzVYUdjGD","name":"Bash","input":{"command":"cd /Users/chen/Desktop/robocenter && sed -n 20,32p scripts/bluespace/services/cell_server.py; sed -n 1330,1347p scripts/bluespace/services/cell_server.py; cat config/webhook.yaml | sed 's/\\(token: *\\).*/\\1<已隐藏>/' | head -12","description":"查看工作站端口定义、启动代码与现有推送配置头部"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"f7dca94637a2aaa836419ea9d1f89c87be4abd855dc45284a9bfda709c73c8d0","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDJjP44eZCCw4s8FAmCyqY","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"事件 webhook 投递(设备 → 上位机)。默认关闭; config/webhook.yaml 里 enabled=false 时行为与没有本模块完全一致。\n3\t\n4\t设计要点(每条都是踩过或预判的坑, 改之前先读):\n5\t 1. **绝不阻塞机械臂**: post_event() 只做 queue.put_nowait(), 微秒级返回。真正的 POST/超时/重试全在独立的送信线程里。\n6\t    cell_server.Task.emit() 跑在机械臂执行线程上——那里同步发 HTTP, 上位机一重启机械臂就僵在格口里(3s×3次=9s)。\n7\t 2. **单线程串行保序**: 一条发完(或彻底放弃)才发下一条。并发发会让 task_end 抢在 stored 前面到, 上位机以为任务完了账还没记全。\n8\t 3. **幂等键 X-Event-Id = <task_id>-<seq>**, 重试时不变。上位机必须据此去重, 否则 stored 重投一次账上多一盒。\n9\t 4. **丢了不追**: 重试耗尽就记一笔继续往下。可靠性由 GET /tasks/{id}/events?since=N 补拉兜底, 不是由这里保证。\n10\t    队列满也是同理(直接丢+计数), 宁可丢事件也不能卡住调用方。\n11\t 5. **任何异常都不向上抛**: 调用方是机械臂流程, 投递失败绝不能影响干活。\n12\t\"\"\"\n13\timport json\n14\timport os\n15\timport queue\n16\timport threading\n17\timport time\n18\timport urllib.error\n19\timport urllib.request\n20\t\n21\t_CFG = {}\n22\t_Q = None\n23\t_TH = None\n24\t_LOCK = threading.Lock()\n25\t_ST = {\"enabled\": False, \"state\": \"disabled\", \"queued\": 0, \"sent\": 0, \"failed\": 0,\n26\t       \"dropped\": 0, \"last_error\": \"\", \"last_ok_at\": \"\", \"inflight\": False}\n27\t_OUT = None          # logs/webhook_out.log: 设备自己的出站流水(每次投递尝试一行), 不依赖接收端是否留了日志\n28\t_ROOT = \"\"\n29\t\n30\t\n31\tdef _out(line):\n32\t    \"\"\"出站流水, 追加写(2026-09-22: 接收端日志被 > 覆盖后, 任务1的投递记录全丢, 设备侧 sent 计数也随服务重启归零 —— 设备必须自己留底)\"\"\"\n33\t    global _OUT\n34\t    try:\n35\t        if _OUT is None and _ROOT:\n36\t            os.makedirs(os.path.join(_ROOT, \"logs\"), exist_ok=True)\n37\t            _OUT = open(os.path.join(_ROOT, \"logs\", \"webhook_out.log\"), \"a\", encoding=\"utf-8\")\n38\t        if _OUT is not None:\n39\t            _OUT.write(\"[out %s] %s\\n\" % (time.strftime(\"%H:%M:%S\"), line)); _OUT.flush()\n40\t    except Exception:\n41\t        pass\n42\t\n43\tDEFAULTS = {\"enabled\": False, \"url\": \"\", \"token\": \"\", \"timeout_s\": 3.0, \"retries\": 3,\n44\t            \"backoff_s\": 2.0, \"queue_max\": 2000,\n45\t            \"events\": [\"stored\", \"discarded\", \"lost\", \"retrieved\", \"outbound_scanned\", \"pit_empty\",\n46\t                       \"code_scanned\", \"stocktake\", \"needs_human\", \"fault\", \"task_end\"]}\n47\t\n48\t\n49\tdef init(root, quiet=False):\n50\t    \"\"\"读配置并(在 enabled 时)起送信线程。cell_server 启动时调一次; 配置缺失/关闭都安静返回。\"\"\"\n51\t    global _CFG, _Q, _TH, _ROOT\n52\t    _ROOT = root\n53\t    cfg = dict(DEFAULTS)\n54\t    path = os.path.join(root, \"config\", \"webhook.yaml\")\n55\t    try:\n56\t        import yaml\n57\t        y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n58\t        if isinstance(y.get(\"webhook\"), dict):\n59\t            y = y[\"webhook\"]\n60\t        cfg.update({k: v for k, v in y.items() if k in DEFAULTS})\n61\t    except FileNotFoundError:\n62\t        pass\n63\t    except Exception as e:\n64\t        _ST[\"last_error\"] = \"配置读取失败: %s\" % str(e)[:80]\n65\t    _CFG = cfg\n66\t    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and cfg[\"url\"])\n67\t    if not _ST[\"enabled\"]:\n68\t        _ST[\"state\"] = \"disabled\"\n69\t        if not quiet:\n70\t            print(\"[webhook] 未启用(config/webhook.yaml enabled=false 或 url 为空), 事件仅存本地供 events?since= 拉取\", flush=True)\n71\t        return False\n72\t    _Q = queue.Queue(maxsize=int(cfg[\"queue_max\"]))\n73\t    _ST[\"state\"] = \"starting\"\n74\t    _TH = threading.Thread(target=_sender_loop, name=\"webhook-sender\", daemon=True)\n75\t    _TH.start()\n76\t    if not quiet:\n77\t        print(\"[webhook] 已启用 -> %s (超时%.1fs 重试%d次 白名单%d种)\"\n78\t              % (cfg[\"url\"], cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"])), flush=True)\n79\t    threading.Thread(target=_ping, name=\"webhook-ping\", daemon=True).start()\n80\t    return True\n81\t\n82\t\n83\tdef post_event(task_id, ev):\n84\t    \"\"\"机械臂线程调这里。只入队, 不做任何网络动作, 不抛异常。\"\"\"\n85\t    try:\n86\t        if not _ST[\"enabled\"] or _Q is None:\n87\t            return\n88\t        kind = ev.get(\"kind\")\n89\t        if _CFG.get(\"events\") and kind not in _CFG[\"events\"]:\n90\t            return                                    # 白名单外(card/text 等刷屏事件)不推, 对方按需用 events?since= 拉\n91\t        item = dict(ev)\n92\t        item[\"task_id\"] = task_id\n93\t        _Q.put_nowait(item)\n94\t        _ST[\"queued\"] = _Q.qsize()\n95\t    except queue.Full:\n96\t        with _LOCK:\n97\t            _ST[\"dropped\"] += 1\n98\t            _ST[\"last_error\"] = \"队列满(%d), 丢弃 seq=%s; 对方可用 events?since= 补拉\" % (_CFG.get(\"queue_max\", 0), ev.get(\"seq\"))\n99\t    except Exception as e:\n100\t        with _LOCK:\n101\t            _ST[\"last_error\"] = \"入队异常: %s\" % str(e)[:80]\n102\t\n103\t\n104\tdef status():\n105\t    \"\"\"给 GET /device 用的一小段状态。\"\"\"\n106\t    s = dict(_ST)\n107\t    s[\"url\"] = _CFG.get(\"url\", \"\")\n108\t    # 待发条数要把\"正在发的那一条\"算进去, 否则重试期间 /device 显示 0 条, 看着像发完了其实没有\n109\t    s[\"queued\"] = (_Q.qsize() if _Q is not None else 0) + (1 if _ST.get(\"inflight\") else 0)\n110\t    return s\n111\t\n112\t\n113\tdef _deliver(item, event_id):\n114\t    \"\"\"发一条; 返回 (成功?, 状态码或错误文字)。只在送信线程里调。\"\"\"\n115\t    body = json.dumps(item, ensure_ascii=False).encode(\"utf-8\")\n116\t    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")\n117\t    req.add_header(\"Content-Type\", \"application/json; charset=utf-8\")\n118\t    req.add_header(\"X-Event-Id\", event_id)             # 幂等键, 重试时不变\n119\t    if _CFG.get(\"token\"):\n120\t        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])\n121\t    try:\n122\t        with urllib.request.urlopen(req, timeout=float(_CFG[\"timeout_s\"])) as r:\n123\t            return (200 <= r.status < 300), str(r.status)\n124\t    except urllib.error.HTTPError as e:\n125\t        return False, \"HTTP %s\" % e.code\n126\t    except Exception as e:\n127\t        return False, type(e).__name__\n128\t\n129\t\n130\tdef _sender_loop():\n131\t    \"\"\"送信线程: 从队列取一条, 发到成功或放弃, 再取下一条(串行=保序)。\"\"\"\n132\t    retries = int(_CFG[\"retries\"])\n133\t    backoff = float(_CFG[\"backoff_s\"])\n134\t    while True:\n135\t        item = _Q.get()\n136\t        _ST[\"inflight\"] = True\n137\t        event_id = \"%s-%s\" % (item.get(\"task_id\"), item.get(\"seq\"))\n138\t        ok, info = False, \"\"\n139\t        for attempt in range(retries + 1):\n140\t            t0 = time.time()\n141\t            ok, info = _deliver(item, event_id)\n142\t            _out(\"%s %s -> %s %.0fms attempt=%d%s\" % (event_id, item.get(\"kind\"), info, (time.time() - t0) * 1000,\n143\t                                                      attempt + 1, \"\" if ok else \" RETRY\" if attempt < retries else \" GIVEUP\"))\n144\t            if ok:\n145\t                break\n146\t            if attempt < retries:\n147\t                time.sleep(backoff * (2 ** attempt))   # 2s, 4s, 8s\n148\t        with _LOCK:\n149\t            if ok:\n150\t                _ST[\"sent\"] += 1\n151\t                _ST[\"state\"] = \"ok\"\n152\t                _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n153\t            else:\n154\t                _ST[\"failed\"] += 1\n155\t                _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n156\t                _ST[\"last_error\"] = \"%s 投递失败(%s), 已放弃; 对方可用 events?since= 补拉\" % (event_id, info)\n157\t                print(\"[webhook] %s\" % _ST[\"last_error\"], flush=True)\n158\t        _ST[\"inflight\"] = False\n159\t        _Q.task_done()\n160\t\n161\t\n162\tdef _ping():\n163\t    \"\"\"启动自检: 发一条 kind=ping, 让 GET /device 能报出地址配错/口令不对, 而不是默默失败。\"\"\"\n164\t    time.sleep(1.0)\n165\t    t0 = time.time()\n166\t    ok, info = _deliver({\"task_id\": 0, \"seq\": 0, \"kind\": \"ping\", \"t\": time.strftime(\"%H:%M:%S\"),\n167\t                         \"ts\": round(time.time(), 3), \"text\": \"设备启动自检\"}, \"0-0\")\n168\t    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, (time.time() - t0) * 1000))\n169\t    with _LOCK:\n170\t        if ok:\n171\t            _ST[\"state\"] = \"ok\"\n172\t            _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n173\t        else:\n174\t            _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n175\t            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info\n176\t    print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)\n177\t"},{"tool_use_id":"toolu_01LZNDcqMzNMH9zMzVYUdjGD","type":"tool_result","content":"from fastapi.responses import FileResponse, RedirectResponse\nfrom pydantic import BaseModel, BeforeValidator, Field\nfrom tools.grasp.slotname import canon as _slot_canon\n# 2026-09-23 格口名统一为 <货架>-<列><层>(A-L10); 老名 L10 进门即转成 A-L10, 下游按新名找文件。所有入参 slot 字段用这个类型\nSlotName = Annotated[str, BeforeValidator(_slot_canon)]\nimport uvicorn\n\nPORT = 8902\nDEST_WAIT_S = 10.0          # 等上位机给去处的上限\nTAGS = [\n    {\"name\": \"盘点\", \"description\": \"POST /tasks type=stocktake {slot, columns}: 设备飞到格口降到盘点位, 深度相机一帧数每列盒数, 与 columns 逐列比对 → 事件 stocktake(字段 stocktake: compare[{ledger_count, measured_count, p, diff, suspect}], columns_found, stray). 示例见 POST /tasks 的\\\"盘点一个格口\\\". 2026-09-17\"},\n    {\"name\": \"规划\", \"description\": \"纯计算接口: 上位机传现有列表, 设备算位置(不保存). 2026-09-16 立放列=横向毫米位置\"},\n    {\"name\": \"设备状态\", \"description\": \"只读. 上位机启动时问一次能力建占用表; 状态随时查. 内部服务(视觉/扫码)对上位机不可见.\"},\n    t.pause_req = False; t.resume_evt.set()\n    return {\"ok\": True}\n\n\nif __name__ == \"__main__\":\n    print(\"[cell] 工作站服务 step3 启动: http://0.0.0.0:%d  (/docs 调试面板, /upper 简易上位机)\" % PORT, flush=True)\n    webhook.init(ROOT)                    # 事件推送(config/webhook.yaml); 未启用时安静返回, 行为与从前一致\n    try:                                  # 2026-09-10: 上次动作中途被打断时吸盘可能停在\"吹气\"态(DO7=1), 启动时拨回吸取待机\n        from hardware.gripper import DucoSuction\n        _s = DucoSuction()\n        if _s.connect():\n            if _s.get_state() == \"blowing\":\n                _s.blow_stop(); print(\"[cell] 吸盘停在吹气态, 已拨回待机\", flush=True)\n            _s.disconnect()\n    except Exception as _e:\n        print(\"[cell] 吸盘自检跳过: %s\" % _e, flush=True)\n    uvicorn.run(app, host=\"0.0.0.0\", port=PORT, log_level=\"warning\")\n# 事件 webhook 推送(设备 → 上位机)。单一来源, deploy_cell.sh 同步到 robot_cell/config/。\n# enabled=false 时行为与没有 webhook 完全一致(事件只存本地, 上位机照旧用 GET /tasks/{id}/events?since=N 拉)。\n#\n# ⚠ webhook 是\"加\"不是\"换\": 推送只负责快, 可靠性始终由 events?since= 补拉兜底。\n#   推丢了(网络抖/对方重启/队列满)账也不会错, 对方按 seq 补拉即可。\n#\n# 绑定方式 = 配置写死(2026-09-21 用户定, 不做注册接口):\n#   上位机地址固定; 注册接口必须连带做鉴权, 否则内网任意机器可把事件流(含追溯码/格口位置/库存变动)重定向走。\n#   换地址: 改这里的 url → 重启工作站服务(scripts/svc.sh restart cell) → GET /device 看 webhook.state 是否 ok。\nwebhook:\n  enabled: true                        # 改 true 才开始推送\n  url: \"http://192.168.100.212:8080/vaccine/device/webhook\"   # 2026-10-20 上位机联调地址(同事电脑, DHCP 分配, IP 变了要改); 本机假上位机=http://127.0.0.1:8904/robot/events","is_error":false}]}}
