destination\"; t.stage_code = \"WAIT_ALLOCATION\"","             t.emit(\"code_scanned\", box_seq=t.box_seq, code=code, size_mm=[round(x, 1) for x in lwh], awaiting_destination=True)","             ok = t.dest_evt.wait(DEST_WAIT_S)","             t.state = \"running\"; t.awaiting_seq = None"]},{"oldStart":735,"oldLines":7,"newStart":750,"newLines":7,"lines":["                     os.makedirs(os.path.join(ROOT, \"data\", \"stocktake\"), exist_ok=True)","                     exp_path = os.path.join(ROOT, \"data\", \"stocktake\", \"%s_expected.json\" % t.req.slot)","                     json.dump({\"slot\": t.req.slot, \"columns\": [c.model_dump() for c in t.req.columns]}, open(exp_path, \"w\", encoding=\"utf-8\"), ensure_ascii=False)","-                t.box_seq = 1; t.current = {\"t_box0\": time.time(), \"box_seq\": 1, \"slot\": t.req.slot}; t.stage = \"盘点\"","+                t.box_seq = 1; t.current = {\"t_box0\": time.time(), \"box_seq\": 1, \"slot\": t.req.slot}; t.stage_code = \"STOCKTAKING\"","                 t.emit(\"box_start\", box_seq=1, slot=t.req.slot, code=None); t0 = time.time()","                 try:","                     st = sfl.run(t.req.slot, exp_path)"]},{"oldStart":760,"oldLines":7,"newStart":775,"newLines":7,"lines":["                 if t.req.stop.minutes and time.time() - t.started >= t.req.stop.minutes * 60: outcome = (\"finished\", \"time_up\"); break","                 if t.req.type == \"store\" and t.req.destination == \"fixed\" and t.progress[\"stored\"] >= len(pits): outcome = (\"finished\", \"pits_exhausted\"); break","                 if t.pause_req:","-                    t.state = \"paused\"; t.stage = \"暂停(在home)\"; t.emit(\"paused\", box_seq=t.box_seq)","+                    t.state = \"paused\"; t.stage_code = \"PAUSED\"; t.emit(\"paused\", box_seq=t.box_seq)","                     t.resume_evt.clear(); t.resume_evt.wait(); t.pause_req = False","                     if t.stop_req: outcome = (\"finished\", \"stopped\"); break","