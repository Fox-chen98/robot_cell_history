" link2=\"suction_cup_link\" reason=\"cable-hugs-arm\"/>","+  <disable_collisions link1=\"cable_bracket\" link2=\"ground_link\" reason=\"cable-hugs-arm\"/>","+  <disable_collisions link1=\"cable_bigarm\" link2=\"cable_elbow\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_bigarm\" link2=\"cable_forearm\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_bigarm\" link2=\"cable_loop\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_bigarm\" link2=\"cable_bracket\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_elbow\" link2=\"cable_forearm\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_elbow\" link2=\"cable_loop\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_elbow\" link2=\"cable_bracket\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_forearm\" link2=\"cable_loop\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_forearm\" link2=\"cable_bracket\" reason=\"cable-self\"/>","+  <disable_collisions link1=\"cable_loop\" link2=\"cable_bracket\" reason=\"cable-self\"/>","+<!-- CABLE_ENV END -->","+</robot>"]}],"created":true},{"filePath":"/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/config/initial_positions.yaml","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":10,"lines":["+# Default initial positions for gcr10_1300's ros2_control fake system","+# J1=1.96° J2=50.88° J3=-120.91° J4=1.60° J5=92.10° J6=-2.40°","+","+initial_positions:","+  arm_1_joint_1: 0.034208","+  arm_1_joint_2: 0.888024","+  arm_1_joint_3: -2.110278","+  arm_1_joint_4: 0.027925","+  arm_1_joint_5: 1.607448","+  arm_1_joint_6: -0.041888"]}],"created":true},{"filePath":"/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/launch/foxglove_demo.launch.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":84,"lines":["+from launch import LaunchDescription","+from launch.actions import IncludeLaunchDescription","+from launch.launch_description_sources import PythonLaunchDescriptionSource","+from launch_ros.actions import Node","+from moveit_configs_utils import MoveItConfigsBuilder","+","+","+def generate_launch_description():","+    moveit_config = (","+        MoveItConfigsBuilder(\"gcr10_1300\", package_name=\"duco_gcr10_1300_moveit_config\")","+        .to_moveit_configs()","+    )","+    launch_package_path = moveit_config.package_path","+","+    ld = LaunchDescription()","+","+    # Static virtual joint TFs","+    virtual_joints_launch = launch_package_path / \"launch/static_virtual_joint_tfs.launch.py\"","+    if virtual_joints_launch.exists():","+        ld.add_action(","+            IncludeLaunchDescription(","+                PythonLaunchDescriptionSource(str(virtual_joints_launch)),","+            )","+        )","+","+    # Robot state publisher","+    ld.add_action(","+        IncludeLaunchDescription(","+            PythonLaunchDescriptionSource(","+                str(launch_package_path / \"launch/rsp.launch.py\")","+            ),","+        )","+    )","+","+    # Move group","+    ld.add_action(","+        IncludeLaunchDescription(","+            PythonLaunchDescriptionSource(","+                str(launch_package_path / \"launch/move_group.launch.py\")","+            ),","+        )","+    )","+","+    # ros2_control with mock hardware","+    ld.add_action(","+        Node(","+            package=\"controller_manager\",","+            executable=\"ros2_control_node\",","+            parameters=[","+                moveit_config.robot_description,","+                str(moveit_config.package_path / \"config/ros2_controllers.yaml\"),","+            ],","+        )","+    )","+","+    # Spawn controllers","+    ld.add_action(","+        Node(","+            package=\"controller_manager\",","+            executable=\"spawner\",","+            arguments=[\"joint_state_broadcaster\", \"--controller-manager\", \"/controller_manager\"],","+        )","+    )","+    ld.add_action(","+        Node(","+            package=\"controller_manager\",","+            executable=\"spawner\",","+            arguments=[\"arm_1_controller\", \"--controller-manager\", \"/controller_manager\"],","+        )","+    )","+","+    # Foxglove Bridge with asset URI allowlist for mesh loading","+    ld.add_action(","+        Node(","+            package=\"foxglove_bridge\",","+            executable=\"foxglove_bridge\",","+            parameters=[","+                {\"port\": 8765},","+                {\"asset_uri_allowlist\": [\"^package://.*\"]},","+            ],","+        )","+    )","+","+    return ld"]}],"created":true},{"filePath":"/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/scripts/task_scene.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":261,"lines":["+#!/usr/bin/env python3","+\"\"\"","+任务场景构建脚本","+使用STL mesh文件加载货架模型到MoveIt规划场景","+","+使用方法:","+    ros2 run duco_gcr10_1300_moveit_config task_scene.py","+","+参数:","+    shelf_x: 货架X位置 (默认: 0.7m)","+    shelf_y: 货架Y位置 (默认: 0.0m)","+    shelf_z: 货架Z位置 (默认: 0.0m)","+    add_ground: 是否添加地面 (默认: true)","+\"\"\"","+","+import rclpy","+from rclpy.node import Node","+from moveit_msgs.msg import CollisionObject, PlanningScene","+from moveit_msgs.srv import ApplyPlanningScene","+from shape_msgs.msg import SolidPrimitive, Mesh, MeshTriangle","+from geometry_msgs.msg import Pose, Point","+from std_msgs.msg import Header","+import time","+import struct","+import os","+import math","+","+from ament_index_python.packages import get_package_share_directory","+","+","+class TaskSceneBuilder(Node):","+    \"\"\"任务场景构建器 - 使用STL mesh加载货架\"\"\"","+","+    def __init__(self):","+        super().__init__('task_scene_builder')","+","+        # 声明参数","+        self.declare_parameter('shelf_x', 0.0)","+        self.declare_parameter('shelf_y', 1.5)","+        self.declare_parameter('shelf_z', 0.0)","+        self.declare_parameter('shelf_yaw', 0.0)","+        self.declare_parameter('add_ground', True)","+        self.declare_parameter('ground_z', 0.0)","+","+        # 使用服务接口 (最可靠的方式)","+        self.apply_scene_client = self.create_client(","+            ApplyPlanningScene,","+            '/apply_planning_scene'","+        )","+","+        # 备用: 发布者","+        self.scene_pub = self.create_publisher(","+            PlanningScene,","+            '/monitored_planning_scene',","+            10","+        )","+","+        self.get_logger().info('任务场景构建器已启动')","+","+    def load_binary_stl(self, stl_path: str) -> Mesh:","+        \"\"\"","+        加载二进制STL文件并转换为ROS Mesh消息","+","+        Args:","+            stl_path: STL文件路径 (单位: 米)","+","+        Returns:","+            shape_msgs/Mesh","+        \"\"\"","+        mesh = Mesh()","+","+        with open(stl_path, 'rb') as f:","+            # 读取STL header (80 bytes)","+            header = f.read(80)","+","+            # 读取三角形数量 (4 bytes, uint32)","+            num_triangles = struct.unpack('<I', f.read(4))[0]","+","+            self.get_logger().info(f'加载STL: {os.path.basename(stl_path)}, 三角形数量: {num_triangles}')","+","+            # 用于去重顶点","+            vertex_map = {}","+            vertices = []","+","+            for i in range(num_triangles):","+                # 法向量 (12 bytes, 3 floats) - 跳过","+                f.read(12)","+","+                # 三个顶点 (36 bytes, 9 floats)","+                v1 = struct.unpack('<fff', f.read(12))","+                v2 = struct.unpack('<fff', f.read(12))","+                v3 = struct.unpack('<fff', f.read(12))","+","+                # 属性字节 (2 bytes) - 跳过","+                f.read(2)","+","+                triangle = MeshTriangle()","+","+                for idx, v in enumerate([v1, v2, v3]):","+                    # STL单位是米，不需要缩放","+                    v_key = (round(v[0], 6), round(v[1], 6), round(v[2], 6))","+","+                    if v_key not in vertex_map:","+                        vertex_map[v_key] = len(vertices)","+                        point = Point()","+                        point.x = v[0]","+                        point.y = v[1]","+                        point.z = v[2]","+                        vertices.append(point)","+","+                    triangle.vertex_indices[idx] = vertex_map[v_key]","+","+                mesh.triangles.append(triangle)","+","+            mesh.vertices = vertices","+","+        self.get_logger().info(f'Mesh加载完成: {len(mesh.vertices)} 顶点, {len(mesh.triangles)} 三角形')","+        return mesh","+","+    def create_shelf_collision_object(self) -> CollisionObject:","+        \"\"\"使用STL mesh创建货架碰撞物体\"\"\"","+","+        shelf_x = self.get_parameter('shelf_x').value","+        shelf_y = self.get_parameter('shelf_y').value","+        shelf_z = self.get_parameter('shelf_z').value","+        shelf_yaw = self.get_parameter('shelf_yaw').value","+","+        obj = CollisionObject()","+        obj.header.frame_id = \"world\"","+        obj.header.stamp = self.get_clock().now().to_msg()","+        obj.id = \"shelf\"","+","+        pose = Pose()","+        pose.position.x = shelf_x","+        pose.position.y = shelf_y","+        pose.position.z = shelf_z","+","+        # 四元数表示yaw旋转","+        pose.orientation.x = 0.0","+        pose.orientation.y = 0.0","+        pose.orientation.z = math.sin(shelf_yaw / 2)","+        pose.orientation.w = math.cos(shelf_yaw / 2)","+","+        try:","+            pkg_share = get_package_share_directory('duco_support')","+            stl_path = os.path.join(pkg_share, 'meshes', 'accessories', 'shelf.STL')","+","+            if not os.path.exists(stl_path):","+                self.get_logger().error(f'STL文件不存在: {stl_path}')","+                return None","+","+            mesh = self.load_binary_stl(stl_path)","+            obj.meshes.append(mesh)","+            obj.mesh_poses.append(pose)","+","+            self.get_logger().info(f'货架已创建: 位置=({shelf_x}, {shelf_y}, {shelf_z})')","+","+        except Exception as e:","+            self.get_logger().error(f'加载货架STL失败: {e}')","+            return None","+","+        obj.operation = CollisionObject.ADD","+        return obj","+","+    def create_ground(self) -> CollisionObject:","+        \"\"\"创建地面碰撞物体\"\"\"","+        ground_z = self.get_parameter('ground_z').value","+","+        obj = CollisionObject()","+        obj.header.frame_id = \"world\"","+        obj.header.stamp = self.get_clock().now().to_msg()","+        obj.id = \"ground\"","+","+        box = SolidPrimitive()","+        box.type = SolidPrimitive.BOX","+        box.dimensions = [4.0, 4.0, 0.02]","+","+        pose = Pose()","+        pose.position.x = 0.0","+        pose.position.y = 0.0","+        pose.position.z = ground_z - 0.01","+        pose.orientation.w = 1.0","+","+        obj.primitives.append(box)","+        obj.primitive_poses.append(pose)","+        obj.operation = CollisionObject.ADD","+","+        self.get_logger().info('地面已创建')","+        return obj","+","+    def publish_scene(self):","+        \"\"\"发布完整场景\"\"\"","+        all_objects = []","+","+        # 货架","+        shelf = self.create_shelf_collision_object()","+        if shelf:","+            all_objects.append(shelf)","+","+        # 地面","+        if self.get_parameter('add_ground').value:","+            ground = self.create_ground()","+            all_objects.append(ground)","+","+        if not all_objects:","+            self.get_logger().warn('没有物体需要发布')","+            return","+","+        # 构建PlanningScene消息","+        scene = PlanningScene()","+        scene.is_diff = True","+        scene.world.collision_objects = all_objects","+","+        # 方法1: 使用服务 (最可靠)","+        self.get_logger().info('等待 /apply_planning_scene 服务...')","+        if self.apply_scene_client.wait_for_service(timeout_sec=10.0):","+            request = ApplyPlanningScene.Request()","+            request.scene = scene","+","+            future = self.apply_scene_client.call_async(request)","+            rclpy.spin_until_future_complete(self, future, timeout_sec=5.0)","+","+            if future.result() is not None and future.result().success:","+                self.get_logger().info(f'场景发布成功 (via service): {len(all_objects)} 个物体')","+                return","+            else:","+                self.get_logger().warn('服务调用失败，尝试话题发布')","+        else:","+            self.get_logger().warn('服务不可用，尝试话题发布')","+","+        # 方法2: 使用话题发布 (备用)","+        for _ in range(5):","+            self.scene_pub.publish(scene)","+            time.sleep(0.2)","+        self.get_logger().info(f'场景发布完成 (via topic): {len(all_objects)} 个物体')","+","+","+def main(args=None):","+    rclpy.init(args=args)","+    node = TaskSceneBuilder()","+","+    # 等待系统稳定","+    time.sleep(1.0)","+","+    # 发布场景","+    node.publish_scene()","+","+    # 保持运行一段时间确保消息发送","+    try:","+        for _ in range(10):","+            rclpy.spin_once(node, timeout_sec=0.5)","+    except KeyboardInterrupt:","+        pass","+    finally:","+        node.get_logger().info('场景构建器退出')","+        node.destroy_node()","+        rclpy.shutdown()","+","+","+if __name__ == '__main__':","+    main()"]}],"created":true},{"filePath":"/Users/chen/Desktop/robocenter/scripts/serverside/stack/duco_joint_relay.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":86,"lines":["+#!/usr/bin/env python3","+\"\"\"DUCO 关节中继(增强版) — 部署在 AutoDL，监听 TCP(9095):","+- 收到 [j1..j6]                 -> 实时帧, 作为当前姿态(live follow)","+- 收到 {\"traj\":[[t,j1..j6],...]} -> 整条轨迹, 按时间线性插值平滑回放(解耦网络抖动)","+统一以 50Hz 发布 /joint_states。","+注意: 方法名不要用 `handle`(会覆盖 rclpy.Node 的 handle 属性导致节点创建崩溃)。\"\"\"","+import socket, json, threading, time","+import rclpy","+from rclpy.node import Node","+from sensor_msgs.msg import JointState","+","+JN = [\"arm_1_joint_1\", \"arm_1_joint_2\", \"arm_1_joint_3\",","+      \"arm_1_joint_4\", \"arm_1_joint_5\", \"arm_1_joint_6\"]","+PORT = 9095","+","+class Relay(Node):","+    def __init__(self):","+        super().__init__(\"duco_joint_relay\")","+        self.pub = self.create_publisher(JointState, \"/joint_states\", 10)","+        self.latest = None","+        self.lock = threading.Lock()","+        threading.Thread(target=self.server, daemon=True).start()","+        self.create_timer(0.02, self.tick)   # 50Hz 发布","+        self.get_logger().info(\"中继(增强版)启动, 监听 0.0.0.0:%d\" % PORT)","+","+    def server(self):","+        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)","+        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)","+        s.bind((\"0.0.0.0\", PORT)); s.listen(1)","+        while True:","+            conn, addr = s.accept()","+            self.get_logger().info(\"客户端连接: %s\" % str(addr))","+            buf = b\"\"","+            with conn:","+                while True:","+                    data = conn.recv(65536)","+                    if not data: break","+                    buf += data","+                    while b\"\\n\" in buf:","+                        line, buf = buf.split(b\"\\n\", 1)","+                        if not line.strip(): continue","+                        try: self.on_msg(json.loads(line))","+                        except Exception as e: self.get_logger().warn(\"解析失败: %s\" % e)","+            self.get_logger().info(\"客户端断开\")","+","+    def on_msg(self, msg):","+        if isinstance(msg, list) and len(msg) == 6:","+            with self.lock: self.latest = [float(x) for x in msg]","+        elif isinstance(msg, dict) and \"traj\" in msg:","+            threading.Thread(target=self.replay, args=(msg[\"traj\"],), daemon=True).start()","+","+    def replay(self, traj):","+        pts = [(float(p[0]), [float(x) for x in p[1:7]]) for p in traj if len(p) >= 7]","+        if not pts: return","+        t_end = pts[-1][0]","+        self.get_logger().info(\"轨迹回放: %d 点, 时长 %.2fs\" % (len(pts), t_end))","+        start = time.time(); i = 0","+        while rclpy.ok():","+            e = time.time() - start","+            if e >= t_end:","+                with self.lock: self.latest = pts[-1][1]","+                break","+            while i < len(pts) - 2 and pts[i+1][0] < e: i += 1","+            t0, j0 = pts[i]; t1, j1 = pts[i+1]","+            a = (e - t0) / (t1 - t0) if t1 > t0 else 0.0","+            a = max(0.0, min(1.0, a))","+            q = [j0[k] + a * (j1[k] - j0[k]) for k in range(6)]","+            with self.lock: self.latest = q","+            time.sleep(0.01)   # 100Hz 插值","+        self.get_logger().info(\"轨迹回放结束\")","+","+    def tick(self):","+        with self.lock: l = self.latest","+        if l is None: return","+        m = JointState(); m.header.stamp = self.get_clock().now().to_msg()","+        m.name = JN; m.position = l","+        self.pub.publish(m)","+","+def main():","+    rclpy.init(); n = Relay()","+    try: rclpy.spin(n)","+    except KeyboardInterrupt: pass","+    n.destroy_node(); rclpy.shutdown()","+","+if __name__ == \"__main__\":","+    main()"]}],"created":true}],"moreFiles":11,"changedFiles":["/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/config/gcr10_1300.srdf","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/config/initial_positions.yaml","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/launch/foxglove_demo.launch.py","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_gcr10_1300_moveit_config/scripts/task_scene.py","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_support/meshes/GCR10_1300/suction_cup.STL","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_support/meshes/accessories/shelf.STL","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_support/meshes/accessories/suction_cup.STL","/Users/chen/Desktop/robocenter/scripts/serverside/duco_driver_patch/duco_support/urdf/duco_gcr10_13