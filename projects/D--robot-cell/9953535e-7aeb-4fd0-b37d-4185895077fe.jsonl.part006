{"type":"bridge-session","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","bridgeSessionId":"cse_01SoknaJYdxMuRhrGtZYtRPv","lastSequenceNum":13639,"ownerAccountUuid":"b6adc3b5-c8e6-4193-9c5d-b3a726cd6f86","ownerOrganizationUuid":"ac90d4f7-a6f0-44de-95bc-eed28854da0d"}
{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"f8cb480e56edf48e250fb3b8e15a76169318ee173945a4e3e5e83a8b1b37198b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"thinking","thinking":"配色已通过校验：上苗蓝、发苗青、退苗紫在色盲和正常视觉下均可区分,青色对比度稍低会标数值并提供表格视图。页面结构已定好：顶部筛选、6个核心指标、多张趋势/构成图表及每日明细表,均支持悬停提示和时间范围联动更新。\n\n","signature":""},{"type":"tool_use","id":"toolu_01U3qQkHHTzacnQPm3BLD9s7","name":"Write","input":{"file_path":"/Users/chen/Desktop/robocenter/docs/首页改版/统计报表.html","content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>统计报表</title>\n<!--\n  统计报表页效果图(演示数据, 纯 SVG 无外部依赖, 离线可开)\n  结构: 筛选行 → 6 个核心指标(比上期) → 出入库趋势 + 在库品种构成 → 丢回原因 / 单盒用时 / 效期结构 → 作业时段热力图 + 品种发苗排名 → 每日明细表\n  配色: 系列 上苗 蓝 / 发苗 青 / 退苗 紫(校验脚本通过, 青色对比 2.87 → 柱顶直标数值 + 明细表兜底)\n        状态色只用于效期与异常: 红=已过期 橙=30 天内 黄=90 天内; 量级(热力图/单品种条)用单一蓝色由浅到深\n-->\n<style>\n:root{--bg:#eef2f7;--card:#fff;--ink:#1f2633;--ink2:#5d6b7e;--ink3:#98a3b3;--line:#e3e8ef;--grid:#eef1f6;\n  --s1:#1f6fff;--s2:#13a89e;--s3:#8b5cf6;--blue2:#e8f0ff;\n  --red:#e5484d;--red2:#fdecec;--orange:#f08a24;--orange2:#fef3e6;--yellow:#e5a50a;--yellow2:#fdf6e0;--ok:#7f8ea3;\n  --r:14px;--num:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:linear-gradient(180deg,#f3f6fb 0%,#e9eef6 100%) fixed;background-color:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}\na{color:inherit;text-decoration:none}\n.top{position:sticky;top:0;z-index:20;height:60px;display:flex;align-items:center;gap:22px;padding:0 28px;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);border-bottom:1px solid rgba(227,232,239,.8)}\n.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}\n.logo svg{width:30px;height:30px}\nnav{display:flex;gap:2px}\nnav a{padding:6px 14px;border-radius:8px;color:var(--ink2);font-size:14px}\nnav a.on{color:var(--s1);background:var(--blue2);font-weight:600}\n.top .sp{flex:1}\n.user{display:flex;align-items:center;gap:8px;font-size:13px}\n.user span{width:32px;height:32px;border-radius:50%;background:var(--s1);color:#fff;display:grid;place-items:center;font-weight:700}\n\n.wrap{max-width:1680px;margin:0 auto;padding:20px 28px 40px;display:flex;flex-direction:column;gap:18px}\n.title{display:flex;align-items:flex-end;gap:12px}\n.title h1{font-size:22px}\n.title small{color:var(--ink3);font-size:13px;margin-bottom:3px}\n.card{background:var(--card);border-radius:var(--r);box-shadow:0 1px 2px rgba(20,40,80,.04),0 6px 24px rgba(20,40,80,.05)}\n\n/* 筛选行 */\n.filters{display:flex;align-items:center;gap:12px;padding:12px 16px;flex-wrap:wrap}\n.seg{display:flex;background:#f2f5f9;border-radius:9px;padding:3px}\n.seg button{border:0;background:none;font:inherit;font-size:13px;padding:5px 14px;border-radius:7px;color:var(--ink2);cursor:pointer}\n.seg button.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(20,40,80,.1)}\n.fl{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink2)}\n.fl select,.fl .date{height:32px;border:1px solid var(--line);border-radius:8px;padding:0 10px;font:inherit;font-size:13px;color:var(--ink);background:#fff}\n.fl .date{display:flex;align-items:center;gap:6px;color:var(--ink2)}\n.filters .sp{flex:1}\n.btn{height:32px;padding:0 14px;border-radius:8px;border:1px solid var(--line);background:#fff;font:inherit;font-size:13px;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;gap:6px}\n.btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}\n.btn.pri{background:var(--s1);border-color:var(--s1);color:#fff}\n\n/* 指标 */\n.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}\n.kpi{padding:14px 18px 12px}\n.kpi .k{font-size:13px;color:var(--ink2);display:flex;align-items:center;gap:6px}\n.kpi .k i{width:8px;height:8px;border-radius:2px}\n.kpi .v{display:flex;align-items:baseline;gap:4px;margin-top:4px}\n.kpi .v b{font:700 30px/1.1 var(--num)}\n.kpi .v span{font-size:12.5px;color:var(--ink3)}\n.kpi .d{font-size:12px;color:var(--ink3);margin-top:3px}\n.kpi .d b{font-weight:600;color:var(--ink2)}\n.kpi .d b.good::before{content:\"▲ \"}.kpi .d b.bad::before{content:\"▼ \"}\n.kpi .d b.good{color:#0b8a7f}.kpi .d b.bad{color:var(--red)}\n\n/* 图卡 */\n.grid{display:grid;gap:18px}\n.g84{grid-template-columns:minmax(0,8fr) minmax(0,4fr)}\n.g444{grid-template-columns:repeat(3,minmax(0,1fr))}\n.g66{grid-template-columns:repeat(2,minmax(0,1fr))}\n.panel{padding:16px 20px 14px;position:relative;display:flex;flex-direction:column;min-width:0}\n.ph{display:flex;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap}\n.ph h3{font-size:15.5px}\n.ph .sub{font-size:12px;color:var(--ink3)}\n.ph .right{margin-left:auto;display:flex;gap:8px;align-items:center}\n.lg{display:flex;gap:14px;font-size:12px;color:var(--ink2)}\n.lg span{display:inline-flex;align-items:center;gap:5px}\n.lg i{width:10px;height:10px;border-radius:3px}\n.mini{font-size:12px;color:var(--s1);cursor:pointer;border:0;background:none}\nsvg.ch{width:100%;display:block;overflow:visible}\n.note{font-size:12px;color:var(--ink3);margin-top:6px}\n.note b{color:var(--ink2);font-weight:600}\n\n.hb{display:flex;flex-direction:column;gap:9px;margin-top:8px}\n.hb .r{display:grid;grid-template-columns:118px 1fr 56px;align-items:center;gap:10px;font-size:12.5px;cursor:default}\n.hb .r .n{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink2)}\n.hb .r .t{height:14px;background:var(--grid);border-radius:4px;overflow:hidden}\n.hb .r .t i{display:block;height:100%;border-radius:0 4px 4px 0;background:var(--s1)}\n.hb .r .val{text-align:right;font:700 14px var(--num);color:var(--ink)}\n.hb .r:hover .t i{filter:brightness(1.08)}\n.hb .r:hover .n{color:var(--ink)}\n\n.exp{display:flex;height:28px;border-radius:8px;overflow:hidden;gap:2px;margin:12px 0 10px}\n.exp div{height:100%}\n.expl{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}\n.expl div{display:flex;gap:8px;align-items:flex-start;padding:8px 10px;border-radius:9px;background:#f7f9fc}\n.expl .ic{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;color:#fff;font:700 11px/1 var(--num);flex:none;margin-top:2px}\n.expl small{display:block;font-size:12px;color:var(--ink2)}\n.expl b{font:700 18px var(--num)}\n.expl em{font-style:normal;font-size:11.5px;color:var(--ink3)}\n\n.heatlg{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink3)}\n.heatlg i{width:16px;height:10px;border-radius:2px}\n\ntable{width:100%;border-collapse:collapse;font-size:13px}\nth{font-weight:500;color:var(--ink3);text-align:right;padding:9px 12px;border-bottom:1px solid var(--line);font-size:12.5px;white-space:nowrap;position:sticky;top:0;background:#fff}\ntd{padding:9px 12px;text-align:right;border-bottom:1px solid #f1f4f8;font-family:var(--num);font-weight:600;font-size:14px}\nth:first-child,td:first-child{text-align:left}\ntd:first-child{font-family:inherit;font-weight:500;font-size:13px}\ntbody tr:hover td{background:#f7f9fd}\ntfoot td{background:#f7f9fc;border-top:1px solid var(--line);font-weight:700}\n.tblwrap{max-height:360px;overflow:auto;margin-top:6px}\ntd .pc{display:inline-block;width:40px;height:6px;border-radius:3px;background:var(--grid);margin-right:6px;vertical-align:middle;overflow:hidden}\ntd .pc i{display:block;height:100%;background:var(--s1)}\n\n.tip{position:fixed;z-index:50;pointer-events:none;background:#fff;border:1px solid var(--line);border-radius:9px;padding:8px 11px;font-size:12.5px;box-shadow:0 10px 30px rgba(20,40,80,.14);display:none;min-width:130px}\n.tip .h{font-weight:700;margin-bottom:3px}\n.tip .row{display:flex;align-items:center;gap:6px;justify-content:space-between}\n.tip .row span{display:inline-flex;align-items:center;gap:6px;color:var(--ink2)}\n.tip .row i{width:8px;height:8px;border-radius:2px}\n.tip .row b{font-family:var(--num)}\n\n@media (max-width:1280px){.kpis{grid-template-columns:repeat(3,1fr)}.g84,.g444,.g66{grid-template-columns:1fr}}\n@media (max-width:640px){.wrap{padding:16px}.top{padding:0 16px}nav{display:none}.kpis{grid-template-columns:repeat(2,1fr)}.hb .r{grid-template-columns:90px 1fr 44px}}\n@media print{.top,.filters .btn{display:none}body{background:#fff}.card{box-shadow:none;border:1px solid var(--line)}}\n</style>\n</head>\n<body>\n<header class=\"top\">\n  <div class=\"logo\"><svg viewBox=\"0 0 40 40\"><path d=\"M6 26l14-16 4 4-14 16z\" fill=\"#f5a623\"/><path d=\"M16 30L32 8l3 3-16 22z\" fill=\"#1f6fff\"/><path d=\"M12 32h22\" stroke=\"#1f6fff\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>冷链自动发苗机器人</div>\n  <nav><a href=\"#\">首页</a><a href=\"#\">上苗管理</a><a href=\"#\">发苗管理</a><a href=\"#\">库存管理</a><a href=\"#\">设备管理</a><a class=\"on\" href=\"#\">统计报表</a><a href=\"#\">追溯码对照</a></nav>\n  <div class=\"sp\"></div>\n  <div class=\"user\"><span>王</span><b>王医生</b></div>\n</header>\n\n<div class=\"wrap\">\n  <div class=\"title\"><h1>统计报表</h1><small id=\"rangeTxt\"></small></div>\n\n  <div class=\"card filters\">\n    <div class=\"seg\" id=\"range\">\n      <button data-r=\"1\">今日</button><button data-r=\"7\" class=\"on\">近 7 天</button><button data-r=\"30\">近 30 天</button><button data-r=\"m\">本月</button>\n    </div>\n    <div class=\"fl\"><span class=\"date\">📅 <span id=\"dateTxt\"></span></span></div>\n    <div class=\"fl\">品种 <select id=\"vac\"><option value=\"\">全部品种</option></select></div>\n    <div class=\"fl\">货架 <select><option>全部</option><option>货架 A</option></select></div>\n    <div class=\"sp\"></div>\n    <button class=\"btn\" onclick=\"print()\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z\"/></svg>打印</button>\n    <button class=\"btn pri\" id=\"exp\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3v12M7 10l5 5 5-5M5 21h14\"/></svg>导出 Excel</button>\n  </div>\n\n  <div class=\"kpis\" id=\"kpis\"></div>\n\n  <div class=\"grid g84\">\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>出入库趋势</h3><span class=\"sub\">单位：支</span>\n        <div class=\"right lg\"><span><i style=\"background:var(--s1)\"></i>上苗</span><span><i style=\"background:var(--s2)\"></i>发苗</span><span><i style=\"background:var(--s3)\"></i>退苗</span></div></div>\n      <svg class=\"ch\" id=\"trend\" height=\"280\"></svg>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>在库品种构成</h3><span class=\"sub\">当前 · 支</span></div>\n      <div class=\"hb\" id=\"stockMix\"></div>\n      <div class=\"note\" id=\"stockNote\"></div>\n    </div>\n  </div>\n\n  <div class=\"grid g444\">\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>入库丢回原因</h3><span class=\"sub\" id=\"discSub\"></span></div>\n      <div class=\"hb\" id=\"disc\"></div>\n      <div class=\"note\">占比最高的原因优先处理；\"上位机拒收\"需在库存账目里核实</div>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>单盒用时</h3><span class=\"sub\">日均 · 秒/盒</span></div>\n      <svg class=\"ch\" id=\"takt\" height=\"190\"></svg>\n      <div class=\"note\" id=\"taktNote\"></div>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>库存效期结构</h3><span class=\"sub\">按距过期天数 · 支</span></div>\n      <div class=\"exp\" id=\"expBar\"></div>\n      <div class=\"expl\" id=\"expL\"></div>\n    </div>\n  </div>\n\n  <div class=\"grid g66\">\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>作业时段分布</h3><span class=\"sub\">上苗 + 发苗 · 支</span>\n        <div class=\"right heatlg\" id=\"heatLg\"></div></div>\n      <svg class=\"ch\" id=\"heat\" height=\"220\"></svg>\n    </div>\n    <div class=\"card panel\">\n      <div class=\"ph\"><h3>品种发苗排名</h3><span class=\"sub\" id=\"rankSub\"></span></div>\n      <div class=\"hb\" id=\"rank\"></div>\n      <div class=\"note\" id=\"rankNote\"></div>\n    </div>\n  </div>\n\n  <div class=\"card panel\">\n    <div class=\"ph\"><h3>每日明细</h3><span class=\"sub\">与上方图表同一数据</span><div class=\"right\"><button class=\"mini\" id=\"exp2\">导出本表 ›</button></div></div>\n    <div class=\"tblwrap\"><table id=\"tbl\"></table></div>\n  </div>\n</div>\n<div class=\"tip\" id=\"tip\"></div>\n\n<script>\n(function () {\n  const $ = id => document.getElementById(id);\n  const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();\n  const S = { up: css(\"--s1\"), out: css(\"--s2\"), ret: css(\"--s3\") };\n  const p2 = n => String(n).padStart(2, \"0\");\n  const TODAY = new Date(2026, 9, 22);\n  const VACS = [\"麻腮风联合减毒活疫苗\", \"Sabin株脊髓灰质炎灭活疫苗\", \"甲型肝炎灭活疫苗\", \"重组乙型肝炎疫苗\", \"流感病毒裂解疫苗\"];\n  const SHORT = { \"麻腮风联合减毒活疫苗\": \"麻腮风\", \"Sabin株脊髓灰质炎灭活疫苗\": \"脊灰(Sabin)\", \"甲型肝炎灭活疫苗\": \"甲肝\", \"重组乙型肝炎疫苗\": \"乙肝\", \"流感病毒裂解疫苗\": \"流感\" };\n  const VW = [0.42, 0.18, 0.16, 0.14, 0.10];          // 各品种占比(演示)\n\n  // ── 演示数据: 按日生成, 固定种子(切换筛选不乱跳) ──\n  let seed = 20261022; const rnd = () => (seed = seed * 16807 % 2147483647) / 2147483647;\n  const DAYS = [];\n  for (let i = 59; i >= 0; i--) {\n    const d = new Date(TODAY); d.setDate(d.getDate() - i);\n    const wk = d.getDay(), ramp = Math.min(1, (60 - i) / 25), off = wk === 0 ? 0.15 : wk === 6 ? 0.45 : 1;\n    const up = Math.round((18 + rnd() * 34) * ramp * off), out = Math.round((6 + rnd() * 18) * ramp * off), ret = rnd() < 0.3 ? Math.round(rnd() * 4) : 0;\n    const disc = Math.round(up * (0.03 + rnd() * 0.07)), takt = +(30 + rnd() * 9 - ramp * 3 + (i < 5 ? -2 : 0)).toFixed(1);\n    const hours = Array.from({ length: 12 }, (_, h) => { const peak = Math.exp(-((h - 2) ** 2) / 3) + 0.8 * Math.exp(-((h - 7) ** 2) / 2.5); return peak; });\n    DAYS.push({ d, up, out, ret, disc, takt, wk, hours });\n  }\n  const label = d => `${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;\n\n  let range = 7, vac = \"\";\n  function pick() {\n    const n = range === \"m\" ? TODAY.getDate() : range;\n    const cur = DAYS.slice(-n), prev = DAYS.slice(-2 * n, -n);\n    const f = vac ? VW[VACS.indexOf(vac)] : 1;\n    const sc = r => ({ ...r, up: Math.round(r.up * f), out: Math.round(r.out * f), ret: Math.round(r.ret * f), disc: Math.round(r.disc * f) });\n    return { n, cur: cur.map(sc), prev: prev.map(sc) };\n  }\n  const sum = (a, k) => a.reduce((s, r) => s + r[k], 0);\n  const avg = (a, k) => a.length ? sum(a, k) / a.length : 0;\n\n  // ── 提示框 ──\n  const tip = $(\"tip\");\n  function showTip(e, h, rows) {\n    tip.innerHTML = `<div class=\"h\">${h}</div>` + rows.map(([n, c, v]) => `<div class=\"row\"><span>${c ? `<i style=\"background:${c}\"></i>` : \"\"}${n}</span><b>${v}</b></div>`).join(\"\");\n    tip.style.display = \"block\";\n    const x = Math.min(e.clientX + 14, innerWidth - tip.offsetWidth - 8), y = Math.min(e.clientY + 14, innerHeight - tip.offsetHeight - 8);\n    tip.style.left = x + \"px\"; tip.style.top = y + \"px\";\n  }\n  const hideTip = () => tip.style.display = \"none\";\n\n  // ── 指标 ──\n  function kpis(D) {\n    const c = D.cur, p = D.prev;\n    const okRate = a => { const u = sum(a, \"up\"); return u ? (u - sum(a, \"disc\")) / u * 100 : 0; };\n    const items = [\n      [\"上苗\", S.up, sum(c, \"up\"), \"支\", sum(p, \"up\"), true],\n      [\"发苗\", S.out, sum(c, \"out\"), \"支\", sum(p, \"out\"), true],\n      [\"退苗\", S.ret, sum(c, \"ret\"), \"支\", sum(p, \"ret\"), null],\n      [\"入库一次成功率\", null, okRate(c).toFixed(1), \"%\", okRate(p).toFixed(1), true, \"pt\"],\n      [\"平均单盒用时\", null, avg(c, \"takt\").toFixed(1), \"秒\", avg(p, \"takt\").toFixed(1), false],\n      [\"作业时长\", null, (sum(c, \"up\") + sum(c, \"out\")) * 32 / 3600 | 0, \"小时\", (sum(p, \"up\") + sum(p, \"out\")) * 32 / 3600 | 0, true],\n    ];\n    $(\"kpis\").innerHTML = items.map(([k, col, v, u, pv, upGood, unit]) => {\n      const dv = +v - +pv, dir = dv === 0 ? \"\" : (dv > 0) === upGood ? \"good\" : upGood === null ? \"\" : \"bad\";\n      const dTxt = dv === 0 ? \"持平\" : `${dv > 0 ? \"+\" : \"\"}${unit === \"pt\" ? dv.toFixed(1) + \" 个百分点\" : (Math.abs(dv) < 1 && dv % 1 ? dv.toFixed(1) : Math.round(dv * 10) / 10) + (u === \"%\" ? \"\" : \" \" + u)}`;\n      return `<div class=\"card kpi\"><div class=\"k\">${col ? `<i style=\"background:${col}\"></i>` : \"\"}${k}</div>\n        <div class=\"v\"><b>${v}</b><span>${u}</span></div>\n        <div class=\"d\">比上期 <b class=\"${dir}\">${dTxt}</b></div></div>`;\n    }).join(\"\");\n  }\n\n  // ── 趋势: 三系列并排柱(同一 y 轴), 柱间 2px 间隙, 只给峰值直标 ──\n  function trend(D) {\n    const svg = $(\"trend\"), W = svg.clientWidth, H = 280, pl = 36, pr = 6, pt = 20, pb = 28, rows = D.cur;\n    const keys = [[\"up\", S.up, \"上苗\"], [\"out\", S.out, \"发苗\"], [\"ret\", S.ret, \"退苗\"]];\n    const mx = Math.max(10, ...rows.flatMap(r => keys.map(k => r[k[0]])));\n    const top = Math.ceil(mx / 10) * 10, y = v => pt + (H - pt - pb) * (1 - v / top);\n    const cw = (W - pl - pr) / rows.length, gw = Math.min(54, cw * 0.72), bw = Math.max(2, (gw - 4) / 3);\n    let s = \"\";\n    for (let k = 0; k <= 4; k++) { const v = top * k / 4; s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${y(v)}\" y2=\"${y(v)}\" stroke=\"var(--grid)\"/><text x=\"${pl - 8}\" y=\"${y(v) + 4}\" font-size=\"11\" fill=\"var(--ink3)\" text-anchor=\"end\">${v}</text>`; }\n    const every = Math.ceil(rows.length / 12);\n    const peak = rows.reduce((b, r, i) => r.up > rows[b].up ? i : b, 0);\n    rows.forEach((r, i) => {\n      const x0 = pl + cw * i + (cw - gw) / 2;\n      keys.forEach(([k, c], j) => {\n        const h = Math.max(r[k] ? 2 : 0, y(0) - y(r[k])), x = x0 + j * (bw + 2), rr = Math.min(4, bw / 2);\n        if (h) s += `<path d=\"M${x},${y(0)} v${-(h - rr)} q0,${-rr} ${rr},${-rr} h${bw - 2 * rr} q${rr},0 ${rr},${rr} v${h - rr} z\" fill=\"${c}\"/>`;\n      });\n      if (i === peak && r.up) s += `<text x=\"${x0 + bw / 2}\" y=\"${y(r.up) - 6}\" font-size=\"11.5\" font-weight=\"700\" fill=\"var(--ink)\" text-anchor=\"middle\" font-family=\"var(--num)\">${r.up}</text>`;\n      if (i % every === 0 || i === rows.length - 1) s += `<text x=\"${pl + cw * i + cw / 2}\" y=\"${H - 8}\" font-size=\"11.5\" fill=\"var(--ink3)\" text-anchor=\"middle\">${i === rows.length - 1 ? \"今天\" : label(r.d)}</text>`;\n      s += `<rect class=\"hit\" data-i=\"${i}\" x=\"${pl + cw * i}\" y=\"${pt}\" width=\"${cw}\" height=\"${H - pt - pb}\" fill=\"transparent\"/>`;\n    });\n    s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${y(0)}\" y2=\"${y(0)}\" stroke=\"#cfd6e0\"/>`;\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n    svg.onmousemove = e => { const h = e.target.closest(\".hit\"); if (!h) return hideTip(); const r = rows[+h.dataset.i];\n      showTip(e, `${label(r.d)} 周${\"日一二三四五六\"[r.wk]}`, keys.map(([k, c, n]) => [n, c, r[k] + \" 支\"])); };\n    svg.onmouseleave = hideTip;\n  }\n\n  // ── 横向条(单一色相: 量级) ──\n  function hbars(el, items, unit, color) {\n    const mx = Math.max(1, ...items.map(i => i[1]));\n    el.innerHTML = items.map(([n, v, extra]) => `<div class=\"r\" data-n=\"${n}\" data-v=\"${v}\" data-x=\"${extra || \"\"}\"><span class=\"n\" title=\"${n}\">${n}</span><span class=\"t\"><i style=\"width:${v / mx * 100}%;background:${color || \"var(--s1)\"}\"></i></span><span class=\"val\">${v}</span></div>`).join(\"\");\n    el.onmousemove = e => { const r = e.target.closest(\".r\"); if (!r) return hideTip(); showTip(e, r.dataset.n, [[\"数量\", color || S.up, r.dataset.v + \" \" + unit], ...(r.dataset.x ? [[\"占比\", null, r.dataset.x]] : [])]); };\n    el.onmouseleave = hideTip;\n  }\n\n  // ── 单盒用时: 单线 + 45s 警戒线 + 末点标注 ──\n  function takt(D) {\n    const svg = $(\"takt\"), W = svg.clientWidth, H = 190, pl = 30, pr = 30, pt = 14, pb = 24, rows = D.cur;\n    const lo = 20, hi = 50, y = v => pt + (H - pt - pb) * (1 - (v - lo) / (hi - lo));\n    const x = i => rows.length === 1 ? (pl + W - pr) / 2 : pl + (W - pl - pr) * i / (rows.length - 1);\n    let s = \"\";\n    for (const v of [20, 30, 40, 50]) s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${y(v)}\" y2=\"${y(v)}\" stroke=\"var(--grid)\"/><text x=\"${pl - 6}\" y=\"${y(v) + 4}\" font-size=\"11\" fill=\"var(--ink3)\" text-anchor=\"end\">${v}</text>`;\n    s += `<line x1=\"${pl}\" x2=\"${W - pr}\" y1=\"${y(45)}\" y2=\"${y(45)}\" stroke=\"var(--red)\" stroke-dasharray=\"4 4\" opacity=\".55\"/><text x=\"${W - pr + 4}\" y=\"${y(45) + 4}\" font-size=\"11\" fill=\"var(--red)\">45</text>`;\n    const d = rows.map((r, i) => `${i ? \"L\" : \"M\"}${x(i).toFixed(1)},${y(r.takt).toFixed(1)}`).join(\"\");\n    s += `<path d=\"${d}\" fill=\"none\" stroke=\"var(--s1)\" stroke-width=\"2\" stroke-linejoin=\"round\"/>`;\n    const L = rows.length - 1;\n    s += `<circle cx=\"${x(L)}\" cy=\"${y(rows[L].takt)}\" r=\"4.5\" fill=\"var(--s1)\" stroke=\"#fff\" stroke-width=\"2\"/><text x=\"${x(L)}\" y=\"${y(rows[L].takt) - 10}\" font-size=\"12\" font-weight=\"700\" fill=\"var(--ink)\" text-anchor=\"end\" font-family=\"var(--num)\">${rows[L].takt}s</text>`;\n    s += `<line id=\"cx\" x1=\"0\" x2=\"0\" y1=\"${pt}\" y2=\"${H - pb}\" stroke=\"#b9c3d1\" stroke-dasharray=\"3 3\" opacity=\"0\"/><circle id=\"cd\" r=\"4.5\" fill=\"var(--s1)\" stroke=\"#fff\" stroke-width=\"2\" opacity=\"0\"/>`;\n    s += `<text x=\"${pl}\" y=\"${H - 6}\" font-size=\"11\" fill=\"var(--ink3)\">${label(rows[0].d)}</text><text x=\"${W - pr}\" y=\"${H - 6}\" font-size=\"11\" fill=\"var(--ink3)\" text-anchor=\"end\">今天</text>`;\n    s += `<rect x=\"${pl}\" y=\"${pt}\" width=\"${W - pl - pr}\" height=\"${H - pt - pb}\" fill=\"transparent\" id=\"taktHit\"/>`;\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n    svg.onmousemove = e => {\n      const b = svg.getBoundingClientRect(), mx = (e.clientX - b.left) / b.width * W;\n      const i = Math.max(0, Math.min(L, Math.round((mx - pl) / ((W - pl - pr) / Math.max(1, L)))));\n      const cx = svg.querySelector(\"#cx\"), cd = svg.querySelector(\"#cd\");\n      cx.setAttribute(\"x1\", x(i)); cx.setAttribute(\"x2\", x(i)); cx.setAttribute(\"opacity\", 1);\n      cd.setAttribute(\"cx\", x(i)); cd.setAttribute(\"cy\", y(rows[i].takt)); cd.setAttribute(\"opacity\", 1);\n      showTip(e, label(rows[i].d), [[\"单盒用时\", S.up, rows[i].takt + \" 秒\"]]);\n    };\n    svg.onmouseleave = () => { hideTip(); svg.querySelector(\"#cx\")?.setAttribute(\"opacity\", 0); svg.querySelector(\"#cd\")?.setAttribute(\"opacity\", 0); };\n    const a = avg(rows, \"takt\"), slow = rows.filter(r => r.takt > 45).length;\n    $(\"taktNote\").innerHTML = `平均 <b>${a.toFixed(1)} 秒</b> · 超过 45 秒的天数 <b>${slow}</b>`;\n  }\n\n  // ── 作业时段热力图: 星期 × 时段, 单一蓝色由浅到深 ──\n  const RAMP = [\"#f1f5fb\", \"#cde2fb\", \"#9ec5f4\", \"#6da7ec\", \"#3987e5\", \"#256abf\", \"#184f95\"];\n  function heat(D) {\n    const svg = $(\"heat\"), W = svg.clientWidth, H = 220, pl = 34, pt = 6, pb = 22, HRS = 12;   // 8:00~19:00\n    const M = Array.from({ length: 7 }, () => Array(HRS).fill(0));\n    D.cur.forEach(r => r.hours.forEach((w, h) => M[r.wk][h] += Math.round((r.up + r.out) * w / 4.2)));\n    const mx = Math.max(1, ...M.flat()), cw = (W - pl) / HRS, ch = (H - pt - pb) / 7;\n    const order = [1, 2, 3, 4, 5, 6, 0];\n    let s = \"\";\n    order.forEach((wk, ri) => {\n      s += `<text x=\"${pl - 8}\" y=\"${pt + ch * ri + ch / 2 + 4}\" font-size=\"11.5\" fill=\"var(--ink3)\" text-anchor=\"end\">周${\"日一二三四五六\"[wk]}</text>`;\n      for (let h = 0; h < HRS; h++) {\n        const v = M[wk][h], k = v ? Math.min(RAMP.length - 1, 1 + Math.floor(v / mx * (RAMP.length - 1.01))) : 0;\n        s += `<rect class=\"c\" data-v=\"${v}\" data-wk=\"${wk}\" data-h=\"${h}\" x=\"${pl + cw * h + 1}\" y=\"${pt + ch * ri + 1}\" width=\"${cw - 2}\" height=\"${ch - 2}\" rx=\"3\" fill=\"${RAMP[k]}\"/>`;\n      }\n    });\n    for (let h = 0; h < HRS; h += 2) s += `<text x=\"${pl + cw * h + cw / 2}\" y=\"${H - 6}\" font-size=\"11\" fill=\"var(--ink3)\" text-anchor=\"middle\">${8 + h}:00</text>`;\n    svg.setAttribute(\"viewBox\", `0 0 ${W} ${H}`); svg.innerHTML = s;\n    svg.onmousemove = e => { const c = e.target.closest(\".c\"); if (!c) return hideTip(); const h = +c.dataset.h;\n      showTip(e, `周${\"日一二三四五六\"[+c.dataset.wk]} ${8 + h}:00–${9 + h}:00`, [[\"上苗 + 发苗\", RAMP[5], c.dataset.v + \" 支\"]]); };\n    svg.onmouseleave = hideTip;\n    $(\"heatLg\").innerHTML = `少 ${RAMP.slice(1).map(c => `<i style=\"background:${c}\"></i>`).join(\"\")} 多`;\n  }\n\n  // ── 库存效期结构: 状态色 + 图标 + 文字(不只靠颜色) ──\n  function expiry() {\n    const B = [[\"已过期\", \"var(--red)\", \"!\", 52, \"需退苗\"], [\"30 天内\", \"var(--orange)\", \"30\", 18, \"优先发出\"], [\"90 天内\", \"var(--yellow)\", \"90\", 34, \"关注\"], [\"90 天以上\", \"var(--ok)\", \"✓\", 120, \"正常\"]];\n    const tot = B.reduce((a, b) => a + b[3], 0);\n    $(\"expBar\").innerHTML = B.map(b => `<div style=\"width:${b[3] / tot * 100}%;background:${b[1]}\" title=\"${b[0]} ${b[3]} 支\"></div>`).join(\"\");\n    $(\"expL\").innerHTML = B.map(b => `<div><span class=\"ic\" style=\"background:${b[1]}\">${b[2]}</span><span><small>${b[0]}</small><b>${b[3]}</b> <em>支 · ${Math.round(b[3] / tot * 100)}% · ${b[4]}</em></span></div>`).join(\"\");\n  }\n\n  // ── 明细表 ──\n  function table(D) {\n    const rows = D.cur.slice().reverse();\n    const tr = r => { const ok = r.up ? (r.up - r.disc) / r.up * 100 : 0;\n      return `<tr><td>${label(r.d)} 周${\"日一二三四五六\"[r.wk]}</td><td>${r.up}</td><td>${r.out}</td><td>${r.ret}</td><td>${r.disc}</td><td><span class=\"pc\"><i style=\"width:${ok}%\"></i></span>${r.up ? ok.toFixed(1) + \"%\" : \"—\"}</td><td>${r.takt}</td></tr>`; };\n    const c = D.cur, ok = sum(c, \"up\") ? (sum(c, \"up\") - sum(c, \"disc\")) / sum(c, \"up\") * 100 : 0;\n    $(\"tbl\").innerHTML = `<thead><tr><th>日期</th><th>上苗(支)</th><th>发苗(支)</th><th>退苗(支)</th><th>丢回(次)</th><th>入库成功率</th><th>单盒用时(秒)</th></tr></thead>\n      <tbody>${rows.map(tr).join(\"\")}</tbody>\n      <tfoot><tr><td>合计 / 平均</td><td>${sum(c, \"up\")}</td><td>${sum(c, \"out\")}</td><td>${sum(c, \"ret\")}</td><td>${sum(c, \"disc\")}</td><td>${ok.toFixed(1)}%</td><td>${avg(c, \"takt\").toFixed(1)}</td></tr></tfoot>`;\n  }\n  function csv() {\n    const D = pick(), lines = [\"日期,上苗,发苗,退苗,丢回,单盒用时\"].concat(D.cur.map(r => [label(r.d), r.up, r.out, r.ret, r.disc, r.takt].join(\",\")));\n    const a = document.createElement(\"a\"); a.href = URL.createObjectURL(new Blob([\"\\ufeff\" + lines.join(\"\\n\")], { type: \"text/csv\" })); a.download = \"统计报表.csv\"; a.click();\n  }\n  $(\"exp\").onclick = csv; $(\"exp2\").onclick = csv;\n\n  function render() {\n    const D = pick(), first = D.cur[0].d;\n    const rt = range === 1 ? \"今日\" : range === \"m\" ? \"本月\" : `近 ${range} 天`;\n    $(\"rangeTxt\").textContent = `${rt} · ${vac || \"全部品种\"} · 对比上一同长周期`;\n    $(\"dateTxt\").textContent = `${first.getFullYear()}-${label(first)} ~ ${TODAY.getFullYear()}-${label(TODAY)}`;\n    kpis(D); trend(D); takt(D); heat(D); table(D);\n    const stock = VACS.map((v, i) => [SHORT[v], Math.round(224 * VW[i])]);\n    hbars($(\"stockMix\"), stock.map(([n, v]) => [n, v, Math.round(v / 224 * 100) + \"%\"]), \"支\");\n    $(\"stockNote\").innerHTML = `在库合计 <b>224 支</b> · 5 个品种 · 9 个批号`;\n    const dt = sum(D.cur, \"disc\");\n    const R = [[\"没扫到条码\", 0.34], [\"上位机拒收·账目核实\", 0.22], [\"尺寸与品种不符\", 0.17], [\"上位机拒收·重复入库\", 0.12], [\"盒子立着/侧放\", 0.09], [\"上位机超时未答\", 0.06]];\n    hbars($(\"disc\"), R.map(([n, w]) => [n, Math.max(0, Math.round(dt * w)), Math.round(w * 100) + \"%\"]), \"次\", \"#7f8ea3\");\n    $(\"discSub\").textContent = `共 ${dt} 次`;\n    const outs = sum(D.cur, \"out\"), RW = [0.46, 0.2, 0.15, 0.12, 0.07];\n    const rk = VACS.map((v, i) => [SHORT[v], Math.round(outs * RW[i])]).filter(r => !vac || r[0] === SHORT[vac]).sort((a, b) => b[1] - a[1]);\n    hbars($(\"rank\"), rk.map(([n, v]) => [n, v, outs ? Math.round(v / outs * 100) + \"%\" : \"0%\"]), \"支\", S.out);\n    $(\"rankSub\").textContent = `${rt} · 发苗 ${outs} 支`;\n    $(\"rankNote\").innerHTML = rk.length ? `第一名 <b>${rk[0][0]}</b> 占 ${outs ? Math.round(rk[0][1] / outs * 100) : 0}%` : \"\";\n  }\n  expiry();\n  $(\"vac\").innerHTML += VACS.map(v => `<option value=\"${v}\">${v}</option>`).join(\"\");\n  $(\"vac\").onchange = e => { vac = e.target.value; render(); };\n  $(\"range\").onclick = e => { const b = e.target.closest(\"button\"); if (!b) return;\n    [...$(\"range\").children].forEach(x => x.classList.toggle(\"on\", x === b)); range = b.dataset.r === \"m\" ? \"m\" : +b.dataset.r; render(); };\n  render(); addEventListener(\"resize\", render);\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}]}}
