mm, columns_found:[{x_mm,w_mm,front_mm,stack_mm,n,p,sku}], compare:[{x_mm,box_mm,group_key,ledger_count,front_mm(实测队首),front_expected_mm(账上队首),front_diff_mm,boxes_diff(负=少几盒),diff_kind(match／whole_boxes／shifted),measured_count(粗估),p,diff,suspect,pitch_mm}], stray, csv, jpg(设备本地路径), image_url(标注图地址, GET 设备地址+image_url 取图)} |"," | pits | List<List<Number>> | 否 |  |"," | box_mm | List<Number> | 否 |  |"," | front_mm | Number | 否 | stored/retrieved 事件: 这个动作做完后该列队首前脸位置(mm, 推进量). 上位机存进账本, 下次盘点在 columns[].front_mm 里传回来, 盘点就能只比位置不做乘法 |"]},{"oldStart":1463,"oldLines":14,"newStart":1463,"newLines":14,"lines":[" "," ```"," {","-  \"t\": \"13:37:10\",","+  \"t\": \"09:52:13\",","   \"services\": [","     {","       \"name\": \"vision\",","       \"port\": 8900,","       \"role\": \"视觉(相机+模型)\",","       \"listening\": true,","-      \"pid\": 46812,","+      \"pid\": 20436,","       \"hold\": false","     },","     {"]},{"oldStart":1478,"oldLines":7,"newStart":1478,"newLines":7,"lines":["       \"port\": 8901,","       \"role\": \"扫码(键盘钩子)\",","       \"listening\": true,","-      \"pid\": 43012,","+      \"pid\": 19608,","       \"hold\": false","     },","     {"]},{"oldStart":1486,"oldLines":7,"newStart":1486,"newLines":7,"lines":["       \"port\": 8902,","       \"role\": \"工作站(本服务)\",","       \"listening\": true,","-      \"pid\": 55004,","+      \"pid\": 32620,","       \"hold\": false","     },","     {"]},{"oldStart":1494,"oldLines":7,"newStart":1494,"newLines":7,"lines":["       \"port\": 8903,","       \"role\": \"上位机后端(追溯)\",","       \"listening\": true,","-      \"pid\": 20024,","+      \"pid\": 20184,","       \"hold\": false","     }","   ]"]}]}],"moreFiles":1,"changedFiles":["/Users/chen/Desktop/robocenter/docs/openapi.json","/Users/chen/Desktop/robocenter/docs/盘点对接说明.md","/Users/chen/Desktop/robocenter/docs/设备接口文档.md","/Users/chen/Desktop/robocenter/docs/设备接口文档_V1.docx","/Users/chen/Desktop/robocenter/docs/设备接口文档_V1.md"]}},"serverClassifierContext":{"request":"8