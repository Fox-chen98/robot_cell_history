it, box_mm=it.box_mm, dest=t.req.dest) if t.req.type in (\"retrieve\", \"outbound\") else fl.run(slot, pit)''',\n '''                    msg = rfl.run(slot, pit, box_mm=it.box_mm, dest=t.req.dest, scan_first=(t.req.type == \"outbound\")) if t.req.type in (\"retrieve\", \"outbound\") else fl.run(slot, pit)'''),\n('''                     \"飞路径\": \"飞行\", \"放置\": \"放置\", \"丢回\": \"丢回\", \"复位\": \"复位\"}''',\n '''                     \"飞路径\": \"飞行\", \"放置\": \"放置\", \"丢回\": \"丢回\", \"复位\": \"复位\", \"取货\": \"取货\", \"投放\": \"投放\"}'''),\n('''    stocktake: slot, stocktake(盘点结果 dict, 见 stocktake 字段说明), text''',\n '''    stocktake: slot, stocktake(盘点结果 dict, 见 stocktake 字段说明), text\n    outbound_scanned(出库扫码, 2026-10-22): slot, x_mm, index, dest, code_expected(任务 items 里给的码), code_scanned(扫到的; 四面没读到=null), match(true/false; 没读到或没给账上码=null). 不论结果都照常投放'''),\n('''    dest: Optional[str] = Field(None, description=\"出库/退苗的去处名(任务开始与取出事件带)\")''',\n '''    dest: Optional[str] = Field(None, description=\"出库/退苗的去处名(任务开始与取出事件带)\")\n    code_expected: Optional[str] = Field(None, description=\"outbound_scanned 事件: 上位机在任务 items 里给的这盒追溯码\")\n    code_scanned: Optional[str] = Field(None, description=\"outbound_scanned 事件: 扫码口实际扫到的码(四面都没读到=null)\")\n    match: Optional[bool] = Field(None, description=\"outbound_scanned 事件: 扫到的码与账上是否一致(没读到或任务没给码=null). 设备不据此改变去处\"),'''),\n]\nfor a,b in rep:\n    assert a in s, a[:70]; s=s.replace(a,b,1)\ns=s.replace('match: Optional[bool] = Field(None, description=\"outbound_scanned 事件: 扫到的码与账上是否一致(没读到或任务没给码=null). 设备不据此改变去处\"),','match: Optional[bool] = Field(None, description=\"outbound_scanned 事件: 扫到的码与账上是否一致(没读到或任务没给码=null). 设备不据此改变去处\")')\n# kind 列表\ns=s.replace('lost/retrieved/pit_empty/stocktake/waiting_box','lost/retrieved/outbound_scanned/pit_empty/stocktake/waiting_box',1)\n# 示例: 出库(扫码)\na='''    \"退苗一个批号\": {'''\nassert a in s\ns=s.replace(a,'''    \"出库(先扫码)\": {\"summary\": \"出库 1 盒: 取出后先到扫码口扫码, 推 outbound_scanned(账上码 vs 扫到的码), 再送到传送带口; 不等回复\", \"value\": {\"type\": \"outbound\", \"items\": [{\"slot\": \"A-L10\", \"x_mm\": -246.2, \"index\": 16, \"box_mm\": [60, 38.5, 22.4], \"code\": \"81002713760075609215\"}], \"on_empty\": \"skip\", \"dest\": \"drop\", \"reason\": \"出库 门诊领用\"}},\n    \"退苗一个批号\": {''',1)\nopen(p,'w',encoding='utf-8').write(s)\n\np='scripts/bluespace/services/webhook.py'\ns=open(p,encoding='utf-8').read()\na='''\"events\": [\"stored\", \"discarded\", \"lost\", \"retrieved\", \"pit_empty\",'''\nassert a in s; s=s.replace(a,'''\"events\": [\"stored\", \"discarded\", \"lost\", \"retrieved\", \"outbound_scanned\", \"pit_empty\",''',1)\nopen(p,'w',encoding='utf-8').write(s)\n\np='config/webhook.yaml'\ns=open(p,encoding='utf-8').read()\na='''    - retrieved                        # 出库取出成功 → 销账'''\nassert a in s\ns=s.replace(a,a+'''\n    - outbound_scanned                 # 出库扫码结果(账上码/扫到的码/是否一致; 2026-10-22), 设备不等回复照常投放''',1)\nopen(p,'w',encoding='utf-8').write(s)\nEOF\npython3 -m py_compile scripts/bluespace/services/cell_server.py scripts/bluespace/services/webhook.py && echo OK; grep -n 'type in (\"retrieve\", \"outbound\")' scripts/bluespace/services/cell_server.py | wc -l","description":"工作站服务接入出库类型与扫码事件"},"caller":{"type":"direct"}}]}}
