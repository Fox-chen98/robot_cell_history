e(人处理完臂应已在home/mid), 或 stop 结束\n                    t.state = \"needs_human\"; t.stage = \"等人处理\"; t.emit(\"needs_human\", box_seq=t.box_seq, text=s)\n                    t.resume_evt.clear(); t.resume_evt.wait()\n                    if t.stop_req: outcome = (\"finished\", \"stopped\"); break\n                    t.state = \"running\"; t.emit(\"resumed\", box_seq=t.box_seq, text=\"人工处理后继续下一盒\")\n                    continue\n        except AssertionError as e:\n            outcome = (\"finished\", \"not_ready\"); t.emit(\"fault\", box_seq=t.box_seq, code=\"E_NOT_READY\", message=str(e))\n        except Exception as e:\n            import traceback; traceback.print_exc()\n            outcome = (\"needs_human\", \"exception\"); t.emit(\"fault\", box_seq=t.box_seq, code=\"EXCEPTION\", message=\"%s: %s\" % (type(e).__name__, str(e)[:120]))\n        finally:\n            try: F.close_resources(arm, res, False)\n            except Exception: pass\n            F.SINK[\"text\"] = None; F.SINK[\"card\"] = None; PS.EVENT_HOOK = None\n            t.state, t.end_reason = outcome; t.ended = time.time(); t.stage = \"结束\"\n            t.emit(\"task_end\", state=t.state, reason=t.end_reason, stored=t.progress[\"stored\"], discarded=t.progress[\"discarded\"],\n                   retrieved=t.progress[\"retrieved\"], empty=t.progress[\"empty\"], boxes=t.box_seq, elapsed_s=round(t.ended - t.started, 1))\n254:    state: str = Field(..., description=\"任务状态: queued=排队; running=进行中; awaiting_destination=等上位机答复去处; paused=已暂停; needs_human=需人工处理; finished=已结束(正常或被停止, 见 end_reason)\")\n258:    end_reason: Optional[str] = Field(None, description=\"结束原因: count_reached=做够数量; time_up=时间到; pits_exhausted=坑位用完; stopped=被停止; aborted=被立即停止; table_empty=桌上一直没盒; feeder_empty=传送带没盒; fault=动作失败; not_ready=设备未就绪; exception=程序异常\")\n439:        self.id = tid; self.req = req; self.state = \"queued\"; self.stage = \"排队\"; self.end_reason = None\n488:             \"end_reason\": self.end_reason, \"n_events\": 