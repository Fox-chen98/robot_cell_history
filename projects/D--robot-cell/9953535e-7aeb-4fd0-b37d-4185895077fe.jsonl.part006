{"parentUuid":"88a3b375-a2b7-4e4c-beb3-35a81a086e89","isSidechain":false,"promptId":"a7ffe1a0-139f-4057-ad30-a310ebbd1b13","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZHVvLaRYcUBYVmnN5apCy","type":"tool_result","content":"2:\"\"\"事件 webhook 投递(设备 → 上位机)。默认关闭; config/webhook.yaml 里 enabled=false 时行为与没有本模块完全一致。\n21:_CFG = {}\n31:def _out(line):\n43:DEFAULTS = {\"enabled\": False, \"url\": \"\", \"token\": \"\", \"timeout_s\": 3.0, \"retries\": 3,\n49:def init(root, quiet=False):\n51:    global _CFG, _Q, _TH, _ROOT\n54:    path = os.path.join(root, \"config\", \"webhook.yaml\")\n56:        import yaml\n57:        y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n65:    _CFG = cfg\n66:    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and cfg[\"url\"])\n70:            print(\"[webhook] 未启用(config/webhook.yaml enabled=false 或 url 为空), 事件仅存本地供 events?since= 拉取\", flush=True)\n78:              % (cfg[\"url\"], cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"])), flush=True)\n83:def post_event(task_id, ev):\n89:        if _CFG.get(\"events\") and kind not in _CFG[\"events\"]:\n98:            _ST[\"last_error\"] = \"队列满(%d), 丢弃 seq=%s; 对方可用 events?since= 补拉\" % (_CFG.get(\"queue_max\", 0), ev.get(\"seq\"))\n104:def status():\n107:    s[\"url\"] = _CFG.get(\"url\", \"\")\n113:def _deliver(item, event_id):\n116:    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")\n119:    if _CFG.get(\"token\"):\n120:        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])\n122:        with urllib.request.urlopen(req, timeout=float(_CFG[\"timeout_s\"])) as r:\n130:def _sender_loop():\n132:    retries = int(_CFG[\"retries\"])\n133:    backoff = float(_CFG[\"backoff_s\"])\n162:def _ping():\n175:            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info\n---\n16:from services import webhook\n68:           \"webhook\": webhook.status()}\n189:    out[\"webhook\"] = webhook.status()\n287:    webhook: Optional[Dict[str, Any]] = Field(None, description=\"事件推送状态: enabled 是否启用; state=disabled/ok/unreachable/unauthorized; url; queued 待发条数; sent/failed/dropped 计数; last_error。推送只是快车道, 失败不影响账——上位机始终可用 GET /tasks/{id}/events?since=N 补拉\")\n561:        # webhook 投递(2026-09-21): 只入队, 微秒级返回。⚠ 绝不可改成同步 POST ——\n562:        # 这里跑在机械臂执行线程上, 上位机一重启就会让臂僵在格口里(3s超时×3次)。细节见 services/webhook.py 头部。\n563:        try: webhook.post_event(self.id, ev)\n1004:    给 scripts/webhook_trace.py 合成\"交互全过程\"用。\"\"\"\n1168:            key = json.dumps({k: v for k, v in st.items() if k not in (\"t\", \"age_s\", \"webhook\")}, sort_keys=True, ensure_ascii=False, default=str)\n1336:    webhook.init(ROOT)                    # 事件推送(config/webhook.yaml); 未启用时安静返回, 行为与从前一致\n---\n26:scp -q \"$ROOT\"/config/T_wrist2cam.npy \"$BS:$CELL/config/calibration/ducocobot/T_wrist2cam.npy\" || { echo \"❌ FAIL: 手眼矩阵同步失败\"; exit 1; }   # 2026-09-15: Mac config/T_wrist2cam.npy 是唯一来源, 生产侧此前从不同步(换TCP后抓取/验证全偏8cm)\n34:scp -q \"$ROOT\"/config/feeder_baseline.json \"$BS:$CELL/config/feeder_baseline.json\" || { echo \"❌ FAIL: feeder基准同步失败\"; exit 1; }\n35:scp -q \"$ROOT\"/config/speed_profile.yaml \"$BS:$CELL/config/speed_profile.yaml\" || { echo \"❌ FAIL: speed_profile同步失败\"; exit 1; }\n36:scp -q \"$ROOT\"/config/drop_point.yaml \"$BS:$CELL/config/drop_point.yaml\" || { echo \"❌ FAIL: drop_point同步失败\"; exit 1; }\n37:scp -q \"$ROOT\"/config/scan_point.yaml \"$BS:$CELL/config/scan_point.yaml\" || { echo \"❌ FAIL: scan_point同步失败\"; exit 1; }   # 2026-10-21: 此前不同步, 换立放末端后扫码位关节角一直是8月旧值\n38:scp -q \"$ROOT\"/config/poses.yaml \"$BS:$CELL/config/poses.yaml\" || { echo \"❌ FAIL: poses同步失败\"; exit 1; }\n39:scp -q \"$ROOT\"/config/slots.yaml \"$BS:$CELL/config/slots.yaml\" || { echo \"❌ FAIL: slots.yaml同步失败\"; exit 1; }\n40:scp -q \"$ROOT\"/config/webhook.yaml \"$BS:$CELL/config/webhook.yaml\" || { echo \"❌ FAIL: webhook.yaml同步失败\"; exit 1; }\n41:scp -q \"$ROOT\"/config/sku_dims.yaml \"$BS:$CELL/config/sku_dims.yaml\" || { echo \"❌ FAIL: