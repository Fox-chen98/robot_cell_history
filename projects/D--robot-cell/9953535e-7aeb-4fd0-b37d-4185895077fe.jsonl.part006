; t.started = time.time(); t.stage = \"开工\"","         t.emit(\"task_start\", feed=t.req.feed, destination=t.req.destination, slot=t.req.slot, pits=t.req.pits, stop=t.req.stop.model_dump(),","-               dest=t.req.dest if t.req.type == \"retrieve\" else None, reason=t.req.reason, items=len(t.req.items or []) if t.req.type == \"retrieve\" else None)","+               dest=t.req.dest if t.req.type in (\"retrieve\", \"outbound\") else None, reason=t.req.reason, items=len(t.req.items or []) if t.req.type in (\"retrieve\", \"outbound\") else None)","         _stage_of = {\"去 home\": \"回位\", \"识别\": \"识别\", \"送料\": \"送料\", \"吸取\": \"吸取\", \"扫码\": \"扫码\", \"去 mid\": \"去mid\",","-                     \"飞路径\": \"飞行\", \"放置\": \"放置\", \"丢回\": \"丢回\", \"复位\": \"复位\"}","+                     \"飞路径\": \"飞行\", \"放置\": \"放置\", \"丢回\": \"丢回\", \"复位\": \"复位\", \"取货\": \"取货\", \"投放\": \"投放\"}"," ","         def on_text(s):","             s = s.strip()"]},{"oldStart":567,"oldLines":14,"newStart":571,"newLines":19,"lines":["                   \"message\": r.message, \"payload\": getattr(r.payload, \"value\", str(r.payload)), \"where\": r.arm_at,","                   \"elapsed_s\": round(r.elapsed_s, 1), \"data\": d.get(\"data\", {})}","             t.emit(\"card\", **ev)","-            if r.action.startswith(\"扫码\") and r.ok and t.req.destination != \"ask\":","+            if r.action.startswith(\"扫码\") and r.ok and t.req.type == \"outbound\":     # 2026-10-22 出库扫码: 只报不等, 判断归上位机","+                bc = str((d.get(\"data\") or {}).get(\"条码\", \"\")); got = bc.split(\" \")[0] if bc and bc[0].isdigit() else None","+                exp = t.current.get(\"code\")","+                t.emit(\"outbound_scanned\", box_seq=t.box_seq, slot=t.current.get(\"slot\"), pit=t.current.get(\"pit\"), dest=t.req.dest,","+                       code_expected=exp, code_scanned=got, match=(None if got is None else (got == exp if exp else None)), **_xi(t.current.get(\"pit\")))","+            elif r.action.