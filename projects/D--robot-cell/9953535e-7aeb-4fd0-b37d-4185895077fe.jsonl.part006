{"parentUuid":"6bf81890-59bc-4e60-bc02-823607b1efac","isSidechain":false,"attachment":{"type":"file","filename":"/Users/chen/Desktop/robocenter/scripts/bluespace/arm/rewind_check.py","content":{"type":"text","file":{"filePath":"/Users/chen/Desktop/robocenter/scripts/bluespace/arm/rewind_check.py","content":"# -*- coding: utf-8 -*-\n\"\"\"复位验证(控制器仿真模式, 2026-10-23): 跑一个动作 → 第 N 秒从另一条连接发停止(模拟中途急停/中断) → 调复位 → 判是否回到 home/mid.\n\n用法(blue-space, 控制器须已是仿真模式):\n  python tools/arm/rewind_check.py --setup \"pose:mid;fly mid_to_A-L10\" --run \"place A-L10 30.8 5 0\" --stop 3.0 [--label 格内放置]\n  --setup  分号隔开的准备动作: \"pose:<poses.yaml 名>\" = 直接 movej 摆过去; 其他 = run_action.py 的参数(自动加 --dry)\n  --run    被测动作(同上)\n  --stop   臂开始动之后第几秒发停止\n判决: [PASS] 复位成功且臂在 home/mid / [FAIL] 其他. 末行输出一行 JSON 供汇总.\n只在仿真模式下跑(真实模式拒绝), 不切模式(由调用方负责, 跑完切回真实).\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\n\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nsys.path.insert(0, ROOT)\nfrom hardware.robot_arm import DucoCobotArm  # noqa: E402\n\nPY = sys.executable\nIP, PORT = \"192.168.0.20\", 7003\n\n\ndef opt(k, d=None):\n    return sys.argv[sys.argv.index(k) + 1] if k in sys.argv else d\n\n\ndef act(args, timeout=120):\n    cmd = [PY, os.path.join(ROOT, \"actions\", \"run_action.py\")] + args.split() + [\"--dry\"]\n    env = dict(os.environ, GRASP_YES=\"1\", PYTHONIOENCODING=\"utf-8\")\n    return subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\n\n\ndef main():\n    setup = [s.strip() for s in (opt(\"--setup\", \"\") or \"\").split(\";\") if s.strip()]\n    run = opt(\"--run\"); stop_s = float(opt(\"--stop\", \"2.0\")); label = opt(\"--label\", run)\n    arm = DucoCobotArm(IP, PORT)\n    assert arm.connect(), \"[FAIL] 机械臂连不上\"\n    out = {\"label\": label, \"run\": run, \"stop_s\": stop_s}\n    try:\n        assert arm._cobot.get_simulation_state() is True, \"[FAIL] 控制器不是仿真模式, 拒绝\"\n        for s in setup:\n            if s.startswith(\"pose:\"):            # 直接摆到命名位姿(仿真 movej); run_action 的 goto --dry 会先挪到 drop_mid, 不适合当准备步\n                import yaml\n                q = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"poses.yaml\"), encoding=\"utf-8\"))[s[5:]]\n                assert arm.move_joint([float(x) for x in q], velocity=0.8, acceleration=0.6, def_acc=True), \"[FAIL] 摆到 %s 失败\" % s[5:]\n                continue\n            p = act(s); txt = p.communicate(timeout=180)[0].decode(\"utf-8\", \"replace\")\n            if p.returncode != 0 and \"成功\" not in txt:\n                print(txt[-800:]); raise SystemExit(\"[FAIL] 准备动作失败: %s\" % s)\n        q0 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n        p = act(run)\n        t_go = time.time()                      # 从臂真正开始动起计时(子进程启动+连接+使能要一两秒, 按发令计时会停在动作开始之前)\n        while time.time() - t_go < 30 and p.poll() is None:\n            q = [float(x) for x in arm._cobot.get_actual_joints_position()]\n            if max(abs(a_ - b_) for a_, b_ in zip(q, q0)) > 0.01:\n                break\n            time.sleep(0.05)\n        time.sleep(stop_s)\n        p.kill()                                # 先结束动作程序(仿真里单发 stop 只停当前一段, 程序会接着发下一段把动作做完; 真急停是断动力)\n        stopper = DucoCobotArm(IP, PORT)\n        if stopper.connect():\n            try: stopper._cobot.stop(True)\n            finally: stopper.disconnect()\n        try: p.communicate(timeout=10)\n        except Exception: pass\n        time.sleep(0.5)\n        q1 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n        moved = max(abs(a - b) for a, b in zip(q0, q1))\n        out[\"停在\"] = [round(x, 3) for x in q1]; out[\"停前动了rad\"] = round(moved, 3)\n        from actions import breadcrumb as BC\n        out[\"脚印步数\"] = len(BC.load())\n        time.sleep(1.0)\n        from actions.reset import reset_to_mid\n        r = reset_to_mid(arm)\n        q2 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n        where = BC.anchor_of(q2, 0.05)\n        out.update({\"复位\": r.ok, \"复位码\": r.code, \"说明\": r.message, \"最后在\": where, \"脚印明细\": (r.data or {}).get(\"脚印\", \"\")})\n        ok = r.ok and where in (\"home\", \"mid\")\n        print(\"%s %s | 停前动了 %.2frad | %s | 最后在 %s\" % (\"[PASS]\" if ok else \"[FAIL]\", label, moved, r.message, where))\n        out[\"pass\"] = ok\n    finally:\n        arm.disconnect()\n        print(\"JSON \" + json.dumps(out, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":92,"startLine":1,"totalLines":92}},"displayPath":"scripts/bluespace/arm/rewind_check.py"},"type":"attachment","uuid":"63ece134-9a59-4292-b671-721c037d7359","timestamp":"2026-10-23T05:48:00.716Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/chen/Desktop/robocenter/scripts/bluespace/arm/rewind_check.py\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t# -*- coding: utf-8 -*-\n2\t\"\"\"复位验证(控制器仿真模式, 2026-10-23): 跑一个动作 → 第 N 秒从另一条连接发停止(模拟中途急停/中断) → 调复位 → 判是否回到 home/mid.\n3\t\n4\t用法(blue-space, 控制器须已是仿真模式):\n5\t  python tools/arm/rewind_check.py --setup \"pose:mid;fly mid_to_A-L10\" --run \"place A-L10 30.8 5 0\" --stop 3.0 [--label 格内放置]\n6\t  --setup  分号隔开的准备动作: \"pose:<poses.yaml 名>\" = 直接 movej 摆过去; 其他 = run_action.py 的参数(自动加 --dry)\n7\t  --run    被测动作(同上)\n8\t  --stop   臂开始动之后第几秒发停止\n9\t判决: [PASS] 复位成功且臂在 home/mid / [FAIL] 其他. 末行输出一行 JSON 供汇总.\n10\t只在仿真模式下跑(真实模式拒绝), 不切模式(由调用方负责, 跑完切回真实).\n11\t\"\"\"\n12\timport json\n13\timport os\n14\timport subprocess\n15\timport sys\n16\timport threading\n17\timport time\n18\t\n19\tROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n20\tsys.path.insert(0, ROOT)\n21\tfrom hardware.robot_arm import DucoCobotArm  # noqa: E402\n22\t\n23\tPY = sys.executable\n24\tIP, PORT = \"192.168.0.20\", 7003\n25\t\n26\t\n27\tdef opt(k, d=None):\n28\t    return sys.argv[sys.argv.index(k) + 1] if k in sys.argv else d\n29\t\n30\t\n31\tdef act(args, timeout=120):\n32\t    cmd = [PY, os.path.join(ROOT, \"actions\", \"run_action.py\")] + args.split() + [\"--dry\"]\n33\t    env = dict(os.environ, GRASP_YES=\"1\", PYTHONIOENCODING=\"utf-8\")\n34\t    return subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\n35\t\n36\t\n37\tdef main():\n38\t    setup = [s.strip() for s in (opt(\"--setup\", \"\") or \"\").split(\";\") if s.strip()]\n39\t    run = opt(\"--run\"); stop_s = float(opt(\"--stop\", \"2.0\")); label = opt(\"--label\", run)\n40\t    arm = DucoCobotArm(IP, PORT)\n41\t    assert arm.connect(), \"[FAIL] 机械臂连不上\"\n42\t    out = {\"label\": label, \"run\": run, \"stop_s\": stop_s}\n43\t    try:\n44\t        assert arm._cobot.get_simulation_state() is True, \"[FAIL] 控制器不是仿真模式, 拒绝\"\n45\t        for s in setup:\n46\t            if s.startswith(\"pose:\"):            # 直接摆到命名位姿(仿真 movej); run_action 的 goto --dry 会先挪到 drop_mid, 不适合当准备步\n47\t                import yaml\n48\t                q = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"poses.yaml\"), encoding=\"utf-8\"))[s[5:]]\n49\t                assert arm.move_joint([float(x) for x in q], velocity=0.8, acceleration=0.6, def_acc=True), \"[FAIL] 摆到 %s 失败\" % s[5:]\n50\t                continue\n51\t            p = act(s); txt = p.communicate(timeout=180)[0].decode(\"utf-8\", \"replace\")\n52\t            if p.returncode != 0 and \"成功\" not in txt:\n53\t                print(txt[-800:]); raise SystemExit(\"[FAIL] 准备动作失败: %s\" % s)\n54\t        q0 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n55\t        p = act(run)\n56\t        t_go = time.time()                      # 从臂真正开始动起计时(子进程启动+连接+使能要一两秒, 按发令计时会停在动作开始之前)\n57\t        while time.time() - t_go < 30 and p.poll() is None:\n58\t            q = [float(x) for x in arm._cobot.get_actual_joints_position()]\n59\t            if max(abs(a_ - b_) for a_, b_ in zip(q, q0)) > 0.01:\n60\t                break\n61\t            time.sleep(0.05)\n62\t        time.sleep(stop_s)\n63\t        p.kill()                                # 先结束动作程序(仿真里单发 stop 只停当前一段, 程序会接着发下一段把动作做完; 真急停是断动力)\n64\t        stopper = DucoCobotArm(IP, PORT)\n65\t        if stopper.connect():\n66\t            try: stopper._cobot.stop(True)\n67\t            finally: stopper.disconnect()\n68\t        try: p.communicate(timeout=10)\n69\t        except Exception: pass\n70\t        time.sleep(0.5)\n71\t        q1 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n72\t        moved = max(abs(a - b) for a, b in zip(q0, q1))\n73\t        out[\"停在\"] = [round(x, 3) for x in q1]; out[\"停前动了rad\"] = round(moved, 3)\n74\t        from actions import breadcrumb as BC\n75\t        out[\"脚印步数\"] = len(BC.load())\n76\t        time.sleep(1.0)\n77\t        from actions.reset import reset_to_mid\n78\t        r = reset_to_mid(arm)\n79\t        q2 = [float(x) for x in arm._cobot.get_actual_joints_position()]\n80\t        where = BC.anchor_of(q2, 0.05)\n81\t        out.update({\"复位\": r.ok, \"复位码\": r.code, \"说明\": r.message, \"最后在\": where, \"脚印明细\": (r.data or {}).get(\"脚印\", \"\")})\n82\t        ok = r.ok and where in (\"home\", \"mid\")\n83\t        print(\"%s %s | 停前动了 %.2frad | %s | 最后在 %s\" % (\"[PASS]\" if ok else \"[FAIL]\", label, moved, r.message, where))\n84\t        out[\"pass\"] = ok\n85\t    finally:\n86\t        arm.disconnect()\n87\t        print(\"JSON \" + json.dumps(out, ensure_ascii=False))\n88\t\n89\t\n90\tif __name__ == \"__main__\":\n91\t    main()\n92\t\n</system-reminder>"}],"renderedRole":"system","session_id":"2e8bfcd4-e637-441c-b83c-f83c49135d41","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"63ece134-9a59-4292-b671-721c037d7359","isSidechain":false,"attachment":{"type":"file","filename":"/Users/chen/Desktop/robocenter/scripts/bluespace/actions/breadcrumb.py","content":{"type":"text","file":{"filePath":"/Users/chen/Desktop/robocenter/scripts/bluespace/actions/breadcrumb.py","content":"# -*- coding: utf-8 -*-\n\"\"\"脚印(2026-10-23): 每发一条运动指令前, 记下\"从哪出发、用什么运动、去哪\", 叠成一摞; 复位时从最上面一条开始原路倒回.\n\n为什么: 很多动作不在路径库里(格内推进/退出、桌面下探吸取、去扫码口、去近拍位), 中途急停/中断后原复位认不出位置.\n倒回走的是\"同一种运动、同一条线\"(movej 关节直线 / movel 笛卡尔直线 / track 同一串路点倒序), 扫过的空间与来时一致.\n\n记法:\n  - 出发点在 home/mid(锚点)上 → 先清空再记(脚印永远只是\"离开锚点以来走过的路\")\n  - 不等完成的连发直线(拐角抹圆) → 下一条的出发点取上一条的目标, 不取发令瞬间的实际位置\n  - 文件 logs/breadcrumb.json, 跨进程(工作站服务/act.sh/flow.sh)共用, 服务重启不丢\n  - PAUSED[0]=True 时不记(倒回过程自己的运动不能再叠上去)\n倒回前逐条核对\"当前位置确实在这一段上\"(仿真干跑也会记脚印, 被人用示教器挪过也会对不上), 对不上就停, 不瞎走.\n\"\"\"\nimport json\nimport math\nimport os\nimport threading\nimport time\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nFILE = os.path.join(ROOT, \"logs\", \"breadcrumb.json\")\nMAX_N = 300\nANCHOR_TOL = 0.03          # rad: 出发点离 home/mid 这么近就算从锚点出发(清空重记)\nLOOP_TOL = 0.004           # rad(≈3~4mm): 出发点离之前某一步的出发点这么近 = 走了个闭环回来, 删掉那段. 真闭环回到同一指令位姿(<0.1mm); 不能放大到 0.01, 格内 10mm 的降/推会被误判(2026-10-23 仿真实证)\nPAUSED = [False]\n_lock = threading.Lock()\n_anchors = None\n\n\ndef anchors():\n    global _anchors\n    if _anchors is None:\n        import yaml\n        p = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"poses.yaml\"), encoding=\"utf-8\"))\n        _anchors = {k: [float(x) for x in p[k]] for k in (\"home\", \"mid\")}\n    return _anchors\n\n\ndef anchor_of(q, tol=ANCHOR_TOL):\n    if not q:\n        return None\n    for k, a in anchors().items():\n        if max(abs(float(x) - y) for x, y in zip(q, a)) < tol:\n            return k\n    return None\n\n\ndef load():\n    try:\n        return json.load(open(FILE, encoding=\"utf-8\"))\n    except Exception:\n        return []\n\n\ndef _save(st):\n    os.makedirs(os.path.dirname(FILE), exist_ok=True)\n    tmp = FILE + \".tmp\"\n    json.dump(st[-MAX_N:], open(tmp, \"w\", encoding=\"utf-8\"))\n    os.replace(tmp, FILE)\n\n\ndef push(kind, start_j, chained=False, **extra):\n    \"\"\"记一步. start_j: 出发关节(rad). chained=True: 接在上一条不等完成的直线后连发(出发点不是发令瞬间的位置, 不做锚点清空).\n    extra: target_j / start_pose / target_pose / tool / wobj / pts / label / pending\"\"\"\n    if PAUSED[0] or not start_j:\n        return\n    try:\n        with _lock:\n            st = load()\n            if anchor_of(start_j) and not chained:\n                st = []\n            elif not chained:\n                # 回到了之前某一步的出发点 = 中间是\"出去又回来\"的闭环(如放置完退回悬停点), 整段删掉:\n                # 否则复位会把整个放置倒着再走一遍, 方管重新伸进格口顶到刚放好的盒子\n                for i, e0 in enumerate(st):\n                    if max(abs(float(x) - y) for x, y in zip(start_j, e0[\"start_j\"])) < LOOP_TOL:\n                        st = st[:i]\n                        break\n            e = {\"kind\": kind, \"t\": round(time.time(), 2), \"start_j\": [round(float(x), 6) for x in start_j]}\n            e.update(extra)\n            st.append(e)\n            _save(st)\n    except Exception:\n        pass                                  # 记脚印失败绝不影响运动本身\n\n\ndef last_pending_movel():\n    \"\"\"上一条若是\"不等完成的直线\", 返回它的目标位姿(下一条连发直线的出发点); 否则 None\"\"\"\n    st = load()\n    if st and st[-1].get(\"kind\") == \"movel\" and st[-1].get(\"pending\") and time.time() - st[-1].get(\"t\", 0) < 20:\n        return st[-1].get(\"target_pose\")\n    return None\n\n\ndef set_last(**kw):\n    \"\"\"补记上一条(如阻塞的 movej_pose 走完后补目标关节)\"\"\"\n    if PAUSED[0]:\n        return\n    try:\n        with _lock:\n            st = load()\n            if st:\n                st[-1].update(kw)\n                _save(st)\n    except Exception:\n        pass\n\n\ndef pop():\n    with _lock:\n        st = load()\n        if st:\n            st.pop()\n            _save(st)\n        return st\n\n\ndef clear():\n    with _lock:\n        _save([])\n\n\n# ── 倒回时的\"当前位置在不在这一段上\"核对 ──\ndef on_joint_segment(cur, a, b, tol=0.06):\n    \"\"\"关节直线段 a→b 上(movej): 返回 (在不在, 参数λ, 偏差rad). b 为空则只认\"在 a 附近\"或放宽\"\"\"\n    if b is None:\n        d = max(abs(x - y) for x, y in zip(cur, a))\n        return d < tol, 0.0, d\n    ab = [y - x for x, y in zip(a, b)]\n    L2 = sum(v * v for v in ab)\n    lam = 0.0 if L2 < 1e-12 else max(0.0, min(1.0, sum((c - x) * v for c, x, v in zip(cur, a, ab)) / L2))\n    d = max(abs(c - (x + lam * v)) for c, x, v in zip(cur, a, ab))\n    return d < tol, lam, d\n\n\ndef on_line_segment(cur_xyz, a_xyz, b_xyz, tol=0.008):\n    \"\"\"笛卡尔直线段 a→b 上(movel): 偏差 m\"\"\"\n    ab = [y - x for x, y in zip(a_xyz, b_xyz)]\n    L2 = sum(v * v for v in ab)\n    lam = 0.0 if L2 < 1e-12 else max(0.0, min(1.0, sum((c - x) * v for c, x, v in zip(cur_xyz, a_xyz, ab)) / L2))\n    d = math.sqrt(sum((c - (x + lam * v)) ** 2 for c, x, v in zip(cur_xyz, a_xyz, ab)))\n    return d < tol, lam, d\n\n\ndef nearest_point(cur, pts):\n    best = None\n    for i, q in enumerate(pts):\n        d = max(abs(x - y) for x, y in zip(cur, q))\n        if best is None or d < best[0]:\n            best = (d, i)\n    return best\n","numLines":152,"startLine":1,"totalLines":152}},"displayPath":"scripts/bluespace/actions/breadcrumb.py"},"type":"attachment","uuid":"eab11cb1-8eae-4a2f-b1a5-30f26d07f5f7","timestamp":"2026-10-23T05:48:00.716Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/chen/Desktop/robocenter/scripts/bluespace/actions/breadcrumb.py\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t# -*- coding: utf-8 -*-\n2\t\"\"\"脚印(2026-10-23): 每发一条运动指令前, 记下\"从哪出发、用什么运动、去哪\", 叠成一摞; 复位时从最上面一条开始原路倒回.\n3\t\n4\t为什么: 很多动作不在路径库里(格内推进/退出、桌面下探吸取、去扫码口、去近拍位), 中途急停/中断后原复位认不出位置.\n5\t倒回走的是\"同一种运动、同一条线\"(movej 关节直线 / movel 笛卡尔直线 / track 同一串路点倒序), 扫过的空间与来时一致.\n6\t\n7\t记法:\n8\t  - 出发点在 home/mid(锚点)上 → 先清空再记(脚印永远只是\"离开锚点以来走过的路\")\n9\t  - 不等完成的连发直线(拐角抹圆) → 下一条的出发点取上一条的目标, 不取发令瞬间的实际位置\n10\t  - 文件 logs/breadcrumb.json, 跨进程(工作站服务/act.sh/flow.sh)共用, 服务重启不丢\n11\t  - PAUSED[0]=True 时不记(倒回过程自己的运动不能再叠上去)\n12\t倒回前逐条核对\"当前位置确实在这一段上\"(仿真干跑也会记脚印, 被人用示教器挪过也会对不上), 对不上就停, 不瞎走.\n13\t\"\"\"\n14\timport json\n15\timport math\n16\timport os\n17\timport threading\n18\timport time\n19\t\n20\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n21\tFILE = os.path.join(ROOT, \"logs\", \"breadcrumb.json\")\n22\tMAX_N = 300\n23\tANCHOR_TOL = 0.03          # rad: 出发点离 home/mid 这么近就算从锚点出发(清空重记)\n24\tLOOP_TOL = 0.004           # rad(≈3~4mm): 出发点离之前某一步的出发点这么近 = 走了个闭环回来, 删掉那段. 真闭环回到同一指令位姿(<0.1mm); 不能放大到 0.01, 格内 10mm 的降/推会被误判(2026-10-23 仿真实证)\n25\tPAUSED = [False]\n26\t_lock = threading.Lock()\n27\t_anchors = None\n28\t\n29\t\n30\tdef anchors():\n31\t    global _anchors\n32\t    if _anchors is None:\n33\t        import yaml\n34\t        p = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"poses.yaml\"), encoding=\"utf-8\"))\n35\t        _anchors = {k: [float(x) for x in p[k]] for k in (\"home\", \"mid\")}\n36\t    return _anchors\n37\t\n38\t\n39\tdef anchor_of(q, tol=ANCHOR_TOL):\n40\t    if not q:\n41\t        return None\n42\t    for k, a in anchors().items():\n43\t        if max(abs(float(x) - y) for x, y in zip(q, a)) < tol:\n44\t            return k\n45\t    return None\n46\t\n47\t\n48\tdef load():\n49\t    try:\n50\t        return json.load(open(FILE, encoding=\"utf-8\"))\n51\t    except Exception:\n52\t        return []\n53\t\n54\t\n55\tdef _save(st):\n56\t    os.makedirs(os.path.dirname(FILE), exist_ok=True)\n57\t    tmp = FILE + \".tmp\"\n58\t    json.dump(st[-MAX_N:], open(tmp, \"w\", encoding=\"utf-8\"))\n59\t    os.replace(tmp, FILE)\n60\t\n61\t\n62\tdef push(kind, start_j, chained=False, **extra):\n63\t    \"\"\"记一步. start_j: 出发关节(rad). chained=True: 接在上一条不等完成的直线后连发(出发点不是发令瞬间的位置, 不做锚点清空).\n64\t    extra: target_j / start_pose / target_pose / tool / wobj / pts / label / pending\"\"\"\n65\t    if PAUSED[0] or not start_j:\n66\t        return\n67\t    try:\n68\t        with _lock:\n69\t            st = load()\n70\t            if anchor_of(start_j) and not chained:\n71\t                st = []\n72\t            elif not chained:\n73\t                # 回到了之前某一步的出发点 = 中间是\"出去又回来\"的闭环(如放置完退回悬停点), 整段删掉:\n74\t                # 否则复位会把整个放置倒着再走一遍, 方管重新伸进格口顶到刚放好的盒子\n75\t                for i, e0 in enumerate(st):\n76\t                    if max(abs(float(x) - y) for x, y in zip(start_j, e0[\"start_j\"])) < LOOP_TOL:\n77\t                        st = st[:i]\n78\t                        break\n79\t            e = {\"kind\": kind, \"t\": round(time.time(), 2), \"start_j\": [round(float(x), 6) for x in start_j]}\n80\t            e.update(extra)\n81\t            st.append(e)\n82\t            _save(st)\n83\t    except Exception:\n84\t        pass                                  # 记脚印失败绝不影响运动本身\n85\t\n86\t\n87\tdef last_pending_movel():\n88\t    \"\"\"上一条若是\"不等完成的直线\", 返回它的目标位姿(下一条连发直线的出发点); 否则 None\"\"\"\n89\t    st = load()\n90\t    if st and st[-1].get(\"kind\") == \"movel\" and st[-1].get(\"pending\") and time.time() - st[-1].get(\"t\", 0) < 20:\n91\t        return st[-1].get(\"target_pose\")\n92\t    return None\n93\t\n94\t\n95\tdef set_last(**kw):\n96\t    \"\"\"补记上一条(如阻塞的 movej_pose 走完后补目标关节)\"\"\"\n97\t    if PAUSED[0]:\n98\t        return\n99\t    try:\n100\t        with _lock:\n101\t            st = load()\n102\t            if st:\n103\t                st[-1].update(kw)\n104\t                _save(st)\n105\t    except Exception:\n106\t        pass\n107\t\n108\t\n109\tdef pop():\n110\t    with _lock:\n111\t        st = load()\n112\t        if st:\n113\t            st.pop()\n114\t            _save(st)\n115\t        return st\n116\t\n117\t\n118\tdef clear():\n119\t    with _lock:\n120\t        _save([])\n121\t\n122\t\n123\t# ── 倒回时的\"当前位置在不在这一段上\"核对 ──\n124\tdef on_joint_segment(cur, a, b, tol=0.06):\n125\t    \"\"\"关节直线段 a→b 上(movej): 返回 (在不在, 参数λ, 偏差rad). b 为空则只认\"在 a 附近\"或放宽\"\"\"\n126\t    if b is None:\n127\t        d = max(abs(x - y) for x, y in zip(cur, a))\n128\t        return d < tol, 0.0, d\n129\t    ab = [y - x for x, y in zip(a, b)]\n130\t    L2 = sum(v * v for v in ab)\n131\t    lam = 0.0 if L2 < 1e-12 else max(0.0, min(1.0, sum((c - x) * v for c, x, v in zip(cur, a, ab)) / L2))\n132\t    d = max(abs(c - (x + lam * v)) for c, x, v in zip(cur, a, ab))\n133\t    return d < tol, lam, d\n134\t\n135\t\n136\tdef on_line_segment(cur_xyz, a_xyz, b_xyz, tol=0.008):\n137\t    \"\"\"笛卡尔直线段 a→b 上(movel): 偏差 m\"\"\"\n138\t    ab = [y - x for x, y in zip(a_xyz, b_xyz)]\n139\t    L2 = sum(v * v for v in ab)\n140\t    lam = 0.0 if L2 < 1e-12 else max(0.0, min(1.0, sum((c - x) * v for c, x, v in zip(cur_xyz, a_xyz, ab)) / L2))\n141\t    d = math.sqrt(sum((c - (x + lam * v)) ** 2 for c, x, v in zip(cur_xyz, a_xyz, ab)))\n142\t    return d < tol, lam, d\n143\t\n144\t\n145\tdef nearest_point(cur, pts):\n146\t    best = None\n147\t    for i, q in enumerate(pts):\n148\t        d = max(abs(x - y) for x, y in zip(cur, q))\n149\t        if best is None or d < best[0]:\n150\t            best = (d, i)\n151\t    return best\n152\t\n</system-reminder>"}],"renderedRole":"system","session_id":"2e8bfcd4-e637-441c-b83c-f83c49135d41","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
