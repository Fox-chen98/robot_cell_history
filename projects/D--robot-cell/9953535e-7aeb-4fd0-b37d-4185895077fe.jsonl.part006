  except Exception as e:\n        return \"读不到状态(%s)\" % e, None\n    parts = [SR.get(r, \"机器人状态%d\" % r), SS.get(s, \"安全状态%d\" % s), OM.get(m, \"模式%d\" % m)]\n    if s in (7, 8, 9):\n        head = \"⚠️ 急停/安全停止 → 需人工: 解除急停→上电→使能\"\n    elif r == 4:\n        head = \"⚠️ 已断电 → 需人工上电\"\n    elif r == 5:\n        head = \"未使能 → 可程序使能\"\n    else:\n        head = \"正常\"\n    return head + \" [\" + \" / \".join(parts) + \"]\", (r, p, s, m)\n\n\ndef joints_or_last(cobot, rec):\n    \"\"\"急停后控制器答关节全零; 用录制的最后一个有效点代替\"\"\"\n    try:\n        j = cobot.get_actual_joints_position()\n    except Exception:\n        j = None\n    if j and len(j) == 6 and any(abs(x) > 1e-6 for x in j):\n        return list(j), \"实时\"\n    if rec:\n        return list(rec[-1][1:7]), \"停滞前最后录制点\"","is_error":false}]},"uuid":"1623e8f4-f3a5-4b36-87e2-18aa2b2bf490","timestamp":"2026-10-28T09:18:46.253Z","toolUseResult":{"stdout":"            print(\"[cell] 任务号落盘失败(下次重启可能重号): %s\" % e, flush=True)\n\n    def current_id(self):\n        return self.running.id if self.running else None\n\n    def submit(self, req):\n        with self.lock:\n            if self.running is not None:\n                raise HTTPException(409, {\"error\": \"busy\", \"task_id\": self.running.id})\n            t = Task(self.next_id, req); self._save_last_id(t.id); self.next_id += 1; self.tasks[t.id] = t; self.running = t\n        threading.Thread(target=self._run, args=(t,), daemon=True, name=\"task-%d\" % t.id).start()\n        return t\n\n    # ── 一个任务 = 一次开硬件 + N 盒循环 ──\n    def _run(self, t):\n        import flows.store_one_box as F\n        t.state = \"running\"; t.started = time.time(); t.stage_code = \"STARTING\"\n        t.emit(\"task_start\", feed=t.req.feed, destination=t.req.destination, slot=t.req.slot, pits=t.req.pits, stop=t.req.stop.model_dump(),\n               dest=t.req.dest if t.req.type in (\"retrieve\", \"outbound\") else None, reason=t.req.reason, items=len(t.req.items or []) if t.req.type in (\"retrieve\", 