{"type":"bridge-session","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","bridgeSessionId":"cse_01SoknaJYdxMuRhrGtZYtRPv","lastSequenceNum":13639,"ownerAccountUuid":"b6adc3b5-c8e6-4193-9c5d-b3a726cd6f86","ownerOrganizationUuid":"ac90d4f7-a6f0-44de-95bc-eed28854da0d"}
{"parentUuid":"4dd29cf8-ffdd-443f-817d-d29fe3c50af8","isSidechain":false,"promptId":"a422cbf8-e2f5-4f95-9b3c-98aeb76c6299","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RAMBJTWdbqyjoiA9WkECpg","type":"tool_result","content":"The file D:\\robot_cell\\tools\\handeye\\aruco_snap.py has been updated successfully."}]},"uuid":"5c394719-dc5c-437a-b7c8-714e80e35958","timestamp":"2026-10-29T02:59:07.998Z","toolUseResult":{"filePath":"D:\\robot_cell\\tools\\handeye\\aruco_snap.py","oldString":"源文件在Mac: robocenter/scripts/bluespace/handeye/aruco_snap.py (deploy_cell.sh 推送, 勿直接改此份)","newString":"2026-10-29 起运行目录并入主仓库 D:\\robot_cell, 本文件即唯一来源(原 Mac 编辑源 scripts/bluespace/handeye/ + deploy_cell.sh 已取消)","originalFile":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\naruco_snap.py — 拍N帧RGB+深度, 检测ArUco码 + PnP位姿估计 + 深度互验 (无任何机械臂运动)\n运行(blue-space): python tools\\\\handeye\\\\aruco_snap.py [帧数,默认5]   (2026-09-10 迁入robot_cell/tools/handeye)\n输出: JSON(检出ID/位姿/PnP距离vs深度距离/抖动) + 标注图 robot_cell\\\\data\\\\captures\\\\aruco_snap.jpg\n源文件在Mac: robocenter/scripts/bluespace/handeye/aruco_snap.py (deploy_cell.sh 推送, 勿直接改此份)\n码牌参数见 robocenter/docs/ArUco标定物说明.md: DICT_6X6_1000, 码9cm(markerLength=0.09)\n\"\"\"\nimport os\nimport sys\nimport json\nimport time\n\nimport numpy as np\nimport cv2\nimport cv2.aruco as aruco\n\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))   # robot_cell\nsys.path.insert(0, ROOT)\nfrom hardware.depth_camera import Gemini335Camera  # noqa: E402\n\n\ndef _open_camera(tries=3, wait=2.0):\n    \"\"\"相机刚被别的进程释放时 Windows MF 会短暂报 0xc00d3704(2026-09-10 实测), 重试几次\"\"\"\n    for i in range(tries):\n        c = Gemini335Camera()\n        if c.connect() and c.start():\n            return c\n        try: c.disconnect()\n        except Exception: pass\n        time.sleep(wait)\n    raise SystemExit(\"camera fail (被占用? 视觉服务在跑先 vision_service.sh stop)\")\n\nMARKER_LENGTH = 0.09        # 米, 码黑框外沿(不是12cm贴纸!)\nMARKER_LENGTH_BY_ID = {0: 0.10}   # 特例: ID0=购入刚性标定板(黑框100mm/整板120mm/厚3mm)\nN = int(sys.argv[1]) if len(sys.argv) > 1 else 5\nCAP_DIR = os.path.join(ROOT, \"data\", \"captures\")\n\ncam = _open_camera()\nintr = cam.get_intrinsic()\nK = np.array([[intr.fx, 0, intr.cx], [0, intr.fy, intr.cy], [0, 0, 1]], dtype=np.float64)\nD = np.zeros(5)             # SDK出厂内参无畸变系数, 按零畸变\n\ndictionary = aruco.getPredefinedDictionary(aruco.DICT_6X6_1000)\ndetector = aruco.ArucoDetector(dictionary, aruco.DetectorParameters())\nobj_pts = np.array([[-MARKER_LENGTH/2,  MARKER_LENGTH/2, 0],\n                    [ MARKER_LENGTH/2,  MARKER_LENGTH/2, 0],\n                    [ MARKER_LENGTH/2, -MARKER_LENGTH/2, 0],\n                    [-MARKER_LENGTH/2, -MARKER_LENGTH/2, 0]], dtype=np.float32)\n\nresults = {}                # id -> [(tvec, rvec, depth_mm), ...]\nlast = None                 # (color, corners, ids)\ngot, tries = 0, 0\nwhile got < N and tries < N * 10:   # 重试直到拿满N帧有效图像(相机偶发空帧)\n    tries += 1\n    ok, color, depth = cam.capture()\n    if not ok or color is None or depth is None:\n        time.sleep(0.15)\n        continue\n    got += 1\n    gray = cv2.cvtColor(color, cv2.COLOR_BGR2GRAY)\n    corners, ids, _rej = detector.detectMarkers(gray)\n    last = (color, corners, ids)\n    if ids is None:\n        continue\n    for c, mid in zip(corners, ids.flatten()):\n        L = MARKER_LENGTH_BY_ID.get(int(mid), MARKER_LENGTH)\n        op = obj_pts * (L / MARKER_LENGTH)\n        okp, rvec, tvec = cv2.solvePnP(op, c[0], K, D, flags=cv2.SOLVEPNP_IPPE_SQUARE)\n        if not okp:\n            continue\n        u, v = c[0].mean(axis=0).astype(int)\n        patch = depth[max(0, v-3):v+4, max(0, u-3):u+4].astype(float)\n        dval = float(np.median(patch[patch > 0])) if (patch > 0).any() else -1.0\n        results.setdefault(int(mid), []).append((tvec.flatten(), rvec.flatten(), dval))\n\n# 标注图(最后一帧): 检测框+坐标轴\nos.makedirs(CAP_DIR, exist_ok=True)\nif last is not None:\n    color, corners, ids = last\n    out_img = aruco.drawDetectedMarkers(color.copy(), corners, ids)\n    if ids is not None:\n        for c, mid in zip(corners, ids.flatten()):\n            L = MARKER_LENGTH_BY_ID.get(int(mid), MARKER_LENGTH)\n            okp, rvec, tvec = cv2.solvePnP(obj_pts * (L / MARKER_LENGTH), c[0], K, D, flags=cv2.SOLVEPNP_IPPE_SQUARE)\n            if okp:\n                cv2.drawFrameAxes(out_img, K, D, rvec, tvec, 0.05)\n    cv2.imwrite(os.path.join(CAP_DIR, \"aruco_snap.jpg\"), out_img)\n\nsummary = {\"frames\": f\"{got}/{N}有效(尝试{tries})\",\n           \"intrinsic\": {\"fx\": round(intr.fx, 2), \"fy\": round(intr.fy, 2),\n                         \"cx\": round(intr.cx, 2), \"cy\": round(intr.cy, 2)},\n           \"markers\": {}}\nfor mid, obs in sorted(results.items()):\n    ts = np.array([o[0] for o in obs])\n    rs = np.array([o[1] for o in obs])\n    ds = [o[2] for o in obs if o[2] > 0]\n    t = ts.mean(axis=0)\n    summary[\"markers\"][mid] = {\n        \"hits\": f\"{len(obs)}/{N}\",\n        \"tvec_m\": [round(float(x), 4) for x in t],\n        \"rvec\": [round(float(x), 4) for x in rs.mean(axis=0)],\n        \"pnp_z_mm\": round(float(t[2]) * 1000, 1),          # PnP给出的光轴向距离\n        \"depth_z_mm\": round(float(np.median(ds)), 1) if ds else None,   # 深度图读数(互验)\n        \"jitter_mm\": round(float(ts.std(axis=0).max()) * 1000, 2),      # 多帧位置抖动\n    }\ncam.stop()\ncam.disconnect()\nprint(json.dumps(summary, ensure_ascii=False))  # 单行:多行JSON会被Windows-SSH通道吞行\n","structuredPatch":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":7,"lines":[" aruco_snap.py — 拍N帧RGB+深度, 检测ArUco码 + PnP位姿估计 + 深度互验 (无任何机械臂运动)"," 运行(blue-space): python tools\\\\handeye\\\\aruco_snap.py [帧数,默认5]   (2026-09-10 迁入robot_cell/tools/handeye)"," 输出: JSON(检出ID/位姿/PnP距离vs深度距离/抖动) + 标注图 robot_cell\\\\data\\\\captures\\\\aruco_snap.jpg","-源文件在Mac: robocenter/scripts/bluespace/handeye/aruco_snap.py (deploy_cell.sh 推送, 勿直接改此份)","+2026-10-29 起运行目录并入主仓库 D:\\robot_cell, 本文件即唯一来源(原 Mac 编辑源 scripts/bluespace/handeye/ + deploy_cell.sh 已取消)"," 码牌参数见 robocenter/docs/ArUco标定物说明.md: DICT_6X6_1000, 码9cm(markerLength=0.09)"," \"\"\""," import os"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"4dd29cf8-ffdd-443f-817d-d29fe3c50af8","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
