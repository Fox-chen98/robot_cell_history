\" % (ARM_TOOL,\r","+    print(\"设备代码用的是控制器里名为 %s 的工具%s; 示教器当前选中的工具%s\" % (tname,\r","+          \"(--tool 临时指定, 配置里实际是 %s)\" % ARM_TOOL if tool else \"(config/speed_profile.yaml tool.name)\",\r","           \"也是这组数\" if same_sel else \" ⚠ 数值不同(%s) —— 设备代码不受影响, 但示教器手动示教时的 TCP 读数会不同\" % sel))\r","     s, _ = load_snap(name)\r","     snap_ctl = s[\"meta\"].get(\"controller_tcp\") or (s[\"values\"][\"tcp\"][\"xyz\"] + s[\"values\"][\"tcp\"][\"rpy\"])\r"]},{"oldStart":327,"oldLines":6,"newStart":335,"newLines":8,"lines":["     elif cmd == \"diff\":\r","         sys.exit(0 if diff(rest[0], rest[1] if len(rest) > 1 else None) else 1)\r","     elif cmd == \"tcpcheck\":\r","-        sys.exit(0 if tcpcheck(rest[0] if rest else \"baseline_20261029\") else 1)\r","+        tl = a[a.index(\"--tool\") + 1] if \"--tool\" in a else None\r","+        rest = [x for x in rest if x != tl]\r","+        sys.exit(0 if tcpcheck(rest[0] if rest else \"baseline_20261029\", tl) else 1)\r","     else:\r","         restore(rest[0], apply=\"--apply\" in a)"]}]}],"moreFiles":0,"changedFiles":["D:\\robot_cell\\tools\\arm\\read_tcp_offset.py","D:\\robot_cell\\tools\\calib\\calib_snapshot.py"]}},"serverClassifierContext":{"request":"d6a3fdd9-6387-4af2-bd30-4a11e342250f","context":{"git_state":{"cwd":"/d/robot_cell","root":"/d/robot_cell","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/d/robot_cell","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"86c936d6-4d82-4da5-ab87-8d36fe035088","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"