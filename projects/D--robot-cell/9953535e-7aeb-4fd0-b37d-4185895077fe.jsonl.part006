"))","+            self.f.write(part)","+            self.bol = part.endswith(\"\\n\")","+        self.f.flush()","+","+    def flush(self):","+        try:","+            self.stream.flush()","+        except Exception:","+            pass","+","+","+def _open_log():","+    os.makedirs(os.path.dirname(LOG), exist_ok=True)","+    if os.path.exists(LOG) and os.path.getsize(LOG) > 5 * 1024 * 1024:","+        os.replace(LOG, LOG + \".1\")","+    f = open(LOG, \"a\", encoding=\"utf-8\")","+    sys.stdout = _Tee(sys.stdout, f)","+    sys.stderr = _Tee(sys.stderr, f)"," "," "," def main():","+    _open_log()","     t0 = time.time()","+    print(\"[扫码服务] 启动 pid=%d\" % os.getpid())","     sc = KeyboardScanner()","+    keys = {\"n\": 0, \"t\": None}                 # 钩子收到的按键(只记数和时刻, 回调里不做别的, 免得拖慢被摘)","+    _orig_on_key = sc._on_key","+","+    def _on_key(event):","+        keys[\"n\"] += 1; keys[\"t\"] = time.time()","+        return _orig_on_key(event)","+    sc._on_key = _on_key                       # connect() 里 keyboard.hook(self._on_key) 取的是这个","     if not sc.connect():","         raise SystemExit(\"[FAIL] 键盘钩子挂载失败\")","     n_codes = 0"]},{"oldStart":39,"oldLines":6,"newStart":88,"newLines":9,"lines":["     srv.listen(2)","     print(\"[扫码服务] 就绪, 监听 %s:%d  (本窗口须保持开着; 码同时自动落库storage/data/)\" % (HOST, PORT))"," ","+    def _key_age():","+        return round(time.time() - keys[\"t\"], 1) if keys[\"t\"] else None","+","     alive = True","     while alive:","         conn, _addr = srv.accept()"]},{"oldStart":57,"oldLines":7,"newStart":109,"newLines":8,"lines":["                     code, ts = sc.get_latest()","                     resp = {\"ok\": True, \"uptime_s\": round(time.time() - t0, 1),","                             \"n_codes\": n_codes,","-                            \"latest_age_s\": round(time.time() - ts, 1) if code else None}","+                            \"latest_age_s\": round(time.time() - ts, 1) if code else None,","+                            \"n_key