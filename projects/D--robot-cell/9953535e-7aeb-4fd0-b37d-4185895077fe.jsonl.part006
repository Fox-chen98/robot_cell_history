\\n  const setD = c => { document.body.classList.toggle(\\\"compact\\\", c); $(\\\"dens\\\").classList.toggle(\\\"on\\\", c); $(\\\"dens\\\").lastChild.textContent = c ? \\\"紧凑\\\" : \\\"紧凑\\\"; try { localStorage.setItem(\\\"dm_compact\\\", c ? \\\"1\\\" : \\\"\\\"); } catch (e) {} };\\n  $(\\\"dens\\\").onclick = () => setD(!document.body.classList.contains(\\\"compact\\\"));\\n  try { if (localStorage.getItem(\\\"dm_compact\\\") || location.hash === \\\"#compact\\\") setD(true); } catch (e) { if (location.hash === \\\"#compact\\\") setD(true); }\\n  // 调试开关\"),\n]\nfor a,b in R:\n    assert a in s,a[:60]; s=s.replace(a,b)\nopen(p,\"w\",encoding=\"utf-8\").write(s)\nEOF\nCH=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"; S=/private/tmp/claude-501/-Users-chen-Desktop-robocenter/9953535e-7aeb-4fd0-b37d-4185895077fe/scratchpad; \"$CH\" --headless=new --enable-logging=stderr --hide-scrollbars --force-device-scale-factor=2 --window-size=1000,628 --virtual-time-budget=1500 --screenshot=$S/disp3.png \"file://$PWD/发苗记录.html#compact\" 2>&1 | grep -i uncaught; echo ok","description":"加入紧凑显示模式并截图","timeout":60000},"caller":{"type":"direct"}}]}}
