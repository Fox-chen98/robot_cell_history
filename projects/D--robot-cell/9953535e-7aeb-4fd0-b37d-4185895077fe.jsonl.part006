           // 从左到右渐隐(遮罩作用于整张画布, 模型/药盒/动画一起变淡)\n    const f = { from: 0.4, to: 1.0, ...(opts.fade || {}) };\n    const g = `linear-gradient(to right, #000 ${f.from * 100}%, transparent ${f.to * 100}%)`;\n    renderer.domElement.style.maskImage = renderer.domElement.style.webkitMaskImage = g;\n  }\n\n  const scene = new THREE.Scene();","originalFile":null,"structuredPatch":[{"oldStart":75,"oldLines":19,"newStart":75,"newLines":24,"lines":[" const ease = p => p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;"," const ROD = 25, ROD_L = 260;                         // 立放吸杆: 25×25 方管, 画出伸在盒前的一段"," ","-function renderSlot(container, stock, geom) {","+function renderSlot(container, stock, geom, opts = {}) {","   container.classList.add(\"slot3d\");","   const tip = document.createElement(\"div\"); tip.className = \"tip\"; container.appendChild(tip);","   const flash = document.createElement(\"div\"); flash.className = \"flash\"; container.appendChild(flash);","   const dark = matchMedia(\"(prefers-color-scheme: dark)\").matches;"," ","-  const renderer = new THREE.WebGLRenderer({ antialias: true });","+  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });   // 透明背景: 透出网页底色, 不再是一块方框","+  renderer.setClearColor(0x000000, 0);","   renderer.setPixelRatio(Math.min(devicePixelRatio, 2));","   renderer.shadowMap.enabled = true;","   container.prepend(renderer.domElement);","+  if (opts.fade !== false) {                         // 从左到右渐隐(遮罩作用于整张画布, 模型/药盒/动画一起变淡)","+    const f = { from: 0.4, to: 1.0, ...(opts.fade || {}) };","+    const g = `linear-gradient(to right, #000 ${f.from * 100}%, transparent ${f.to * 100}%)`;","+    renderer.domElement.style.maskImage = renderer.domElement.style.webkitMaskImage = g;","+  }"," ","   const scene = new THREE.Scene();","-  scene.background = new THREE.Color(dark ? 0x1e293b : 0xffffff);","   const camera = new THREE.PerspectiveCamera(35, 1, 0.01, 10);","   const controls = new OrbitControls(camera, renderer.domElement);","   controls.enableDamping = true;"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"74dfd37a-4252-4098-b75f-af988bd0598f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"99e4ce18-cae8-43c8-bfaf-0a8d19bb1239","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.304","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
