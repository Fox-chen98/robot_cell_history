{"parentUuid":"0052d196-b9da-4ff7-bd22-ec4bec7576e8","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgW1DP5Kwf1ehB7v9swTn","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1263,"cache_read_input_tokens":150690,"output_tokens":6346,"output_tokens_details":{"thinking_tokens":109},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1263,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":6346,"cache_read_input_tokens":150690,"cache_creation_input_tokens":1263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1263},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":1217,"thinkingDisplay":"updates","serverClassifierRequest":"32f885e5-20cc-499b-93b5-4f03ac842c18","apiBlockIndex":0,"requestId":"req_011CgW1DNjEweN4unbjiWd9R","requestRef":"ff1a155b-af18-4394-ba54-b9af7c99236c","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"d1a721b7-8e71-4b6f-a4f9-0d14b6788c91","timestamp":"2026-10-29T05:49:55.504Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"d1a721b7-8e71-4b6f-a4f9-0d14b6788c91","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgW1DP5Kwf1ehB7v9swTn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01949v6jFvMdGzZiyUYXVMFq","name":"Write","input":{"file_path":"D:\\robot_cell\\tools\\calib\\calib_snapshot.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"calib_snapshot.py — 现役标定参数存档与对比(部署向导第 0 步; 也是各步\"结果对比\"的底层)\n\n用法(D:\\\\robot_cell 下, conda robot 环境):\n  python tools\\\\calib\\\\calib_snapshot.py save <名字> [--controller] [--note \"说明\"]\n      把现役标定值摘出来 + 原文件整份拷贝 → data/calib_snapshots/<名字>/\n      --controller = 顺带只读控制器里的 TCP(示教器四点标定的权威值)一并记下\n  python tools\\\\calib\\\\calib_snapshot.py show [<名字>]          不给名字=看当前现役值\n  python tools\\\\calib\\\\calib_snapshot.py diff <名字A> [<名字B>]  不给 B=对比当前现役值; 超容差的项标 ✗, 有 ✗ 则退出码 1\n  python tools\\\\calib\\\\calib_snapshot.py restore <名字> [--apply]  默认只列出会覆盖哪些文件; --apply 才真写(写前把当前文件再存一个快照)\n\n存什么(单一清单 ITEMS, 加标定项只改这里):\n  数值项: TCP / 唇边接触偏差 / 手眼矩阵 / 底座高 / 桌子位姿 / 货架位姿 / 桌面平面 / 相机内参\n  整文件指纹项: 命名位姿 / 格口参数 / 立放账本(每格口) / 路径库 / 丢弃点 / 扫码点 / 上苗机基准\n判决: diff 全部在容差内 → PASS\n\"\"\"\nimport sys, os, json, hashlib, shutil, glob, math, datetime, subprocess\nimport numpy as np\nimport yaml\n\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nSNAP_DIR = os.path.join(ROOT, \"data\", \"calib_snapshots\")\nHE = \"config/calibration/ducocobot/T_wrist2cam.npy\"     # 设备读的那份\nHE_COPY = \"config/T_wrist2cam.npy\"                      # Mac 时代仿真侧读的副本, 应与上面一致\n\n\ndef _yaml(rel, base=ROOT):\n    with open(os.path.join(base, rel), encoding=\"utf-8\") as f:\n        return yaml.safe_load(f)\n\n\ndef _sha(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        h.update(f.read())\n    return h.hexdigest()[:16]\n\n\ndef _he_summary(T):\n    T = np.asarray(T)\n    R = T[:3, :3]\n    ang = math.degrees(math.acos(max(-1.0, min(1.0, (np.trace(R) - 1) / 2))))\n    return {\"t_mm\": [round(v * 1000, 2) for v in T[:3, 3]], \"rot_deg\": round(ang, 3), \"matrix\": T.round(6).tolist()}\n\n\n# ---- 数值项: (键, 中文名, 来源文件列表, 取值函数(base)->dict, 对比函数(a,b)->(差值说明, 是否在容差内)) ----\ndef _d_vec(keys_tol):\n    \"\"\"keys_tol: [(字段, 缩放, 单位, 容差)] 逐字段取最大绝对差\"\"\"\n    def f(a, b):\n        parts, ok = [], True\n        for k, s, unit, tol in keys_tol:\n            va, vb = np.atleast_1d(np.asarray(a[k], float)), np.atleast_1d(np.asarray(b[k], float))\n            d = float(np.max(np.abs(va - vb))) * s\n            ok &= d <= tol\n            parts.append(\"%s %.3g%s\" % (k, d, unit))\n        return \", \".join(parts), ok\n    return f\n\n\ndef _d_he(a, b):\n    Ta, Tb = np.asarray(a[\"matrix\"]), np.asarray(b[\"matrix\"])\n    dt = float(np.linalg.norm(Ta[:3, 3] - Tb[:3, 3])) * 1000\n    Rd = Ta[:3, :3].T @ Tb[:3, :3]\n    dr = math.degrees(math.acos(max(-1.0, min(1.0, (np.trace(Rd) - 1) / 2))))\n    ok = dt <= 1.0 and dr <= 0.3 and a.get(\"copy_same\", True) == b.get(\"copy_same\", True)\n    return \"平移 %.2fmm, 转角 %.3f°\" % (dt, dr), ok\n\n\ndef _sp(base):\n    return _yaml(\"config/scene_params.yaml\", base)\n\n\ndef _tcp(base):\n    t = _sp(base)[\"tool\"]\n    return {\"xyz\": t[\"tcp_xyz\"], \"rpy\": t[\"tcp_rpy\"]}\n\n\ndef _contact(base):\n    c = _yaml(\"config/tool_contact.yaml\", base)\n    return {\"lip_press_m\": c.get(\"lip_press_m\"), \"tip_overshoot_m\": _sp(base)[\"tool\"].get(\"tip_overshoot\"),\n            \"table_z\": c.get(\"table_z\")}\n\n\ndef _he(base):\n    d = _he_summary(np.load(os.path.join(base, HE)))\n    cp = os.path.join(base, HE_COPY)\n    d[\"copy_same\"] = os.path.exists(cp) and _sha(cp) == _sha(os.path.join(base, HE))\n    return d\n\n\ndef _pose(sec):\n    def f(base):\n        s = _sp(base)[sec]\n        return {\"xyz\": s[\"pose_xyz\"], \"rpy\": s[\"pose_rpy\"]}\n    return f\n\n\ndef _plane(base):\n    p = _yaml(\"config/table_plane.yaml\", base)\n    return {\"abc\": [p[\"plane\"][k] for k in \"abc\"], \"d\": p[\"plane\"][\"d\"], \"roi\": p.get(\"roi\")}\n\n\ndef _intr(base):\n    c = _yaml(\"config/camera_intrinsic.yaml\", base)\n    return {k: c[k] for k in (\"fx\", \"fy\", \"cx\", \"cy\", \"width\", \"height\")}\n\n\nITEMS = [\n    (\"tcp\", \"TCP(示教器四点标定, 仿真侧副本)\", [\"config/scene_params.yaml\"], _tcp,\n     _d_vec([(\"xyz\", 1000, \"mm\", 0.5), (\"rpy\", 57.2958, \"°\", 0.1)])),\n    (\"contact\", \"吸盘唇边接触偏差\", [\"config/tool_contact.yaml\"], _contact,\n     _d_vec([(\"lip_press_m\", 1000, \"mm\", 0.5), (\"tip_overshoot_m\", 1000, \"mm\", 0.5)])),\n    (\"handeye\", \"手眼矩阵 T_wrist2cam\", [HE, HE_COPY], _he, _d_he),\n    (\"pedestal\", \"底座高度(地面码 ID4)\", [\"config/scene_params.yaml\"],\n     lambda b: {\"height\": _sp(b)[\"pedestal\"][\"height\"]}, _d_vec([(\"height\", 1000, \"mm\", 2.0)])),\n    (\"table\", \"桌子位姿(桌面码 ID5)\", [\"config/scene_params.yaml\"], _pose(\"table\"),\n     _d_vec([(\"xyz\", 1000, \"mm\", 3.0), (\"rpy\", 57.2958, \"°\", 0.3)])),\n    (\"shelf\", \"货架位姿(货架码 ID6/3/2)\", [\"config/scene_params.yaml\"], _pose(\"shelf\"),\n     _d_vec([(\"xyz\", 1000, \"mm\", 3.0), (\"rpy\", 57.2958, \"°\", 0.3)])),\n    (\"table_plane\", \"桌面平面(相机系)\", [\"config/table_plane.yaml\"], _plane,\n     _d_vec([(\"abc\", 57.2958, \"°≈\", 0.3), (\"d\", 1, \"mm\", 3.0)])),\n    (\"intrinsic\", \"相机内参\", [\"config/camera_intrinsic.yaml\"], _intr,\n     _d_vec([(\"fx\", 1, \"px\", 2.0), (\"fy\", 1, \"px\", 2.0), (\"cx\", 1, \"px\", 2.0), (\"cy\", 1, \"px\", 2.0)])),\n]\n\n# ---- 整文件指纹项: 内容一变就报(这些不是\"量出来有误差\"的值, 动了就是有人改过) ----\nFILE_GROUPS = [\n    (\"poses\", \"命名位姿\", [\"config/poses.yaml\"]),\n    (\"slots\", \"格口参数\", [\"config/slots.yaml\"]),\n    (\"stand\", \"立放账本(每格口)\", [\"config/slot_range/*_stand.json\"]),\n    (\"screen\", \"格内安全筛查结果\", [\"config/slot_range/screen/*.json\"]),\n    (\"paths\", \"路径库\", [\"config/paths/*.json\"]),\n    (\"points\", \"丢弃点/扫码点/上苗机基准/抓取走廊\", [\"config/drop_point.yaml\", \"config/scan_point.yaml\",\n                                          \"config/feeder_baseline.json\", \"config/grasp_corridor.yaml\"]),\n    (\"handeye_cfg\", \"手眼巡拍参数(板位)\", [\"config/handeye.yaml\"]),\n]\n\n\ndef _files(base, pats):\n    out = []\n    for p in pats:\n        out += sorted(os.path.relpath(f, base).replace(\"\\\\\", \"/\") for f in glob.glob(os.path.join(base, p)))\n    return out\n\n\ndef collect(base=ROOT):\n    vals = {}\n    for key, name, _, fn, _ in ITEMS:\n        try:\n            vals[key] = fn(base)\n        except Exception as e:  # 某文件缺失也要能存其余项\n            vals[key] = {\"error\": str(e)}\n    fps = {}\n    for key, name, pats in FILE_GROUPS:\n        fps[key] = {f: _sha(os.path.join(base, f)) for f in _files(base, pats)}\n    return vals, fps\n\n\ndef all_files(base=ROOT):\n    fs = set()\n    for _, _, srcs, _, _ in ITEMS:\n        fs.update(s for s in srcs if os.path.exists(os.path.join(base, s)))\n    for _, _, pats in FILE_GROUPS:\n        fs.update(_files(base, pats))\n    return sorted(fs)\n\n\ndef read_controller_tcp():\n    py = os.path.join(ROOT, \"tools\", \"arm\", \"read_tcp_offset.py\")\n    r = subprocess.run([sys.executable, py], capture_output=True, text=True, timeout=20)\n    for line in r.stdout.splitlines():\n        if line.startswith(\"TCP_OFFSET:\"):\n            return json.loads(line.split(\":\", 1)[1])\n    raise RuntimeError(\"读控制器 TCP 失败: \" + (r.stderr or r.stdout)[-300:])\n\n\ndef load_snap(name):\n    d = os.path.join(SNAP_DIR, name)\n    with open(os.path.join(d, \"snapshot.json\"), encoding=\"utf-8\") as f:\n        return json.load(f), os.path.join(d, \"files\")\n\n\ndef save(name, controller=False, note=\"\"):\n    d = os.path.join(SNAP_DIR, name)\n    if os.path.exists(d):\n        sys.exit(\"❌ 快照 %s 已存在, 换个名字\" % name)\n    vals, fps = collect()\n    meta = {\"name\": name, \"time\": datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"), \"note\": note}\n    try:\n        meta[\"git\"] = subprocess.run([\"git\", \"-C\", ROOT, \"rev-parse\", \"--short\", \"HEAD\"],\n                                     capture_output=True, text=True).stdout.strip()\n    except Exception:\n        pass\n    if controller:\n        off = read_controller_tcp()\n        meta[\"controller_tcp\"] = off\n        same = max(abs(a - b) for a, b in zip(off[:3], vals[\"tcp\"][\"xyz\"])) * 1000 < 0.05\n        meta[\"controller_tcp_same_as_yaml\"] = bool(same)\n    files = all_files()\n    for f in files:\n        dst = os.path.join(d, \"files\", f)\n        os.makedirs(os.path.dirname(dst), exist_ok=True)\n        shutil.copy2(os.path.join(ROOT, f), dst)\n    with open(os.path.join(d, \"snapshot.json\"), \"w\", encoding=\"utf-8\") as fo:\n        json.dump({\"meta\": meta, \"values\": vals, \"fingerprints\": fps}, fo, ensure_ascii=False, indent=1)\n    print(\"✅ 已存快照 %s: %d 个数值项, %d 个文件 → %s\" % (name, len(vals), len(files), d))\n    if controller:\n        print(\"   控制器 TCP %s  与配置%s\" % (meta[\"controller_tcp\"], \"一致\" if meta[\"controller_tcp_same_as_yaml\"] else \"❌不一致\"))\n\n\ndef show(name=None):\n    if name:\n        s, _ = load_snap(name)\n        vals, fps, meta = s[\"values\"], s[\"fingerprints\"], s[\"meta\"]\n        print(\"快照 %s  (%s, git %s)  %s\" % (name, meta[\"time\"], meta.get(\"git\", \"?\"), meta.get(\"note\", \"\")))\n        if \"controller_tcp\" in meta:\n            print(\"  控制器 TCP: %s\" % meta[\"controller_tcp\"])\n    else:\n        vals, fps = collect()\n        print(\"当前现役值\")\n    for key, cname, _, _, _ in ITEMS:\n        v = dict(vals.get(key, {}))\n        v.pop(\"matrix\", None)\n        print(\"  %-12s %-28s %s\" % (key, cname, json.dumps(v, ensure_ascii=False)))\n    for key, cname, _ in FILE_GROUPS:\n        print(\"  %-12s %-28s %d 个文件\" % (key, cname, len(fps.get(key, {}))))\n\n\ndef diff(a, b=None):\n    sa, _ = load_snap(a)\n    if b:\n        sb, _ = load_snap(b)\n        vb, fb, lb = sb[\"values\"], sb[\"fingerprints\"], b\n    else:\n        vb, fb = collect()\n        lb = \"当前\"\n    va, fa = sa[\"values\"], sa[\"fingerprints\"]\n    print(\"对比  %s  →  %s\" % (a, lb))\n    bad = 0\n    for key, cname, _, _, dfn in ITEMS:\n        x, y = va.get(key, {}), vb.get(key, {})\n        if \"error\" in x or \"error\" in y:\n            print(\"  ✗ %-28s 读取出错: %s\" % (cname, x.get(\"error\") or y.get(\"error\")))\n            bad += 1\n            continue\n        txt, ok = dfn(x, y)\n        bad += not ok\n        print(\"  %s %-28s %s\" % (\"✓\" if ok else \"✗\", cname, txt))\n    for key, cname, _ in FILE_GROUPS:\n        x, y = fa.get(key, {}), fb.get(key, {})\n        changed = [f for f in set(x) | set(y) if x.get(f) != y.get(f)]\n        bad += bool(changed)\n        if changed:\n            print(\"  ✗ %-28s %d 个文件变了: %s\" % (cname, len(changed), \", \".join(sorted(changed)[:6]) +\n                                               (\" …\" if len(changed) > 6 else \"\")))\n        else:\n            print(\"  ✓ %-28s %d 个文件未变\" % (cname, len(x)))\n    print(\"PASS: 全部在容差内\" if not bad else \"FAIL: %d 项超容差/有改动\" % bad)\n    return bad == 0\n\n\ndef restore(name, apply=False):\n    s, src = load_snap(name)\n    files = sorted(os.path.relpath(f, src).replace(\"\\\\\", \"/\")\n                   for f in glob.glob(os.path.join(src, \"**\", \"*\"), recursive=True) if os.path.isfile(f))\n    changed = [f for f in files if not os.path.exists(os.path.join(ROOT, f))\n               or _sha(os.path.join(ROOT, f)) != _sha(os.path.join(src, f))]\n    print(\"快照 %s 共 %d 个文件, 与当前不同 %d 个:\" % (name, len(files), len(changed)))\n    for f in changed:\n        print(\"   \", f)\n    if not changed:\n        print(\"PASS: 当前就是该快照, 无需恢复\")\n        return\n    if not apply:\n        print(\"(只列出; 加 --apply 才写入)\")\n        return\n    save(\"before_restore_\" + datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\"), note=\"恢复 %s 前自动存档\" % name)\n    for f in changed:\n        dst = os.path.join(ROOT, f)\n        os.makedirs(os.path.dirname(dst), exist_ok=True)\n        shutil.copy2(os.path.join(src, f), dst)\n    print(\"✅ 已恢复 %d 个文件; 常驻服务读配置的需重启: services\\\\svc.bat restart cell / vision\" % len(changed))\n\n\nif __name__ == \"__main__\":\n    a = sys.argv[1:]\n    if not a or a[0] not in (\"save\", \"show\", \"diff\", \"restore\"):\n        print(__doc__)\n        sys.exit(1)\n    cmd, rest = a[0], [x for x in a[1:] if not x.startswith(\"--\")]\n    note = a[a.index(\"--note\") + 1] if \"--note\" in a else \"\"\n    if \"--note\" in a:\n        rest = [x for x in rest if x != note]\n    if cmd == \"save\":\n        save(rest[0], controller=\"--controller\" in a, note=note)\n    elif cmd == \"show\":\n        show(rest[0] if rest else None)\n    elif cmd == \"diff\":\n        sys.exit(0 if diff(rest[0], rest[1] if len(rest) > 1 else None) else 1)\n    else:\n        restore(rest[0], apply=\"--apply\" in a)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1263,"cache_read_input_tokens":150690,"output_tokens":6346,"output_tokens_details":{"thinking_tokens":109},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1263,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":6346,"cache_read_input_tokens":150690,"cache_creation_input_tokens":1263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1263},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01949v6jFvMdGzZiyUYXVMFq":{"file_path":"D:\\robot_cell\\tools\\calib\\calib_snapshot.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"calib_snapshot.py — 现役标定参数存档与对比(部署向导第 0 步; 也是各步\"结果对比\"的底层)\n\n用法(D:\\\\robot_cell 下, conda robot 环境):\n  python tools\\\\calib\\\\calib_snapshot.py save <名字> [--controller] [--note \"说明\"]\n      把现役标定值摘出来 + 原文件整份拷贝 → data/calib_snapshots/<名字>/\n      --controller = 顺带只读控制器里的 TCP(示教器四点标定的权威值)一并记下\n  python tools\\\\calib\\\\calib_snapshot.py show [<名字>]          不给名字=看当前现役值\n  python tools\\\\calib\\\\calib_snapshot.py diff <名字A> [<名字B>]  不给 B=对比当前现役值; 超容差的项标 ✗, 有 ✗ 则退出码 1\n  python tools\\\\calib\\\\calib_snapshot.py restore <名字> [--apply]  默认只列出会覆盖哪些文件; --apply 才真写(写前把当前文件再存一个快照)\n\n存什么(单一清单 ITEMS, 加标定项只改这里):\n  数值项: TCP / 唇边接触偏差 / 手眼矩阵 / 底座高 / 桌子位姿 / 货架位姿 / 桌面平面 / 相机内参\n  整文件指纹项: 命名位姿 / 格口参数 / 立放账本(每格口) / 路径库 / 丢弃点 / 扫码点 / 上苗机基准\n判决: diff 全部在容差内 → PASS\n\"\"\"\nimport sys, os, json, hashlib, shutil, glob, math, datetime, subprocess\nimport numpy as np\nimport yaml\n\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nSNAP_DIR = os.path.join(ROOT, \"data\", \"calib_snapshots\")\nHE = \"config/calibration/ducocobot/T_wrist2cam.npy\"     # 设备读的那份\nHE_COPY = \"config/T_wrist2cam.npy\"                      # Mac 时代仿真侧读的副本, 应与上面一致\n\n\ndef _yaml(rel, base=ROOT):\n    with open(os.path.join(base, rel), encoding=\"utf-8\") as f:\n        return yaml.safe_load(f)\n\n\ndef _sha(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        h.update(f.read())\n    return h.hexdigest()[:16]\n\n\ndef _he_summary(T):\n    T = np.asarray(T)\n    R = T[:3, :3]\n    ang = math.degrees(math.acos(max(-1.0, min(1.0, (np.trace(R) - 1) / 2))))\n    return {\"t_mm\": [round(v * 1000, 2) for v in T[:3, 3]], \"rot_deg\": round(ang, 3), \"matrix\": T.round(6).tolist()}\n\n\n# ---- 数值项: (键, 中文名, 来源文件列表, 取值函数(base)->dict, 对比函数(a,b)->(差值说明, 是否在容差内)) ----\ndef _d_vec(keys_tol):\n    \"\"\"keys_tol: [(字段, 缩放, 单位, 容差)] 逐字段取最大绝对差\"\"\"\n    def f(a, b):\n        parts, ok = [], True\n        for k, s, unit, tol in keys_tol:\n            va, vb = np.atleast_1d(np.asarray(a[k], float)), np.atleast_1d(np.asarray(b[k], float))\n            d = float(np.max(np.abs(va - vb))) * s\n            ok &= d <= tol\n            parts.append(\"%s %.3g%s\" % (k, d, unit))\n        return \", \".join(parts), ok\n    return f\n\n\ndef _d_he(a, b):\n    Ta, Tb = np.asarray(a[\"matrix\"]), np.asarray(b[\"matrix\"])\n    dt = float(np.linalg.norm(Ta[:3, 3] - Tb[:3, 3])) * 1000\n    Rd = Ta[:3, :3].T @ Tb[:3, :3]\n    dr = math.degrees(math.acos(max(-1.0, min(1.0, (np.trace(Rd) - 1) / 2))))\n    ok = dt <= 1.0 and dr <= 0.3 and a.get(\"copy_same\", True) == b.get(\"copy_same\", True)\n    return \"平移 %.2fmm, 转角 %.3f°\" % (dt, dr), ok\n\n\ndef _sp(base):\n    return _yaml(\"config/scene_params.yaml\", base)\n\n\ndef _tcp(base):\n    t = _sp(base)[\"tool\"]\n    return {\"xyz\": t[\"tcp_xyz\"], \"rpy\": t[\"tcp_rpy\"]}\n\n\ndef _contact(base):\n    c = _yaml(\"config/tool_contact.yaml\", base)\n    return {\"lip_press_m\": c.get(\"lip_press_m\"), \"tip_overshoot_m\": _sp(base)[\"tool\"].get(\"tip_overshoot\"),\n            \"table_z\": c.get(\"table_z\")}\n\n\ndef _he(base):\n    d = _he_summary(np.load(os.path.join(base, HE)))\n    cp = os.path.join(base, HE_COPY)\n    d[\"copy_same\"] = os.path.exists(cp) and _sha(cp) == _sha(os.path.join(base, HE))\n    return d\n\n\ndef _pose(sec):\n    def f(base):\n        s = _sp(base)[sec]\n        return {\"xyz\": s[\"pose_xyz\"], \"rpy\": s[\"pose_rpy\"]}\n    return f\n\n\ndef _plane(base):\n    p = _yaml(\"config/table_plane.yaml\", base)\n    return {\"abc\": [p[\"plane\"][k] for k in \"abc\"], \"d\": p[\"plane\"][\"d\"], \"roi\": p.get(\"roi\")}\n\n\ndef _intr(base):\n    c = _yaml(\"config/camera_intrinsic.yaml\", base)\n    return {k: c[k] for k in (\"fx\", \"fy\", \"cx\", \"cy\", \"width\", \"height\")}\n\n\nITEMS = [\n    (\"tcp\", \"TCP(示教器四点标定, 仿真侧副本)\", [\"config/scene_params.yaml\"], _tcp,\n     _d_vec([(\"xyz\", 1000, \"mm\", 0.5), (\"rpy\", 57.2958, \"°\", 0.1)])),\n    (\"contact\", \"吸盘唇边接触偏差\", [\"config/tool_contact.yaml\"], _contact,\n     _d_vec([(\"lip_press_m\", 1000, \"mm\", 0.5), (\"tip_overshoot_m\", 1000, \"mm\", 0.5)])),\n    (\"handeye\", \"手眼矩阵 T_wrist2cam\", [HE, HE_COPY], _he, _d_he),\n    (\"pedestal\", \"底座高度(地面码 ID4)\", [\"config/scene_params.yaml\"],\n     lambda b: {\"height\": _sp(b)[\"pedestal\"][\"height\"]}, _d_vec([(\"height\", 1000, \"mm\", 2.0)])),\n    (\"table\", \"桌子位姿(桌面码 ID5)\", [\"config/scene_params.yaml\"], _pose(\"table\"),\n     _d_vec([(\"xyz\", 1000, \"mm\", 3.0), (\"rpy\", 57.2958, \"°\", 0.3)])),\n    (\"shelf\", \"货架位姿(货架码 ID6/3/2)\", [\"config/scene_params.yaml\"], _pose(\"shelf\"),\n     _d_vec([(\"xyz\", 1000, \"mm\", 3.0), (\"rpy\", 57.2958, \"°\", 0.3)])),\n    (\"table_plane\", \"桌面平面(相机系)\", [\"config/table_plane.yaml\"], _plane,\n     _d_vec([(\"abc\", 57.2958, \"°≈\", 0.3), (\"d\", 1, \"mm\", 3.0)])),\n    (\"intrinsic\", \"相机内参\", [\"config/camera_intrinsic.yaml\"], _intr,\n     _d_vec([(\"fx\", 1, \"px\", 2.0), (\"fy\", 1, \"px\", 2.0), (\"cx\", 1, \"px\", 2.0), (\"cy\", 1, \"px\", 2.0)])),\n]\n\n# ---- 整文件指纹项: 内容一变就报(这些不是\"量出来有误差\"的值, 动了就是有人改过) ----\nFILE_GROUPS = [\n    (\"poses\", \"命名位姿\", [\"config/poses.yaml\"]),\n    (\"slots\", \"格口参数\", [\"config/slots.yaml\"]),\n    (\"stand\", \"立放账本(每格口)\", [\"config/slot_range/*_stand.json\"]),\n    (\"screen\", \"格内安全筛查结果\", [\"config/slot_range/screen/*.json\"]),\n    (\"paths\", \"路径库\", [\"config/paths/*.json\"]),\n    (\"points\", \"丢弃点/扫码点/上苗机基准/抓取走廊\", [\"config/drop_point.yaml\", \"config/scan_point.yaml\",\n                                          \"config/feeder_baseline.json\", \"config/grasp_corridor.yaml\"]),\n    (\"handeye_cfg\", \"手眼巡拍参数(板位)\", [\"config/handeye.yaml\"]),\n]\n\n\ndef _files(base, pats):\n    out = []\n    for p in pats:\n        out += sorted(os.path.relpath(f, base).replace(\"\\\\\", \"/\") for f in glob.glob(os.path.join(base, p)))\n    return out\n\n\ndef collect(base=ROOT):\n    vals = {}\n    for key, name, _, fn, _ in ITEMS:\n        try:\n            vals[key] = fn(base)\n        except Exception as e:  # 某文件缺失也要能存其余项\n            vals[key] = {\"error\": str(e)}\n    fps = {}\n    for key, name, pats in FILE_GROUPS:\n        fps[key] = {f: _sha(os.path.join(base, f)) for f in _files(base, pats)}\n    return vals, fps\n\n\ndef all_files(base=ROOT):\n    fs = set()\n    for _, _, srcs, _, _ in ITEMS:\n        fs.update(s for s in srcs if os.path.exists(os.path.join(base, s)))\n    for _, _, pats in FILE_GROUPS:\n        fs.update(_files(base, pats))\n    return sorted(fs)\n\n\ndef read_controller_tcp():\n    py = os.path.join(ROOT, \"tools\", \"arm\", \"read_tcp_offset.py\")\n    r = subprocess.run([sys.executable, py], capture_output=True, text=True, timeout=20)\n    for line in r.stdout.splitlines():\n        if line.startswith(\"TCP_OFFSET:\"):\n            return json.loads(line.split(\":\", 1)[1])\n    raise RuntimeError(\"读控制器 TCP 失败: \" + (r.stderr or r.stdout)[-300:])\n\n\ndef load_snap(name):\n    d = os.path.join(SNAP_DIR, name)\n    with open(os.path.join(d, \"snapshot.json\"), encoding=\"utf-8\") as f:\n        return json.load(f), os.path.join(d, \"files\")\n\n\ndef save(name, controller=False, note=\"\"):\n    d = os.path.join(SNAP_DIR, name)\n    if os.path.exists(d):\n        sys.exit(\"❌ 快照 %s 已存在, 换个名字\" % name)\n    vals, fps = collect()\n    meta = {\"name\": name, \"time\": datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"), \"note\": note}\n    try:\n        meta[\"git\"] = subprocess.run([\"git\", \"-C\", ROOT, \"rev-parse\", \"--short\", \"HEAD\"],\n                                     capture_output=True, text=True).stdout.strip()\n    except Exception:\n        pass\n    if controller:\n        off = read_controller_tcp()\n        meta[\"controller_tcp\"] = off\n        same = max(abs(a - b) for a, b in zip(off[:3], vals[\"tcp\"][\"xyz\"])) * 1000 < 0.05\n        meta[\"controller_tcp_same_as_yaml\"] = bool(same)\n    files = all_files()\n    for f in files:\n        dst = os.path.join(d, \"files\", f)\n        os.makedirs(os.path.dirname(dst), exist_ok=True)\n        shutil.copy2(os.path.join(ROOT, f), dst)\n    with open(os.path.join(d, \"snapshot.json\"), \"w\", encoding=\"utf-8\") as fo:\n        json.dump({\"meta\": meta, \"values\": vals, \"fingerprints\": fps}, fo, ensure_ascii=False, indent=1)\n    print(\"✅ 已存快照 %s: %d 个数值项, %d 个文件 → %s\" % (name, len(vals), len(files), d))\n    if controller:\n        print(\"   控制器 TCP %s  与配置%s\" % (meta[\"controller_tcp\"], \"一致\" if meta[\"controller_tcp_same_as_yaml\"] else \"❌不一致\"))\n\n\ndef show(name=None):\n    if name:\n        s, _ = load_snap(name)\n        vals, fps, meta = s[\"values\"], s[\"fingerprints\"], s[\"meta\"]\n        print(\"快照 %s  (%s, git %s)  %s\" % (name, meta[\"time\"], meta.get(\"git\", \"?\"), meta.get(\"note\", \"\")))\n        if \"controller_tcp\" in meta:\n            print(\"  控制器 TCP: %s\" % meta[\"controller_tcp\"])\n    else:\n        vals, fps = collect()\n        print(\"当前现役值\")\n    for key, cname, _, _, _ in ITEMS:\n        v = dict(vals.get(key, {}))\n        v.pop(\"matrix\", None)\n        print(\"  %-12s %-28s %s\" % (key, cname, json.dumps(v, ensure_ascii=False)))\n    for key, cname, _ in FILE_GROUPS:\n        print(\"  %-12s %-28s %d 个文件\" % (key, cname, len(fps.get(key, {}))))\n\n\ndef diff(a, b=None):\n    sa, _ = load_snap(a)\n    if b:\n        sb, _ = load_snap(b)\n        vb, fb, lb = sb[\"values\"], sb[\"fingerprints\"], b\n    else:\n        vb, fb = collect()\n        lb = \"当前\"\n    va, fa = sa[\"values\"], sa[\"fingerprints\"]\n    print(\"对比  %s  →  %s\" % (a, lb))\n    bad = 0\n    for key, cname, _, _, dfn in ITEMS:\n        x, y = va.get(key, {}), vb.get(key, {})\n        if \"error\" in x or \"error\" in y:\n            print(\"  ✗ %-28s 读取出错: %s\" % (cname, x.get(\"error\") or y.get(\"error\")))\n            bad += 1\n            continue\n        txt, ok = dfn(x, y)\n        bad += not ok\n        print(\"  %s %-28s %s\" % (\"✓\" if ok else \"✗\", cname, txt))\n    for key, cname, _ in FILE_GROUPS:\n        x, y = fa.get(key, {}), fb.get(key, {})\n        changed = [f for f in set(x) | set(y) if x.get(f) != y.get(f)]\n        bad += bool(changed)\n        if changed:\n            print(\"  ✗ %-28s %d 个文件变了: %s\" % (cname, len(changed), \", \".join(sorted(changed)[:6]) +\n                                               (\" …\" if len(changed) > 6 else \"\")))\n        else:\n            print(\"  ✓ %-28s %d 个文件未变\" % (cname, len(x)))\n    print(\"PASS: 全部在容差内\" if not bad else \"FAIL: %d 项超容差/有改动\" % bad)\n    return bad == 0\n\n\ndef restore(name, apply=False):\n    s, src = load_snap(name)\n    files = sorted(os.path.relpath(f, src).replace(\"\\\\\", \"/\")\n                   for f in glob.glob(os.path.join(src, \"**\", \"*\"), recursive=True) if os.path.isfile(f))\n    changed = [f for f in files if not os.path.exists(os.path.join(ROOT, f))\n               or _sha(os.path.join(ROOT, f)) != _sha(os.path.join(src, f))]\n    print(\"快照 %s 共 %d 个文件, 与当前不同 %d 个:\" % (name, len(files), len(changed)))\n    for f in changed:\n        print(\"   \", f)\n    if not changed:\n        print(\"PASS: 当前就是该快照, 无需恢复\")\n        return\n    if not apply:\n        print(\"(只列出; 加 --apply 才写入)\")\n        return\n    save(\"before_restore_\" + datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\"), note=\"恢复 %s 前自动存档\" % name)\n    for f in changed:\n        dst = os.path.join(ROOT, f)\n        os.makedirs(os.path.dirname(dst), exist_ok=True)\n        shutil.copy2(os.path.join(src, f), dst)\n    print(\"✅ 已恢复 %d 个文件; 常驻服务读配置的需重启: services\\\\svc.bat restart cell / vision\" % len(changed))\n\n\nif __name__ == \"__main__\":\n    a = sys.argv[1:]\n    if not a or a[0] not in (\"save\", \"show\", \"diff\", \"restore\"):\n        print(__doc__)\n        sys.exit(1)\n    cmd, rest = a[0], [x for x in a[1:] if not x.startswith(\"--\")]\n    note = a[a.index(\"--note\") + 1] if \"--note\" in a else \"\"\n    if \"--note\" in a:\n        rest = [x for x in rest if x != note]\n    if cmd == \"save\":\n        save(rest[0], controller=\"--controller\" in a, note=note)\n    elif cmd == \"show\":\n        show(rest[0] if rest else None)\n    elif cmd == \"diff\":\n        sys.exit(0 if diff(rest[0], rest[1] if len(rest) > 1 else None) else 1)\n    else:\n        restore(rest[0], apply=\"--apply\" in a)\n"}},"serverClassifierRequest":"32f885e5-20cc-499b-93b5-4f03ac842c18","apiBlockIndex":1,"requestId":"req_011CgW1DNjEweN4unbjiWd9R","requestRef":"ff1a155b-af18-4394-ba54-b9af7c99236c","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"eeeab70c-4c80-4c1c-a52f-6e5c801f7242","timestamp":"2026-10-29T05:50:43.412Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
