"2.1.310","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"efaa4dae-1bdc-4ca4-96a2-51d88bf5e20b","isSidechain":false,"promptId":"12933cbd-f703-4314-a852-db734a87636d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TKnJFNzT7373U8qySK8ayq","type":"tool_result","content":"        os.remove(f\"{ROOT}/out/rsp_tool_patch.py\")   # 工具关闭时不再同步RSP侧\n\nS = P[\"shelf\"]\nif S[\"enabled\"]:\n    W, D, H = S[\"width\"], S[\"depth\"], S[\"height\"]\n    NC, NL = S[\"columns\"], S[\"layers\"]\n    ps, bt = S[\"post_section\"], S[\"board_thickness\"]\n    fb, gap = S[\"first_board_h\"], S[\"board_gap\"]\n\n    # ---- 数值自检 ----\n    top_of_stack = fb + (NL - 1) * (gap + bt)          # 最高层板顶面高度\n    need = top_of_stack + gap                           # 顶层格口还需净空\n    if need > H + 1e-6:\n        errors.append(f\"层板放不下: 首板高{fb} + {NL-1}x(净距{gap}+板厚{bt}) + 顶层净空{gap} = {need:.3f} > 总高{H}\")\n    if NC < 1 or NL < 1: errors.append(\"columns/layers 必须 >=1\")\n\n    boxes = []                                          # (cx,cy,cz,sx,sy,sz) 显示与碰撞共用\n    # 4根角柱 + 列分隔柱(前后各 columns-1 根)\n    xs = [-W/2 + ps/2, W/2 - ps/2]\n    ys = [-D/2 + ps/2, D/2 - ps/2]\n    for x in xs:\n        for y in ys:\n            boxes.append((x, y, H/2, ps, ps, H))\n    col_w = W / NC\n    for i in range(1, NC):\n        x = -W/2 + i * col_w\n        for y in ys:\n            boxes.append((x, y, H/2, ps, ps, H))\n    # 层板: 2026-09-16 左右列独立(column_layers 有则每列自己的首板高/净高/层数, 层板只横贯本列宽; 无则沿用整宽横贯) + 顶板\n    CL = S.get(\"column_layers\")\n    col_names = [\"left\", \"right\"] if NC == 2 else [f\"c{c+1}\" for c in range(NC)]\n    def layout(c):\n        if CL and col_names[c] in CL:\n            L = CL[col_names[c]]; return float(L[\"first_board_h\"]), float(L[\"board_gap\"]), int(L[\"layers\"])\n        return fb, gap, NL\n    for c in range(NC):\n        cfb, cgap, cNL = layout(c); ccx = -W/2 + (c + 0.5) * col_w\n        top_c = cfb + (cNL - 1) * (cgap + bt) + cgap\n        if top_c > H + 1e-6: errors.append(f\"{col_names[c]}列层板放不下: {top_c:.3f} > 总高{H}\")\n        for k in range(cNL):\n            z = cfb + k * (cgap + bt)                       # 第k层板顶面\n            boxes.append((ccx, 0, z - bt/2, col_w, D, bt))\n            cells.append((f\"C{c+1}_L{k+1}\", ccx, 0.0, z + cgap/2))   # 格口中心表(格口k在板k顶面之上,净高cgap)\n    boxes.append((0, 0, H - bt/2, W, D, bt))\n    v = [box_visual(f\"b{i}\", *b) for i, b in enumerate(boxes)]\n\n    for mkr in S.get(\"markers\") or []:\n        mc = mkr.get(\"column\") or (\"right\" if mkr.get(\"center_x\", 0.0) > 0 else \"left\")   # 码牌贴在哪一列的层板前缘(中柱上的按左列)\n        mfb, mgap, _ = layout(col_names.index(mc)) if mc in col_names else (fb, gap, NL)\n        zb = mfb + (mkr[\"board\"] - 1) * (mgap + bt) - bt / 2       # 第board层板前缘中心高度\n        v.append(aruco_front_visuals(mkr.get(\"image\"), mkr.get(\"center_x\", 0.0), -D/2, zb, f\"shf{mkr['id']}\", mkr.get(\"yaw\", 0.0)))\n        print(f\"货架码牌ID{mkr['id']}: 货架系[x={mkr.get('center_x', 0.0)}, y={-D/2}, z={zb:.4f}] (第{mkr['board']}层板前缘)\")\n\n    x0, y0, z0 = S[\"pose_xyz\"]; r0, p0, yaw0 = S[\"pose_rpy\"]\n    snippets.append(f'''  <link name=\"scene_shelf\">\\n{''.join(v)}  </link>\n  <joint name=\"pedestal_to_scene_shelf\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_shelf\"/>\n    <origin xyz=\"{x0} {y0} {z0}\" rpy=\"{r0} {p0} {yaw0}\"/></joint>\\n''')\n\n    S2 = P.get(\"shelf2\") or {}\n    if S2.get(\"enabled\"):\n        v2 = [box_visual(f\"s2b{i}\", *b) for i, b in enumerate(boxes)]   # 几何完全复用主货架\n        x2, y2, z2 = S2[\"pose_xyz\"]; r2, p2, yaw2 = S2[\"pose_rpy\"]\n        snippets.append(f'''  <link name=\"scene_shelf2\">\\n{''.join(v2)}  </link>\n  <joint name=\"pedestal_to_scene_shelf2\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_shelf2\"/>\n    <origin xyz=\"{x2} {y2} {z2}\" rpy=\"{r2} {p2} {yaw2}\"/></joint>\\n''')\n        print(f\"第二货架: 位姿{S2['pose_xyz']} yaw={yaw2}(几何同主货架)\")\n\nT = P[\"table\"]\nif T[\"enabled\"]:\n    tx, ty, tz = T[\"pose_xyz\"]; sx, sy, sz = T[\"size\"]\n    tr, tp, tyaw = T.get(\"pose_rpy\", [0, 0, 0])\n    tv = box_visual(\"table\", 0, 0, sz/2, sx, sy, sz, \"0.55 0.42 0.28 0.9\")\n    port = T.get(\"scan_port\")\n    if port:\n        px, py = port[\"center_offset\"]; pw, pd = port[\"size\"]\n        if abs(px) + pw/2 > sx/2 + 1e-6 or abs(py) + pd/2 > sy/2 + 1e-6:\n            errors.append(f\"扫码口超出桌面: 中心{port['center_offset']} 尺寸{port['size']} vs 桌面{sx}x{sy}\")\n        tv += box_visual(\"scanport\", px, py, sz + 0.0015, pw, pd, 0.003, \"0.15 0.55 0.95 1.0\")\n    hp = T.get(\"return_belt\")\n    if hp:\n        hx, hy = hp[\"center_offset\"]; hdx, hdy, hdz = hp[\"size\"]\n        tv += box_visual(\"returnbelt\", hx, hy, hdz/2, hdx, hdy, hdz, \"0.45 0.40 0.30 1.0\")\n        print(f\"回流传送带: 桌子系中心[{hx}, {hy}] 尺寸{hp['size']} (落地, 顶沿高出桌面{hdz - sz:.3f}m)\")\n    ss = T.get(\"side_scanner\")\n    if ss:\n        scx, scy = ss[\"center_offset\"]; sdx, sdy, sdz = ss[\"size\"]\n        if abs(scx) + sdx/2 > sx/2 + 1e-6 or abs(scy) + sdy/2 > sy/2 + 1e-6:\n            errors.append(f\"侧扫码器超出桌面: 中心{ss['center_offset']} 尺寸{ss['size']} vs 桌面{sx}x{sy}\")\n        tv += box_visual(\"sidescan\", scx, scy, sz + sdz/2, sdx, sdy, sdz, \"0.25 0.25 0.28 1.0\")\n        # 扫码窗口标识(朝-x面上的蓝色小方块, 中心=窗口高)\n        tv += box_visual(\"sidescanwin\", scx - sdx/2 - 0.0015, scy, sz + ss[\"window_height\"],\n                         0.003, 0.05, 0.05, \"0.15 0.55 0.95 1.0\")\n        print(f\"侧扫码器: 桌子系中心[{scx}, {scy}] 尺寸{ss['size']} 窗口高{ss['window_height']}(朝-x)\")\n    mk = T.get(\"marker\")\n    if mk:\n        kx, ky = mk[\"center_offset\"]; kyaw = mk.get(\"yaw\", 0)\n        if abs(kx) + 0.06 > sx/2 + 1e-6 or abs(ky) + 0.06 > sy/2 + 1e-6:\n            errors.append(f\"桌面码牌超出桌面: 中心{mk['center_offset']} vs 桌面{sx}x{sy}\")\n        tv += aruco_visuals(mk.get(\"image\"), kx, ky, sz, kyaw, f\"tbl{mk.get('id', 0)}\")\n    snippets.append(f'''  <link name=\"scene_table\">\\n{tv}  </link>\n  <joint name=\"pedestal_to_scene_table\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_table\"/>\n    <origin xyz=\"{tx} {ty} {tz}\" rpy=\"{tr} {tp} {tyaw}\"/></joint>\\n''')\n\n# ---- 上苗机包络盒: 单盒进碰撞世界, 显示走半透明Marker(scene_overlay) ----\nCV = P.get(\"conveyor\", {})\ncv_boxes = []                       # (center_local桌子系, size, roll, yaw_local)\nif CV.get(\"enabled\") and T[\"enabled\"]:\n    import math as _cm\n    cv_boxes.append((list(CV[\"box_center\"]), list(CV[\"box_size\"]), 0.0, _cm.radians(CV.get(\"yaw_deg\", 0))))\n    print(f\"传送带包络盒: 中心{CV['box_center']} 尺寸{CV['box_size']} (挂桌子系,仅半透明叠显)\")\n\n# ---- 检验不过就不落盘(避免坏URDF留在out/被后续deploy误推) ----\nif errors:\n    print(\"❌ FAIL:\"); [print(\"  -\", e) for e in errors]; sys.exit(1)\n\n# ---- 注入并输出 ----\nout = base.replace(\"</robot>\", \"\".join(snippets) + \"</robot>\")\nos.makedirs(f\"{ROOT}/out\", exist_ok=True)\nopen(f\"{ROOT}/out/gcr10_1300.urdf\", \"w\").write(out)\n\n# ---- 碰撞清单(同源同参数, 给MoveIt规划场景用) ----\nimport json, math\ndef rpy_to_quat(r, p, y):\n    cr, sr, cp, sp, cy, sy = math.cos(r/2), math.sin(r/2), math.cos(p/2), math.sin(p/2), math.cos(y/2), math.sin(y/2)\n    return [sr*cp*cy - cr*sp*sy, cr*sp*cy + sr*cp*sy, cr*cp*sy - sr*sp*cy, cr*cp*cy + sr*sp*sy]\ndef rot(rpy, v):\n    r, p, yw = rpy\n    x, y, z = v\n    # Rz(yaw)*Ry(pitch)*Rx(roll) 依次作用\n    y, z = y*math.cos(r)-z*math.sin(r), y*math.sin(r)+z*math.cos(r)\n    x, z = x*math.cos(p)+z*math.sin(p), -x*math.sin(p)+z*math.cos(p)\n    x, y = x*math.cos(yw)-y*math.sin(yw), x*math.sin(yw)+y*math.cos(yw)\n    return [x, y, z]\nobjs = []\nif S[\"enabled\"]:\n    q = rpy_to_quat(*S[\"pose_rpy\"])\n    for i, (cx, cy, cz, sx, sy, sz) in enumerate(boxes):\n        pos = [a + b for a, b in zip(S[\"pose_xyz\"], rot(S[\"pose_rpy\"], [cx, cy, cz]))]\n        objs.append({\"id\": f\"scene_shelf_{i}\", \"pos\": [round(x,5) for x in pos], \"quat\": q, \"size\": [sx, sy, sz]})\n    S2 = P.get(\"shelf2\") or {}\n    if S2.get(\"enabled\"):\n        q2 = rpy_to_quat(*S2[\"pose_rpy\"])\n        for i, (cx, cy, cz, sx, sy, sz) in enumerate(boxes):\n            pos = [a + b for a, b in zip(S2[\"pose_xyz\"], rot(S2[\"pose_rpy\"], [cx, cy, cz]))]\n            objs.append({\"id\": f\"scene_shelf2_{i}\", \"pos\": [round(x,5) for x in pos], \"quat\": q2, \"size\": [sx, sy, sz]})\nif T[\"enabled\"]:\n    tx, ty, tz = T[\"pose_xyz\"]; sx, sy, sz = T[\"size\"]\n    trpy = T.get(\"pose_rpy\", [0, 0, 0])\n    tpos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [0, 0, sz/2]))]\n    objs.append({\"id\": \"scene_table\", \"pos\": [round(x,5) for x in tpos], \"quat\": rpy_to_quat(*trpy), \"size\": [sx, sy, sz]})\n    ov = []\n    for k, (c, sz3, rl, yw) in enumerate(cv_boxes):\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, c))]\n        entry = {\"id\": f\"scene_conveyor_{k}\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(rl, 0, trpy[2] + yw), \"size\": sz3}\n        objs.append(entry); ov.append(entry)\n    ss = T.get(\"side_scanner\")\n    if ss:\n        scx, scy = ss[\"center_offset\"]; sdx, sdy, sdz = ss[\"size\"]\n        m = ss.get(\"margin\", 0.015)\n        gi = [sdx + 2*m, sdy + 2*m, sdz + 2*m]              # 碰撞包络=实测每边放margin\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [scx, scy, sz + sdz/2]))]\n        entry = {\"id\": \"scene_side_scanner\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(*trpy), \"size\": [round(x,4) for x in gi]}\n        objs.append(entry); ov.append(entry)                 # 进碰撞世界+半透明叠显\n    hp = T.get(\"return_belt\")\n    if hp:\n        hx, hy = hp[\"center_offset\"]; hdx, hdy, hdz = hp[\"size\"]\n        m = hp.get(\"margin\", 0.02)\n        gi = [hdx + 2*m, hdy + 2*m, hdz + 2*m]\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [hx, hy, hdz/2]))]\n        entry = {\"id\": \"scene_return_belt\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(*trpy), \"size\": [round(x,4) for x in gi]}\n        objs.append(entry); ov.append(entry)\n    ovp = f\"{ROOT}/out/scene_overlay.json\"\n    if ov:\n        json.dump({\"frame_id\": \"pedestal_link\", \"boxes\": ov}, open(ovp, \"w\"), indent=1)\n    elif os.path.exists(ovp):","is_error":false}]},"uuid":"4fba2e6b-2048-46a7-8165-12504d1c8726","timestamp":"2026-10-26T01:18:22.298Z","toolUseResult":{"stdout":"        os.remove(f\"{ROOT}/out/rsp_tool_patch.py\")   # 工具关闭时不再同步RSP侧\n\nS = P[\"shelf\"]\nif S[\"enabled\"]:\n    W, D, H = S[\"width\"], S[\"depth\"], S[\"height\"]\n    NC, NL = S[\"columns\"], S[\"layers\"]\n    ps, bt = S[\"post_section\"], S[\"board_thickness\"]\n    fb, gap = S[\"first_board_h\"], S[\"board_gap\"]\n\n    # ---- 数值自检 ----\n    top_of_stack = fb + (NL - 1) * (gap + bt)          # 最高层板顶面高度\n    need = top_of_stack + gap                           # 顶层格口还需净空\n    if need > H + 1e-6:\n        errors.append(f\"层板放不下: 首板高{fb} + {NL-1}x(净距{gap}+板厚{bt}) + 顶层净空{gap} = {need:.3f} > 总高{H}\")\n    if NC < 1 or NL < 1: errors.append(\"columns/layers 必须 >=1\")\n\n    boxes = []                                          # (cx,cy,cz,sx,sy,sz) 显示与碰撞共用\n    # 4根角柱 + 列分隔柱(前后各 columns-1 根)\n    xs = [-W/2 + ps/2, W/2 - ps/2]\n    ys = [-D/2 + ps/2, D/2 - ps/2]\n    for x in xs:\n        for y in ys:\n            boxes.append((x, y, H/2, ps, ps, H))\n    col_w = W / NC\n    for i in range(1, NC):\n        x = -W/2 + i * col_w\n        for y in ys:\n            boxes.append((x, y, H/2, ps, ps, H))\n    # 层板: 2026-09-16 左右列独立(column_layers 有则每列自己的首板高/净高/层数, 层板只横贯本列宽; 无则沿用整宽横贯) + 顶板\n    CL = S.get(\"column_layers\")\n    col_names = [\"left\", \"right\"] if NC == 2 else [f\"c{c+1}\" for c in range(NC)]\n    def layout(c):\n        if CL and col_names[c] in CL:\n            L = CL[col_names[c]]; return float(L[\"first_board_h\"]), float(L[\"board_gap\"]), int(L[\"layers\"])\n        return fb, gap, NL\n    for c in range(NC):\n        cfb, cgap, cNL = layout(c); ccx = -W/2 + (c + 0.5) * col_w\n        top_c = cfb + (cNL - 1) * (cgap + bt) + cgap\n        if top_c > H + 1e-6: errors.append(f\"{col_names[c]}列层板放不下: {top_c:.3f} > 总高{H}\")\n        for k in range(cNL):\n            z = cfb + k * (cgap + bt)                       # 第k层板顶面\n            boxes.append((ccx, 0, z - bt/2, col_w, D, bt))\n            cells.append((f\"C{c+1}_L{k+1}\", ccx, 0.0, z + cgap/2))   # 格口中心表(格口k在板k顶面之上,净高cgap)\n    boxes.append((0, 0, H - bt/2, W, D, bt))\n    v = [box_visual(f\"b{i}\", *b) for i, b in enumerate(boxes)]\n\n    for mkr in S.get(\"markers\") or []:\n        mc = mkr.get(\"column\") or (\"right\" if mkr.get(\"center_x\", 0.0) > 0 else \"left\")   # 码牌贴在哪一列的层板前缘(中柱上的按左列)\n        mfb, mgap, _ = layout(col_names.index(mc)) if mc in col_names else (fb, gap, NL)\n        zb = mfb + (mkr[\"board\"] - 1) * (mgap + bt) - bt / 2       # 第board层板前缘中心高度\n        v.append(aruco_front_visuals(mkr.get(\"image\"), mkr.get(\"center_x\", 0.0), -D/2, zb, f\"shf{mkr['id']}\", mkr.get(\"yaw\", 0.0)))\n        print(f\"货架码牌ID{mkr['id']}: 货架系[x={mkr.get('center_x', 0.0)}, y={-D/2}, z={zb:.4f}] (第{mkr['board']}层板前缘)\")\n\n    x0, y0, z0 = S[\"pose_xyz\"]; r0, p0, yaw0 = S[\"pose_rpy\"]\n    snippets.append(f'''  <link name=\"scene_shelf\">\\n{''.join(v)}  </link>\n  <joint name=\"pedestal_to_scene_shelf\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_shelf\"/>\n    <origin xyz=\"{x0} {y0} {z0}\" rpy=\"{r0} {p0} {yaw0}\"/></joint>\\n''')\n\n    S2 = P.get(\"shelf2\") or {}\n    if S2.get(\"enabled\"):\n        v2 = [box_visual(f\"s2b{i}\", *b) for i, b in enumerate(boxes)]   # 几何完全复用主货架\n        x2, y2, z2 = S2[\"pose_xyz\"]; r2, p2, yaw2 = S2[\"pose_rpy\"]\n        snippets.append(f'''  <link name=\"scene_shelf2\">\\n{''.join(v2)}  </link>\n  <joint name=\"pedestal_to_scene_shelf2\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_shelf2\"/>\n    <origin xyz=\"{x2} {y2} {z2}\" rpy=\"{r2} {p2} {yaw2}\"/></joint>\\n''')\n        print(f\"第二货架: 位姿{S2['pose_xyz']} yaw={yaw2}(几何同主货架)\")\n\nT = P[\"table\"]\nif T[\"enabled\"]:\n    tx, ty, tz = T[\"pose_xyz\"]; sx, sy, sz = T[\"size\"]\n    tr, tp, tyaw = T.get(\"pose_rpy\", [0, 0, 0])\n    tv = box_visual(\"table\", 0, 0, sz/2, sx, sy, sz, \"0.55 0.42 0.28 0.9\")\n    port = T.get(\"scan_port\")\n    if port:\n        px, py = port[\"center_offset\"]; pw, pd = port[\"size\"]\n        if abs(px) + pw/2 > sx/2 + 1e-6 or abs(py) + pd/2 > sy/2 + 1e-6:\n            errors.append(f\"扫码口超出桌面: 中心{port['center_offset']} 尺寸{port['size']} vs 桌面{sx}x{sy}\")\n        tv += box_visual(\"scanport\", px, py, sz + 0.0015, pw, pd, 0.003, \"0.15 0.55 0.95 1.0\")\n    hp = T.get(\"return_belt\")\n    if hp:\n        hx, hy = hp[\"center_offset\"]; hdx, hdy, hdz = hp[\"size\"]\n        tv += box_visual(\"returnbelt\", hx, hy, hdz/2, hdx, hdy, hdz, \"0.45 0.40 0.30 1.0\")\n        print(f\"回流传送带: 桌子系中心[{hx}, {hy}] 尺寸{hp['size']} (落地, 顶沿高出桌面{hdz - sz:.3f}m)\")\n    ss = T.get(\"side_scanner\")\n    if ss:\n        scx, scy = ss[\"center_offset\"]; sdx, sdy, sdz = ss[\"size\"]\n        if abs(scx) + sdx/2 > sx/2 + 1e-6 or abs(scy) + sdy/2 > sy/2 + 1e-6:\n            errors.append(f\"侧扫码器超出桌面: 中心{ss['center_offset']} 尺寸{ss['size']} vs 桌面{sx}x{sy}\")\n        tv += box_visual(\"sidescan\", scx, scy, sz + sdz/2, sdx, sdy, sdz, \"0.25 0.25 0.28 1.0\")\n        # 扫码窗口标识(朝-x面上的蓝色小方块, 中心=窗口高)\n        tv += box_visual(\"sidescanwin\", scx - sdx/2 - 0.0015, scy, sz + ss[\"window_height\"],\n                         0.003, 0.05, 0.05, \"0.15 0.55 0.95 1.0\")\n        print(f\"侧扫码器: 桌子系中心[{scx}, {scy}] 尺寸{ss['size']} 窗口高{ss['window_height']}(朝-x)\")\n    mk = T.get(\"marker\")\n    if mk:\n        kx, ky = mk[\"center_offset\"]; kyaw = mk.get(\"yaw\", 0)\n        if abs(kx) + 0.06 > sx/2 + 1e-6 or abs(ky) + 0.06 > sy/2 + 1e-6:\n            errors.append(f\"桌面码牌超出桌面: 中心{mk['center_offset']} vs 桌面{sx}x{sy}\")\n        tv += aruco_visuals(mk.get(\"image\"), kx, ky, sz, kyaw, f\"tbl{mk.get('id', 0)}\")\n    snippets.append(f'''  <link name=\"scene_table\">\\n{tv}  </link>\n  <joint name=\"pedestal_to_scene_table\" type=\"fixed\">\n    <parent link=\"pedestal_link\"/><child link=\"scene_table\"/>\n    <origin xyz=\"{tx} {ty} {tz}\" rpy=\"{tr} {tp} {tyaw}\"/></joint>\\n''')\n\n# ---- 上苗机包络盒: 单盒进碰撞世界, 显示走半透明Marker(scene_overlay) ----\nCV = P.get(\"conveyor\", {})\ncv_boxes = []                       # (center_local桌子系, size, roll, yaw_local)\nif CV.get(\"enabled\") and T[\"enabled\"]:\n    import math as _cm\n    cv_boxes.append((list(CV[\"box_center\"]), list(CV[\"box_size\"]), 0.0, _cm.radians(CV.get(\"yaw_deg\", 0))))\n    print(f\"传送带包络盒: 中心{CV['box_center']} 尺寸{CV['box_size']} (挂桌子系,仅半透明叠显)\")\n\n# ---- 检验不过就不落盘(避免坏URDF留在out/被后续deploy误推) ----\nif errors:\n    print(\"❌ FAIL:\"); [print(\"  -\", e) for e in errors]; sys.exit(1)\n\n# ---- 注入并输出 ----\nout = base.replace(\"</robot>\", \"\".join(snippets) + \"</robot>\")\nos.makedirs(f\"{ROOT}/out\", exist_ok=True)\nopen(f\"{ROOT}/out/gcr10_1300.urdf\", \"w\").write(out)\n\n# ---- 碰撞清单(同源同参数, 给MoveIt规划场景用) ----\nimport json, math\ndef rpy_to_quat(r, p, y):\n    cr, sr, cp, sp, cy, sy = math.cos(r/2), math.sin(r/2), math.cos(p/2), math.sin(p/2), math.cos(y/2), math.sin(y/2)\n    return [sr*cp*cy - cr*sp*sy, cr*sp*cy + sr*cp*sy, cr*cp*sy - sr*sp*cy, cr*cp*cy + sr*sp*sy]\ndef rot(rpy, v):\n    r, p, yw = rpy\n    x, y, z = v\n    # Rz(yaw)*Ry(pitch)*Rx(roll) 依次作用\n    y, z = y*math.cos(r)-z*math.sin(r), y*math.sin(r)+z*math.cos(r)\n    x, z = x*math.cos(p)+z*math.sin(p), -x*math.sin(p)+z*math.cos(p)\n    x, y = x*math.cos(yw)-y*math.sin(yw), x*math.sin(yw)+y*math.cos(yw)\n    return [x, y, z]\nobjs = []\nif S[\"enabled\"]:\n    q = rpy_to_quat(*S[\"pose_rpy\"])\n    for i, (cx, cy, cz, sx, sy, sz) in enumerate(boxes):\n        pos = [a + b for a, b in zip(S[\"pose_xyz\"], rot(S[\"pose_rpy\"], [cx, cy, cz]))]\n        objs.append({\"id\": f\"scene_shelf_{i}\", \"pos\": [round(x,5) for x in pos], \"quat\": q, \"size\": [sx, sy, sz]})\n    S2 = P.get(\"shelf2\") or {}\n    if S2.get(\"enabled\"):\n        q2 = rpy_to_quat(*S2[\"pose_rpy\"])\n        for i, (cx, cy, cz, sx, sy, sz) in enumerate(boxes):\n            pos = [a + b for a, b in zip(S2[\"pose_xyz\"], rot(S2[\"pose_rpy\"], [cx, cy, cz]))]\n            objs.append({\"id\": f\"scene_shelf2_{i}\", \"pos\": [round(x,5) for x in pos], \"quat\": q2, \"size\": [sx, sy, sz]})\nif T[\"enabled\"]:\n    tx, ty, tz = T[\"pose_xyz\"]; sx, sy, sz = T[\"size\"]\n    trpy = T.get(\"pose_rpy\", [0, 0, 0])\n    tpos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [0, 0, sz/2]))]\n    objs.append({\"id\": \"scene_table\", \"pos\": [round(x,5) for x in tpos], \"quat\": rpy_to_quat(*trpy), \"size\": [sx, sy, sz]})\n    ov = []\n    for k, (c, sz3, rl, yw) in enumerate(cv_boxes):\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, c))]\n        entry = {\"id\": f\"scene_conveyor_{k}\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(rl, 0, trpy[2] + yw), \"size\": sz3}\n        objs.append(entry); ov.append(entry)\n    ss = T.get(\"side_scanner\")\n    if ss:\n        scx, scy = ss[\"center_offset\"]; sdx, sdy, sdz = ss[\"size\"]\n        m = ss.get(\"margin\", 0.015)\n        gi = [sdx + 2*m, sdy + 2*m, sdz + 2*m]              # 碰撞包络=实测每边放margin\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [scx, scy, sz + sdz/2]))]\n        entry = {\"id\": \"scene_side_scanner\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(*trpy), \"size\": [round(x,4) for x in gi]}\n        objs.append(entry); ov.append(entry)                 # 进碰撞世界+半透明叠显\n    hp = T.get(\"return_belt\")\n    if hp:\n        hx, hy = hp[\"center_offset\"]; hdx, hdy, hdz = hp[\"size\"]\n        m = hp.get(\"margin\", 0.02)\n        gi = [hdx + 2*m, hdy + 2*m, hdz + 2*m]\n        pos = [a + b for a, b in zip([tx, ty, tz], rot(trpy, [hx, hy, hdz/2]))]\n        entry = {\"id\": \"scene_return_belt\", \"pos\": [round(x,5) for x in pos],\n                 \"quat\": rpy_to_quat(*trpy), \"size\": [round(x,4) for x in gi]}\n        objs.append(entry); ov.append(entry)\n    ovp = f\"{ROOT}/out/scene_overlay.json\"\n    if ov:\n        json.dump({\"frame_id\": \"pedestal_link\", \"boxes\": ov}, open(ovp, \"w\"), indent=1)\n    elif os.path.exists(ovp):","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"1c823229-df51-4275-8b81-ac004eb58c71","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":14},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"efaa4dae-1bdc-4ca4-96a2-51d88bf5e20b","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"4a5608cc-8439-46c4-aa57-90a8932cb84f","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.310","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
