{"parentUuid":"40a3b88d-dcc5-414e-986f-397bfea4440a","isSidechain":false,"promptId":"37877f8f-b3fa-4c1b-ab51-228e9e046919","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XnJWwKASiRxjyTQGE13T6k","type":"tool_result","content":"60:def device_busy():\n247:            why = device_busy()\n253:               \"{feeder_com}\": str(knob(\"feeder\", \"com\", \"COM14\"))}\n264:        threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\"), a.get(\"open_after\")), daemon=True).start()\n266:    def _worker(self, cmd, camera, open_after=None):","is_error":false}]},"uuid":"398af9e2-9e86-42a6-ba47-a64d96e7a207","timestamp":"2026-10-29T06:00:47.202Z","toolUseResult":{"stdout":"60:def device_busy():\n247:            why = device_busy()\n253:               \"{feeder_com}\": str(knob(\"feeder\", \"com\", \"COM14\"))}\n264:        threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\"), a.get(\"open_after\")), daemon=True).start()\n266:    def _worker(self, cmd, camera, open_after=None):","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"D:\\robot_cell\\services\\toolbox_catalog.py","hunks":[{"oldStart":1,"oldLines":191,"newStart":1,"newLines":193,"lines":["-# -*- coding: utf-8 -*-","-\"\"\"工程师工具箱的目录(单一来源): 部署向导 / 问题诊断 / 维护工具 每一项的说明文字 + 底层命令。","-界面(toolbox_gui.py)只负责显示和运行, 加一项/改说明只改这里。设计见 docs/交接整理/设备工具箱设计.md","-","-每项字段:","-  id, title          唯一键 / 标题","-  status             ready=已接通可运行 / todo=还没接通(只显示说明) / env=要先装环境(视觉训练环境或 WSL2+ROS2)","-  what               这一步标什么/做什么","-  when               什么时候必须做","-  prep               准备事项(列表)","-  depends            上游步骤 id(上游重做了, 提醒这一步也要重做)","-  tools              底层脚本(给人看, 也方便照着在命令行手动跑)","-  actions            可运行的动作: [{label, cmd, arm(会动真机), camera(独占相机, 自动停视觉服务), confirm(运行前确认的话)}]","-                     cmd 里 {py}=设备 Python, {ts}=当前时刻 20261029_1530, {baseline}=基准快照名","-  checks             (诊断专用) 检查链: [(检查什么, 指向的条目 id 或说明)]","-\"\"\"","-","-BASELINE = \"baseline_20261029\"","-","-DEPLOY = [","-    dict(id=\"d0\", title=\"0 存档现役参数\", status=\"ready\",","-         what=\"把当前所有标定值和相关文件存成一个快照。之后每一步的结果都和基准快照对比; 改坏了可以一键恢复。\",","-         when=\"开始部署/重标之前必做; 任何一步决定「采用」新值前, 向导也会自动再存一份。\",","-         prep=[\"不需要动臂, 不需要相机\"],","-         tools=[\"tools/calib/calib_snapshot.py save|show|diff|restore\"],","-         actions=[","-             dict(label=\"存一个新快照\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"save\", \"snap_{ts}\", \"--controller\", \"--note\", \"部署向导存档\"]),","-             dict(label=\"和基准对比\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"diff\", \"{baseline}\"]),","-             dict(label=\"看当前值\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"show\"]),","-         ]),","-    dict(id=\"d1\", title=\"1 硬件体检\", status=\"ready\",","-         what=\"逐项检查机械臂、相机、吸盘、真空开关、扫码器、上苗机是否正常, 各自给出 PASS/FAIL。机械臂只读, 不会动。\",","-         when=\"新场地上电后、搬动/重新接线后、出现说不清的故障时。\",","-         prep=[\"设备空闲(没有任务在跑; 每项运行前自动检查)\", \"准备一盒药: 真空开关、扫码器两项要手拿盒子配合\",","-               \"腕部旋转电机已随立放末端拆除(speed_profile.yaml tool.rotator=false), 不检查\"],","-         depends=[],","-         tools=[\"tools/check_hw/arm.py\", \"camera.py\", \"suction.py\", \"vacuum.py\", \"scanner.py\", \"feeder.py(同目录)\"],","-         actions=[","-             dict(label=\"① 机械臂(只读)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/arm.py\"]),","-             dict(label=\"② 相机\", idle=True, camera=True, cmd=[\"{py}\", \"tools/check_hw/camera.py\"],","-                  open_after=[\"tools/check_hw/output/camera_color.jpg\", \"tools/check_hw/output/camera_depth.jpg\"]),","-             dict(label=\"③ 吸盘(吹1秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/suction.py\", \"--blow\", \"1\"],","-                  confirm=\"吸盘会吹气 1 秒再回到吸取待机(臂不动)。听吹开瞬间气流声有没有变化。继续吗?\"),","-             dict(label=\"④ 真空开关(20秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/vacuum.py\", \"20\"],","-                  confirm=\"开始后 20 秒内: 手拿药盒贴到吸盘上, 再拿开, 可以重复几次。准备好了吗?\"),","-             dict(label=\"⑤ 扫码器(30秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/scanner.py\", \"--timeout\", \"30\"],","-                  confirm=\"开始后 30 秒内: 手拿药盒, 条码面朝扫码口过一下。准备好了吗?\"),","-             dict(label=\"⑥ 上苗机\", idle=True, cmd=[\"{py}\", \"tools/check_hw/feeder.py\", \"--com\", \"{feeder_com}\"],","-                  confirm=\"上苗机皮带会转动! 盒到取料台会提示【药盒到达】; 在下方输入框: 直接按发送=放行下一盒, s=看状态, q=退出。继续吗?\"),","-         ]),","-    dict(id=\"d2\", title=\"2 TCP 与接触偏差\", status=\"todo\",","-         what=\"TCP = 吸盘中心相对法兰的位置, 在示教器上用四点法标定。之后读回控制器的值同步到配置, 再测吸盘唇边比 TCP 低多少(接触偏差)。\",","-         when=\"末端重新设计/更换吸盘后必须重标。末端拆下再装回: 只做「验证」(读回对比 + 第 3 步落点闭环), 不过再重标。\",","-         prep=[\"示教器四点标定由人在示教器上完成, 向导只做提示\", \"接触偏差: 臂自动去桌面上方 30cm, 人用示教器降到纸片刚夹住/压紧\"],","-         depends=[],","-         tools=[\"tools/arm/read_tcp_offset.py(只读)\", \"scripts/tcp_sync.sh → 待本机化\", \"scripts/arm/tcp_contact.sh → 待本机化\",","-                \"scripts/arm/tcp_verify.sh(可选)\"]),","-    dict(id=\"d3\", title=\"3 手眼标定\", status=\"todo\",","-         what=\"求相机相对手腕的矩阵 T_wrist2cam。流程: 定板位 → (生成候选拍摄站) → 逐站试拍 → 采样 → 求解+质检 → 落点闭环验证。\",","-         when=\"相机或相机支架动过、末端重新设计后必须重标。拆装末端后: 只跑最后的「落点闭环」验证。\",","-         prep=[\"标定板放进桌面胶带框\", \"会停视觉服务\", \"候选拍摄站生成要判碰撞, 依赖路径规划环境(未装前沿用已有站点库)\"],","-         depends=[\"d2\"],","-         tools=[\"tools/handeye/aruco_snap.py\", \"tools/handeye/handeye_capture.py\", \"tools/handeye/handeye_solve.py\",","-                \"tools/handeye/handeye_verify2.py\", \"scripts/handeye_grid.py(需 ROS)\"]),","-    dict(id=\"d4\", title=\"4 地面码 → 底座高度\", status=\"todo\",","-         what=\"拍地面 ID4 码牌, 反算机械臂底座高度 pedestal.height。\",","-         when=\"换场地、底座重新安装后。\",","-         prep=[\"地面 ID4 码牌已贴好\", \"臂摆到能正对俯拍 ID4 的位置\", \"会停视觉服务\"],","-         depends=[\"d3\"],","-         tools=[\"tools/calib/calibrate_scene.py floor\"]),","-    dict(id=\"d5\", title=\"5 桌面码 → 桌子位姿 / 桌面平面 / ROI\", status=\"todo\",","-         what=\"拍桌面 ID5 码牌算桌子在机械臂坐标系里的位置和朝向; 再拟合桌面平面、算识别用的桌面 ROI。\",","-         when=\"桌子挪动过、换场地后。\",","-         prep=[\"桌面 ID5 码牌已贴好\", \"臂在拍摄位(home)\", \"桌面清空\", \"会停视觉服务\"],","-         depends=[\"d3\", \"d4\"],","-         tools=[\"tools/calib/calibrate_scene.py table\", \"tools/vision_steps(plane 桌面平面)\", \"tools/calib/table_roi.py\"]),","-    dict(id=\"d6\", title=\"6 货架码 → 货架位姿\", status=\"todo\",","-         what=\"逐张正对拍货架 ID6/ID3/ID2 三个码, 三点拟合货架位置和朝向。斜拍有厘米级偏差, 不要一张拍全。\",","-         when=\"货架挪动过、换场地后。货架位姿变了, 格口悬停点和路径都要复核(第 7、8 步)。\",","-         prep=[\"货架三个码牌已贴好\", \"引导式: 每拍一张前把臂摆到正对该码\", \"会停视觉服务\"],","-         depends=[\"d3\"],","-         tools=[\"tools/calib/calibrate_scene.py shelf\", \"scripts/calibrate_shelf.sh → 待本机化\"]),","-    dict(id=\"d7\", title=\"7 更新仿真场景 + 旧路径重判\", status=\"env\",","-         what=\"把新标定值写进仿真场景(桌子/货架/工具模型), 再把路径库所有路径放进新场景重判有没有碰撞。\",","-         when=\"第 2~6 步任何一步「采用」了新值之后。\",","-         prep=[\"需要路径规划环境(WSL2 + ROS2 + MoveIt), 未装前可跳过\"],","-         depends=[\"d2\", \"d3\", \"d4\", \"d5\", \"d6\"],","-         tools=[\"scripts/build_scene.py\", \"scripts/deploy_scene.sh\", \"scripts/arm/replay.sh\", \"scripts/arm/path_check.py\"]),","-    dict(id=\"d8\", title=\"8 格口标定与干跑\", status=\"todo\",","-         what=\"每个格口: 立放标定(空载左右极限 + 持货背板推进量/层板高度) → 控制器仿真干跑坑位体检。\",","-         when=\"货架位姿变了、悬停点重解、换吸盘后; 新增格口时。\",","-         prep=[\"逐个格口做, 可多选\", \"立放标定要人用示教器 jog\", \"干跑在控制器仿真模式下进行, 结束必须切回真实模式\"],","-         depends=[\"d6\", \"d7\"],","-         tools=[\"scripts/arm/calib_stand.sh → 待本机化\", \"scripts/arm/probe_pits.sh → 待本机化\", \"tools/grasp/stand_screen.py(自碰撞判定需 ROS)\"]),","-]","-","-# 诊断: 按现象 → 检查链. 每一步指向一个条目(d*/m*)或给出说明","-DIAG = [","-    dict(id=\"x_detect\", title=\"识别不到盒 / 识别不准\", status=\"todo\",","-         what=\"相机看不到盒、尺寸量错、认脸对不上被丢回。\",","-         checks=[(\"视觉服务在不在、相机有没有断流\", \"控制台服务面板 / 视觉日志\"),","-                 (\"看这一帧九步管线坏在哪一步\", \"tools/vision_steps(scripts/vision_steps.sh 待本机化)\"),","-                 (\"量尺/认脸回归\", \"python services/quiz_lw.py\"),","-                 (\"品种没录入尺寸表\", \"m_sku\"),","-                 (\"模型本身认不出(新外观/新光照)\", \"m_train\")]),","-    dict(id=\"x_pick\", title=\"抓偏 / 吸不住\", status=\"todo\",","-         what=\"吸盘落点偏离盒中心, 或吸不住、掉盒。\",","-         checks=[(\"末端有没有松(先查这个)\", \"用手晃末端; 2026-10-23 松动案例\"),","-                 (\"TCP 读回和基准一致吗\", \"d2\"), (\"落点闭环误差\", \"d3\"), (\"桌面平面/桌子位姿\", \"d5\"),","-                 (\"吸取压入量\", \"config/speed_profile.yaml pick.press_mm\")]),","-    dict(id=\"x_place\", title=\"放歪 / 压不紧 / 压层板\", status=\"todo\",","-         what=\"上架后盒子歪、一列比计划长、盘点报账外物体或队首偏外。\",","-         checks=[(\"末端有没有松(先查这个)\", \"用手晃末端\"), (\"盘点核对队首\", \"m_stocktake\"),","-                 (\"立放标定微调 tune back/board\", \"d8\"), (\"货架被碰动了\", \"d6\")]),","-    dict(id=\"x_collide\", title=\"撞了 / 碰撞检测报警\", status=\"todo\",","-         what=\"控制器碰撞检测停机, 或真的刮碰。\",","-         checks=[(\"先复位回 home\", \"控制台「机械臂复位」\"), (\"哪个关节报警、在哪一段\", \"工作站日志\"),","-                 (\"格内速度/加速度是否太大\", \"config/speed_profile.yaml place/stand 段\"),","-                 (\"路径在当前场景里还安全吗\", \"d7\")]),","-    dict(id=\"x_scan\", title=\"扫不到码\", status=\"todo\",","-         what=\"入库扫码四面都没读到, 或出库扫码读不到。\",","-         checks=[(\"扫码服务在不在、桌面是否锁屏(锁屏钩子失效)\", \"控制台扫码记录\"),","-                 (\"扫码器本身\", \"d1\"), (\"吸住的面和条码面的关系\", \"出库扫码对接说明 / 任务 194 待查\")]),","-    dict(id=\"x_stock\", title=\"盘点不符\", status=\"todo\",","-         what=\"盘点结果和账上盒数/队首位置对不上。\",","-         checks=[(\"取点有没有取歪(看图)\", \"scripts/stocktake_view.py\"), (\"离线复算\", \"scripts/stocktake_new.py\"),","-                 (\"真的放歪了\", \"x_place\")]),","-    dict(id=\"x_service\", title=\"服务掉了 / 网页打不开\", status=\"todo\",","-         what=\"控制台服务灯红、上位机连不上设备。\",","-         checks=[(\"控制台里重启该服务\", \"控制台服务面板\"), (\"看该服务日志最后的报错\", \"控制台日志页\"),","-                 (\"看门狗是否在跑\", \"看门狗日志\"), (\"服务托管说明\", \"docs/服务托管.md\")]),","-    dict(id=\"x_webhook\", title=\"事件推送异常 / 上位机没记账\", status=\"todo\",","-         what=\"控制台「事件推送」报异常, 或上位机账和设备对不上。\",","-         checks=[(\"CRV 是否在运行、端口\", \"控制台 CRV 行\"), (\"对接配置\", \"config/upper_link.yaml\"),","-                 (\"一次任务的完整交互记录\", \"scripts/webhook_trace.py\")]),","-    dict(id=\"x_arm\", title=\"机械臂不动 / 很慢 / 中途停了\", status=\"todo\",","-         what=\"下了任务臂不动、动得很慢, 或停在半路。\",","-         checks=[(\"急停、使能\", \"示教器\"), (\"手动模式(限速)→自动\", \"scripts/check_cell.sh opmode auto(下任务时会自动切)\"),","-                 (\"是否误留在仿真模式\", \"控制台「模式」行\"), (\"停在半路 → 复位原路倒回\", \"控制台「机械臂复位」\")]),","-    dict(id=\"x_feeder\", title=\"上苗机不送料\", status=\"todo\",","-         what=\"入库时等不到盒。\",","-         checks=[(\"上苗机体检(串口/传感器)\", \"d1\"), (\"是否关了送料\", \"config/speed_profile.yaml feeder.enabled\")]),","-]","-","-MAINT = [","-    dict(id=\"m_snapshot\", title=\"标定快照: 对比 / 恢复\", status=\"ready\",","-         what=\"把当前参数和任意快照对比; 改坏了恢复到某个快照(恢复前自动再存一份)。\",","-         when=\"怀疑参数被改过、重标后效果变差想退回时。\",","-         prep=[\"恢复后需重启工作站和视觉服务才生效\"],","-         tools=[\"tools/calib/calib_snapshot.py\"],","-         actions=[","-             dict(label=\"当前 vs 基准\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"diff\", \"{baseline}\"]),","-             dict(label=\"列出恢复到基准会改哪些文件\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"restore\", \"{baseline}\"]),","-             dict(label=\"恢复到基准(写入)\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"restore\", \"{baseline}\", \"--apply\"],","-                  confirm=\"会把配置文件恢复成基准快照(恢复前自动另存一份当前值)。确定吗?\"),","-         ]),","-    dict(id=\"m_train\", title=\"视觉训练(收难例 → 标注 → 训练 → 对比 → 采用)\", status=\"env\",","-         what=\"识别模型(YOLO11n-seg)认不出新外观/新光照时, 收集失败照片标注后重新训练, 和现役模型对比后再决定是否采用。\",","-         when=\"诊断指向「模型本身认不出」时。\",","-         prep=[\"需要视觉训练环境(独立 conda 环境: CUDA 版 PyTorch + ultralytics + LabelMe), 未装\"],","-         tools=[\"scripts/vision_train/*\", \"models/best_v3.pt(现役)\"]),","-    dict(id=\"m_path\", title=\"路径规划(新格口 / 重新规划 / 判碰撞 / 试飞入库)\", status=\"env\",","-         what=\"新增格口、挪层板、路径有停顿或撞了时, 用 MoveIt 规划平顺路径, 控制器仿真实跑判碰撞, 生产速度试飞后入库。\",","-         when=\"加格口、改货架、诊断指向路径问题时。\",","-         prep=[\"需要路径规划环境(WSL2 + Ubuntu 22.04 + ROS2 Humble + MoveIt2 + Foxglove), 未装\"],","-         tools=[\"scripts/arm/solve_slot.sh\", \"scripts/arm/plan_smooth.sh\", \"scripts/arm/reverse_candidate.sh\", \"scripts/arm/path_check.py\"]),","-    dict(id=\"m_sku\", title=\"录入新药盒品种\", status=\"todo\",","-         what=\"卡尺量三围, 查追溯码得到品种钥匙, 写进尺寸表。没录入的品种上架会因认脸对不上被丢回。\",","-         when=\"来了新品种。\",","-         prep=[\"卡尺\", \"一盒样品(要扫追溯码)\"],","-         tools=[\"scripts/sku_add.sh → 待本机化\", \"config/sku_dims.yaml\"]),","-    dict(id=\"m_stocktake\", title=\"盘点工具(取点可视化 / 离线复算 / 空格口基准)\", status=\"todo\",","-         what=\"盘点报错时看取点区域, 离线复算判据; 层板改动后重采空格口基准。\",","-         when=\"盘点不符、层板改动后。\",","-         prep=[\"空格口基准采集要求货架全空\"],","-         tools=[\"scripts/stocktake_view.py\", \"scripts/stocktake_new.py\", \"scripts/stocktake_ref.sh → 待本机化\",","-                \"scripts/calib_board_by_camera.py\"]),","-    dict(id=\"m_speed\", title=\"速度调整\", status=\"todo\",","-         what=\"所有速度/加速度/等待常数都在一个文件里; 一次只拧一个, 回归后对账。\",","-         when=\"要提速, 或某段触发碰撞检测要降速。\",","-         prep=[\"改完重启工作站服务生效\"],","-         tools=[\"config/speed_profile.yaml\", \"scripts/speed_report.sh → 待本机化\", \"docs/速度优化日志.md\"]),","-    dict(id=\"m_link\", title=\"上位机对接配置\", status=\"todo\",","-         what=\"设备端口、上位机地址、推送口令都在一个文件里。\",","-         when=\"上位机换机器/换端口。\",","-         prep=[\"改完重启工作站服务, 看控制台「事件推送」变为正常\"],","-         tools=[\"config/upper_link.yaml\", \"docs/上位机对接配置说明.md\"]),","-]","-","-SECTIONS = [(\"deploy\", \"① 部署向导\", DEPLOY), (\"diag\", \"② 问题诊断\", DIAG), (\"maint\", \"③ 维护工具\", MAINT)]","-ALL = {it[\"id\"]: it for _, _, items in SECTIONS for it in items}","+# -*- coding: utf-8 -*-\r","+\"\"\"工程师工具箱的目录(单一来源): 部署向导 / 问题诊断 / 维护工具 每一项的说明文字 + 底层命令。\r","+界面(toolbox_gui.py)只负责显示和运行, 加一项/改说明只改这里。设计见 docs/交接整理/设备工具箱设计.md\r","+\r","+每项字段:\r","+  id, title          唯一键 / 标题\r","+  status             ready=已接通可运行 / todo=还没接通(只显示说明) / env=要先装环境(视觉训练环境或 WSL2+ROS2)\r","+  what               这一步标什么/做什么\r","+  when               什么时候必须做\r","+  prep               准备事项(列表)\r","+  depends            上游步骤 id(上游重做了, 提醒这一步也要重做)\r","+  tools              底层脚本(给人看, 也方便照着在命令行手动跑)\r","+  actions            可运行的动作: [{label, cmd, arm(会动真机), camera(独占相机, 自动停视觉服务), confirm(运行前确认的话),\r","+                     idle(运行前查设备空闲, 有任务在跑就拒绝), open_after(成功后打开的文件, 如照片)}]\r","+                     cmd 里 {py}=设备 Python, {ts}=当前时刻 20261029_1530, {baseline}=基准快照名,\r","+                     {feeder_com}=上苗机串口(speed_profile.yaml feeder.com)\r","+  checks             (诊断专用) 检查链: [(检查什么, 指向的条目 id 或说明)]\r","+\"\"\"\r","+\r","+BASELINE = \"baseline_20261029\"\r","+\r","+DEPLOY = [\r","+    dict(id=\"d0\", title=\"0 存档现役参数\", status=\"ready\",\r","+         what=\"把当前所有标定值和相关文件存成一个快照。之后每一步的结果都和基准快照对比; 改坏了可以一键恢复。\",\r","+         when=\"开始部署/重标之前必做; 任何一步决定「采用」新值前, 向导也会自动再存一份。\",\r","+         prep=[\"不需要动臂, 不需要相机\"],\r","+         tools=[\"tools/calib/calib_snapshot.py save|show|diff|restore\"],\r","+         actions=[\r","+             dict(label=\"存一个新快照\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"save\", \"snap_{ts}\", \"--controller\", \"--note\", \"部署向导存档\"]),\r","+             dict(label=\"和基准对比\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"diff\", \"{baseline}\"]),\r","+             dict(label=\"看当前值\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"show\"]),\r","+         ]),\r","+    dict(id=\"d1\", title=\"1 硬件体检\", status=\"ready\",\r","+         what=\"逐项检查机械臂、相机、吸盘、真空开关、扫码器、上苗机是否正常, 各自给出 PASS/FAIL。机械臂只读, 不会动。\",\r","+         when=\"新场地上电后、搬动/重新接线后、出现说不清的故障时。\",\r","+         prep=[\"设备空闲(没有任务在跑; 每项运行前自动检查)\", \"准备一盒药: 真空开关、扫码器两项要手拿盒子配合\",\r","+               \"腕部旋转电机已随立放末端拆除(speed_profile.yaml tool.rotator=false), 不检查\"],\r","+         depends=[],\r","+         tools=[\"tools/check_hw/arm.py\", \"camera.py\", \"suction.py\", \"vacuum.py\", \"scanner.py\", \"feeder.py(同目录)\"],\r","+         actions=[\r","+             dict(label=\"① 机械臂(只读)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/arm.py\"]),\r","+             dict(label=\"② 相机\", idle=True, camera=True, cmd=[\"{py}\", \"tools/check_hw/camera.py\"],\r","+                  open_after=[\"tools/check_hw/output/camera_color.jpg\", \"tools/check_hw/output/camera_depth.jpg\"]),\r","+             dict(label=\"③ 吸盘(吹1秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/suction.py\", \"--blow\", \"1\"],\r","+                  confirm=\"吸盘会吹气 1 秒再回到吸取待机(臂不动)。听吹开瞬间气流声有没有变化。继续吗?\"),\r","+             dict(label=\"④ 真空开关(20秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/vacuum.py\", \"20\"],\r","+                  confirm=\"开始后 20 秒内: 手拿药盒贴到吸盘上, 再拿开, 可以重复几次。准备好了吗?\"),\r","+             dict(label=\"⑤ 扫码器(30秒)\", idle=True, cmd=[\"{py}\", \"tools/check_hw/scanner.py\", \"--timeout\", \"30\"],\r","+                  confirm=\"开始后 30 秒内: 手拿药盒, 条码面朝扫码口过一下。准备好了吗?\"),\r","+             dict(label=\"⑥ 上苗机\", idle=True, cmd=[\"{py}\", \"tools/check_hw/feeder.py\", \"--com\", \"{feeder_com}\"],\r","+                  confirm=\"上苗机皮带会转动! 盒到取料台会提示【药盒到达】; 在下方输入框: 直接按发送=放行下一盒, s=看状态, q=退出。继续吗?\"),\r","+         ]),\r","+    dict(id=\"d2\", title=\"2 TCP 与接触偏差\", status=\"todo\",\r","+         what=\"TCP = 吸盘中心相对法兰的位置, 在示教器上用四点法标定。之后读回控制器的值同步到配置, 再测吸盘唇边比 TCP 低多少(接触偏差)。\",\r","+         when=\"末端重新设计/更换吸盘后必须重标。末端拆下再装回: 只做「验证」(读回对比 + 第 3 步落点闭环), 不过再重标。\",\r","+         prep=[\"示教器四点标定由人在示教器上完成, 向导只做提示\", \"接触偏差: 臂自动去桌面上方 30cm, 人用示教器降到纸片刚夹住/压紧\"],\r","+         depends=[],\r","+         tools=[\"tools/arm/read_tcp_offset.py(只读)\", \"scripts/tcp_sync.sh → 待本机化\", \"scripts/arm/tcp_contact.sh → 待本机化\",\r","+                \"scripts/arm/tcp_verify.sh(可选)\"]),\r","+    dict(id=\"d3\", title=\"3 手眼标定\", status=\"todo\",\r","+         what=\"求相机相对手腕的矩阵 T_wrist2cam。流程: 定板位 → (生成候选拍摄站) → 逐站试拍 → 采样 → 求解+质检 → 落点闭环验证。\",\r","+         when=\"相机或相机支架动过、末端重新设计后必须重标。拆装末端后: 只跑最后的「落点闭环」验证。\",\r","+         prep=[\"标定板放进桌面胶带框\", \"会停视觉服务\", \"候选拍摄站生成要判碰撞, 依赖路径规划环境(未装前沿用已有站点库)\"],\r","+         depends=[\"d2\"],\r","+         tools=[\"tools/handeye/aruco_snap.py\", \"tools/handeye/handeye_capture.py\", \"tools/handeye/handeye_solve.py\",\r","+                \"tools/handeye/handeye_verify2.py\", \"scripts/handeye_grid.py(需 ROS)\"]),\r","+    dict(id=\"d4\", title=\"4 地面码 → 底座高度\", status=\"todo\",\r","+         what=\"拍地面 ID4 码牌, 反算机械臂底座高度 pedestal.height。\",\r","+         when=\"换场地、底座重新安装后。\",\r","+         prep=[\"地面 ID4 码牌已贴好\", \"臂摆到能正对俯拍 ID4 的位置\", \"会停视觉服务\"],\r","+         depends=[\"d3\"],\r","+         tools=[\"tools/calib/calibrate_scene.py floor\"]),\r","+    dict(id=\"d5\", title=\"5 桌面码 → 桌子位姿 / 桌面平面 / ROI\", status=\"todo\",\r","+         what=\"拍桌面 ID5 码牌算桌子在机械臂坐标系里的位置和朝向; 再拟合桌面平面、算识别用的桌面 ROI。\",\r","+         when=\"桌子挪动过、换场地后。\",\r","+         prep=[\"桌面 ID5 码牌已贴好\", \"臂在拍摄位(home)\", \"桌面清空\", \"会停视觉服务\"],\r","+         depends=[\"d3\", \"d4\"],\r","+         tools=[\"tools/calib/calibrate_scene.py table\", \"tools/vision_steps(plane 桌面平面)\", \"tools/calib/table_roi.py\"]),\r","+    dict(id=\"d6\", title=\"6 货架码 → 货架位姿\", status=\"todo\",\r","+         what=\"逐张正对拍货架 ID6/ID3/ID2 三个码, 三点拟合货架位置和朝向。斜拍有厘米级偏差, 不要一张拍全。\",\r","+         when=\"货架挪动过、换场地后。货架位姿变了, 格口悬停点和路径都要复核(第 7、8 步)。\",\r","+         prep=[\"货架三个码牌已贴好\", \"引导式: 每拍一张前把臂摆到正对该码\", \"会停视觉服务\"],\r","+         depends=[\"d3\"],\r","+         tools=[\"tools/calib/calibrate_scene.py shelf\", \"scripts/calibrate_shelf.sh → 待本机化\"]),\r","+    dict(id=\"d7\", title=\"7 更新仿真场景 + 旧路径重判\", status=\"env\",\r","+         what=\"把新标定值写进仿真场景(桌子/货架/工具模型), 再把路径库所有路径放进新场景重判有没有碰撞。\",\r","+         when=\"第 2~6 步任何一步「采用」了新值之后。\",\r","+         prep=[\"需要路径规划环境(WSL2 + ROS2 + MoveIt), 未装前可跳过\"],\r","+         depends=[\"d2\", \"d3\", \"d4\", \"d5\", \"d6\"],\r","+         tools=[\"scripts/build_scene.py\", \"scripts/deploy_scene.sh\", \"scripts/arm/replay.sh\", \"scripts/arm/path_check.py\"]),\r","+    dict(id=\"d8\", title=\"8 格口标定与干跑\", status=\"todo\",\r","+         what=\"每个格口: 立放标定(空载左右极限 + 持货背板推进量/层板高度) → 控制器仿真干跑坑位体检。\",\r","+         when=\"货架位姿变了、悬停点重解、换吸盘后; 新增格口时。\",\r","+         prep=[\"逐个格口做, 可多选\", \"立放标定要人用示教器 jog\", \"干跑在控制器仿真模式下进行, 结束必须切回真实模式\"],\r","+         depends=[\"d6\", \"d7\"],\r","+         tools=[\"scripts/arm/calib_stand.sh → 待本机化\", \"scripts/arm/probe_pits.sh → 待本机化\", \"tools/grasp/stand_screen.py(自碰撞判定需 ROS)\"]),\r","+]\r","+\r","+# 诊断: 按现象 → 检查链. 每一步指向一个条目(d*/m*)或给出说明\r","+DIAG = [\r","+    dict(id=\"x_detect\", title=\"识别不到盒 / 识别不准\", status=\"todo\",\r","+         what=\"相机看不到盒、尺寸量错、认脸对不上被丢回。\",\r","+         checks=[(\"视觉服务在不在、相机有没有断流\", \"控制台服务面板 / 视觉日志\"),\r","+                 (\"看这一帧九步管线坏在哪一步\", \"tools/vision_steps(scripts/vision_steps.sh 待本机化)\"),\r","+                 (\"量尺/认脸回归\", \"python services/quiz_lw.py\"),\r","+                 (\"品种没录入尺寸表\", \"m_sku\"),\r","+                 (\"模型本身认不出(新外观/新光照)\", \"m_train\")]),\r","+    dict(id=\"x_pick\", title=\"抓偏 / 吸不住\", status=\"todo\",\r","+         what=\"吸盘落点偏离盒中心, 或吸不住、掉盒。\",\r","+         checks=[(\"末端有没有松(先查这个)\", \"用手晃末端; 2026-10-23 松动案例\"),\r","+                 (\"TCP 读回和基准一致吗\", \"d2\"), (\"落点闭环误差\", \"d3\"), (\"桌面平面/桌子位姿\", \"d5\"),\r","+                 (\"吸取压入量\", \"config/speed_profile.yaml pick.press_mm\")]),\r","+    dict(id=\"x_place\", title=\"放歪 / 压不紧 / 压层板\", status=\"todo\",\r","+         what=\"上架后盒子歪、一列比计划长、盘点报账外物体或队首偏外。\",\r","+         checks=[(\"末端有没有松(先查这个)\", \"用手晃末端\"), (\"盘点核对队首\", \"m_stocktake\"),\r","+                 (\"立放标定微调 tune back/board\", \"d8\"), (\"货架被碰动了\", \"d6\")]),\r","+    dict(id=\"x_collide\", title=\"撞了 / 碰撞检测报警\", status=\"todo\",\r","+         what=\"控制器碰撞检测停机, 或真的刮碰。\",\r","+         checks=[(\"先复位回 home\", \"控制台「机械臂复位」\"), (\"哪个关节报警、在哪一段\", \"工作站日志\"),\r","+                 (\"格内速度/加速度是否太大\", \"config/speed_profile.yaml place/stand 段\"),\r","+                 (\"路径在当前场景里还安全吗\", \"d7\")]),\r","+    dict(id=\"x_scan\", title=\"扫不到码\", status=\"todo\",\r","+         what=\"入库扫码四面都没读到, 或出库扫码读不到。\",\r","+         checks=[(\"扫码服务在不在、桌面是否锁屏(锁屏钩子失效)\", \"控制台扫码记录\"),\r","+                 (\"扫码器本身\", \"d1\"), (\"吸住的面和条码面的关系\", \"出库扫码对接说明 / 任务 194 待查\")]),\r","+    dict(id=\"x_stock\", title=\"盘点不符\", status=\"todo\",\r","+         what=\"盘点结果和账上盒数/队首位置对不上。\",\r","+         checks=[(\"取点有没有取歪(看图)\", \"scripts/stocktake_view.py\"), (\"离线复算\", \"scripts/stocktake_new.py\"),\r","+                 (\"真的放歪了\", \"x_place\")]),\r","+    dict(id=\"x_service\", title=\"服务掉了 / 网页打不开\", status=\"todo\",\r","+         what=\"控制台服务灯红、上位机连不上设备。\",\r","+         checks=[(\"控制台里重启该服务\", \"控制台服务面板\"), (\"看该服务日志最后的报错\", \"控制台日志页\"),\r","+                 (\"看门狗是否在跑\", \"看门狗日志\"), (\"服务托管说明\", \"docs/服务托管.md\")]),\r","+    dict(id=\"x_webhook\", title=\"事件推送异常 / 上位机没记账\", status=\"todo\",\r","+         what=\"控制台「事件推送」报异常, 或上位机账和设备对不上。\",\r","+         checks=[(\"CRV 是否在运行、端口\", \"控制台 CRV 行\"), (\"对接配置\", \"config/upper_link.yaml\"),\r","+                 (\"一次任务的完整交互记录\", \"scripts/webhook_trace.py\")]),\r","+    dict(id=\"x_arm\", title=\"机械臂不动 / 很慢 / 中途停了\", status=\"todo\",\r","+         what=\"下了任务臂不动、动得很慢, 或停在半路。\",\r","+         checks=[(\"急停、使能\", \"示教器\"), (\"手动模式(限速)→自动\", \"scripts/check_cell.sh opmode auto(下任务时会自动切)\"),\r","+                 (\"是否误留在仿真模式\", \"控制台「模式」行\"), (\"停在半路 → 复位原路倒回\", \"控制台「机械臂复位」\")]),\r","+    dict(id=\"x_feeder\", title=\"上苗机不送料\", status=\"todo\",\r","+         what=\"入库时等不到盒。\",\r","+         checks=[(\"上苗机体检(串口/传感器)\", \"d1\"), (\"是否关了送料\", \"config/speed_profile.yaml feeder.enabled\")]),\r","+]\r","+\r","+MAINT = [\r","+    dict(id=\"m_snapshot\", title=\"标定快照: 对比 / 恢复\", status=\"ready\",\r","+         what=\"把当前参数和任意快照对比; 改坏了恢复到某个快照(恢复前自动再存一份)。\",\r","+         when=\"怀疑参数被改过、重标后效果变差想退回时。\",\r","+         prep=[\"恢复后需重启工作站和视觉服务才生效\"],\r","+         tools=[\"tools/calib/calib_snapshot.py\"],\r","+         actions=[\r","+             dict(label=\"当前 vs 基准\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"diff\", \"{baseline}\"]),\r","+             dict(label=\"列出恢复到基准会改哪些文件\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"restore\", \"{baseline}\"]),\r","+             dict(label=\"恢复到基准(写入)\", cmd=[\"{py}\", \"tools/calib/calib_snapshot.py\", \"restore\", \"{baseline}\", \"--apply\"],\r","+                  confirm=\"会把配置文件恢复成基准快照(恢复前自动另存一份当前值)。确定吗?\"),\r","+         ]),\r","+    dict(id=\"m_train\", title=\"视觉训练(收难例 → 标注 → 训练 → 对比 → 采用)\", status=\"env\",\r","+         what=\"识别模型(YOLO11n-seg)认不出新外观/新光照时, 收集失败照片标注后重新训练, 和现役模型对比后再决定是否采用。\",\r","+         when=\"诊断指向「模型本身认不出」时。\",\r","+         prep=[\"需要视觉训练环境(独立 conda 环境: CUDA 版 PyTorch + ultralytics + LabelMe), 未装\"],\r","+         tools=[\"scripts/vision_train/*\", \"models/best_v3.pt(现役)\"]),\r","+    dict(id=\"m_path\", title=\"路径规划(新格口 / 重新规划 / 判碰撞 / 试飞入库)\", status=\"env\",\r","+         what=\"新增格口、挪层板、路径有停顿或撞了时, 用 MoveIt 规划平顺路径, 控制器仿真实跑判碰撞, 生产速度试飞后入库。\",\r","+         when=\"加格口、改货架、诊断指向路径问题时。\",\r","+         prep=[\"需要路径规划环境(WSL2 + Ubuntu 22.04 + ROS2 Humble + MoveIt2 + Foxglove), 未装\"],\r","+         tools=[\"scripts/arm/solve_slot.sh\", \"scripts/arm/plan_smooth.sh\", \"scripts/arm/reverse_candidate.sh\", \"scripts/arm/path_check.py\"]),\r","+    dict(id=\"m_sku\", title=\"录入新药盒品种\", status=\"todo\",\r","+         what=\"卡尺量三围, 查追溯码得到品种钥匙, 写进尺寸表。没录入的品种上架会因认脸对不上被丢回。\",\r","+         when=\"来了新品种。\",\r","+         prep=[\"卡尺\", \"一盒样品(要扫追溯码)\"],\r","+         tools=[\"scripts/sku_add.sh → 待本机化\", \"config/sku_dims.yaml\"]),\r","+    dict(id=\"m_stocktake\", title=\"盘点工具(取点可视化 / 离线复算 / 空格口基准)\", status=\"todo\",\r","+         what=\"盘点报错时看取点区域, 离线复算判据; 层板改动后重采空格口基准。\",\r","+         when=\"盘点不符、层板改动后。\",\r","+         prep=[\"空格口基准采集要求货架全空\"],\r","+         tools=[\"scripts/stocktake_view.py\", \"scripts/stocktake_new.py\", \"scripts/stocktake_ref.sh → 待本机化\",\r","+                \"scripts/calib_board_by_camera.py\"]),\r","+    dict(id=\"m_speed\", title=\"速度调整\", status=\"todo\",\r","+         what=\"所有速度/加速度/等待常数都在一个文件里; 一次只拧一个, 回归后对账。\",\