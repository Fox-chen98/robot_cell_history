))\n\n\ndef _svc_status_loop():\n    \"\"\"线程B: 每 5 秒问一次视觉/扫码服务在不在(扫码服务在等码时会卡住几秒, 和线程A分开, 不拖慢机械臂状态)\"\"\"\n    while True:\n        try:\n            from services.vision_client import VisionClient\n            _STATUS[\"svc\"][\"vision\"] = VisionClient.try_connect() is not None\n        except Exception: _STATUS[\"svc\"][\"vision\"] = False\n        try:\n            from services.scan_client import ScanClient\n            _STATUS[\"svc\"][\"scanner\"] = ScanClient.try_connect() is not None\n        except Exception: _STATUS[\"svc\"][\"scanner\"] = False\n        time.sleep(5.0)\n\n\nthreading.Thread(target=_arm_status_loop, daemon=True, name=\"status-arm\").start()\nthreading.Thread(target=_svc_status_loop, daemon=True, name=\"status-svc\").start()\n\n\ndef _cached_device():\n    \"\"\"GET /device 用: 后台缓存 + 现取的轻量字段(任务号/推送状态). 刚启动缓存还没有时退回当场读一次\"\"\"\n    arm = _STATUS[\"arm\"]\n    if arm is None:\n        with _ctrl_lock:\n            return _read_device()\n    out = dict(arm)\n    out[\"t\"] = time.strftime(\"%Y-%m-%d %H:%M:%S\", time.localtime(_STATUS[\"arm_ts\"]))\n    out[\"age_s\"] = round(time.time() - _STATUS[\"arm_ts\"], 1)\n    out[\"services\"] = dict(_STATUS[\"svc\"])\n    out[\"task_id\"] = TASKS.current_id()\n    out[\"webhook\"] = webhook.status()\n    if out[\"task_id\"] is not None and out[\"state\"] == \"idle\":\n        out[\"state\"] = \"busy\"\n    return out\n\n\n''' + a,1)\n# 3) 接口改用缓存\na='''def device():\n    \"\"\"设备当前状态(只读)\"\"\"\n    with _ctrl_lock:\n        return _read_device()'''\nassert a in s\ns=s.replace(a,'''def device():\n    \"\"\"设备当前状态(只读). 2026-10-23 起取后台缓存(每秒刷新), 毫秒级返回, 不随设备忙闲变慢; age_s = 这份状态是几秒前读的\"\"\"\n    return _cached_device()''')\nopen(p,\"w\",encoding=\"utf-8\").write(s)\nEOF\n/usr/bin/python3 -m py_compile services/cell_server.py && echo ok; grep -n \"^TASKS\\s*=\\|^TASKS =\" services/cell_server.py | head -2; grep -n \"^def _arm_status_loop\\|^threading.Thread(target=_arm\" services/cell_server.py","description":"