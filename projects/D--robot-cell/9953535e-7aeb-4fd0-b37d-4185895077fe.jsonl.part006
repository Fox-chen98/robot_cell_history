\"): {\"action\": \"丢回传送带\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已吹开丢回传送带, 空手回到 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 9.8, \"data\": {}},","     (\"POST\", \"/device/home\"): {\"action\": \"去 home\", \"ok\": True, \"code\": \"OK\", \"category\": \"none\", \"message\": \"已在 home\", \"payload\": \"none\", \"where\": \"home\", \"elapsed_s\": 0.3, \"data\": {}},","     (\"POST\", \"/services/{name}/{cmd}\"): {\"ok\": True, \"name\": \"vision\", \"cmd\": \"restart\", \"output\": \"vision pid 74368 killed\"},","+    (\"GET\", \"/stocktake/image/{name}\"): \"（二进制 JPG 图片，Content-Type: image/jpeg）\","," }"," EXAMPLES_REQ_EXTRA = {   # 请求示例(路径参数/查询参数类接口)","     (\"GET\", \"/tasks/{tid}\"): \"GET /tasks/2\","]},{"oldStart":96,"oldLines":6,"newStart":100,"newLines":7,"lines":["     (\"POST\", \"/tasks/{tid}/destination\"): {\"box_seq\": 1, \"action\": \"place\", \"slot\": \"A-L10\", \"pit\": [3, 0, 0], \"box_mm\": [60.0, 38.5, 22.4], \"name\": \"麻腮风联合减毒活疫苗\"},","     (\"POST\", \"/tasks/{tid}/stop\"): \"POST /tasks/2/stop\", (\"POST\", \"/tasks/{tid}/pause\"): \"POST /tasks/2/pause\", (\"POST\", \"/tasks/{tid}/resume\"): \"POST /tasks/2/resume\", (\"POST\", \"/tasks/{tid}/abort\"): \"POST /tasks/2/abort\",","     (\"POST\", \"/services/{name}/{cmd}\"): \"POST /services/vision/restart\",","+    (\"GET\", \"/stocktake/image/{name}\"): \"GET /stocktake/image/A-L10_20261022_094405.jpg\","," }"," EVENT_KINDS = [","     (\"task_start\", \"任务开始\", \"feed, destination, slot, pits, stop；出库/退苗另有 dest, reason, items(盒数)\"),"]}]}],"moreFiles":2,"changedFiles":["/Users/chen/Desktop/robocenter/docs/设备接口文档_V1.docx","/Users/chen/Desktop/robocenter/docs/设备接口文档_V1.md","/Users/chen/Desktop/robocenter/scripts/api_doc_classic.py"]}},"serverClassifierContext":{"request":"30b2aa20-44ab-4084-8387-3b1ceea76539","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch"