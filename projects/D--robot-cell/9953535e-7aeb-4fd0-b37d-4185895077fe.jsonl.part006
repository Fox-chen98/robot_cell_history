          st, raw = describe(arm._cobot); data[\"机器人状态\"] = st\n            return ActionResult(act, False, \"E_GOTO_MOTION\", C.MANUAL, \"丢弃点退到drop_mid中断: \" + st.split(\" [\")[0], payload, \"丢弃点→drop_mid 途中\", sw.s(), data)\n    ok = arm.move_joint([float(x) for x in poses[name]], velocity=knob(\"goto\", \"movej_v\"), acceleration=knob(\"goto\", \"movej_a\"), def_acc=True)\n    if not ok:\n        st, raw = describe(arm._cobot); data[\"机器人状态\"] = st; data[\"看门狗\"] = getattr(arm, \"last_guard_reason\", \"\") or \"-\"\n        estop = raw and (raw[2] in (7, 8, 9) or raw[0] == 4)\n        return ActionResult(act, False, \"E_GOTO_MOTION\", C.MANUAL if estop else C.NEED_RESET, \"movej 中断: \" + st.split(\" [\")[0], payload, \"%s→%s 途中\" % (frm, name), sw.s(), data)\n    return ActionResult(act, True, \"OK\", C.NONE, \"%s → %s\" % (frm, name), payload, name, sw.s(), data)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"34e5cadd-ae3a-49d5-b8f9-d75a271d0351","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":14},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"e49f6399-dc27-4392-b8b3-11db3806b8a7","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"2e8bfcd4-e637-441c-b83c-f83c49135d41","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
