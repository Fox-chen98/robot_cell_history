 Write-Host $value -ForegroundColor $color }\r","+\r","+function Show-Status {\r","+    Clear-Host\r","+    Write-Host \"\"\r","+    Write-Host \"  ========== 设备状态  $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') ==========\" -ForegroundColor Cyan\r","+    Write-Host \"\"\r","+    Write-Host \"  [服务]\"\r","+    foreach ($s in $SERVICES) {\r","+        if (Test-Port $s.port) { Line $s.name \"运行中 (端口 $($s.port))\" \"Green\" } else { Line $s.name \"未运行 (端口 $($s.port))  -> 可选 2 重启\" \"Red\" }\r","+    }\r","+    if (Test-Port 8977) { Line \"CRV上位机\" \"运行中\" \"Green\" } else { Line \"CRV上位机\" \"未运行(桌面双击'沈苏单机版CRV'打开)\" \"Yellow\" }\r","+    Write-Host \"\"\r","+    Write-Host \"  [机械臂]\"\r","+    $d = Get-Dev\r","+    if ($null -eq $d) { Line \"状态\" \"读不到(工作站服务没在运行)\" \"Red\"; return }\r","+    $st = if ($STATE_CN.ContainsKey(\"$($d.state)\")) { $STATE_CN[\"$($d.state)\"] } else { \"$($d.state)\" }\r","+    $c = switch (\"$($d.state)\") { \"idle\" { \"Green\" } \"busy\" { \"Cyan\" } default { \"Red\" } }\r","+    Line \"状态\" $st $c\r","+    if ($d.detail) { Line \"说明\" \"$($d.detail)\" \"Yellow\" }\r","+    Line \"位置\" \"$($d.arm_at)\"\r","+    $pay = switch (\"$($d.payload)\") { \"none\" { \"空手\" } \"holding\" { \"手上有盒\" } default { \"$($d.payload)\" } }\r","+    Line \"手上\" $pay $(if (\"$($d.payload)\" -eq \"holding\") { \"Yellow\" } else { \"Gray\" })\r","+    if ($null -ne $d.estop) { Line \"急停\" $(if ($d.estop) { \"已按下\" } else { \"未按下\" }) $(if ($d.estop) { \"Red\" } else { \"Gray\" }) }\r","+    if ($null -ne $d.sim_mode) { Line \"控制器\" $(if ($d.sim_mode) { \"仿真模式(真机不会动!)\" } else { \"真实模式\" }) $(if ($d.sim_mode) { \"Yellow\" } else { \"Gray\" }) }\r","+    if ($d.task_id) { Line \"当前任务\" \"#$($d.task_id)\" \"Cyan\" }\r","+    if ($d.webhook -and $d.webhook.enabled) {\r","+        $w = \"$($d.webhook.state)\"\r","+        Line \"事件推送\" $(if ($w -eq \"ok\") { \"正常\" } else { \"异常: $w (失败 $($d.webhook.failed) 次)\" }) $(if ($w -eq \"ok\") { \"Gray\" } else { \"Yellow\" })\r","+    }\r","+}\r","+\r","+function Confirm-Yes($msg) {\r","+    Write-Host \"\"\r","+    Write-Host \"  $msg\" -ForegroundColor Yellow\r","+    return ((Read-Host \"  确认请输入 是 ，其他任意键取消\") -eq \"是\")\r","+}\r","+\r","+function Restart-Svc($key) {\r","+    $d = Get-Dev\r","+    if ($d -and \"$($d.state)\" -eq \"busy\" -and $key -in @(\"all\", \"cell\", \"vision\", \"scan\")) {\r","+        if (-not (Confirm-Yes \"设备正在执行任务 #$($d.task_id)，重启服务会中断它。\")) { return }\r","+    }\r","+    Write-Host \"  正在重启，约 10~30 秒...\" -ForegroundColor Cyan\r","+    & \"$CELL\\services\\svc.bat\" restart $key | Out-Null\r","+    Start-Sleep -Seconds 3\r","+}\r","+\r","+function Do-Reset {\r","+    $ok = Confirm-Yes \"机械臂复位：沿原路退回到原点(home)，真机会动！请确认：1.周围无人  2.急停已解除  3.控制器为自动模式\"\r","+    if (-not $ok) { return }\r","+    Write-Host \"  复位中，请勿离开(最长约 1 分钟)...\" -ForegroundColor Cyan\r","+    try {\r","+        $r = Invoke-RestMethod -Method Post \"$API/device/reset\" -TimeoutSec 180\r","+        Write-Host \"\"\r","+        Line \"结果\" $(if ($r.ok) { \"成功\" } else { \"失败 ($($r.code))\" }) $(if ($r.ok) { \"Green\" } else { \"Red\" })\r","+        Line \"说明\" \"$($r.message)\"\r","+        Line \"位置\" \"$($r.where)\"\r","+        if (\"$($r.payload)\" -eq \"holding\") { Line \"注意\" \"手上还有一盒，请人工取下或丢回传送带\" \"Yellow\" }\r","+    } catch {\r","+        $m = \"$($_.ErrorDetails.Message)\"; if (-not $m) { $m = \"$($_.Exception.Message)\" }\r","+        if ($m -match \"busy\") { Write-Host \"  有任务正在执行，不能复位。请先在上位机停止任务。\" -ForegroundColor Red }\r","+        else { Write-Host \"  复位请求失败: $m\" -ForegroundColor Red }\r","+    }\r","+}\r","+\r","+function Show-Logs {\r","+    Write-Host \"\"\r","+    Write-Host \"  [工作站服务日志 最近 25 行]\" -ForegroundColor Cyan\r","+    Get-Content \"$CELL\\logs\\cell_service.log\" -Tail 25 -Encoding UTF8 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }\r","+    Write-Host \"\"\r","+    if ((Read-Host \"  按 回车 返回，输入 o 打开日志文件夹\") -eq \"o\") { Start-Process explorer.exe \"$CELL\\logs\" }\r","+}\r","+\r","+while ($true) {\r","+    Show-Status\r","+    Write-Host \"\"\r","+    Write-Host \"  ---------------------------------------------\" -ForegroundColor DarkGray\r","+    Write-Host \"   1  刷新状态\"\r","+    Write-Host \"   2  重启全部服务\"\r","+    Write-Host \"   3  重启单个服务\"\r","+    Write-Host \"   4  打开设备网页(任务/卡片流/库存)\"\r","+    Write-Host \"   5  打开接口调试页\"\r","+    Write-Host \"   6  查看日志\"\r","+    Write-Host \"   7  机械臂复位(真机会动)\" -ForegroundColor Yellow\r","+    Write-Host \"   0  退出\"\r","+    Write-Host \"\"\r","+    switch (Read-Host \"  请选择\") {\r","+        \"1\" { }\r","+        \"2\" { Restart-Svc \"all\" }\r","+        \"3\" {\r","+            for ($i = 0; $i -lt $SERVICES.Count; $i++) { Write-Host (\"   {0}  {1}\" -f ($i + 1), $SERVICES[$i].name) }\r","+            $n = Read-Host \"  选择要重启的服务\"\r","+            if ($n -match \"^[1-4]$\") { Restart-Svc $SERVICES[[int]$n - 1].key }\r","+        }\r","+        \"4\" { Start-Process \"$API/upper\" }\r","+        \"5\" { Start-Process \"$API/docs\" }\r","+        \"6\" { Show-Logs }\r","+        \"7\" { Do-Reset; Read-Host \"  按 回车 返回\" | Out-Null }\r","+        \"0\" { exit }\r","+    }\r","+}\r"]}],"created":true},{"filePath":"/Users/chen/Desktop/robocenter/scripts/deploy_cell.sh","hunks":[{"oldStart":18,"oldLines":7,"newStart":18,"newLines":7,"lines":[" scp -q \"$ROOT\"/scripts/bluespace/flows/*.py \"$BS:$CELL/flows/\" || { echo \"❌ FAIL: flows同步失败\"; exit 1; }"," scp -q \"$ROOT\"/scripts/bluespace/hardware/robot_arm/ducocobot.py \"$BS:$CELL/hardware/robot_arm/ducocobot.py\" || { echo \"❌ FAIL: 臂封装同步失败\"; exit 1; }"," scp -q \"$ROOT\"/scripts/bluespace/hardware/depth_camera/*.py \"$BS:$CELL/hardware/depth_camera/\" || { echo \"❌ FAIL: 相机封装同步失败\"; exit 1; }   # 2026-09-23 纳入仓库(断流诊断)","-scp -q \"$ROOT\"/scripts/bluespace/services/*.py \"$ROOT\"/scripts/bluespace/services/*.bat \"$ROOT\"/scripts/bluespace/services/*.vbs \"$BS:$CELL/services/\" || { echo \"❌ FAIL: services同步失败\"; exit 1; }","+scp -q \"$ROOT\"/scripts/bluespace/services/*.py \"$ROOT\"/scripts/bluespace/services/*.bat \"$ROOT\"/scripts/bluespace/services/*.vbs \"$ROOT\"/scripts/bluespace/services/*.ps1 \"$BS:$CELL/services/\" || { echo \"❌ FAIL: services同步失败\"; exit 1; }"," ssh -n -o ConnectTimeout=15 \"$BS\" \"if not exist D:\\\\Destop\\\\robot_cell\\\\services\\\\upper mkdir D:\\\\Destop\\\\robot_cell\\\\services\\\\upper\" >/dev/null 2>&1"," scp -q \"$ROOT\"/scripts/upper/* \"$BS:$CELL/services/upper/\" || { echo \"❌ FAIL: 上位机网页同步失败\"; exit 1; }"," scp -q \"$ROOT\"/scripts/bluespace/hardware/gripper/duco_suction.py \"$BS:$CELL/hardware/gripper/duco_suction.py\" || { echo \"❌ FAIL: 吸盘类同步失败\"; exit 1; }"]}]}],"moreFiles":0,"changedFiles":["/Users/chen/Desktop/robocenter/scripts/bluespace/services/device_console.ps1","/Users/chen/Desktop/robocenter/scripts/deploy_cell.sh"]}},"serverClassifierContext":{"request":"6412c16a-5c06-4bf2-9597-81fb0d291dfa","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":16},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"b2cc62bd-ae98-4488-8871-05f44c927d4c","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"9343acc9-1522-4f43-ad44-22eed585118b","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.311","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"a21562b3588fb80186ecc32c86951ba894d9b8b52b16530eec847151ece17573","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"thinking","thinking":"记录两个顺带发现：机械臂设备连不上（可能控制器未开机，需确认），以及 webhook 已失败推送171次，仍在推旧地址192.168.100.212而非已迁移的 blue-space，会在第二步测试一起处理。现在开始写设备控制台，一个复用现有服务管理脚本和设备状态接口的 PowerShell 菜单程序。\n\n","signature":""},{"type":"tool_use","id":"toolu_01DZarDzsSgUVAJzpuXDQe3B","name":"Bash","input":{"command":"cd /Users/chen/Desktop/robocenter && /usr/bin/python3 - <<'PYEOF'\nsrc = r'''# 设备控制台(2026-10-28): blue-space 桌面\"设备控制台\"图标打开的菜单。给现场使用者用, 不需要懂命令行。\n# 四个服务开机由看门狗自动启动, 这里只负责: 看状态 / 重启服务 / 打开网页 / 看日志 / 机械臂复位。\n# 复用: services\\svc.bat(起停服务) + 工作站接口 http://127.0.0.1:8902(/device 状态, /device/reset 复位)\n# 源: robocenter 仓库 scripts/bluespace/services/device_console.ps1, deploy_cell.sh 推到 D:\\Destop\\robot_cell\\services\\\n$Host.UI.RawUI.WindowTitle = \"设备控制台\"\n$CELL = \"D:\\Destop\\robot_cell\"\n$API = \"http://127.0.0.1:8902\"\n$SERVICES = @(\n    @{ key = \"vision\"; name = \"视觉服务\";       port = 8900 },\n    @{ key = \"scan\";   name = \"扫码服务\";       port = 8901 },\n    @{ key = \"cell\";   name = \"工作站服务\";     port = 8902 },\n    @{ key = \"upper\";  name = \"上位机后端(调试)\"; port = 8903 }\n)\n$STATE_CN = @{ idle = \"空闲\"; busy = \"执行任务中\"; offline = \"离线\"; needs_human = \"需要人工处理\"; estop = \"急停\"; paused = \"已暂停\" }\n\nfunction Test-Port($p) { [bool](Get-NetTCPConnection -LocalPort $p -State Listen -ErrorAction SilentlyContinue) }\nfunction Get-Dev { try { Invoke-RestMethod \"$API/device\" -TimeoutSec 5 } catch { $null } }\nfunction Line($label, $value, $color = \"Gray\") { Write-Host (\"  {0,-10}\" -f $label) -NoNewline; Write-Host $value -ForegroundColor $color }\n\nfunction Show-Status {\n    Clear-Host\n    Write-Host \"\"\n    Write-Host \"  ========== 设备状态  $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') ==========\" -ForegroundColor Cyan\n    Write-Host \"\"\n    Write-Host \"  [服务]\"\n    foreach ($s in $SERVICES) {\n        if (Test-Port $s.port) { Line $s.name \"运行中 (端口 $($s.port))\" \"Green\" } else { Line $s.name \"未运行 (端口 $($s.port))  -> 可选 2 重启\" \"Red\" }\n    }\n    if (Test-Port 8977) { Line \"CRV上位机\" \"运行中\" \"Green\" } else { Line \"CRV上位机\" \"未运行(桌面双击'沈苏单机版CRV'打开)\" \"Yellow\" }\n    Write-Host \"\"\n    Write-Host \"  [机械臂]\"\n    $d = Get-Dev\n    if ($null -eq $d) { Line \"状态\" \"读不到(工作站服务没在运行)\" \"Red\"; return }\n    $st = if ($STATE_CN.ContainsKey(\"$($d.state)\")) { $STATE_CN[\"$($d.state)\"] } else { \"$($d.state)\" }\n    $c = switch (\"$($d.state)\") { \"idle\" { \"Green\" } \"busy\" { \"Cyan\" } default { \"Red\" } }\n    Line \"状态\" $st $c\n    if ($d.detail) { Line \"说明\" \"$($d.detail)\" \"Yellow\" }\n    Line \"位置\" \"$($d.arm_at)\"\n    $pay = switch (\"$($d.payload)\") { \"none\" { \"空手\" } \"holding\" { \"手上有盒\" } default { \"$($d.payload)\" } }\n    Line \"手上\" $pay $(if (\"$($d.payload)\" -eq \"holding\") { \"Yellow\" } else { \"Gray\" })\n    if ($null -ne $d.estop) { Line \"急停\" $(if ($d.estop) { \"已按下\" } else { \"未按下\" }) $(if ($d.estop) { \"Red\" } else { \"Gray\" }) }\n    if ($null -ne $d.sim_mode) { Line \"控制器\" $(if ($d.sim_mode) { \"仿真模式(真机不会动!)\" } else { \"真实模式\" }) $(if ($d.sim_mode) { \"Yellow\" } else { \"Gray\" }) }\n    if ($d.task_id) { Line \"当前任务\" \"#$($d.task_id)\" \"Cyan\" }\n    if ($d.webhook -and $d.webhook.enabled) {\n        $w = \"$($d.webhook.state)\"\n        Line \"事件推送\" $(if ($w -eq \"ok\") { \"正常\" } else { \"异常: $w (失败 $($d.webhook.failed) 次)\" }) $(if ($w -eq \"ok\") { \"Gray\" } else { \"Yellow\" })\n    }\n}\n\nfunction Confirm-Yes($msg) {\n    Write-Host \"\"\n    Write-Host \"  $msg\" -ForegroundColor Yellow\n    return ((Read-Host \"  确认请输入 是 ，其他任意键取消\") -eq \"是\")\n}\n\nfunction Restart-Svc($key) {\n    $d = Get-Dev\n    if ($d -and \"$($d.state)\" -eq \"busy\" -and $key -in @(\"all\", \"cell\", \"vision\", \"scan\")) {\n        if (-not (Confirm-Yes \"设备正在执行任务 #$($d.task_id)，重启服务会中断它。\")) { return }\n    }\n    Write-Host \"  正在重启，约 10~30 秒...\" -ForegroundColor Cyan\n    & \"$CELL\\services\\svc.bat\" restart $key | Out-Null\n    Start-Sleep -Seconds 3\n}\n\nfunction Do-Reset {\n    $ok = Confirm-Yes \"机械臂复位：沿原路退回到原点(home)，真机会动！请确认：1.周围无人  2.急停已解除  3.控制器为自动模式\"\n    if (-not $ok) { return }\n    Write-Host \"  复位中，请勿离开(最长约 1 分钟)...\" -ForegroundColor Cyan\n    try {\n        $r = Invoke-RestMethod -Method Post \"$API/device/reset\" -TimeoutSec 180\n        Write-Host \"\"\n        Line \"结果\" $(if ($r.ok) { \"成功\" } else { \"失败 ($($r.code))\" }) $(if ($r.ok) { \"Green\" } else { \"Red\" })\n        Line \"说明\" \"$($r.message)\"\n        Line \"位置\" \"$($r.where)\"\n        if (\"$($r.payload)\" -eq \"holding\") { Line \"注意\" \"手上还有一盒，请人工取下或丢回传送带\" \"Yellow\" }\n    } catch {\n        $m = \"$($_.ErrorDetails.Message)\"; if (-not $m) { $m = \"$($_.Exception.Message)\" }\n        if ($m -match \"busy\") { Write-Host \"  有任务正在执行，不能复位。请先在上位机停止任务。\" -ForegroundColor Red }\n        else { Write-Host \"  复位请求失败: $m\" -ForegroundColor Red }\n    }\n}\n\nfunction Show-Logs {\n    Write-Host \"\"\n    Write-Host \"  [工作站服务日志 最近 25 行]\" -ForegroundColor Cyan\n    Get-Content \"$CELL\\logs\\cell_service.log\" -Tail 25 -Encoding UTF8 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host \"  $_\" }\n    Write-Host \"\"\n    if ((Read-Host \"  按 回车 返回，输入 o 打开日志文件夹\") -eq \"o\") { Start-Process explorer.exe \"$CELL\\logs\" }\n}\n\nwhile ($true) {\n    Show-Status\n    Write-Host \"\"\n    Write-Host \"  ---------------------------------------------\" -ForegroundColor DarkGray\n    Write-Host \"   1  刷新状态\"\n    Write-Host \"   2  重启全部服务\"\n    Write-Host \"   3  重启单个服务\"\n    Write-Host \"   4  打开设备网页(任务/卡片流/库存)\"\n    Write-Host \"   5  打开接口调试页\"\n    Write-Host \"   6  查看日志\"\n    Write-Host \"   7  机械臂复位(真机会动)\" -ForegroundColor Yellow\n    Write-Host \"   0  退出\"\n    Write-Host \"\"\n    switch (Read-Host \"  请选择\") {\n        \"1\" { }\n        \"2\" { Restart-Svc \"all\" }\n        \"3\" {\n            for ($i = 0; $i -lt $SERVICES.Count; $i++) { Write-Host (\"   {0}  {1}\" -f ($i + 1), $SERVICES[$i].name) }\n            $n = Read-Host \"  选择要重启的服务\"\n            if ($n -match \"^[1-4]$\") { Restart-Svc $SERVICES[[int]$n - 1].key }\n        }\n        \"4\" { Start-Process \"$API/upper\" }\n        \"5\" { Start-Process \"$API/docs\" }\n        \"6\" { Show-Logs }\n        \"7\" { Do-Reset; Read-Host \"  按 回车 返回\" | Out-Null }\n        \"0\" { exit }\n    }\n}\n'''\nopen(\"scripts/bluespace/services/device_console.ps1\", \"wb\").write(b\"\\xef\\xbb\\xbf\" + src.replace(\"\\r\\n\", \"\\n\").replace(\"\\n\", \"\\r\\n\").encode(\"utf-8\"))\np = \"scripts/deploy_cell.sh\"; s = open(p, encoding=\"utf-8\").read()\na = '\"$ROOT\"/scripts/bluespace/services/*.vbs \"$BS:$CELL/services/\"'\nassert a in s\ns = s.replace(a, '\"$ROOT\"/scripts/bluespace/services/*.vbs \"$ROOT\"/scripts/bluespace/services/*.ps1 \"$BS:$CELL/services/\"')\nopen(p, \"w\", encoding=\"utf-8\").write(s)\nprint(\"ok\")\nPYEOF\n./scripts/deploy_cell.sh 2>&1 | grep -E \"PASS|FAIL\"","description":"编写设备控制台菜单脚本并部署到设备","timeout":300000},"caller":{"type":"direct"}}]}}
