{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"18123b4ce8d184820685091d30ddf3eef79efda3ebe329a3c81f5c1de4c243d5","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01Kc6FKqFTkNbduuGLXLn6n4","name":"Bash","input":{"command":"cd /Users/chen/Desktop/robocenter/scripts/bluespace && python3 - <<'EOF'\np='services/webhook.py'\ns=open(p,encoding='utf-8').read()\nold=s[s.index('    time.sleep(1.0)\\n    ok, info, ms = _ping_once(\"设备启动自检\")'):]\nnew='''    time.sleep(1.0)\n    ok, info, ms = _ping_once(\"设备启动自检\")\n    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, ms))\n    print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通, 之后每%.0f秒重检\" % RECHECK_S, info), flush=True)\n    last = ok\n    while True:\n        if info is not None:                                 # 本轮真 ping 过才改状态\n            with _LOCK:\n                if ok:\n                    _ST[\"state\"] = \"ok\"\n                    _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n                else:\n                    _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n                    _ST[\"last_error\"] = \"自检失败(%s, 每%.0f秒重试): 检查上位机是否已打开, 及 config/upper_link.yaml 的 upper/webhook(当前目标 %s)\" % (info, RECHECK_S, target_url())\n            if ok != last:\n                print(\"[webhook] 重检: %s (%s)\" % (\"恢复\" if ok else \"又断了\", info), flush=True)\n            last = ok\n        time.sleep(RECHECK_S)\n        ok, info = True, None                                # 默认本轮不 ping(状态正常或队列忙)\n        busy = _ST.get(\"inflight\") or (_Q is not None and _Q.qsize() > 0)\n        if _ST.get(\"state\") != \"ok\" and not busy:\n            ok, info, ms = _ping_once(\"设备重检(状态不正常时每%.0f秒一次)\" % RECHECK_S)\n            if ok != last:\n                _out(\"0-0 ping -> %s %.0fms (recheck, %s)\" % (info, ms, \"恢复\" if ok else \"又断了\"))\n'''\ns=s.replace(old,new,1)\nopen(p,'w',encoding='utf-8').write(s)\nEOF\npython3 -m py_compile services/webhook.py && echo ok\n# offline test on Mac: target closed port, then open receiver\nT=/private/tmp/claude-501/-Users-chen-Desktop-robocenter/9953535e-7aeb-4fd0-b37d-4185895077fe/scratchpad/whtest; rm -rf $T; mkdir -p $T/config $T/logs\ncat > $T/config/upper_link.yaml <<'Y'\nupper: {host: 127.0.0.1, port: 18999}\nwebhook: {enabled: true, path: /hook, timeout_s: 1.0, retries: 0}\nY\ncat > $T/run.py <<'P'\nimport sys, time, threading, http.server\nsys.path.insert(0, sys.argv[1]); import webhook as w\nw.RECHECK_S = 2.0\nw.init(sys.argv[2])\ndef st(tag): s=w.status(); print(\"%-22s state=%s last_ok=%s\" % (tag, s[\"state\"], s[\"last_ok_at\"]), flush=True)\ntime.sleep(2.5); st(\"CRV not up yet:\")\nclass H(http.server.BaseHTTPRequestHandler):\n    def do_POST(self): self.rfile.read(int(self.headers[\"Content-Length\"])); self.send_response(200); self.end_headers()\n    def log_message(self,*a): pass\nsrv=http.server.HTTPServer((\"127.0.0.1\",18999),H); threading.Thread(target=srv.serve_forever,daemon=True).start()\ntime.sleep(3); st(\"CRV up, after recheck:\")\nsrv.shutdown(); srv.server_close()\nw.post_event(1, {\"seq\":1,\"kind\":\"stored\"}); time.sleep(2); st(\"CRV down, event failed:\")\nP\npython3 $T/run.py \"$PWD/services\" $T 2>&1; echo \"--- out log:\"; cat $T/logs/webhook_out.log","description":"离线模拟测试推送重检逻辑","timeout":60000},"caller":{"type":"direct"}}]}}
