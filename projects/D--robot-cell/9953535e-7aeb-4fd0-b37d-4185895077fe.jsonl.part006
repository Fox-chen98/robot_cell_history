{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"9a98095b9596f163186ec9b1d444c9e5695b26235b925dfcd1d95a176f2a9685","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01XnJWwKASiRxjyTQGE13T6k","name":"Bash","input":{"command":"cd /d/robot_cell && C:/Users/26293/.conda/envs/robot/python.exe - <<'EOF'\np = r\"services\\toolbox_catalog.py\"\ns = open(p, encoding=\"utf-8\").read()\ns = s.replace(\"\"\"  actions            可运行的动作: [{label, cmd, arm(会动真机), camera(独占相机, 自动停视觉服务), confirm(运行前确认的话)}]\n                     cmd 里 {py}=设备 Python, {ts}=当前时刻 20261029_1530, {baseline}=基准快照名\"\"\",\n\"\"\"  actions            可运行的动作: [{label, cmd, arm(会动真机), camera(独占相机, 自动停视觉服务), confirm(运行前确认的话),\n                     idle(运行前查设备空闲, 有任务在跑就拒绝), open_after(成功后打开的文件, 如照片)}]\n                     cmd 里 {py}=设备 Python, {ts}=当前时刻 20261029_1530, {baseline}=基准快照名,\n                     {feeder_com}=上苗机串口(speed_profile.yaml feeder.com)\"\"\")\nopen(p, \"w\", encoding=\"utf-8\").write(s)\n\np = r\"services\\toolbox_gui.py\"\ns = open(p, encoding=\"utf-8\").read()\ns = s.replace('''def vision(cmd):''', '''def knob(sec, key, default=None):\n    try:\n        import yaml\n        with open(os.path.join(ROOT, \"config\", \"speed_profile.yaml\"), encoding=\"utf-8\") as f:\n            return (yaml.safe_load(f).get(sec) or {}).get(key, default)\n    except Exception:\n        return default\n\n\ndef device_busy():\n    \"\"\"有任务在跑返回说明文字, 空闲返回 None; 工作站接口不通视为可以继续(硬件体检本来就可能在服务挂了时用)\"\"\"\n    try:\n        with urllib.request.urlopen(API + \"/device\", timeout=3) as r:\n            d = json.loads(r.read().decode(\"utf-8\"))\n        if d.get(\"task_id\") or d.get(\"state\") == \"busy\":\n            return \"设备正在执行任务 #%s, 请等任务结束或在上位机停止后再做\" % d.get(\"task_id\")\n    except Exception:\n        pass\n    return None\n\n\ndef vision(cmd):''')\ns = s.replace('''        if a.get(\"confirm\") and not messagebox.askyesno(\"确认\", a[\"confirm\"], parent=self.win):\n            return\n        sub = {\"{py}\": PY, \"{ts}\": datetime.datetime.now().strftime(\"%Y%m%d_%H%M\"), \"{baseline}\": C.BASELINE}''',\n'''        if a.get(\"idle\"):\n            why = device_busy()\n            if why:\n                messagebox.showwarning(\"设备忙\", why, parent=self.win); return\n        if a.get(\"confirm\") and not messagebox.askyesno(\"确认\", a[\"confirm\"], parent=self.win):\n            return\n        sub = {\"{py}\": PY, \"{ts}\": datetime.datetime.now().strftime(\"%Y%m%d_%H%M\"), \"{baseline}\": C.BASELINE,\n               \"{feeder_com}\": str(knob(\"feeder\", \"com\", \"COM14\"))}''')\ns = s.replace('''threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\")), daemon=True).start()\n\n    def _worker(self, cmd, camera):''', '''threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\"), a.get(\"open_after\")), daemon=True).start()\n\n    def _worker(self, cmd, camera, open_after=None):''')\ns = s.replace('''            ui(self._log, \"\\\\n■ 结束(退出码 %d)\\\\n\" % rc, \"ok\" if rc == 0 else \"bad\")''',\n'''            ui(self._log, \"\\\\n■ 结束(退出码 %d)\\\\n\" % rc, \"ok\" if rc == 0 else \"bad\")\n            for f in (open_after or []) if rc == 0 else []:\n                fp = os.path.join(ROOT, f)\n                if os.path.exists(fp):\n                    os.startfile(fp); ui(self._log, \"已打开 %s\\\\n\" % f, \"dim\")''')\nopen(p, \"w\", encoding=\"utf-8\").write(s)\nEOF\ngrep -n \"device_busy\\|open_after\\|feeder_com\" services/toolbox_gui.py | head","description":"工具箱加空闲检查、打开照片、串口替换"},"caller":{"type":"direct"}}]}}
