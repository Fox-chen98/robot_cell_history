{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"1bd098bd8f278f63b67b13796637fa193aaa5786c32a125cb83bde71080347dc","message":{"role":"assistant","content":[{"type":"text","text":"Now update webhook.py to read the new file:"},{"type":"tool_use","id":"toolu_014LJdCeSJZbZkb3H21XBpQH","name":"Bash","input":{"command":"cd /Users/chen/Desktop/robocenter && /usr/bin/python3 - <<'PYEOF'\np = \"scripts/bluespace/services/webhook.py\"; s = open(p, encoding=\"utf-8\").read()\ndef rep(a, b):\n    global s; assert s.count(a) == 1, a; s = s.replace(a, b)\nrep('''\"\"\"事件 webhook 投递(设备 → 上位机)。默认关闭; config/webhook.yaml 里 enabled=false 时行为与没有本模块完全一致。\n''', '''\"\"\"事件 webhook 投递(设备 → 上位机)。配置在 config/upper_link.yaml 的 webhook 段(2026-10-28 起; 旧 config/webhook.yaml 仅在新文件缺失时兜底读)。\nenabled=false 时行为与没有本模块完全一致。\n地址 = webhook.url(填了就用) 否则 http://<upper.host>:<upper.port><webhook.path>; upper.port=auto 时每次投递前读 CRV 的 runtime-state.json apiPort\n(CRV 重启/重装会换端口, 不能只在设备启动时读一次)。口令放进 webhook.token_headers 列出的每个请求头。\n''')\nrep('''DEFAULTS = {\"enabled\": False, \"url\": \"\", \"token\": \"\", \"timeout_s\": 3.0, \"retries\": 3,''',\n    '''DEFAULTS = {\"enabled\": False, \"url\": \"\", \"path\": \"\", \"token\": \"\", \"token_headers\": [\"X-Cell-Token\"], \"timeout_s\": 3.0, \"retries\": 3,''')\nrep('''    cfg = dict(DEFAULTS)\n    path = os.path.join(root, \"config\", \"webhook.yaml\")\n    try:\n        import yaml\n        y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n        if isinstance(y.get(\"webhook\"), dict):\n            y = y[\"webhook\"]\n        cfg.update({k: v for k, v in y.items() if k in DEFAULTS})\n    except FileNotFoundError:\n        pass\n    except Exception as e:\n        _ST[\"last_error\"] = \"配置读取失败: %s\" % str(e)[:80]\n    _CFG = cfg\n    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and cfg[\"url\"])\n    if not _ST[\"enabled\"]:\n        _ST[\"state\"] = \"disabled\"\n        if not quiet:\n            print(\"[webhook] 未启用(config/webhook.yaml enabled=false 或 url 为空), 事件仅存本地供 events?since= 拉取\", flush=True)\n        return False''', '''    cfg = dict(DEFAULTS)\n    cfg[\"_upper\"] = {}\n    try:\n        import yaml\n        for name in (\"upper_link.yaml\", \"webhook.yaml\"):   # 新文件优先; 旧 webhook.yaml 只在新文件缺失时兜底\n            path = os.path.join(root, \"config\", name)\n            if not os.path.exists(path):\n                continue\n            y = yaml.safe_load(open(path, encoding=\"utf-8\")) or {}\n            cfg[\"_upper\"] = y.get(\"upper\") or {}\n            w = y[\"webhook\"] if isinstance(y.get(\"webhook\"), dict) else y\n            cfg.update({k: v for k, v in w.items() if k in DEFAULTS})\n            cfg[\"_file\"] = \"config/\" + name\n            break\n    except Exception as e:\n        _ST[\"last_error\"] = \"配置读取失败: %s\" % str(e)[:80]\n    _CFG = cfg\n    _ST[\"enabled\"] = bool(cfg[\"enabled\"] and (cfg[\"url\"] or cfg[\"path\"]))\n    if not _ST[\"enabled\"]:\n        _ST[\"state\"] = \"disabled\"\n        if not quiet:\n            print(\"[webhook] 未启用(%s enabled=false 或地址为空), 事件仅存本地供 events?since= 拉取\" % cfg.get(\"_file\", \"config/upper_link.yaml\"), flush=True)\n        return False''')\nrep('''        print(\"[webhook] 已启用 -> %s (超时%.1fs 重试%d次 白名单%d种)\"\n              % (cfg[\"url\"], cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"])), flush=True)''',\n    '''        print(\"[webhook] 已启用 -> %s (超时%.1fs 重试%d次 白名单%d种, 配置 %s)\"\n              % (target_url(), cfg[\"timeout_s\"], cfg[\"retries\"], len(cfg[\"events\"]), cfg.get(\"_file\")), flush=True)''')\nrep('''def post_event(task_id, ev):''', '''def _upper_port():\n    \"\"\"upper.port: 数字直接用; auto = 读 CRV runtime-state.json 的 apiPort(读不到退 8080)\"\"\"\n    up = _CFG.get(\"_upper\") or {}\n    p = up.get(\"port\", \"auto\")\n    if str(p).lower() != \"auto\":\n        return int(p)\n    try:\n        return int(json.load(open(up.get(\"crv_state_file\", \"\"), encoding=\"utf-8\"))[\"apiPort\"])\n    except Exception:\n        return 8080\n\n\ndef target_url():\n    \"\"\"当前推送目标(每次投递前现算, port=auto 时跟随 CRV 端口变化)\"\"\"\n    if _CFG.get(\"url\"):\n        return _CFG[\"url\"]\n    up = _CFG.get(\"_upper\") or {}\n    return \"http://%s:%d%s\" % (up.get(\"host\", \"127.0.0.1\"), _upper_port(), _CFG.get(\"path\", \"\"))\n\n\ndef post_event(task_id, ev):''')\nrep('''    s[\"url\"] = _CFG.get(\"url\", \"\")''', '''    try:\n        s[\"url\"] = target_url() if _CFG else \"\"\n    except Exception:\n        s[\"url\"] = _CFG.get(\"url\", \"\")''')\nrep('''    req = urllib.request.Request(_CFG[\"url\"], data=body, method=\"POST\")''', '''    req = urllib.request.Request(target_url(), data=body, method=\"POST\")''')\nrep('''    if _CFG.get(\"token\"):\n        req.add_header(\"X-Cell-Token\", _CFG[\"token\"])''', '''    if _CFG.get(\"token\"):\n        for h in (_CFG.get(\"token_headers\") or [\"X-Cell-Token\"]):\n            req.add_header(h, _CFG[\"token\"])''')\nrep('''            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/webhook.yaml 的 url/token\" % info''',\n    '''            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/upper_link.yaml 的 upper/webhook(当前目标 %s)\" % (info, target_url())''')\nopen(p, \"w\", encoding=\"utf-8\").write(s)\n\np = \"scripts/bluespace/services/cell_server.py\"; s = open(p, encoding=\"utf-8\").read()\na = \"PORT = 8902\\n\"\nassert s.count(a) == 1\ns = s.replace(a, '''def _device_port(default=8902):\n    \"\"\"设备接口端口: config/upper_link.yaml 的 device.port(2026-10-28 起可配置), 读不到用 8902\"\"\"\n    try:\n        import yaml\n        return int(yaml.safe_load(open(os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"config\", \"upper_link.yaml\"), encoding=\"utf-8\"))[\"device\"][\"port\"])\n    except Exception:\n        return default\n\n\nPORT = _device_port()\n''')\ns = s.replace(\"    webhook.init(ROOT)                    # 事件推送(config/webhook.yaml); 未启用时安静返回, 行为与从前一致\",\n              \"    webhook.init(ROOT)                    # 事件推送(config/upper_link.yaml 的 webhook 段); 未启用时安静返回, 行为与从前一致\")\nopen(p, \"w\", encoding=\"utf-8\").write(s)\nprint(\"ok\")\nPYEOF\ngrep -n \"^import os\\|^import yaml\\|^ROOT\" scripts/bluespace/services/cell_server.py | head; /usr/bin/python3 -m py_compile scripts/bluespace/services/webhook.py scripts/bluespace/services/cell_server.py && echo COMPILE_OK","description":"推送模块与工作站服务改为读取新配置文件并做语法检查"},"caller":{"type":"direct"}}]}}
