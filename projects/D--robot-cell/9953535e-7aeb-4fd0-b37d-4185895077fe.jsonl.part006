ield(None, description=\"盘点用: 上位机账上这个格口的列表(与 /plan/store 的 columns 同形, 多一个 count). 给了就逐列比对报差异; 不给只报自动分列结果\")","     items: Optional[List[RetrieveItem]] = Field(None, description=\"出库/退苗用: 要取的盒的列表, 设备按顺序逐盒取。哪些盒能取(立放: 列队首=该列最大序号)由上位机按库存账保证\")","     on_empty: str = Field(\"skip\", pattern=\"^(skip|stop)$\", description=\"出库/退苗用: 到坑位发现没吸到盒(账上有、架上没有)怎么办: skip=报一个pit_empty事件后继续下一盒; stop=报事件后结束任务(reason=pit_empty; 臂已空手回home, 不锁设备)\")"]},{"oldStart":278,"oldLines":12,"newStart":278,"newLines":13,"lines":["     waiting_box: reason, waited_s | fault: code, category, message, payload, where | needs_human: text","     paused/resumed/pause_requested/stop_requested/abort_requested | aborted: text, payload","     stocktake: slot, stocktake(盘点结果 dict, 见 stocktake 字段说明), text","+    outbound_scanned(出库扫码, 2026-10-22): slot, x_mm, index, dest, code_expected(任务 items 里给的码), code_scanned(扫到的; 四面没读到=null), match(true/false; 没读到或没给账上码=null). 不论结果都照常投放","     lost: 货物丢失(吸住→吹开之间 DI4 变 0): code, slot, x_mm/index(若已定去处), di4=0, after(最后确认持货的动作), during(发现时的动作), arm_at, text(人读); 账不记, 臂回 home, 任务继续","     task_end: state, reason, stored, discarded, boxes, elapsed_s\"\"\"","     seq: int = Field(..., description=\"事件序号, 任务内从1递增。上位机记住最后一个, 下次拉取带 since=它, 只拿新的\")","     t: str = Field(..., description=\"发生时刻 HH:MM:SS\")","     ts: float = Field(..., description=\"发生时刻的 Unix 时间戳(秒)\")","-    kind: str = Field(..., description=\"task_start/box_start/card/text/code_scanned/destination/stored/discarded/lost/retrieved/pit_empty/stocktake/waiting_box/fault/needs_human/paused/resumed/pause_requested/stop_requested/abort_requested/aborted/box_end/task_end\")","+    kind: str = Field(..., description=\"task_start/box_start/card/text/code_scanned/destination/stored/discarded/lost/retrieved/outbound_scanned/pit_empty/stocktake/waiting_box/fault/needs_human/paused/resumed/pause_requested/stop_requested/abort_requested/aborted/box_end/task_end\")","     box_seq: Optional[int] = Field(None, description=\"第几盒