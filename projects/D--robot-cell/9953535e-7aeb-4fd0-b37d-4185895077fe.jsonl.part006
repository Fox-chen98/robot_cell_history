in); return\r","         if a.get(\"arm\") and not messagebox.askyesno(\"会动真机\", \"这个动作会让机械臂运动!\\n\\n确认: 周围没有人、急停可随时按下。\\n继续吗?\", parent=self.win):\r","             return\r","+        if a.get(\"idle\"):\r","+            why = device_busy()\r","+            if why:\r","+                messagebox.showwarning(\"设备忙\", why, parent=self.win); return\r","         if a.get(\"confirm\") and not messagebox.askyesno(\"确认\", a[\"confirm\"], parent=self.win):\r","             return\r","-        sub = {\"{py}\": PY, \"{ts}\": datetime.datetime.now().strftime(\"%Y%m%d_%H%M\"), \"{baseline}\": C.BASELINE}\r","+        sub = {\"{py}\": PY, \"{ts}\": datetime.datetime.now().strftime(\"%Y%m%d_%H%M\"), \"{baseline}\": C.BASELINE,\r","+               \"{feeder_com}\": str(knob(\"feeder\", \"com\", \"COM14\"))}\r","         cmd = []\r","         for x in a[\"cmd\"]:\r","             for k, v in sub.items():\r"]},{"oldStart":235,"oldLines":9,"newStart":261,"newLines":9,"lines":["         self.out.delete(\"1.0\", \"end\")\r","         self._log(\"▶ %s\\n  %s\\n\\n\" % (a[\"label\"], \" \".join(cmd[2:] if cmd[0] == PY else cmd)), \"dim\")\r","         self.stop_b.configure(state=\"normal\")\r","-        threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\")), daemon=True).start()\r","+        threading.Thread(target=self._worker, args=(cmd, a.get(\"camera\"), a.get(\"open_after\")), daemon=True).start()\r"," \r","-    def _worker(self, cmd, camera):\r","+    def _worker(self, cmd, camera, open_after=None):\r","         ui = lambda f, *x: self.q.put((f, x))\r","         try:\r","             if camera:"]}]}],"moreFiles":0,"changedFiles":["D:\\robot_cell\\services\\toolbox_catalog.py","D:\\robot_cell\\services\\toolbox_gui.py"]}},"serverClassifierContext":{"request":"907257db-43f5-49d5-8874-42b763154a67","context":{"git_state":{"cwd":"/d/robot_cell","root":"/d/robot_cell","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":