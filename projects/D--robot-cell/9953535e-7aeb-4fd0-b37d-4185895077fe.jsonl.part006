,"-rem Windows service body (2026-10-28). WinSW runs \"cmd /c svc_run.bat <name>\" as Windows service RobotCell<Name> (no console window, starts at boot without logon).","-rem   python output is appended to logs\\<name>_service.log (same file as the old run_service.bat loop).","-rem   exit code tells Windows what to do next:","-rem     exit 1 = any unexpected end (crash / killed / os._exit) -> service failure -> SCM restarts it in 5s (failure actions, unlimited)","-rem     exit 0 = logs\\hold_<name>.flag present (svc.bat stop / vision_service.sh stop / camera tools) -> service stays stopped","-rem   do NOT change the final \"exit 1\" to 0: WinSW reports code 0 as a clean stop and Windows will not restart the service.","-setlocal","-set NAME=%1","-set PY=C:\\Users\\26293\\.conda\\envs\\robot\\python.exe","-cd /d D:\\Destop\\robot_cell","-if not exist logs mkdir logs","-set PYTHONIOENCODING=utf-8","-if \"%NAME%\"==\"vision\" set SCRIPT=services\\vision_server.py","-if \"%NAME%\"==\"cell\"   set SCRIPT=services\\cell_server.py","-if \"%NAME%\"==\"upper\"  set SCRIPT=services\\upper_server.py","-if \"%SCRIPT%\"==\"\" ( echo unknown service %NAME% & exit 1 )","-if exist logs\\hold_%NAME%.flag ( echo [%date% %time%] %NAME% hold flag present, service not started >> logs\\%NAME%_service.log & exit 0 )","-echo [%date% %time%] start %NAME% (windows service) >> logs\\%NAME%_service.log","-%PY% -u %SCRIPT% >> logs\\%NAME%_service.log 2>&1","-set RC=%errorlevel%","-echo [%date% %time%] %NAME% exited rc=%RC% >> logs\\%NAME%_service.log","-if exist logs\\hold_%NAME%.flag ( echo [%date% %time%] hold flag present, service stays stopped >> logs\\%NAME%_service.log & exit 0 )","-echo [%date% %time%] windows will restart %NAME% in 5s >> logs\\%NAME%_service.log","-exit 1","+@echo off\r","+rem Windows service body (2026-10-28). WinSW runs \"cmd /c svc_run.bat <name>\" as Windows service RobotCell<Name> (no console window, starts at boot without logon).\r","+rem   python output is appended to logs\\<name>_service.log (same file as the old run_service.bat loop).\r","+rem   exit code tells Windows what to do next:\r","+rem     exit 1 = any unexpected end (crash / killed / os._exit) -> service failure -> SCM restarts it in 5s (failure actions, unlimited)\r","+rem     exit 0 = logs\\hold_<name>.flag present (svc.bat stop / vision_service.sh stop / camera tools) -> service stays stopped\r","+rem   do NOT change the final \"exit 1\" to 0: WinSW reports code 0 as a clean stop and Windows will not restart the service.\r","+setlocal\r","+set NAME=%1\r","+set PY=C:\\Users\\26293\\.conda\\envs\\robot\\python.exe\r","+cd /d D:\\Destop\\robot_cell\r","+if not exist logs mkdir logs\r","+set PYTHONIOENCODING=utf-8\r","+if \"%NAME%\"==\"vision\" set SCRIPT=services\\vision_server.py\r","+if \"%NAME%\"==\"cell\"   set SCRIPT=services\\cell_server.py\r","+if \"%NAME%\"==\"upper\"  set SCRIPT=services\\upper_server.py\r","+if \"%SCRIPT%\"==\"\" ( echo unknown service %NAME% & exit 1 )\r","+if exist logs\\hold_%NAME%.flag ( echo [%date% %time%] %NAME% hold flag present, service not started >> logs\\%NAME%_service.log & exit 0 )\r","+echo [%date% %time%] start %NAME% (windows service) >> logs\\%NAME%_service.log\r","+%PY% -u %SCRIPT% >> logs\\%NAME%_service.log 2>&1\r","+set RC=%errorlevel%\r","+echo [%date% %time%] %NAME% exited rc=%RC% >> logs\\%NAME%_service.log\r","+if exist logs\\hold_%NAME%.flag ( echo [%date% %time%] hold flag present, service stays stopped >> logs\\%NAME%_service.log & exit 0 )\r","+echo [%date% %time%] windows will restart %NAME% in 5s >> logs\\%NAME%_service.log\r","+exit 1\r"]}]},{"filePath":"/Users/chen/Desktop/robocenter/scripts/bluespace/services/winsw/RobotCellCell.xml","hunks":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":7,"lines":[" <service>","   <id>RobotCellCell</id>","   <name>RobotCell Cell (8902)</name>","-  <description>robot_cell cell service, port 8902: cell_server.py (workstation API for the upper computer, tasks, webh