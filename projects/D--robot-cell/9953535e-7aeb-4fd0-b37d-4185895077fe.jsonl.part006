axis\n\n\t\tconst centerLength = Math.max( sideLength - 2","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/chen/Desktop/robocenter/docs/首页效果图/lib/RoundedBoxGeometry.js","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":140,"lines":["+( function () {","+","+\tconst _tempNormal = new THREE.Vector3();","+","+\tfunction getUv( faceDirVector, normal, uvAxis, projectionAxis, radius, sideLength ) {","+","+\t\tconst totArcLength = 2 * Math.PI * radius / 4; // length of the planes between the arcs on each axis","+","+\t\tconst centerLength = Math.max( sideLength - 2 * radius, 0 );","+\t\tconst halfArc = Math.PI / 4; // Get the vector projected onto the Y plane","+","+\t\t_tempNormal.copy( normal );","+","+\t\t_tempNormal[ projectionAxis ] = 0;","+","+\t\t_tempNormal.normalize(); // total amount of UV space alloted to a single arc","+","+","+\t\tconst arcUvRatio = 0.5 * totArcLength / ( totArcLength + centerLength ); // the distance along one arc the point is at","+","+\t\tconst arcAngleRatio = 1.0 - _tempNormal.angleTo( faceDirVector ) / halfArc;","+","+\t\tif ( Math.sign( _tempNormal[ uvAxis ] ) === 1 ) {","+","+\t\t\treturn arcAngleRatio * arcUvRatio;","+","+\t\t} else {","+","+\t\t\t// total amount of UV space alloted to the plane between the arcs","+\t\t\tconst lenUv = centerLength / ( totArcLength + centerLength );","+\t\t\treturn lenUv + arcUvRatio + arcUvRatio * ( 1.0 - arcAngleRatio );","+","+\t\t}","+","+\t}","+","+\tclass RoundedBoxGeometry extends THREE.BoxGeometry {","+","+\t\tconstructor( width = 1, height = 1, depth = 1, segments = 2, radius = 0.1 ) {","+","+\t\t\t// ensure segments is odd so we have a plane connecting the rounded corners","+\t\t\tsegments = segments * 2 + 1; // ensure radius isn't bigger than shortest side","+","+\t\t\tradius = Math.min( width / 2, height / 2, depth / 2, radius );","+\t\t\tsuper( 1, 1, 1, segments, segments, segments ); // if we just have one segment we're the same as a regular box","+","+\t\t\tif ( segments === 1 ) return;","+\t\t\tconst geometry2 = this.toNonIndexed();","+\t\t\tthis.index = null;","+\t\t\tthis.attributes.position = geometry2.attributes.position;","+\t\t\tthis.attributes.normal = geometry2.attributes.normal;","+\t\t\tthis.attributes.uv = geometry2.attributes.uv; //","+","+\t\t\tconst position = new THREE.Vector3();","+\t\t\tconst normal = new THREE.Vector3();","+\t\t\tconst box = new THREE.Vector3( width, height, depth ).divideScalar( 2 ).subScalar( radius );","+\t\t\tconst positions = this.attributes.position.array;","+\t\t\tconst normals = this.attributes.normal.array;","+\t\t\tconst uvs = this.attributes.uv.array;","+\t\t\tconst faceTris = positions.length / 6;","+\t\t\tconst faceDirVector = new THREE.Vector3();","+\t\t\tconst halfSegmentSize = 0.5 / segments;","+","+\t\t\tfor ( let i = 0, j = 0; i < positions.length; i += 3, j += 2 ) {","+","+\t\t\t\tposition.fromArray( positions, i );","+\t\t\t\tnormal.copy( position );","+\t\t\t\tnormal.x -= Math.sign( normal.x ) * halfSegmentSize;","+\t\t\t\tnormal.y -= Math.sign( normal.y ) * halfSegmentSize;","+\t\t\t\tnormal.z -= Math.sign( normal.z ) * halfSegmentSize;","+\t\t\t\tnormal.normalize();","+\t\t\t\tpositions[ i + 0 ] = box.x * Math.sign( position.x ) + normal.x * radius;","+\t\t\t\tpositions[ i + 1 ] = box.y * Math.sign( position.y ) + normal.y * radius;","+\t\t\t\tpositions[ i + 2 ] = box.z * Math.sign( position.z ) + normal.z * radius;","+\t\t\t\tnormals[ i + 0 ] = normal.x;","+\t\t\t\tnormals[ i + 1 ] = normal.y;","+\t\t\t\tnormals[ i + 2 ] = normal.z;","+\t\t\t\tconst side = Math.floor( i / faceTris );","+","+\t\t\t\tswitch ( side ) {","+","+\t\t\t\t\tcase 0:","+\t\t\t\t\t\t// right","+\t\t\t\t\t\t// generate UVs along Z then Y","+\t\t\t\t\t\tfaceDirVector.set( 1, 0, 0 );","+\t\t\t\t\t\tuvs[ j + 0 ] = getUv( faceDirVector, normal, 'z', 'y', radius, depth );","+\t\t\t\t\t\tuvs[ j + 1 ] = 1.0 - getUv( faceDirVector, normal, 'y', 'z', radius, height );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t\tcase 1:","+\t\t\t\t\t\t// left","+\t\t\t\t\t\t// generate UVs along Z then Y","+\t\t\t\t\t\tfaceDirVector.set( - 1, 0, 0 );","+\t\t\t\t\t\tuvs[ j + 0 ] = 1.0 - getUv( faceDirVector, normal, 'z', 'y', radius, depth );","+\t\t\t\t\t\tuvs[ j + 1 ] = 1.0 - getUv( faceDirVector, normal, 'y', 'z', radius, height );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t\tcase 2:","+\t\t\t\t\t\t// top","+\t\t\t\t\t\t// generate UVs along X then Z","+\t\t\t\t\t\tfaceDirVector.set( 0, 1, 0 );","+\t\t\t\t\t\tuvs[ j + 0 ] = 1.0 - getUv( faceDirVector, normal, 'x', 'z', radius, width );","+\t\t\t\t\t\tuvs[ j + 1 ] = getUv( faceDirVector, normal, 'z', 'x', radius, depth );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t\tcase 3:","+\t\t\t\t\t\t// bottom","+\t\t\t\t\t\t// generate UVs along X then Z","+\t\t\t\t\t\tfaceDirVector.set( 0, - 1, 0 );","+\t\t\t\t\t\tuvs[ j + 0 ] = 1.0 - getUv( faceDirVector, normal, 'x', 'z', radius, width );","+\t\t\t\t\t\tuvs[ j + 1 ] = 1.0 - getUv( faceDirVector, normal, 'z', 'x', radius, depth );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t\tcase 4:","+\t\t\t\t\t\t// front","+\t\t\t\t\t\t// generate UVs along X then Y","+\t\t\t\t\t\tfaceDirVector.set( 0, 0, 1 );","+\t\t\t\t\t\tuvs[ j + 0 ] = 1.0 - getUv( faceDirVector, normal, 'x', 'y', radius, width );","+\t\t\t\t\t\tuvs[ j + 1 ] = 1.0 - getUv( faceDirVector, normal, 'y', 'x', radius, height );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t\tcase 5:","+\t\t\t\t\t\t// back","+\t\t\t\t\t\t// generate UVs along X then Y","+\t\t\t\t\t\tfaceDirVector.set( 0, 0, - 1 );","+\t\t\t\t\t\tuvs[ j + 0 ] = getUv( faceDirVector, normal, 'x', 'y', radius, width );","+\t\t\t\t\t\tuvs[ j + 1 ] = 1.0 - getUv( faceDirVector, normal, 'y', 'x', radius, height );","+\t\t\t\t\t\tbreak;","+","+\t\t\t\t}","+","+\t\t\t}","+","+\t\t}","+","+\t}","+","+\tTHREE.RoundedBoxGeometry = RoundedBoxGeometry;","+","+} )();"]}],"created":true}],"moreFiles":2,"changedFiles":["/Users/chen/Desktop/robocenter/docs/首页效果图/lib/O