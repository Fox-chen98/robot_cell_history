{"type":"api-request-blob","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","hash":"2f539c4873baf93dbfd0fe71217b6730278f4aff8bcf0a02562fed5bdd1ad89f","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_019sRHM9BSXyvEpMJF7CqKD8","name":"Bash","input":{"command":"cd /Users/chen/Desktop/robocenter/scripts/bluespace && python3 - <<'EOF'\np='services/webhook.py'\ns=open(p,encoding='utf-8').read()\nold='''def _ping():\n    \"\"\"启动自检: 发一条 kind=ping, 让 GET /device 能报出地址配错/口令不对, 而不是默默失败。\"\"\"\n    time.sleep(1.0)\n    t0 = time.time()\n    ok, info = _deliver({\"task_id\": 0, \"seq\": 0, \"kind\": \"ping\", \"t\": time.strftime(\"%H:%M:%S\"),\n                         \"ts\": round(time.time(), 3), \"text\": \"设备启动自检\"}, \"0-0\")\n    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, (time.time() - t0) * 1000))\n    with _LOCK:\n        if ok:\n            _ST[\"state\"] = \"ok\"\n            _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n        else:\n            _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n            _ST[\"last_error\"] = \"启动自检失败(%s): 检查 config/upper_link.yaml 的 upper/webhook(当前目标 %s)\" % (info, target_url())\n    print(\"[webhook] 启动自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)\n'''\nnew='''RECHECK_S = 30.0   # 状态不正常时多久重新自检一次\n\n\ndef _ping_once(why):\n    t0 = time.time()\n    ok, info = _deliver({\"task_id\": 0, \"seq\": 0, \"kind\": \"ping\", \"t\": time.strftime(\"%H:%M:%S\"),\n                         \"ts\": round(time.time(), 3), \"text\": why}, \"0-0\")\n    return ok, info, (time.time() - t0) * 1000\n\n\ndef _ping():\n    \"\"\"启动自检 + 不正常时每 30 秒重检(2026-10-29)。\n    为什么要重检: 原来只在启动时自检一次, 之后要等真有事件推成功状态才变回 ok。开机时设备服务(Windows 服务, 不等登录)\n    总比 CRV 先起来 → 自检必败 → 控制台一直显示\"异常\", 实际早就能推了, 现场会误以为出故障。\n    规则: 只在 state 不是 ok 且送信队列空闲(没有待发/在发)时才 ping, 不和真实事件抢; webhook_out.log 只记首次与结果变化, 不每 30 秒刷一行。\"\"\"\n    time.sleep(1.0)\n    ok, info, ms = _ping_once(\"设备启动自检\")\n    _out(\"0-0 ping -> %s %.0fms (startup selfcheck)\" % (info, ms))\n    last = ok\n    while True:\n        with _LOCK:\n            if ok:\n                _ST[\"state\"] = \"ok\"\n                _ST[\"last_ok_at\"] = time.strftime(\"%H:%M:%S\")\n            elif info is not None:\n                _ST[\"state\"] = \"unauthorized\" if info == \"HTTP 401\" else \"unreachable\"\n                _ST[\"last_error\"] = \"自检失败(%s, 每%.0f秒重试): 检查上位机是否已打开, 及 config/upper_link.yaml 的 upper/webhook(当前目标 %s)\" % (info, RECHECK_S, target_url())\n        if info is not None and ok != last:\n            print(\"[webhook] 自检: %s (%s)\" % (\"通\" if ok else \"不通\", info), flush=True)\n        if info is not None:\n            last = ok\n        time.sleep(RECHECK_S)\n        ok, info = True, None                               # 默认本轮不 ping(状态正常或队列忙)\n        busy = _ST.get(\"inflight\") or (_Q is not None and _Q.qsize() > 0)\n        if _ST.get(\"state\") != \"ok\" and not busy:\n            ok, info, ms = _ping_once(\"设备重检(状态不正常时每%.0f秒一次)\" % RECHECK_S)\n            if ok != last:\n                _out(\"0-0 ping -> %s %.0fms (recheck, %s)\" % (info, ms, \"恢复\" if ok else \"又断了\"))\n'''\nassert old in s; s=s.replace(old,new,1)\nopen(p,'w',encoding='utf-8').write(s)\nEOF\npython3 -m py_compile services/webhook.py flows/store_one_box.py services/cell_server.py && echo ok; grep -n \"_ping, name\" services/webhook.py","description":"推送模块加状态异常时每30秒重新自检"},"caller":{"type":"direct"}}]}}
