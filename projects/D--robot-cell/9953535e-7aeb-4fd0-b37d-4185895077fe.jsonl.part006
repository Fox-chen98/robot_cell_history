     except Exception:\n            return None\n\n    def _bc_joints(self):\n        try:\n            return [float(x) for x in self._cobot.get_actual_joints_position()]\n        except Exception:\n            return None\n\n    def _bc_movel(self, pose, block, tool, wobj, read_pose):\n        bc = self._bc()\n        if bc is None:\n            return\n        try:\n            prev = bc.last_pending_movel()\n            start = prev if prev is not None else (read_pose().to_list() if read_pose() else None)\n            bc.push(\"movel\", self._bc_joints(), chained=prev is not None, start_pose=start, target_pose=pose.to_list(),\n                    tool=tool, wobj=wobj, pending=not block)\n        except Exception:\n            pass\n\n''' + a,1)\n# move_joint\na='''        try:\n            # movej2: 速度单位 rad/s，加速度单位 rad/s^2，融合半径 0\n            result = self._cobot.movej2('''\nassert a in s\ns=s.replace(a,'''        bc = self._bc()\n        if bc: bc.push(\"movej\", self._bc_joints(), target_j=[float(x) for x in joints], pending=not block)\n        try:\n            # movej2: 速度单位 rad/s，加速度单位 rad/s^2，融合半径 0\n            result = self._cobot.movej2(''')\n# move_linear (当前工具)\na='''        try:\n            # movel: p, v, a, r, q_near, tool, wobj, block, op, def_acc\n            result = self._cobot.movel(\n                pose.to_list(),\n                velocity,\n                acceleration,\n                0,      # 融合半径'''\nassert s.count(a)==1, s.count(a)\ns=s.replace(a,'''        self._bc_movel(pose, block, \"\", \"\", self.get_tcp_pose)\n        try:\n            # movel: p, v, a, r, q_near, tool, wobj, block, op, def_acc\n            result = self._cobot.movel(\n                pose.to_list(),\n                velocity,\n                acceleration,\n                0,      # 融合半径''')\n# move_joint_to_pose\na='''        try:\n            # movej_pose2: p, v, a, r, q_near, tool, wobj, block, op, def_acc\n            result = self._cobot.movej_pose2('''\nassert a in s\ns=s.replace(a,'''        bc = self._bc()\n        if bc: bc.push(\"movej\", self._bc_joints(), target_pose=pose.to_list(), tool=tool, wobj=wobj, pending=not block)\n        try:\n            # movej_pose2: p, v, a, r, q_near, tool, wobj, block, op, def_acc\n            result = self._cobot.movej_pose2(''')\na='''            if not success:\n                print(f\"[DucoCobot] 关节运动到位姿失败，返回码: {result}\")\n            return success'''\nassert a in s\ns=s.replace(a,'''            if not success:\n                print(f\"[DucoCobot] 关节运动到位姿失败，返回码: {result}\")\n            elif block and bc:                     # 目标只给了位姿: 走完补记目标关节, 倒回时据此核对\"在不在这段上\"\n                bc.set_last(target_j=self._bc_joints())\n            return success''')\nopen(p,\"w\",encoding=\"utf-8\").write(s)\nEOF\ngrep -n \"def move_linear_with_tool\" -A45 hardware/robot_arm/ducocobot.py | grep -n \"try:\\|movel(\" | head -4","description":"在关节运动、直线运动、按位姿运动中加入记脚印"},"caller":{"type":"direct"}}]}}
