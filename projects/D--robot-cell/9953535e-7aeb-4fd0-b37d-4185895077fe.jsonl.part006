{"parentUuid":"21b41e35-59dc-420c-b164-092c4159f1c1","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgVfhQW7aTCzfjUtg4x2f","type":"message","role":"assistant","content":[{"type":"text","text":"前提都满足：设备上的 Python 自带界面库，也有不弹窗口的 `pythonw`。开始写界面程序。"}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2461,"cache_read_input_tokens":295408,"output_tokens":7993,"output_tokens_details":{"thinking_tokens":609},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2461,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":7993,"cache_read_input_tokens":295408,"cache_creation_input_tokens":2461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2461},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"f2faf285-7992-487c-96cd-6b5f7221ac4d","apiBlockIndex":1,"requestId":"req_011CgVfhPuPrpdCvcocVEErC","requestRef":"cdca4395-7dbe-403a-8f05-7fc4f00dfd7d","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"6c407406-3719-4cc6-8ce1-e500aa7cbd7f","timestamp":"2026-10-29T01:34:12.555Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"e3658006-fd31-4b0f-afb2-07a88a71385d","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.312","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
{"parentUuid":"6c407406-3719-4cc6-8ce1-e500aa7cbd7f","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgVfhQW7aTCzfjUtg4x2f","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WTRDiAhA7n8NWphwT9uCoe","name":"Write","input":{"file_path":"/Users/chen/Desktop/robocenter/scripts/bluespace/services/console_gui.py","content":"# -*- coding: utf-8 -*-\n\"\"\"设备控制台(图形界面版, 2026-10-29): blue-space 桌面\"设备控制台\"图标打开的窗口, 给现场使用者用, 不需要懂命令行。\n取代 PowerShell 菜单版 device_console.ps1(旧版保留备用)。\n\n显示: 四个服务(运行/停止 + Windows 服务状态) / CRV 上位机是否在运行 / 机械臂状态 / 扫码实时记录 / 各服务日志。\n操作: 重启单个或全部服务 / 机械臂复位(输入\"是\"确认) / 打开设备网页 / 接口调试页。\n\n设计要点:\n - 只读端口、日志文件和工作站接口, 自己不托管任何服务: 窗口随便开关, 服务不受影响(扫码服务仍在后台桌面会话里跑, 这里只显示它的日志)。\n - 工作站服务挂了也能用: 服务状态直接探端口 + sc query, 重启走接口失败时退回 svc.bat start(清 hold 旗 + 触发看门狗计划任务)。\n - 重启走工作站接口 POST /services/<名>/restart: 视觉/工作站/上位机后端是系统账户的 Windows 服务, 普通权限的本窗口杀不动它们。\n - 用 pythonw 启动(无黑窗口); 调外部命令一律 CREATE_NO_WINDOW, 否则每次刷新闪一下黑框。\n - 单实例: 绑定 127.0.0.1:8911, 已有窗口在开就不再开第二个。\n源: robocenter 仓库 scripts/bluespace/services/console_gui.py, deploy_cell.sh 推到 D:\\\\Destop\\\\robot_cell\\\\services\\\\\n\"\"\"\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport threading\nimport time\nimport tkinter as tk\nimport urllib.request\nimport webbrowser\nfrom tkinter import messagebox, simpledialog, ttk\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nAPI = \"http://127.0.0.1:8902\"\nSVC_BAT = os.path.join(ROOT, \"services\", \"svc.bat\")\nCRV_CONF = r\"C:\\Users\\26293\\AppData\\Roaming\\my-react-app\\local-runtime\\application-standalone.properties\"\nNOWIN = 0x08000000  # CREATE_NO_WINDOW\nSERVICES = [(\"vision\", \"视觉服务\", 8900, \"RobotCellVision\"), (\"scan\", \"扫码服务\", 8901, None),\n            (\"cell\", \"工作站服务\", 8902, \"RobotCellCell\"), (\"upper\", \"上位机后端\", 8903, \"RobotCellUpper\")]\nSTATE_CN = {\"idle\": \"空闲\", \"busy\": \"执行任务中\", \"offline\": \"离线(连不上机械臂)\", \"needs_human\": \"需要人工处理\",\n            \"estop\": \"急停\", \"paused\": \"已暂停\", \"not_ready\": \"未就绪\", \"unknown\": \"未知\"}\nLOGS = [(\"工作站日志\", \"cell_service.log\"), (\"视觉日志\", \"vision_service.log\"), (\"扫码原始日志\", \"scan_service.log\"),\n        (\"上位机后端日志\", \"upper_service.log\"), (\"看门狗\", \"ensure.log\")]\nFONT = \"Microsoft YaHei UI\"\nGREEN, RED, AMBER, GRAY, BLUE = \"#1a7f37\", \"#cf222e\", \"#bf8700\", \"#57606a\", \"#0969da\"\n\n\ndef api(path, method=\"GET\", timeout=5):\n    req = urllib.request.Request(API + path, method=method, data=b\"\" if method == \"POST\" else None)\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef port_open(p):\n    try:\n        with socket.create_connection((\"127.0.0.1\", p), timeout=0.3):\n            return True\n    except Exception:\n        return False\n\n\ndef svc_state(name):\n    \"\"\"Windows 服务状态: RUNNING/STOPPED/...; 没装返回 None。sc 输出随系统语言变, 只认英文状态词\"\"\"\n    try:\n        out = subprocess.run([\"sc\", \"query\", name], capture_output=True, timeout=5, creationflags=NOWIN).stdout.decode(\"gbk\", \"replace\")\n        m = re.search(r\"\\b(RUNNING|STOPPED|START_PENDING|STOP_PENDING|PAUSED)\\b\", out)\n        return m.group(1) if m else None\n    except Exception:\n        return None\n\n\ndef crv_port():\n    try:\n        for ln in open(CRV_CONF, encoding=\"utf-8\", errors=\"replace\"):\n            m = re.match(r\"\\s*server\\.port\\s*=\\s*(\\d+)\", ln)\n            if m:\n                return int(m.group(1))\n    except Exception:\n        pass\n    return 8080\n\n\ndef tail(path, nbytes=96 * 1024):\n    try:\n        with open(path, \"rb\") as f:\n            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - nbytes))\n            data = f.read()\n        txt = data.decode(\"utf-8\", \"replace\")\n        if size > nbytes:\n            txt = txt.split(\"\\n\", 1)[-1]\n        return size, txt\n    except Exception:\n        return -1, \"(还没有这个日志文件)\"\n\n\nclass Console:\n    def __init__(self, root):\n        self.root = root\n        root.title(\"货架机器人 设备控制台\")\n        root.geometry(\"1100x760\")\n        root.minsize(900, 600)\n        st = ttk.Style()\n        try: st.theme_use(\"vista\")\n        except Exception: pass\n        st.configure(\".\", font=(FONT, 10))\n        st.configure(\"Title.TLabel\", font=(FONT, 15, \"bold\"))\n        st.configure(\"H.TLabel\", font=(FONT, 11, \"bold\"))\n        st.configure(\"Big.TButton\", font=(FONT, 10), padding=6)\n        self.data = {\"svc\": {}, \"dev\": None, \"crv\": (8080, False), \"ts\": 0}\n        self.busy_op = False\n        self._build()\n        threading.Thread(target=self._poll_loop, daemon=True).start()\n        self._log_sizes = {}\n        self.root.after(500, self._refresh_ui)\n        self.root.after(800, self._refresh_logs)\n\n    # ── 界面 ──\n    def _build(self):\n        top = ttk.Frame(self.root, padding=(16, 12, 16, 4)); top.pack(fill=\"x\")\n        ttk.Label(top, text=\"货架机器人 设备控制台\", style=\"Title.TLabel\").pack(side=\"left\")\n        self.clock = ttk.Label(top, foreground=GRAY); self.clock.pack(side=\"right\")\n\n        mid = ttk.Frame(self.root, padding=(16, 4)); mid.pack(fill=\"x\")\n        # 服务\n        sf = ttk.LabelFrame(mid, text=\" 服务 \", padding=10); sf.pack(side=\"left\", fill=\"both\", expand=True, padx=(0, 8))\n        self.svc_rows = {}\n        for i, (key, cn, port, _) in enumerate(SERVICES):\n            dot = tk.Label(sf, text=\"●\", font=(FONT, 14), fg=GRAY); dot.grid(row=i, column=0, padx=(0, 6))\n            ttk.Label(sf, text=cn, width=10).grid(row=i, column=1, sticky=\"w\")\n            ttk.Label(sf, text=\":%d\" % port, foreground=GRAY, width=6).grid(row=i, column=2, sticky=\"w\")\n            st = ttk.Label(sf, text=\"…\", width=22); st.grid(row=i, column=3, sticky=\"w\")\n            b = ttk.Button(sf, text=\"重启\", width=6, command=lambda k=key: self.restart([k])); b.grid(row=i, column=4, padx=4, pady=2)\n            self.svc_rows[key] = (dot, st)\n        i = len(SERVICES)\n        self.crv_dot = tk.Label(sf, text=\"●\", font=(FONT, 14), fg=GRAY); self.crv_dot.grid(row=i, column=0, padx=(0, 6), pady=(6, 0))\n        ttk.Label(sf, text=\"CRV上位机\", width=10).grid(row=i, column=1, sticky=\"w\", pady=(6, 0))\n        self.crv_lbl = ttk.Label(sf, text=\"…\"); self.crv_lbl.grid(row=i, column=2, columnspan=3, sticky=\"w\", pady=(6, 0))\n\n        # 设备\n        df = ttk.LabelFrame(mid, text=\" 机械臂 \", padding=10); df.pack(side=\"left\", fill=\"both\", expand=True)\n        self.dev_lbl = {}\n        for i, (k, cn) in enumerate([(\"state\", \"状态\"), (\"detail\", \"控制器\"), (\"arm_at\", \"位置\"), (\"payload\", \"手上\"),\n                                     (\"mode\", \"模式\"), (\"task\", \"当前任务\"), (\"webhook\", \"事件推送\")]):\n            ttk.Label(df, text=cn, foreground=GRAY, width=8).grid(row=i, column=0, sticky=\"nw\", pady=1)\n            l = tk.Label(df, text=\"…\", font=(FONT, 10), anchor=\"w\", justify=\"left\", wraplength=380)\n            l.grid(row=i, column=1, sticky=\"w\", pady=1); self.dev_lbl[k] = l\n\n        # 操作\n        bar = ttk.Frame(self.root, padding=(16, 8)); bar.pack(fill=\"x\")\n        ttk.Button(bar, text=\"重启全部服务\", style=\"Big.TButton\", command=lambda: self.restart([\"vision\", \"scan\", \"upper\", \"cell\"])).pack(side=\"left\")\n        ttk.Button(bar, text=\"机械臂复位\", style=\"Big.TButton\", command=self.reset).pack(side=\"left\", padx=8)\n        ttk.Button(bar, text=\"设备网页\", style=\"Big.TButton\", command=lambda: webbrowser.open(API + \"/upper\")).pack(side=\"left\")\n        ttk.Button(bar, text=\"接口调试\", style=\"Big.TButton\", command=lambda: webbrowser.open(API + \"/docs\")).pack(side=\"left\", padx=8)\n        self.msg = ttk.Label(bar, foreground=BLUE); self.msg.pack(side=\"left\", padx=12)\n\n        # 扫码 + 日志\n        nb = ttk.Notebook(self.root); nb.pack(fill=\"both\", expand=True, padx=16, pady=(0, 14))\n        self.texts = {}\n        for title, fname in [(\"扫码记录\", None)] + LOGS:\n            fr = ttk.Frame(nb); nb.add(fr, text=\"  %s  \" % title)\n            t = tk.Text(fr, font=(\"Consolas\", 10), wrap=\"none\", bg=\"#f6f8fa\", relief=\"flat\", padx=8, pady=6)\n            ys = ttk.Scrollbar(fr, orient=\"vertical\", command=t.yview); t.configure(yscrollcommand=ys.set)\n            ys.pack(side=\"right\", fill=\"y\"); t.pack(fill=\"both\", expand=True)\n            t.tag_configure(\"ok\", foreground=GREEN); t.tag_configure(\"bad\", foreground=RED); t.tag_configure(\"dim\", foreground=GRAY)\n            t.configure(state=\"disabled\")\n            self.texts[title] = (t, fname)\n\n    # ── 后台采集(不卡界面) ──\n    def _poll_loop(self):\n        n = 0\n        while True:\n            svc = {}\n            for key, cn, port, sname in SERVICES:\n                prev = self.data[\"svc\"].get(key, {})\n                svc[key] = {\"up\": port_open(port), \"hold\": os.path.exists(os.path.join(ROOT, \"logs\", \"hold_%s.flag\" % key)),\n                            \"svc\": (svc_state(sname) if sname and n % 3 == 0 else prev.get(\"svc\")) if sname else \"计划任务\"}\n            try: dev = api(\"/device\", timeout=3)\n            except Exception: dev = None\n            cp = crv_port()\n            self.data.update(svc=svc, dev=dev, crv=(cp, port_open(cp)), ts=time.time())\n            n += 1\n            time.sleep(2)\n\n    def _refresh_ui(self):\n        self.clock.configure(text=time.strftime(\"%Y-%m-%d %H:%M:%S\"))\n        for key, (dot, st) in self.svc_rows.items():\n            s = self.data[\"svc\"].get(key)\n            if not s: continue\n            host = \"Windows服务\" if s[\"svc\"] not in (None, \"计划任务\") else (\"后台(桌面会话)\" if s[\"svc\"] == \"计划任务\" else \"\")\n            if s[\"up\"]:\n                dot.configure(fg=GREEN); st.configure(text=\"运行中  %s\" % host, foreground=GREEN)\n            elif s[\"hold\"]:\n                dot.configure(fg=AMBER); st.configure(text=\"已手动停止\", foreground=AMBER)\n            else:\n                dot.configure(fg=RED); st.configure(text=\"未运行(看门狗1分钟内会拉起)\", foreground=RED)\n        cp, up = self.data[\"crv\"]\n        self.crv_dot.configure(fg=GREEN if up else AMBER)\n        self.crv_lbl.configure(text=(\"运行中(端口 %d)\" % cp) if up else \"未运行 — 桌面双击「沈苏单机版CRV」打开\", foreground=GREEN if up else AMBER)\n\n        d = self.data[\"dev\"]; L = self.dev_lbl\n        if d is None:\n            for k in L: L[k].configure(text=\"—\", fg=GRAY)\n            L[\"state\"].configure(text=\"读不到(工作站服务没在运行)\", fg=RED)\n        else:\n            s = str(d.get(\"state\"))\n            L[\"state\"].configure(text=STATE_CN.get(s, s), fg=GREEN if s == \"idle\" else BLUE if s in (\"busy\", \"paused\") else RED)\n            L[\"detail\"].configure(text=d.get(\"detail\") or \"—\", fg=AMBER if (\"手动\" in str(d.get(\"detail\")) or \"⚠\" in str(d.get(\"detail\"))) else \"black\")\n            L[\"arm_at\"].configure(text=d.get(\"arm_at\") or \"—\", fg=\"black\")\n            pay = {\"none\": \"空手\", \"holding\": \"手上有盒\", \"unknown\": \"不确定\"}.get(str(d.get(\"payload\")), str(d.get(\"payload\")))\n            L[\"payload\"].configure(text=pay, fg=AMBER if d.get(\"payload\") == \"holding\" else \"black\")\n            sim = d.get(\"sim_mode\")\n            L[\"mode\"].configure(text=\"仿真模式(真机不会动!)\" if sim else \"真实模式\" if sim is False else \"—\", fg=AMBER if sim else \"black\")\n            L[\"task\"].configure(text=(\"#%s\" % d[\"task_id\"]) if d.get(\"task_id\") else \"无\", fg=BLUE if d.get(\"task_id\") else \"black\")\n            w = d.get(\"webhook\") or {}\n            if not w.get(\"enabled\"):\n                L[\"webhook\"].configure(text=\"未启用\", fg=GRAY)\n            else:\n                ok = w.get(\"state\") in (\"ok\", \"starting\")\n                L[\"webhook\"].configure(text=(\"正常\" if w.get(\"state\") == \"ok\" else \"启动中\" if ok else \"异常: %s\" % (w.get(\"last_error\") or w.get(\"state\"))) + \"  → \" + str(w.get(\"url\", \"\")),\n                                       fg=\"black\" if ok else RED)\n        self.root.after(1000, self._refresh_ui)\n\n    def _set_text(self, title, lines):\n        t, _ = self.texts[title]\n        at_end = t.yview()[1] > 0.98\n        t.configure(state=\"normal\"); t.delete(\"1.0\", \"end\")\n        for txt, tag in lines:\n            t.insert(\"end\", txt + \"\\n\", tag)\n        t.configure(state=\"disabled\")\n        if at_end: t.see(\"end\")\n\n    def _refresh_logs(self):\n        for title, (t, fname) in self.texts.items():\n            path = os.path.join(ROOT, \"logs\", fname or \"scan_service.log\")\n            size = os.path.getsize(path) if os.path.exists(path) else -1\n            if self._log_sizes.get(title) == size: continue\n            self._log_sizes[title] = size\n            _, txt = tail(path)\n            if fname is None:   # 扫码记录: 只挑扫到的码 / 交给任务的结果, 不显示轮询超时噪音\n                out = []\n                for ln in txt.splitlines():\n                    if \"[KeyboardScanner]\" in ln:\n                        out.append((ln.replace(\"[KeyboardScanner] \", \"\"), \"dim\" if \"code='\" in ln else \"ok\"))\n                    elif \"[扫码服务] scan ok\" in ln:\n                        out.append((ln.replace(\"[扫码服务] scan ok\", \"  → 已交给任务:\"), \"ok\"))\n                    elif \"[扫码服务] 启动\" in ln or \"[扫码服务] 就绪\" in ln or \"已退出\" in ln:\n                        out.append((ln, \"dim\"))\n                if not out: out = [(\"(还没有扫码记录)\", \"dim\")]\n                self._set_text(title, out[-300:])\n            else:\n                self._set_text(title, [(ln, \"bad\" if (\"Traceback\" in ln or \"Error\" in ln or \"FAIL\" in ln or \"失败\" in ln) else \"\") for ln in txt.splitlines()[-500:]])\n        self.root.after(2000, self._refresh_logs)\n\n    # ── 操作 ──\n    def _run_bg(self, label, fn):\n        if self.busy_op:\n            messagebox.showinfo(\"请稍候\", \"上一个操作还没做完\"); return\n        self.busy_op = True; self.msg.configure(text=label + \" …\")\n        def wrap():\n            try: res = fn()\n            except Exception as e: res = \"失败: %s\" % e\n            self.root.after(0, lambda: (self.msg.configure(text=res), setattr(self, \"busy_op\", False)))\n        threading.Thread(target=wrap, daemon=True).start()\n\n    def restart(self, keys):\n        d = self.data[\"dev\"]\n        if d and d.get(\"state\") == \"busy\" and set(keys) & {\"vision\", \"scan\", \"cell\"}:\n            if not messagebox.askyesno(\"确认\", \"设备正在执行任务 #%s, 重启服务会中断它。确定要重启吗?\" % d.get(\"task_id\")): return\n        names = \"、\".join(cn for k, cn, _, _ in SERVICES if k in keys)\n        def go():\n            fallback = []\n            for k in keys:   # 工作站放最后(它自己也是接口)\n                try: api(\"/services/%s/restart\" % k, \"POST\", timeout=70)\n                except Exception: fallback.append(k)\n            for k in fallback:\n                subprocess.run([\"cmd\", \"/c\", SVC_BAT, \"start\", k], capture_output=True, timeout=90, creationflags=NOWIN)\n            return \"已重启 %s(约 10~30 秒恢复)%s\" % (names, \"; 工作站接口不通, 已改为触发看门狗拉起\" if fallback else \"\")\n        self._run_bg(\"正在重启 \" + names, go)\n\n    def reset(self):\n        ans = simpledialog.askstring(\"机械臂复位\", \"复位会让真机沿原路退回到原点(home)!\\n\\n请确认:\\n  1. 机械臂周围没有人\\n  2. 急停已解除\\n  3. 控制器为自动模式\\n\\n确认请输入: 是\", parent=self.root)\n        if ans != \"是\": return\n        def go():\n            try:\n                r = api(\"/device/reset\", \"POST\", timeout=180)\n            except urllib.error.HTTPError as e:\n                body = e.read().decode(\"utf-8\", \"replace\")\n                return \"复位被拒: 有任务正在执行, 请先在上位机停止任务\" if \"busy\" in body else \"复位失败: HTTP %s %s\" % (e.code, body[:80])\n            msg = \"复位%s: %s  位置=%s\" % (\"成功\" if r.get(\"ok\") else \"失败(%s)\" % r.get(\"code\"), r.get(\"message\", \"\"), r.get(\"where\", \"\"))\n            if r.get(\"payload\") == \"holding\": msg += \"  ⚠ 手上还有一盒, 请人工取下或丢回\"\n            return msg\n        self._run_bg(\"复位中(最长约 1 分钟, 请勿离开)\", go)\n\n\ndef main():\n    lock = socket.socket()\n    try:\n        lock.bind((\"127.0.0.1\", 8911))\n    except OSError:\n        r = tk.Tk(); r.withdraw(); messagebox.showinfo(\"设备控制台\", \"设备控制台已经打开了(看看任务栏)\"); return\n    root = tk.Tk()\n    try: root.iconbitmap(default=\"\")\n    except Exception: pass\n    Console(root)\n    root.mainloop()\n\n\nif __name__ == \"__main__\":\n    import urllib.error  # noqa: F401  (reset 里捕获 HTTPError)\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2461,"cache_read_input_tokens":295408,"output_tokens":7993,"output_tokens_details":{"thinking_tokens":609},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2461,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":7993,"cache_read_input_tokens":295408,"cache_creation_input_tokens":2461,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2461},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01WTRDiAhA7n8NWphwT9uCoe":{"file_path":"/Users/chen/Desktop/robocenter/scripts/bluespace/services/console_gui.py","content":"# -*- coding: utf-8 -*-\n\"\"\"设备控制台(图形界面版, 2026-10-29): blue-space 桌面\"设备控制台\"图标打开的窗口, 给现场使用者用, 不需要懂命令行。\n取代 PowerShell 菜单版 device_console.ps1(旧版保留备用)。\n\n显示: 四个服务(运行/停止 + Windows 服务状态) / CRV 上位机是否在运行 / 机械臂状态 / 扫码实时记录 / 各服务日志。\n操作: 重启单个或全部服务 / 机械臂复位(输入\"是\"确认) / 打开设备网页 / 接口调试页。\n\n设计要点:\n - 只读端口、日志文件和工作站接口, 自己不托管任何服务: 窗口随便开关, 服务不受影响(扫码服务仍在后台桌面会话里跑, 这里只显示它的日志)。\n - 工作站服务挂了也能用: 服务状态直接探端口 + sc query, 重启走接口失败时退回 svc.bat start(清 hold 旗 + 触发看门狗计划任务)。\n - 重启走工作站接口 POST /services/<名>/restart: 视觉/工作站/上位机后端是系统账户的 Windows 服务, 普通权限的本窗口杀不动它们。\n - 用 pythonw 启动(无黑窗口); 调外部命令一律 CREATE_NO_WINDOW, 否则每次刷新闪一下黑框。\n - 单实例: 绑定 127.0.0.1:8911, 已有窗口在开就不再开第二个。\n源: robocenter 仓库 scripts/bluespace/services/console_gui.py, deploy_cell.sh 推到 D:\\\\Destop\\\\robot_cell\\\\services\\\\\n\"\"\"\nimport json\nimport os\nimport re\nimport socket\nimport subprocess\nimport sys\nimport threading\nimport time\nimport tkinter as tk\nimport urllib.request\nimport webbrowser\nfrom tkinter import messagebox, simpledialog, ttk\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nAPI = \"http://127.0.0.1:8902\"\nSVC_BAT = os.path.join(ROOT, \"services\", \"svc.bat\")\nCRV_CONF = r\"C:\\Users\\26293\\AppData\\Roaming\\my-react-app\\local-runtime\\application-standalone.properties\"\nNOWIN = 0x08000000  # CREATE_NO_WINDOW\nSERVICES = [(\"vision\", \"视觉服务\", 8900, \"RobotCellVision\"), (\"scan\", \"扫码服务\", 8901, None),\n            (\"cell\", \"工作站服务\", 8902, \"RobotCellCell\"), (\"upper\", \"上位机后端\", 8903, \"RobotCellUpper\")]\nSTATE_CN = {\"idle\": \"空闲\", \"busy\": \"执行任务中\", \"offline\": \"离线(连不上机械臂)\", \"needs_human\": \"需要人工处理\",\n            \"estop\": \"急停\", \"paused\": \"已暂停\", \"not_ready\": \"未就绪\", \"unknown\": \"未知\"}\nLOGS = [(\"工作站日志\", \"cell_service.log\"), (\"视觉日志\", \"vision_service.log\"), (\"扫码原始日志\", \"scan_service.log\"),\n        (\"上位机后端日志\", \"upper_service.log\"), (\"看门狗\", \"ensure.log\")]\nFONT = \"Microsoft YaHei UI\"\nGREEN, RED, AMBER, GRAY, BLUE = \"#1a7f37\", \"#cf222e\", \"#bf8700\", \"#57606a\", \"#0969da\"\n\n\ndef api(path, method=\"GET\", timeout=5):\n    req = urllib.request.Request(API + path, method=method, data=b\"\" if method == \"POST\" else None)\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return json.loads(r.read().decode(\"utf-8\"))\n\n\ndef port_open(p):\n    try:\n        with socket.create_connection((\"127.0.0.1\", p), timeout=0.3):\n            return True\n    except Exception:\n        return False\n\n\ndef svc_state(name):\n    \"\"\"Windows 服务状态: RUNNING/STOPPED/...; 没装返回 None。sc 输出随系统语言变, 只认英文状态词\"\"\"\n    try:\n        out = subprocess.run([\"sc\", \"query\", name], capture_output=True, timeout=5, creationflags=NOWIN).stdout.decode(\"gbk\", \"replace\")\n        m = re.search(r\"\\b(RUNNING|STOPPED|START_PENDING|STOP_PENDING|PAUSED)\\b\", out)\n        return m.group(1) if m else None\n    except Exception:\n        return None\n\n\ndef crv_port():\n    try:\n        for ln in open(CRV_CONF, encoding=\"utf-8\", errors=\"replace\"):\n            m = re.match(r\"\\s*server\\.port\\s*=\\s*(\\d+)\", ln)\n            if m:\n                return int(m.group(1))\n    except Exception:\n        pass\n    return 8080\n\n\ndef tail(path, nbytes=96 * 1024):\n    try:\n        with open(path, \"rb\") as f:\n            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - nbytes))\n            data = f.read()\n        txt = data.decode(\"utf-8\", \"replace\")\n        if size > nbytes:\n            txt = txt.split(\"\\n\", 1)[-1]\n        return size, txt\n    except Exception:\n        return -1, \"(还没有这个日志文件)\"\n\n\nclass Console:\n    def __init__(self, root):\n        self.root = root\n        root.title(\"货架机器人 设备控制台\")\n        root.geometry(\"1100x760\")\n        root.minsize(900, 600)\n        st = ttk.Style()\n        try: st.theme_use(\"vista\")\n        except Exception: pass\n        st.configure(\".\", font=(FONT, 10))\n        st.configure(\"Title.TLabel\", font=(FONT, 15, \"bold\"))\n        st.configure(\"H.TLabel\", font=(FONT, 11, \"bold\"))\n        st.configure(\"Big.TButton\", font=(FONT, 10), padding=6)\n        self.data = {\"svc\": {}, \"dev\": None, \"crv\": (8080, False), \"ts\": 0}\n        self.busy_op = False\n        self._build()\n        threading.Thread(target=self._poll_loop, daemon=True).start()\n        self._log_sizes = {}\n        self.root.after(500, self._refresh_ui)\n        self.root.after(800, self._refresh_logs)\n\n    # ── 界面 ──\n    def _build(self):\n        top = ttk.Frame(self.root, padding=(16, 12, 16, 4)); top.pack(fill=\"x\")\n        ttk.Label(top, text=\"货架机器人 设备控制台\", style=\"Title.TLabel\").pack(side=\"left\")\n        self.clock = ttk.Label(top, foreground=GRAY); self.clock.pack(side=\"right\")\n\n        mid = ttk.Frame(self.root, padding=(16, 4)); mid.pack(fill=\"x\")\n        # 服务\n        sf = ttk.LabelFrame(mid, text=\" 服务 \", padding=10); sf.pack(side=\"left\", fill=\"both\", expand=True, padx=(0, 8))\n        self.svc_rows = {}\n        for i, (key, cn, port, _) in enumerate(SERVICES):\n            dot = tk.Label(sf, text=\"●\", font=(FONT, 14), fg=GRAY); dot.grid(row=i, column=0, padx=(0, 6))\n            ttk.Label(sf, text=cn, width=10).grid(row=i, column=1, sticky=\"w\")\n            ttk.Label(sf, text=\":%d\" % port, foreground=GRAY, width=6).grid(row=i, column=2, sticky=\"w\")\n            st = ttk.Label(sf, text=\"…\", width=22); st.grid(row=i, column=3, sticky=\"w\")\n            b = ttk.Button(sf, text=\"重启\", width=6, command=lambda k=key: self.restart([k])); b.grid(row=i, column=4, padx=4, pady=2)\n            self.svc_rows[key] = (dot, st)\n        i = len(SERVICES)\n        self.crv_dot = tk.Label(sf, text=\"●\", font=(FONT, 14), fg=GRAY); self.crv_dot.grid(row=i, column=0, padx=(0, 6), pady=(6, 0))\n        ttk.Label(sf, text=\"CRV上位机\", width=10).grid(row=i, column=1, sticky=\"w\", pady=(6, 0))\n        self.crv_lbl = ttk.Label(sf, text=\"…\"); self.crv_lbl.grid(row=i, column=2, columnspan=3, sticky=\"w\", pady=(6, 0))\n\n        # 设备\n        df = ttk.LabelFrame(mid, text=\" 机械臂 \", padding=10); df.pack(side=\"left\", fill=\"both\", expand=True)\n        self.dev_lbl = {}\n        for i, (k, cn) in enumerate([(\"state\", \"状态\"), (\"detail\", \"控制器\"), (\"arm_at\", \"位置\"), (\"payload\", \"手上\"),\n                                     (\"mode\", \"模式\"), (\"task\", \"当前任务\"), (\"webhook\", \"事件推送\")]):\n            ttk.Label(df, text=cn, foreground=GRAY, width=8).grid(row=i, column=0, sticky=\"nw\", pady=1)\n            l = tk.Label(df, text=\"…\", font=(FONT, 10), anchor=\"w\", justify=\"left\", wraplength=380)\n            l.grid(row=i, column=1, sticky=\"w\", pady=1); self.dev_lbl[k] = l\n\n        # 操作\n        bar = ttk.Frame(self.root, padding=(16, 8)); bar.pack(fill=\"x\")\n        ttk.Button(bar, text=\"重启全部服务\", style=\"Big.TButton\", command=lambda: self.restart([\"vision\", \"scan\", \"upper\", \"cell\"])).pack(side=\"left\")\n        ttk.Button(bar, text=\"机械臂复位\", style=\"Big.TButton\", command=self.reset).pack(side=\"left\", padx=8)\n        ttk.Button(bar, text=\"设备网页\", style=\"Big.TButton\", command=lambda: webbrowser.open(API + \"/upper\")).pack(side=\"left\")\n        ttk.Button(bar, text=\"接口调试\", style=\"Big.TButton\", command=lambda: webbrowser.open(API + \"/docs\")).pack(side=\"left\", padx=8)\n        self.msg = ttk.Label(bar, foreground=BLUE); self.msg.pack(side=\"left\", padx=12)\n\n        # 扫码 + 日志\n        nb = ttk.Notebook(self.root); nb.pack(fill=\"both\", expand=True, padx=16, pady=(0, 14))\n        self.texts = {}\n        for title, fname in [(\"扫码记录\", None)] + LOGS:\n            fr = ttk.Frame(nb); nb.add(fr, text=\"  %s  \" % title)\n            t = tk.Text(fr, font=(\"Consolas\", 10), wrap=\"none\", bg=\"#f6f8fa\", relief=\"flat\", padx=8, pady=6)\n            ys = ttk.Scrollbar(fr, orient=\"vertical\", command=t.yview); t.configure(yscrollcommand=ys.set)\n            ys.pack(side=\"right\", fill=\"y\"); t.pack(fill=\"both\", expand=True)\n            t.tag_configure(\"ok\", foreground=GREEN); t.tag_configure(\"bad\", foreground=RED); t.tag_configure(\"dim\", foreground=GRAY)\n            t.configure(state=\"disabled\")\n            self.texts[title] = (t, fname)\n\n    # ── 后台采集(不卡界面) ──\n    def _poll_loop(self):\n        n = 0\n        while True:\n            svc = {}\n            for key, cn, port, sname in SERVICES:\n                prev = self.data[\"svc\"].get(key, {})\n                svc[key] = {\"up\": port_open(port), \"hold\": os.path.exists(os.path.join(ROOT, \"logs\", \"hold_%s.flag\" % key)),\n                            \"svc\": (svc_state(sname) if sname and n % 3 == 0 else prev.get(\"svc\")) if sname else \"计划任务\"}\n            try: dev = api(\"/device\", timeout=3)\n            except Exception: dev = None\n            cp = crv_port()\n            self.data.update(svc=svc, dev=dev, crv=(cp, port_open(cp)), ts=time.time())\n            n += 1\n            time.sleep(2)\n\n    def _refresh_ui(self):\n        self.clock.configure(text=time.strftime(\"%Y-%m-%d %H:%M:%S\"))\n        for key, (dot, st) in self.svc_rows.items():\n            s = self.data[\"svc\"].get(key)\n            if not s: continue\n            host = \"Windows服务\" if s[\"svc\"] not in (None, \"计划任务\") else (\"后台(桌面会话)\" if s[\"svc\"] == \"计划任务\" else \"\")\n            if s[\"up\"]:\n                dot.configure(fg=GREEN); st.configure(text=\"运行中  %s\" % host, foreground=GREEN)\n            elif s[\"hold\"]:\n                dot.configure(fg=AMBER); st.configure(text=\"已手动停止\", foreground=AMBER)\n            else:\n                dot.configure(fg=RED); st.configure(text=\"未运行(看门狗1分钟内会拉起)\", foreground=RED)\n        cp, up = self.data[\"crv\"]\n        self.crv_dot.configure(fg=GREEN if up else AMBER)\n        self.crv_lbl.configure(text=(\"运行中(端口 %d)\" % cp) if up else \"未运行 — 桌面双击「沈苏单机版CRV」打开\", foreground=GREEN if up else AMBER)\n\n        d = self.data[\"dev\"]; L = self.dev_lbl\n        if d is None:\n            for k in L: L[k].configure(text=\"—\", fg=GRAY)\n            L[\"state\"].configure(text=\"读不到(工作站服务没在运行)\", fg=RED)\n        else:\n            s = str(d.get(\"state\"))\n            L[\"state\"].configure(text=STATE_CN.get(s, s), fg=GREEN if s == \"idle\" else BLUE if s in (\"busy\", \"paused\") else RED)\n            L[\"detail\"].configure(text=d.get(\"detail\") or \"—\", fg=AMBER if (\"手动\" in str(d.get(\"detail\")) or \"⚠\" in str(d.get(\"detail\"))) else \"black\")\n            L[\"arm_at\"].configure(text=d.get(\"arm_at\") or \"—\", fg=\"black\")\n            pay = {\"none\": \"空手\", \"holding\": \"手上有盒\", \"unknown\": \"不确定\"}.get(str(d.get(\"payload\")), str(d.get(\"payload\")))\n            L[\"payload\"].configure(text=pay, fg=AMBER if d.get(\"payload\") == \"holding\" else \"black\")\n            sim = d.get(\"sim_mode\")\n            L[\"mode\"].configure(text=\"仿真模式(真机不会动!)\" if sim else \"真实模式\" if sim is False else \"—\", fg=AMBER if sim else \"black\")\n            L[\"task\"].configure(text=(\"#%s\" % d[\"task_id\"]) if d.get(\"task_id\") else \"无\", fg=BLUE if d.get(\"task_id\") else \"black\")\n            w = d.get(\"webhook\") or {}\n            if not w.get(\"enabled\"):\n                L[\"webhook\"].configure(text=\"未启用\", fg=GRAY)\n            else:\n                ok = w.get(\"state\") in (\"ok\", \"starting\")\n                L[\"webhook\"].configure(text=(\"正常\" if w.get(\"state\") == \"ok\" else \"启动中\" if ok else \"异常: %s\" % (w.get(\"last_error\") or w.get(\"state\"))) + \"  → \" + str(w.get(\"url\", \"\")),\n                                       fg=\"black\" if ok else RED)\n        self.root.after(1000, self._refresh_ui)\n\n    def _set_text(self, title, lines):\n        t, _ = self.texts[title]\n        at_end = t.yview()[1] > 0.98\n        t.configure(state=\"normal\"); t.delete(\"1.0\", \"end\")\n        for txt, tag in lines:\n            t.insert(\"end\", txt + \"\\n\", tag)\n        t.configure(state=\"disabled\")\n        if at_end: t.see(\"end\")\n\n    def _refresh_logs(self):\n        for title, (t, fname) in self.texts.items():\n            path = os.path.join(ROOT, \"logs\", fname or \"scan_service.log\")\n            size = os.path.getsize(path) if os.path.exists(path) else -1\n            if self._log_sizes.get(title) == size: continue\n            self._log_sizes[title] = size\n            _, txt = tail(path)\n            if fname is None:   # 扫码记录: 只挑扫到的码 / 交给任务的结果, 不显示轮询超时噪音\n                out = []\n                for ln in txt.splitlines():\n                    if \"[KeyboardScanner]\" in ln:\n                        out.append((ln.replace(\"[KeyboardScanner] \", \"\"), \"dim\" if \"code='\" in ln else \"ok\"))\n                    elif \"[扫码服务] scan ok\" in ln:\n                        out.append((ln.replace(\"[扫码服务] scan ok\", \"  → 已交给任务:\"), \"ok\"))\n                    elif \"[扫码服务] 启动\" in ln or \"[扫码服务] 就绪\" in ln or \"已退出\" in ln:\n                        out.append((ln, \"dim\"))\n                if not out: out = [(\"(还没有扫码记录)\", \"dim\")]\n                self._set_text(title, out[-300:])\n            else:\n                self._set_text(title, [(ln, \"bad\" if (\"Traceback\" in ln or \"Error\" in ln or \"FAIL\" in ln or \"失败\" in ln) else \"\") for ln in txt.splitlines()[-500:]])\n        self.root.after(2000, self._refresh_logs)\n\n    # ── 操作 ──\n    def _run_bg(self, label, fn):\n        if self.busy_op:\n            messagebox.showinfo(\"请稍候\", \"上一个操作还没做完\"); return\n        self.busy_op = True; self.msg.configure(text=label + \" …\")\n        def wrap():\n            try: res = fn()\n            except Exception as e: res = \"失败: %s\" % e\n            self.root.after(0, lambda: (self.msg.configure(text=res), setattr(self, \"busy_op\", False)))\n        threading.Thread(target=wrap, daemon=True).start()\n\n    def restart(self, keys):\n        d = self.data[\"dev\"]\n        if d and d.get(\"state\") == \"busy\" and set(keys) & {\"vision\", \"scan\", \"cell\"}:\n            if not messagebox.askyesno(\"确认\", \"设备正在执行任务 #%s, 重启服务会中断它。确定要重启吗?\" % d.get(\"task_id\")): return\n        names = \"、\".join(cn for k, cn, _, _ in SERVICES if k in keys)\n        def go():\n            fallback = []\n            for k in keys:   # 工作站放最后(它自己也是接口)\n                try: api(\"/services/%s/restart\" % k, \"POST\", timeout=70)\n                except Exception: fallback.append(k)\n            for k in fallback:\n                subprocess.run([\"cmd\", \"/c\", SVC_BAT, \"start\", k], capture_output=True, timeout=90, creationflags=NOWIN)\n            return \"已重启 %s(约 10~30 秒恢复)%s\" % (names, \"; 工作站接口不通, 已改为触发看门狗拉起\" if fallback else \"\")\n        self._run_bg(\"正在重启 \" + names, go)\n\n    def reset(self):\n        ans = simpledialog.askstring(\"机械臂复位\", \"复位会让真机沿原路退回到原点(home)!\\n\\n请确认:\\n  1. 机械臂周围没有人\\n  2. 急停已解除\\n  3. 控制器为自动模式\\n\\n确认请输入: 是\", parent=self.root)\n        if ans != \"是\": return\n        def go():\n            try:\n                r = api(\"/device/reset\", \"POST\", timeout=180)\n            except urllib.error.HTTPError as e:\n                body = e.read().decode(\"utf-8\", \"replace\")\n                return \"复位被拒: 有任务正在执行, 请先在上位机停止任务\" if \"busy\" in body else \"复位失败: HTTP %s %s\" % (e.code, body[:80])\n            msg = \"复位%s: %s  位置=%s\" % (\"成功\" if r.get(\"ok\") else \"失败(%s)\" % r.get(\"code\"), r.get(\"message\", \"\"), r.get(\"where\", \"\"))\n            if r.get(\"payload\") == \"holding\": msg += \"  ⚠ 手上还有一盒, 请人工取下或丢回\"\n            return msg\n        self._run_bg(\"复位中(最长约 1 分钟, 请勿离开)\", go)\n\n\ndef main():\n    lock = socket.socket()\n    try:\n        lock.bind((\"127.0.0.1\", 8911))\n    except OSError:\n        r = tk.Tk(); r.withdraw(); messagebox.showinfo(\"设备控制台\", \"设备控制台已经打开了(看看任务栏)\"); return\n    root = tk.Tk()\n    try: root.iconbitmap(default=\"\")\n    except Exception: pass\n    Console(root)\n    root.mainloop()\n\n\nif __name__ == \"__main__\":\n    import urllib.error  # noqa: F401  (reset 里捕获 HTTPError)\n    main()\n"}},"serverClassifierRequest":"f2faf285-7992-487c-96cd-6b5f7221ac4d","apiBlockIndex":2,"requestId":"req_011CgVfhPuPrpdCvcocVEErC","requestRef":"cdca4395-7dbe-403a-8f05-7fc4f00dfd7d","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"dcef4f8d-b2cf-4f65-a35a-9a5ad6b283b9","timestamp":"2026-10-29T01:35:07.512Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"e3658006-fd31-4b0f-afb2-07a88a71385d","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.312","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
