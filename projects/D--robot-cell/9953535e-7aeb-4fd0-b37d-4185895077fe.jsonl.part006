{"type":"file-history-delta","messageId":"fe316a86-6835-4b55-b424-caf8c6fcc183","snapshotMessageId":"badb0317-dff0-4d7e-90a7-b33821697d14","trackingPath":"tools\\arm\\track_executor.py","backup":{"backupFileName":"e9d9b9c7bba24368@v1","version":1,"backupTime":"2026-10-29T02:59:08.954Z","realParentDir":"D:\\robot_cell\\tools\\arm"},"timestamp":"2026-10-29T02:59:08.954Z"}
{"parentUuid":"fe316a86-6835-4b55-b424-caf8c6fcc183","isSidechain":false,"promptId":"a422cbf8-e2f5-4f95-9b3c-98aeb76c6299","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012usDP9YL1MJ1e7UJaXCUgr","type":"tool_result","content":"The file D:\\robot_cell\\tools\\arm\\track_executor.py has been updated successfully."}]},"uuid":"e9f60a36-8502-4b60-b7cd-69950607f58e","timestamp":"2026-10-29T02:59:09.278Z","toolUseResult":{"filePath":"D:\\robot_cell\\tools\\arm\\track_executor.py","oldString":"源在Mac: robocenter/scripts/bluespace/track_executor.py","newString":"2026-10-29 起本文件即唯一来源(运行目录已并入主仓库 D:\\robot_cell)","originalFile":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"track_executor.py — 控制器(仿真模式)流式执行规划轨迹并录制 (MoveIt流程第③步)\n用法(blue-space): python tools\\\\arm\\\\track_executor.py D:\\\\robot_cell\\\\data\\\\plans\\\\plan_<名>.json [速度 加速度]\n安全: 仅 get_simulation_state()==True 时执行, 否则拒绝(铁规)\n原理: 规划路点加密插值(步长<=0.05rad) → trackEnqueue入队 → trackJointMotion连续跟踪\n     执行期间以~25Hz录制真实关节 → robot_cell\\\\data\\\\recordings\\\\run_<名>.json (格式同blue_space_record)\n源在Mac: robocenter/scripts/bluespace/track_executor.py\n\"\"\"\nimport sys\nimport os\nimport time\nimport json\nimport math\n\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))   # robot_cell (2026-09-10 自旧桥目录迁入)\nAPI = os.path.join(ROOT, \"hardware\", \"robot_arm\", \"ducocobot_api\")   # 本库自带的原生RPC接口\nsys.path.insert(0, os.path.join(API, \"lib\")); sys.path.insert(0, os.path.join(API, \"gen_py\")); sys.path.insert(0, API)\nfrom DucoCobot import DucoCobot  # noqa: E402\n\nargs = [a for a in sys.argv[1:] if a != \"--real\"]\nREAL = \"--real\" in sys.argv                     # 真机模式: 需控制器为真实模式+起点比对通过\nplan_path = args[0]\nV = float(args[1]) if len(args) > 1 else (0.25 if REAL else 0.6)   # 真机默认低速\nA = float(args[2]) if len(args) > 2 else (0.25 if REAL else 0.6)\nname = os.path.basename(plan_path).replace(\"plan_\", \"runreal_\" if REAL else \"run_\")\nout = os.path.join(ROOT, \"data\", \"recordings\", name); os.makedirs(os.path.dirname(out), exist_ok=True)\n\nALLOW_DEV = \"--allow-start-dev\" in sys.argv      # 起点偏差二次确认后放行(由run_real编排)\ntraj = json.load(open(plan_path))[\"traj\"]\npts = [row[1:7] for row in traj]\ntarget = pts[-1]\n\nd = DucoCobot(\"192.168.0.20\", 7003)\nd.open()\nsim = d.get_simulation_state()\nif REAL:\n    if sim is not False:\n        print(\"expect REAL mode but sim_state=True -> abort\")\n        d.close(); sys.exit(2)\n    cur = d.get_actual_joints_position()\n    dev = max(abs(x - y) for x, y in zip(cur, pts[0]))\n    if dev > 0.05:                      # 起点比对: 防错位开跑\n        per = \" \".join(\"J%d=%+.1f\" % (i + 1, math.degrees(c - p))\n                       for i, (c, p) in enumerate(zip(cur, pts[0])))\n        if not ALLOW_DEV:\n            print(f\"START MISMATCH {dev:.3f}rad ({math.degrees(dev):.1f}deg) -> abort\")\n            print(f\"START DEV_PER_JOINT: {per}\")\n            d.close(); sys.exit(4)\n        # 放行: 把当前姿态插到轨迹最前, 让加密插值生成平滑接近段(而非瞬跳)\n        print(f\"START DEV ACCEPTED {math.degrees(dev):.1f}deg ({per}) -> 前置平滑接近段\")\n        pts = [list(cur)] + pts\n    else:\n        print(f\"REAL MODE: start aligned (dev {dev:.4f}rad), speed={V}\")\nelse:\n    if sim is not True:\n        print(\"NOT simulation mode -> abort\")\n        d.close(); sys.exit(2)\n\n# 加密插值: 相邻路点最大关节步长0.05rad(防track样条切角偏离规划; 含放行时的接近段)\ndense = [pts[0]]\nfor a_, b_ in zip(pts, pts[1:]):\n    steps = max(1, int(math.ceil(max(abs(x - y) for x, y in zip(a_, b_)) / 0.05)))\n    for k in range(1, steps + 1):\n        dense.append([x + (y - x) * k / steps for x, y in zip(a_, b_)])\n\nd.trackClearQueue()\nB = 50\nfor i in range(0, len(dense), B):\n    d.trackEnqueue(dense[i:i + B], True)\nd.trackJointMotion(V, A, False)          # 非阻塞启动, 主循环录制\n\nrec, t0, settled = [], time.time(), 0\nwhile time.time() - t0 < 90:\n    j = d.get_actual_joints_position()\n    rec.append([round(time.time() - t0, 3)] + [round(x, 6) for x in j])\n    if max(abs(x - y) for x, y in zip(j, target)) < 0.002:\n        settled += 1\n        if settled >= 5:                 # 连续5帧贴住终点=执行完成\n            break\n    else:\n        settled = 0\n    time.sleep(0.04)\n\njson.dump({\"traj\": rec, \"src\": \"track_run\", \"plan\": os.path.basename(plan_path)}, open(out, \"w\"))\nd.close()\ndone = settled >= 5\nprint(f\"{'RUN' if done else 'TIMEOUT'}:{len(rec)}pts,{rec[-1][0]:.2f}s,densified={len(dense)} -> {out}\")\nsys.exit(0 if done else 3)\n","structuredPatch":[{"oldStart":5,"oldLines":7,"newStart":5,"newLines":7,"lines":[" 安全: 仅 get_simulation_state()==True 时执行, 否则拒绝(铁规)"," 原理: 规划路点加密插值(步长<=0.05rad) → trackEnqueue入队 → trackJointMotion连续跟踪","      执行期间以~25Hz录制真实关节 → robot_cell\\\\data\\\\recordings\\\\run_<名>.json (格式同blue_space_record)","-源在Mac: robocenter/scripts/bluespace/track_executor.py","+2026-10-29 起本文件即唯一来源(运行目录已并入主仓库 D:\\robot_cell)"," \"\"\""," import sys"," import os"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"fe316a86-6835-4b55-b424-caf8c6fcc183","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.309","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
