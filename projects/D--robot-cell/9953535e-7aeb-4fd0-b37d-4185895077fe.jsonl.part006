maxPolarAngle = 1.32;","   controls.minAzimuthAngle = -0.45; controls.maxAzimuthAngle = 0.75;","   controls.autoRotate = true; controls.autoRotateSpeed = 0.3;"]},{"oldStart":231,"oldLines":7,"newStart":232,"newLines":7,"lines":["     const w = stage.clientWidth, h = stage.clientHeight;","     renderer.setSize(w, h, false); camera.aspect = w / h;","     // 宽屏时把模型留在两侧面板之间(镜头视野随宽高比略调)","-    camera.fov = w / h > 1.6 ? 28 : 36;","+    camera.fov = OPT.fov || (w / h > 1.6 ? 28 : 36);","     camera.updateProjectionMatrix();","   }","   window.addEventListener(\"resize\", resize); resize();"]}]}],"moreFiles":0,"changedFiles":["/Users/chen/Desktop/robocenter/docs/首页改版/scene3d.js"]}},"serverClassifierContext":{"request":"2d4f90f5-4c5e-404c-94a1-dd6f6dd15ae0","context":{"git_state":{"cwd":"D:\\robot_cell","root":"/Users/chen/Desktop/robocenter","branch":"exp/stand-place","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":12},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/chen/Desktop/robocenter/docs/首页改版","platform":"macos"}},"sourceToolAssistantUUID":"c82b4d4a-4a2f-43cd-b53a-d25ebbcab56d","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"9522f059-708e-4e8b-be90-04411bc0aa04","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.306","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
