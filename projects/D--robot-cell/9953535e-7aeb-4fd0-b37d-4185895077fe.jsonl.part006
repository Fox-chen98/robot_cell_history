{"parentUuid":"5dadedd5-5ccd-4ec2-be1d-dc1fe8e243e5","isSidechain":false,"promptId":"12933cbd-f703-4314-a852-db734a87636d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015TLXu7FB21XLBKQCWtJhAg","type":"tool_result","content":"File created successfully at: /Users/chen/Desktop/robocenter/scripts/export_layout_dxf.py (file state is current in your context — no need to Read it back)"}]},"uuid":"cf437f9f-9744-4216-bfdc-6edd17fb334f","timestamp":"2026-10-26T01:20:20.308Z","toolUseResult":{"type":"create","filePath":"/Users/chen/Desktop/robocenter/scripts/export_layout_dxf.py","content":"# -*- coding: utf-8 -*-\n\"\"\"设备布局俯视图导出(投标布局用, 2026-10-26): 仿真模型 → 1:1 毫米 DXF, 每台设备一个图块.\n\n用法:  <装了 ezdxf/trimesh/shapely/pyyaml 的 python> scripts/export_layout_dxf.py [输出目录=docs/投标布局] [--pose home]\n  环境: python3 -m venv <dir> && <dir>/bin/pip install ezdxf trimesh shapely numpy pyyaml matplotlib\n产物:  设备布局俯视图.dxf(R2010, AutoCAD 打开后可另存 DWG) + 设备布局俯视图.png(预览)\n\n数据来源(与仿真同源, 不另起参数):\n  - 机械臂: out/gcr10_1300.urdf 的关节链 + DUCO 官方网格(duco_support/meshes/GCR10_1300), 末端=3D_model 里现役立放末端 STL;\n            按 poses.yaml 的姿态(默认 home)正运动学摆好, 三角面投影到地面取并集 = 真实俯视轮廓\n  - 货架/工作台/上苗机/回流带/侧扫码器/扫码口: config/scene_params.yaml(实测位姿+尺寸, 与 build_scene.py 同一套几何)\n坐标: 原点 = 机械臂底座中心(基座系 base_link 的 xy), x/y 同基座系, 单位 mm.\n图块: 每台设备一个 BLOCK, 块内是设备自身坐标(中心为基点), INSERT 时带实测位置+转角 —— 同事可以整块挪动/复制.\n判决: [PASS] 写出文件且每台设备轮廓非空 / [FAIL] 其他.\n⚠ 底座(pedestal)只有占位半径, 不画; shelf2(第二货架)位姿是旧仿真基线值未标定, 单独放图层\"货架B_位置未标定\".\n\"\"\"\nimport math\nimport os\nimport sys\nimport xml.etree.ElementTree as ET\n\nimport ezdxf\nimport numpy as np\nimport trimesh\nimport yaml\nfrom shapely.geometry import Polygon, MultiPolygon\nfrom shapely.ops import unary_union\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nDUCO_MESH = os.path.expanduser(\"~/Desktop/现行项目/机器人/duco_ros_V3.7.1/duco_ws/src/duco_support/meshes/GCR10_1300\")\nREACH_MM = 1300                     # GCR10-1300 最大工作半径(型号标称)\nargs = [a for a in sys.argv[1:] if not a.startswith(\"--\")]\nOUT = os.path.join(ROOT, args[0]) if args else os.path.join(ROOT, \"docs\", \"投标布局\")\nPOSE = sys.argv[sys.argv.index(\"--pose\") + 1] if \"--pose\" in sys.argv else \"home\"\nP = yaml.safe_load(open(os.path.join(ROOT, \"config\", \"scene_params.yaml\"), encoding=\"utf-8\"))\n\n\n# ---------- 机械臂: URDF 正运动学 + 网格投影 ----------\ndef tf(xyz, rpy):\n    r, p, y = rpy\n    Rx = np.array([[1, 0, 0], [0, math.cos(r), -math.sin(r)], [0, math.sin(r), math.cos(r)]])\n    Ry = np.array([[math.cos(p), 0, math.sin(p)], [0, 1, 0], [-math.sin(p), 0, math.cos(p)]])\n    Rz = np.array([[math.cos(y), -math.sin(y), 0], [math.sin(y), math.cos(y), 0], [0, 0, 1]])\n    T = np.eye(4); T[:3, :3] = Rz @ Ry @ Rx; T[:3, 3] = xyz\n    return T\n\n\ndef axis_rot(axis, q):\n    a = np.array(axis, float); a /= np.linalg.norm(a)\n    K = np.array([[0, -a[2], a[1]], [a[2], 0, -a[0]], [-a[1], a[0], 0]])\n    T = np.eye(4); T[:3, :3] = np.eye(3) + math.sin(q) * K + (1 - math.cos(q)) * K @ K\n    return T\n\n\ndef origin_of(el):\n    o = el.find(\"origin\") if el is not None else None\n    if o is None:\n        return np.eye(4)\n    return tf([float(v) for v in o.get(\"xyz\", \"0 0 0\").split()], [float(v) for v in o.get(\"rpy\", \"0 0 0\").split()])\n\n\ndef arm_outline(q):\n    root = ET.parse(os.path.join(ROOT, \"out\", \"gcr10_1300.urdf\")).getroot()\n    joints = {j.find(\"child\").get(\"link\"): j for j in root.findall(\"joint\")}\n    jq = {\"arm_1_joint_%d\" % (i + 1): q[i] for i in range(6)}\n    world = {}\n\n    def T_of(link):\n        if link in world:\n            return world[link]\n        j = joints.get(link)\n        if j is None:\n            world[link] = np.eye(4); return world[link]\n        T = T_of(j.find(\"parent\").get(\"link\")) @ origin_of(j)\n        if j.get(\"type\") in (\"revolute\", \"continuous\"):\n            ax = j.find(\"axis\"); T = T @ axis_rot([float(v) for v in (ax.get(\"xyz\") if ax is not None else \"0 0 1\").split()], jq.get(j.get(\"name\"), 0.0))\n        world[link] = T\n        return T\n\n    arm_links = [\"base_link\"] + [\"link_%d\" % i for i in range(1, 7)] + [\"suction_cup_link\", \"camera_link\"]\n    polys = []\n    for l in root.findall(\"link\"):\n        name = l.get(\"name\")\n        if name not in arm_links:\n            continue\n        for v in l.findall(\"visual\"):\n            g = next(iter(v.find(\"geometry\")))\n            T = T_of(name) @ origin_of(v)\n            if g.tag == \"mesh\":\n                fn = g.get(\"filename\")\n                path = os.path.join(DUCO_MESH, os.path.basename(fn)) if \"GCR10_1300\" in fn else os.path.join(ROOT, P[\"tool\"][\"mesh\"])\n                m = trimesh.load(path, force=\"mesh\")\n                sc = [float(s) for s in g.get(\"scale\", \"1 1 1\").split()]\n                V = m.vertices * sc\n                F = m.faces\n            elif g.tag == \"box\":\n                sx, sy, sz = [float(s) for s in g.get(\"size\").split()]\n                b = trimesh.creation.box(extents=[sx, sy, sz]); V, F = b.vertices, b.faces\n            else:\n                continue\n            W = (T[:3, :3] @ V.T).T + T[:3, 3]\n            tri = W[F][:, :, :2] * 1000.0                   # 投影到地面, 毫米\n            area = 0.5 * np.abs((tri[:, 1, 0] - tri[:, 0, 0]) * (tri[:, 2, 1] - tri[:, 0, 1]) - (tri[:, 2, 0] - tri[:, 0, 0]) * (tri[:, 1, 1] - tri[:, 0, 1]))\n            polys += [Polygon(t) for t in tri[area > 1e-4]]\n    shape = unary_union(polys).buffer(0.3).buffer(-0.3).simplify(0.5)\n    return shape\n\n\n# ---------- DXF ----------\ndef rect(blk, cx, cy, w, h, layer, yaw=0.0):\n    c, s = math.cos(yaw), math.sin(yaw)\n    pts = [(cx + c * x - s * y, cy + s * x + c * y) for x, y in ((-w / 2, -h / 2), (w / 2, -h / 2), (w / 2, h / 2), (-w / 2, h / 2))]\n    blk.add_lwpolyline(pts, close=True, dxfattribs={\"layer\": layer})\n\n\ndef label(msp_or_blk, text, x, y, h=40, layer=\"标注\", rot=0.0):\n    t = msp_or_blk.add_text(text, height=h, rotation=rot, dxfattribs={\"layer\": layer, \"style\": \"CN\"})\n    t.set_placement((x, y), align=ezdxf.enums.TextEntityAlignment.MIDDLE_CENTER)\n\n\ndef main():\n    os.makedirs(OUT, exist_ok=True)\n    doc = ezdxf.new(\"R2010\", setup=True)\n    doc.units = ezdxf.units.MM\n    doc.header[\"$INSUNITS\"] = 4\n    doc.styles.new(\"CN\", dxfattribs={\"font\": \"simsun.ttc\"})\n    for name, color in ((\"机械臂\", 1), (\"机械臂_工作半径\", 8), (\"货架A\", 5), (\"货架B_位置未标定\", 6), (\"工作台\", 3),\n                        (\"上苗机\", 30), (\"回流传送带\", 4), (\"侧扫码器\", 2), (\"扫码口\", 140), (\"标注\", 7)):\n        doc.layers.add(name, color=color)\n    doc.layers.get(\"机械臂_工作半径\").dxf.linetype = \"DASHED\"\n    msp = doc.modelspace()\n    report = []\n\n    # 机械臂(块内=基座系, 基点=底座中心)\n    q = [float(x) for x in yaml.safe_load(open(os.path.join(ROOT, \"config\", \"poses.yaml\"), encoding=\"utf-8\"))[POSE]]\n    arm = arm_outline(q)\n    b = doc.blocks.new(\"机械臂_GCR10-1300\")\n    geoms = list(arm.geoms) if isinstance(arm, MultiPolygon) else [arm]\n    for g in geoms:\n        b.add_lwpolyline(list(g.exterior.coords), close=True, dxfattribs={\"layer\": \"机械臂\"})\n        for hole in g.interiors:\n            b.add_lwpolyline(list(hole.coords), close=True, dxfattribs={\"layer\": \"机械臂\"})\n    b.add_circle((0, 0), REACH_MM, dxfattribs={\"layer\": \"机械臂_工作半径\"})\n    b.add_line((-60, 0), (60, 0), dxfattribs={\"layer\": \"机械臂\"}); b.add_line((0, -60), (0, 60), dxfattribs={\"layer\": \"机械臂\"})\n    msp.add_blockref(\"机械臂_GCR10-1300\", (0, 0), dxfattribs={\"layer\": \"机械臂\"})\n    label(msp, \"最大工作半径 R%d\" % REACH_MM, 0, -REACH_MM - 60, 50)\n    label(msp, \"机械臂 DUCO GCR10-1300(%s姿态)\" % POSE, 0, -180, 40)\n    report.append((\"机械臂\", arm.area > 0, \"轮廓 %d 段, 外接 %.0f×%.0f mm\" % (len(geoms), arm.bounds[2] - arm.bounds[0], arm.bounds[3] - arm.bounds[1])))\n\n    # 货架(块内=货架系: 中心基点, x 沿宽, 前沿 y=-D/2 朝机械臂)\n    S = P[\"shelf\"]; W, D, ps = S[\"width\"] * 1000, S[\"depth\"] * 1000, S[\"post_section\"] * 1000\n    b = doc.blocks.new(\"货架_%dx%d\" % (W, D))\n    rect(b, 0, 0, W, D, \"0\")\n    for x in [-W / 2 + ps / 2] + [-W / 2 + i * W / S[\"columns\"] for i in range(1, S[\"columns\"])] + [W / 2 - ps / 2]:\n        for y in (-D / 2 + ps / 2, D / 2 - ps / 2):\n            rect(b, x, y, ps, ps, \"0\")\n    for nm, key, layer in ((\"货架A\", \"shelf\", \"货架A\"), (\"货架B(位置未标定)\", \"shelf2\", \"货架B_位置未标定\")):\n        sp = P.get(key) or {}\n        if not sp.get(\"enabled\"):\n            continue\n        x, y, _ = sp[\"pose_xyz\"]; yaw = sp[\"pose_rpy\"][2]\n        msp.add_blockref(b.name, (x * 1000, y * 1000), dxfattribs={\"layer\": layer, \"rotation\": math.degrees(yaw)})\n        label(msp, \"%s %d×%d×%d\" % (nm, W, D, S[\"height\"] * 1000), x * 1000, y * 1000, 45, rot=math.degrees(yaw))\n        report.append((nm, True, \"中心(%.0f, %.0f) 转角 %.1f°\" % (x * 1000, y * 1000, math.degrees(yaw))))\n\n    # 工作台 + 挂在桌子系下的设备(上苗机/回流带/侧扫码器/扫码口)\n    T = P[\"table\"]; tx, ty, _ = T[\"pose_xyz\"]; tyaw = T[\"pose_rpy\"][2]; sx, sy, sz = [v * 1000 for v in T[\"size\"]]\n    def at_table(lx, ly):\n        c, s = math.cos(tyaw), math.sin(tyaw)\n        return tx * 1000 + c * lx - s * ly, ty * 1000 + s * lx + c * ly\n    b = doc.blocks.new(\"工作台_%dx%d\" % (sx, sy))\n    rect(b, 0, 0, sx, sy, \"0\")\n    if T.get(\"scan_port\"):\n        (px, py), (pw, pd) = T[\"scan_port\"][\"center_offset\"], T[\"scan_port\"][\"size\"]\n        rect(b, px * 1000, py * 1000, pw * 1000, pd * 1000, \"扫码口\")\n    msp.add_blockref(b.name, at_table(0, 0), dxfattribs={\"layer\": \"工作台\", \"rotation\": math.degrees(tyaw)})\n    label(msp, \"工作台 %d×%d×%d\" % (sx, sy, sz), *at_table(-120, 0), 35, rot=math.degrees(tyaw))\n    report.append((\"工作台\", True, \"中心(%.0f, %.0f) 转角 %.1f°\" % (tx * 1000, ty * 1000, math.degrees(tyaw))))\n    for key, nm, layer in ((\"side_scanner\", \"侧扫码器\", \"侧扫码器\"), (\"return_belt\", \"回流传送带\", \"回流传送带\")):\n        it = T.get(key)\n        if not it:\n            continue\n        (cx, cy), (dx, dy, dz) = it[\"center_offset\"], it[\"size\"]\n        b = doc.blocks.new(\"%s_%dx%d\" % (nm, dx * 1000, dy * 1000))\n        rect(b, 0, 0, dx * 1000, dy * 1000, \"0\")\n        msp.add_blockref(b.name, at_table(cx * 1000, cy * 1000), dxfattribs={\"layer\": layer, \"rotation\": math.degrees(tyaw)})\n        if key == \"return_belt\":\n            label(msp, \"回流传送带 %d×%d\" % (dx * 1000, dy * 1000), *at_table(cx * 1000, cy * 1000), 30, rot=math.degrees(tyaw))\n        report.append((nm, True, \"%d×%d×%d\" % (dx * 1000, dy * 1000, dz * 1000)))\n    CV = P.get(\"conveyor\") or {}\n    if CV.get(\"enabled\"):\n        (cx, cy, _), (dx, dy, dz) = CV[\"box_center\"], CV[\"box_size\"]\n        b = doc.blocks.new(\"上苗机_%dx%d\" % (dx * 1000, dy * 1000))\n        rect(b, 0, 0, dx * 1000, dy * 1000, \"0\")\n        rot = math.degrees(tyaw) + CV.get(\"yaw_deg\", 0)\n        msp.add_blockref(b.name, at_table(cx * 1000, cy * 1000), dxfattribs={\"layer\": \"上苗机\", \"rotation\": rot})\n        label(msp, \"上苗机(整机包络) %d×%d×%d\" % (dx * 1000, dy * 1000, dz * 1000), *at_table(cx * 1000, cy * 1000), 45, rot=rot)\n        report.append((\"上苗机\", True, \"%d×%d×%d\" % (dx * 1000, dy * 1000, dz * 1000)))\n\n    label(msp, \"设备布局俯视图  1:1  单位mm  原点=机械臂底座中心  (由仿真模型导出, 位置为现场标定实测值)\", 0, -REACH_MM - 200, 40)\n    dxf_path = os.path.join(OUT, \"设备布局俯视图.dxf\")\n    doc.saveas(dxf_path)\n\n    try:                                              # 预览图(可选)\n        import matplotlib; matplotlib.use(\"Agg\")\n        import matplotlib.pyplot as plt\n        from matplotlib import font_manager\n        from ezdxf.addons.drawing import RenderContext, Frontend\n        from ezdxf.addons.drawing.matplotlib import MatplotlibBackend\n        for f in (\"PingFang SC\", \"Heiti SC\", \"Arial Unicode MS\"):\n            if any(f in x.name for x in font_manager.fontManager.ttflist):\n                plt.rcParams[\"font.family\"] = f; break\n        fig = plt.figure(figsize=(12, 12)); ax = fig.add_axes([0, 0, 1, 1])\n        Frontend(RenderContext(doc), MatplotlibBackend(ax)).draw_layout(msp)\n        fig.savefig(os.path.join(OUT, \"设备布局俯视图.png\"), dpi=150, facecolor=\"white\")\n    except Exception as e:\n        print(\"(预览图没出: %s)\" % e)\n\n    ok = all(r[1] for r in report)\n    for nm, good, info in report:\n        print(\"  %s %-10s %s\" % (\"✓\" if good else \"✗\", nm, info))\n    print(\"%s %s\" % (\"[PASS]\" if ok else \"[FAIL]\", dxf_path))\n    sys.exit(0 if ok else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"5dadedd5-5ccd-4ec2-be1d-dc1fe8e243e5","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"4a5608cc-8439-46c4-aa57-90a8932cb84f","userType":"external","entrypoint":"cli","cwd":"D:\\robot_cell","sessionId":"9953535e-7aeb-4fd0-b37d-4185895077fe","version":"2.1.310","gitBranch":"exp/stand-place","slug":"nifty-honking-brook"}
