ieve\", \"outbound\"):\n                v = str((d.get(\"data\") or {}).get(\"真空DI4\", \"\"))\n                if \"后1\" in v or ev[\"payload\"] == \"holding\":\n                    t.progress[\"retrieved\"] += 1\n                    t.emit(\"retrieved\", box_seq=t.box_seq, code=t.current.get(\"code\"), slot=t.current.get(\"slot\"), pit=t.current.get(\"pit\"), dest=t.req.dest,\n                           front_mm=getattr(r, \"front_mm\", None), **_xi(t.current.get(\"pit\")))\n                else:\n                    t.progress[\"empty\"] += 1; t.current[\"empty_emitted\"] = True\n                    t.emit(\"pit_empty\", box_seq=t.box_seq, code=t.current.get(\"code\"), slot=t.current.get(\"slot\"), pit=t.current.get(\"pit\"), detail=v, **_xi(t.current.get(\"pit\")))\n            if r.action.startswith(\"丢回\") and r.ok and t.req.type in (\"retrieve\", \"outbound\"):\n                pass                                       # 出库的丢回=送到传送带, 不算\"丢回\"\n            elif r.action.startswith(\"丢回\") and r.ok:\n                t.progress[\"discarded\"] += 1\n                t.emit(\"discarded\", box_seq=t.box_seq, code=t.current.get(\"code\"), reason=t.current.get(\"discard_reason\", \"流程判断不放行\"))\n            if not r.ok:\n                t.emit(\"fault\", box_seq=t.box_seq, code=r.code, category=ev[\"category\"], message=r.message, payload=ev[\"payload\"], where=r.arm_at)\n\n        def on_waiting(why, waited):\n            t.stage_code = \"WAIT_ADJUST\" if (\"无可吸\" in str(why) or \"摆正\" in str(why)) else \"WAIT_LOADING\"   # 有盒但太远/摆歪 vs 桌上没盒\n            if int(waited) % 5 == 0:\n488:def _manual_op(name):\n489-    \"\"\"调试/恢复动作: 独占控制器跑一个动作, 回卡片. 任务运行中拒绝\"\"\"\n490-    t = TASKS.running\n491-    if t is not None and t.state not in (\"needs_human\", \"paused\"):\n492-        raise HTTPException(409, {\"error\": \"busy\", \"task_id\": t.id, \"state\": t.state})\n493-    from hardware.robot_arm import DucoCobotArm\n494-    from actions.result import PayloadState as P\n495-